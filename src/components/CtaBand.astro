---
import Icon from './Icon.astro';
import { firma } from '~/data/site';
import { url } from '~/lib/url';

interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Projekt geplant?',
  text = 'Wir freuen uns auf Ihre Anfrage. Telefonisch, per E-Mail oder persönlich.',
} = Astro.props;
---

<section class="cta-band on-blue">
  <div class="diamond d1" data-spin></div>
  <div class="diamond d2" data-spin></div>
  <div class="container inner">
    <div class="copy" data-reveal>
      <p class="eyebrow light">Kontakt</p>
      <h2 class="h2">{title}</h2>
      <p class="txt">{text}</p>
    </div>
    <div class="ways" data-reveal data-reveal-children>
      <a href={firma.telefonHref} class="way">
        <Icon name="phone" />
        <span><small>Telefon</small>{firma.telefon}</span>
      </a>
      <a href={`mailto:${firma.email}`} class="way">
        <Icon name="mail" />
        <span><small>E-Mail</small>{firma.email}</span>
      </a>
      <a href={url('/kontakt/')} class="btn white"><span>Zum Kontaktformular</span><Icon name="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 9vw, 8rem);
    isolation: isolate;
  }
  .diamond {
    background: rgb(255 255 255 / 0.07);
    z-index: -1;
  }
  .d1 {
    width: min(70vw, 900px);
    right: -18%;
    top: -30%;
  }
  .d2 {
    width: min(40vw, 480px);
    right: 18%;
    bottom: -45%;
    background: rgb(18 23 53 / 0.18);
  }
  .inner {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
  }
  .txt {
    color: rgb(255 255 255 / 0.85);
    margin-top: 1.2rem;
    max-width: 36rem;
  }
  .ways {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }
  .way {
    display: flex;
    gap: 1rem;
    align-items: center;
    text-decoration: none;
    font-family: var(--font-head);
    font-stretch: 108%;
    font-weight: 600;
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    width: 100%;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line-light);
  }
  .way:hover {
    text-decoration: underline;
  }
  .way small {
    display: block;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 0.85rem;
    color: rgb(255 255 255 / 0.7);
  }
  .way :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
    flex: none;
  }
  .ways .btn {
    margin-top: 0.8rem;
  }
  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
