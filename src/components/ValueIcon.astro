---
/**
 * Werte-Motive in einer feinen Raute (Proportionen der Logo-Raute).
 * familie: Familie unter einem Dach · dialog: Gespräch · hammer: Quirling-Hammer aus dem Logo
 */
import QHammer from './QHammer.astro';

interface Props {
  name: 'familie' | 'dialog' | 'hammer';
  class?: string;
}
const { name, class: cls } = Astro.props;
const paths = {
  familie:
    'M14 22 32 10l18 12M20 31.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9ZM12 47v-4.5a8 8 0 0 1 16 0V47M44 31.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9ZM36 47v-4.5a8 8 0 0 1 16 0V47M32 38.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM26.5 50v-3a5.5 5.5 0 0 1 11 0v3',
  dialog: 'M9 14h30v17H21l-6 6v-6H9ZM15 20.5h18M15 25.5h11M27 31v7h18l6 6v-6h4V21H39',
};
---

<span class:list={['vicon', cls]}>
  <svg class="vicon-frame" viewBox="0 0 120 84" aria-hidden="true">
    <path d="M60 1 119 43.5 58 83 1 41.5Z"></path>
  </svg>
  {
    name === 'hammer' ? (
      <QHammer class="vicon-art vicon-hammer" color="currentColor" highlight="var(--vicon-bg, #3948A4)" />
    ) : (
      <svg class="vicon-art" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" aria-hidden="true">
        <path d={paths[name]} />
      </svg>
    )
  }
</span>

<style>
  .vicon {
    position: relative;
    display: grid;
    place-items: center;
    width: 150px;
    aspect-ratio: 120 / 84;
  }
  .vicon-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    opacity: 0.45;
  }
  .vicon :global(.vicon-art) {
    position: relative;
    width: 62px;
    height: 62px;
  }
  .vicon :global(.vicon-hammer) {
    width: 44px;
    height: 44px;
  }
</style>
