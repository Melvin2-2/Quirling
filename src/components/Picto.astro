---
/**
 * Piktogramme im einheitlichen Linienstil (48er-Raster, 1,6 px Strich).
 * Jedes Piktogramm trägt eine kleine gefüllte Raute als Farbakzent (Logo-Motiv).
 */
export type PictoName =
  | 'rohbau'
  | 'schluessel'
  | 'umbau'
  | 'bewehrung'
  | 'kalender'
  | 'gebaeude'
  | 'helm'
  | 'standort'
  | 'hammer'
  | 'kran'
  | 'siegel';

interface Props {
  name: PictoName;
  class?: string;
}
const { name, class: cls } = Astro.props;

const lines: Record<PictoName, string> = {
  rohbau: 'M6 41h36M10 41V20M24 41V20M38 41V20M8 31h32M8 20h32M10 20v-6M24 20v-4M38 20v-8',
  schluessel: 'M7 22 24 8l17 14M10 19.5V41h28V19.5M24 29h9m-3 0v4m3-4v4M20 33a4 4 0 1 1 0-8 4 4 0 0 1 0 8Z',
  umbau: 'M8 23 24 10l16 13M11 20.5V41h26V20.5M30 31a6 6 0 1 1-2.2-4.6M28.5 22.5v4h4',
  bewehrung: 'M8 8h32v32H8zM8 18h32M8 30h32M18 8v32M30 8v32',
  kalender: 'M8 12h32v28H8zM8 20h32M16 7v9M32 7v9M14 27h4M22 27h4M30 27h4M14 33h4M22 33h4',
  gebaeude: 'M8 41V20h12v21M20 41V9h20v32M5 41h38M25 15h3M32 15h3M25 21h3M32 21h3M25 27h3M32 27h3M12 26h4M12 32h4',
  helm: 'M7 34h34M10 34v-3a14 14 0 0 1 28 0v3M20 18.5V14h8v4.5M24 14v10',
  standort: 'M24 42s-12-11-12-21a12 12 0 0 1 24 0c0 10-12 21-12 21ZM24 25.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Z',
  hammer: 'M21 16.5 37.5 33a2.5 2.5 0 0 1-3.5 3.5L17.5 20M12 9.5l7.5-2.5 6 6-4.5 4.5-3 3-6-6 2.5-7.5Z',
  kran: 'M14 42V8M8 42h12M14 8l24 0M14 14l6-6M14 8 4 13M34 8v12M31 20h6v4h-6z',
  siegel: 'M24 5 43 24 24 43 5 24ZM16.5 24.5l5 5 10-11',
};

// Position der Akzent-Raute je Piktogramm
const accent: Record<PictoName, [number, number]> = {
  rohbau: [31, 8],
  schluessel: [24, 2.5],
  umbau: [40, 39],
  bewehrung: [24, 24],
  kalender: [40, 7],
  gebaeude: [14, 14],
  helm: [24, 28],
  standort: [24, 21],
  hammer: [40, 9],
  kran: [44, 34],
  siegel: [41, 41],
};
const [ax, ay] = accent[name];
const s = 3.2;
---

<svg
  class:list={['picto', cls]}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
>
  <path d={lines[name]}></path>
  <path class="picto-accent" d={`M${ax} ${ay - s}l${s} ${s}-${s} ${s}-${s}-${s}Z`} fill="var(--accent, #3948A4)" stroke="none"></path>
</svg>
