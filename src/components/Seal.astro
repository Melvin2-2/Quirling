---
/** Rotierendes Siegel: Kreisschrift mit dem Quirling-Hammer in der Mitte */
import QHammer from './QHammer.astro';

interface Props {
  text?: string;
  class?: string;
  tone?: 'blue' | 'white';
}
const { text = 'QUIRLING · BAUUNTERNEHMEN · HAMBURG · SEIT 1992 · ', class: cls, tone = 'blue' } = Astro.props;
const id = `seal-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['seal', `seal-${tone}`, cls]} data-seal>
  <svg class="seal-ring" viewBox="0 0 200 200" aria-hidden="true">
    <defs><path id={id} d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"></path></defs>
    <text><textPath href={`#${id}`} textLength="488" lengthAdjust="spacing">{text}</textPath></text>
  </svg>
  <span class="seal-core">
    <QHammer class="seal-hammer" color={tone === 'white' ? '#3948A4' : '#fff'} highlight={tone === 'white' ? '#fff' : '#3948A4'} />
  </span>
</div>

<style>
  .seal {
    position: relative;
    width: 168px;
    aspect-ratio: 1;
  }
  .seal-ring {
    width: 100%;
    height: 100%;
    animation: seal-spin 22s linear infinite;
  }
  .seal-ring text {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.06em;
    fill: var(--blue);
  }
  .seal-white .seal-ring text {
    fill: #fff;
  }
  .seal-core {
    position: absolute;
    inset: 27%;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--blue);
  }
  .seal-white .seal-core {
    background: #fff;
  }
  .seal-core :global(.seal-hammer) {
    width: 62%;
    height: 62%;
  }
  @keyframes seal-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
