---
/**
 * Gemeinsame Vorlage der drei Leistungsseiten (Aufbau der Rohbauseite).
 * Ebenen der Blickführung: große Aussage (h-sec) → Einleitung (lead) → Zwischenüberschrift → Fließtext.
 * Abschnitte: Einstieg mit drei Aussagen · Leistungsumfang (hellblau) · Was uns ausmacht (Navy mit Foto) ·
 * Referenzen · Anfrage und die anderen Leistungen.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import { leistungen } from '~/data/site';
import { leistungBild } from '~/data/leistung-bilder';
import { url } from '~/lib/url';

type Punkt = { t: string; d: string };
export interface LeistungDaten {
  slug: 'rohbau' | 'schluesselfertiges-bauen' | 'umbau-sanierung';
  title: string;
  description: string;
  hero: { title: string; light?: string; intro: string; alt: string; pos?: string };
  introTitel: [string, string];
  lead: string;
  usp: Punkt[];
  umfangTitel: [string, string];
  umfang: Punkt[];
  eigenTitel: [string, string];
  eigen: Punkt[];
  eigenAlt: string;
  eigenPos?: string;
  refsLabel: string;
  cta: [string, string];
  ctaBtn: string;
}
interface Props {
  d: LeistungDaten;
}
const { d } = Astro.props;

const hero = await leistungBild(d.slug, 'hero');
const bild = await leistungBild(d.slug, 'text');
const projekte = (await getCollection('projekte', (p) => p.data.bereich === d.slug))
  .sort((a, b) => (a.data.highlight ?? 99) - (b.data.highlight ?? 99) || (b.data.jahr ?? 0) - (a.data.jahr ?? 0))
  .slice(0, 3);
const andere = await Promise.all(
  leistungen.filter((x) => x.slug !== d.slug).map(async (x) => ({ ...x, bild: await leistungBild(x.slug, 'start') })),
);
---

<Base title={d.title} description={d.description}>
  <PageHero
    title={d.hero.title}
    titleLight={d.hero.light}
    intro={d.hero.intro}
    image={hero}
    imageAlt={d.hero.alt}
    imagePosition={d.hero.pos}
    crumbs={[{ label: 'Leistungen', href: '/#leistungen' }, { label: d.title }]}
    size="medium"
  />

  <!-- 1. Einstieg kompakt: Aussage und Einleitung nebeneinander, darunter drei Aussagen in einer Zeile -->
  <section class="rb-intro">
    <div class="container rb-grid">
      <div class="rb-intro-text">
        <h2 class="h-sec">{d.introTitel[0]}<br /><span class="lt">{d.introTitel[1]}</span></h2>
        <p class="rb-lead">{d.lead}</p>
        <ul class="rb-usp">
          {
            d.usp.map((u) => (
              <li>
                <h3 class="rb-h">{u.t}</h3>
                <p>{u.d}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. Leistungsumfang: hellblaue Fläche mit Knick -->
  <section class="rb-scope">
    <div class="container">
      <div class="rb-scope-head">
        <h2 class="h-sec">{d.umfangTitel[0]}<br /><span class="lt">{d.umfangTitel[1]}</span></h2>
      </div>
      <ul class="rb-list">
        {
          d.umfang.map((u) => (
            <li>
              <h3 class="rb-h">{u.t}</h3>
              <p>{u.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Was uns ausmacht: Navy, Foto randlos links -->
  <section class="rb-own on-dark">
    <div class="rb-own-img">
      <Image src={bild} alt={d.eigenAlt} widths={[700, 1100, 1600]} sizes="(min-width: 900px) 44vw, 100vw" style={d.eigenPos ? `object-position:${d.eigenPos}` : undefined} />
    </div>
    <div class="container rb-grid">
      <div class="rb-own-text">
        <h2 class="h-sec">{d.eigenTitel[0]}<br /><span class="lt">{d.eigenTitel[1]}</span></h2>
        <ul class="rb-own-list">
          {
            d.eigen.map((e) => (
              <li>
                <h3 class="rb-h">{e.t}</h3>
                <p>{e.d}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 4. Referenzen -->
  <section class="section rb-refs">
    <div class="container">
      <div class="rb-refs-head">
        <h2 class="h-sec">Gebaut<br /><span class="lt">von uns.</span></h2>
        <a class="text-link" href={url(`/referenzen/?leistung=${d.slug}`)}><span>{d.refsLabel}</span><Icon name="arrow" /></a>
      </div>
      <ul class="rb-tiles" style={`--n:${Math.max(2, projekte.length)}`}>
        {
          projekte.map((p) => (
            <li>
              <a class="rb-tile" href={url(`/referenzen/?p=${p.id}`)}>
                <span class="rb-tile-img">
                  <Image src={p.data.bilder[0]!} alt="" widths={[500, 800, 1200]} sizes="(min-width: 900px) 33vw, 100vw" />
                </span>
                <span class="rb-tile-t">{p.data.title}</span>
                <span class="rb-tile-d">{p.data.leistung}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. Weitere Leistungen und Anfrage -->
  <section class="rb-more">
    <div class="container">
      <div class="rb-cta">
        <p class="rb-cta-t">{d.cta[0]}<br />{d.cta[1]}</p>
        <a class="rb-btn" href={url('/kontakt/')}><span>{d.ctaBtn}</span><Icon name="arrow" /></a>
      </div>
      <h2 class="rb-more-h">Auch das bauen wir.</h2>
      <div class="rb-cards">
        {
          andere.map((a) => (
            <a class="rb-card" href={url(`/leistungen/${a.slug}/`)}>
              <span class="rb-card-img">
                <Image src={a.bild} alt="" widths={[600, 900, 1300]} sizes="(min-width: 900px) 50vw, 100vw" />
              </span>
              <span class="rb-card-body">
                <span class="rb-card-t" set:html={a.title} />
                <span class="rb-card-d">{a.kurz}</span>
                <span class="rb-card-more" aria-hidden="true"><Icon name="arrow" /></span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .rb-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
    width: 100%;
  }
  /* Einleitung unter der großen Aussage */
  .rb-lead {
    margin: 0;
    max-width: 38ch;
    font-size: clamp(1.3rem, 1.75vw, 1.6rem);
    font-weight: 300;
    line-height: 1.45;
    color: var(--navy);
  }
  /* Zwischenüberschrift */
  .rb-h {
    margin: 0 0 0.45rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.3rem, 1.6vw, 1.55rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--blue);
  }

  /* ---------- 1. Einstieg ---------- */
  .rb-intro {
    padding-block: clamp(4.5rem, 7vw, 6rem) clamp(5rem, 8vw, 6.5rem);
  }
  .rb-own-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* links die große Aussage, rechts Einleitung und die drei Aussagen untereinander */
  .rb-intro-text {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }
  /* links Aussage und Einleitung, rechts die drei Aussagen */
  .rb-intro-text .h-sec {
    grid-column: 1 / 7;
    grid-row: 1;
    white-space: nowrap;
  }
  .rb-intro-text .rb-lead {
    grid-column: 1 / 7;
    grid-row: 2;
    max-width: 36ch;
    padding-top: 1.4rem;
  }
  .rb-usp {
    grid-column: 8 / 13;
    grid-row: 1 / 3;
    align-self: center;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.6rem, 2.6vw, 2.2rem);
    max-width: 46ch;
  }
  .rb-usp p {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* ---------- 2. Leistungsumfang ---------- */
  .rb-scope {
    position: relative;
    z-index: 1;
    background: #e6e9f6;
    padding-block: clamp(6rem, 10vw, 8.5rem) calc(clamp(5rem, 8vw, 7rem) + clamp(2rem, 4vw, 3.5rem));
    clip-path: polygon(0 clamp(0.8rem, 1.6vw, 1.4rem), 22% clamp(2rem, 4vw, 3.5rem), 100% 0, 100% 100%, 0 100%);
  }
  .rb-scope-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem clamp(2rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
  }
  .rb-scope-head .h-sec {
    grid-column: 1 / 7;
  }
  .rb-scope-head .rb-lead {
    grid-column: 7 / 13;
  }
  .rb-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(2.2rem, 3.6vw, 3.2rem) clamp(1.6rem, 2.6vw, 2.6rem);
  }
  .rb-list p,
  .rb-own-list p {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* ---------- 3. Eigene Leute, eigenes Gerät ---------- */
  .rb-own {
    position: relative;
    overflow-x: clip;
    z-index: 1;
    min-height: min(88svh, 820px);
    display: flex;
    align-items: center;
    background: var(--navy);
    color: #fff;
    padding-block: clamp(6rem, 10vw, 8rem);
    clip-path: polygon(
      0 0,
      78% clamp(2rem, 4vw, 3.5rem),
      100% clamp(0.8rem, 1.6vw, 1.4rem),
      100% calc(100% - clamp(2rem, 4vw, 3.5rem)),
      22% 100%,
      0 calc(100% - clamp(0.8rem, 1.6vw, 1.4rem))
    );
    /* greift in die hellblaue Fläche darüber, damit im Knick kein heller Spalt entsteht */
    margin-top: calc(clamp(2rem, 4vw, 3.5rem) * -1);
  }
  .rb-own-img {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 44%;
    clip-path: polygon(0 0, 100% 0, 84% 100%, 0 100%);
  }
  .rb-own-text {
    grid-column: 7 / 13;
    display: grid;
    gap: clamp(2.6rem, 4.4vw, 3.6rem);
  }
  .rb-own-text .h-sec {
    color: #fff;
  }
  .rb-own-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2.2rem, 3.6vw, 3rem);
  }
  .rb-own .rb-h {
    margin-bottom: 0.6rem;
    font-size: clamp(1.45rem, 1.9vw, 1.8rem);
    line-height: 1;
    color: #9aa6ee;
  }
  .rb-own-list p {
    max-width: 40ch;
    color: rgb(255 255 255 / 0.85);
  }

  /* ---------- 4. Referenzen ---------- */
  .rb-refs-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }
  .rb-tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr));
    gap: 2rem 10px;
  }
  .rb-tile {
    display: grid;
    gap: 0.4rem;
    color: var(--navy);
    text-decoration: none;
  }
  .rb-tile-img {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: 0.4rem;
    background: var(--stone-200);
  }
  .rb-tile-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .rb-tile:hover .rb-tile-img :global(img) {
    transform: scale(1.04);
  }
  .rb-tile-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.15rem, 1.4vw, 1.35rem);
    line-height: 1;
    text-transform: uppercase;
    transition: color 0.25s ease;
  }
  .rb-tile:hover .rb-tile-t {
    color: var(--blue);
  }
  .rb-tile-d {
    font-size: 0.98rem;
    font-weight: 300;
    line-height: 1.45;
    color: var(--ink-2);
  }

  /* ---------- 5. Weitere Leistungen und Anfrage ---------- */
  .rb-more {
    background: #e6e9f6;
    padding-block: clamp(6rem, 10vw, 8rem) calc(clamp(4rem, 7vw, 6rem) + clamp(1.6rem, 3.2vw, 3rem));
    clip-path: polygon(0 clamp(0.8rem, 1.6vw, 1.4rem), 22% clamp(2rem, 4vw, 3.5rem), 100% 0, 100% 100%, 0 100%);
  }
  .rb-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    padding-bottom: clamp(3rem, 5vw, 4rem);
  }
  .rb-cta-t {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(2rem, 3.6vw, 3.6rem);
    line-height: 0.92;
    text-transform: uppercase;
    color: var(--blue);
  }
  .rb-btn {
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    height: clamp(2.8rem, 4vw, 3.8rem);
    padding: 0.1rem clamp(1.3rem, 2vw, 1.8rem) 0;
    background: var(--blue);
    color: #fff;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.25rem, 1.7vw, 1.7rem);
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.25s ease;
  }
  .rb-btn :global(svg) {
    width: 1.3em;
    height: 1.3em;
    transition: transform 0.35s var(--ease);
  }
  .rb-btn:hover {
    background: var(--navy);
  }
  .rb-btn:hover :global(svg) {
    transform: translateX(4px);
  }
  .rb-more-h {
    margin: 0 0 1.4rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.4rem, 1.8vw, 1.8rem);
    text-transform: uppercase;
    color: var(--navy);
  }
  .rb-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .rb-card {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    background: #fff;
    color: var(--navy);
    text-decoration: none;
    min-height: 15rem;
  }
  .rb-card-img {
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 86% 100%, 0 100%);
  }
  .rb-card-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .rb-card:hover .rb-card-img :global(img) {
    transform: scale(1.05);
  }
  .rb-card-body {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: clamp(1.4rem, 2.4vw, 2rem);
  }
  .rb-card-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.5rem, 2.1vw, 2.1rem);
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--blue);
  }
  .rb-card-d {
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .rb-card-more {
    position: relative;
    width: 2.2rem;
    height: 2.2rem;
    margin-top: 0.4rem;
    display: grid;
    place-items: center;
    color: var(--blue);
  }
  .rb-card-more::before {
    content: '';
    position: absolute;
    inset: 0.35rem;
    border: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition:
      transform 0.4s var(--ease),
      background 0.3s ease;
  }
  .rb-card-more :global(svg) {
    position: relative;
    width: 0.95rem;
    height: 0.95rem;
  }
  .rb-card:hover .rb-card-more {
    color: #fff;
  }
  .rb-card:hover .rb-card-more::before {
    background: var(--blue);
    transform: rotate(135deg);
  }

  @media (max-width: 1100px) {
    .rb-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .rb-cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 900px) {
    .rb-own {
      display: block;
      min-height: 0;
      padding-top: 0;
    }
    .rb-intro-text .h-sec,
    .rb-intro-text .rb-lead,
    .rb-usp {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .rb-intro-text .h-sec {
      white-space: normal;
    }
    .rb-intro-text .rb-lead {
      padding-top: 1.4rem;
    }
    .rb-usp {
      margin-top: 2.6rem;
    }
    .rb-intro {
      padding-bottom: clamp(4rem, 10vw, 5rem);
    }
    .rb-own-img {
      position: relative;
      top: auto;
      bottom: auto;
      width: auto;
      aspect-ratio: 4 / 3;
      margin-bottom: 2.6rem;
      clip-path: polygon(0 0, 100% 0, 100% 92%, 0 100%);
    }
    .rb-own {
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - 1.6rem), 22% 100%, 0 calc(100% - 0.6rem));
      margin-top: 0;
    }
    .rb-own-text,
    .rb-scope-head .h-sec,
    .rb-scope-head .rb-lead {
      grid-column: 1 / -1;
    }
    .rb-tiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .rb-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .rb-card {
      grid-template-columns: minmax(0, 1fr);
    }
    .rb-card-img {
      aspect-ratio: 16 / 9;
      clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%);
    }
  }
</style>
