---
/**
 * Seiten-Header im Stil der Startseite: Bild (oder Navy), schräge Navy-Fläche,
 * Unterkante als angedeutete Raute (Spitze rechts).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { url } from '~/lib/url';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  /** zweite, leichte Zeile der Überschrift */
  titleLight?: string;
  intro?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  crumbs?: Crumb[];
  size?: 'large' | 'medium' | 'small';
  /** Bildausschnitt, z. B. "70% 20%" damit Gesichter nicht angeschnitten werden */
  imagePosition?: string;
}
const { eyebrow, title, titleLight, intro, image, imageAlt = '', crumbs = [], size = 'large', imagePosition } = Astro.props;
---

<section class:list={['phero', `phero-${size}`, { 'no-image': !image }]}>
  <div class="phero-media">
    {image && <Image src={image} alt={imageAlt} widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" style={imagePosition ? `object-position: ${imagePosition}` : undefined} />}
    <div class="phero-slab" aria-hidden="true"></div>
  </div>
  <div class="phero-cut" aria-hidden="true"></div>
  <div class="container phero-content">
    {
      crumbs.length > 0 && (
        <nav class="crumbs" aria-label="Brotkrumen">
          <a href={url('/')}>Start</a>
          {crumbs.map((c) => (
            <>
              <span aria-hidden="true">/</span>
              {c.href ? <a href={url(c.href)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
            </>
          ))}
        </nav>
      )
    }
    {eyebrow && <p class="label">{eyebrow}</p>}
    <h1 class="phero-title">
      {title}
      {titleLight && <span class="lt">{titleLight}</span>}
    </h1>
    {intro && <p class="phero-intro">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .phero {
    position: relative;
    color: #fff;
    display: flex;
    align-items: flex-end;
    --cut: polygon(0 90%, 78% 100%, 100% 94%, 100% 101%, 0 101%);
  }
  .phero-large {
    min-height: min(82svh, 820px);
  }
  .phero-medium {
    min-height: min(66svh, 640px);
  }
  .phero-small {
    min-height: min(46svh, 440px);
  }
  .phero-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--navy);
  }
  .phero-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* schräge Navy-Fläche wie im Video-Header */
  .phero-slab {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--content-left) + min(58vw, 1000px));
    background: rgb(18 23 53 / 0.82);
    clip-path: polygon(0 0, 100% 0, 66% 100%, 0 100%);
  }
  .no-image .phero-slab {
    background: rgb(57 72 164 / 0.35);
  }
  /* Unterkante als angedeutete Raute (Fläche in Seitenfarbe, kein Zuschnitt des Bildes) */
  .phero-cut {
    position: absolute;
    inset: 0;
    background: var(--stone-50);
    clip-path: var(--cut);
    pointer-events: none;
  }
  .phero-content {
    position: relative;
    padding-top: calc(var(--header-h) + 2.5rem);
    padding-bottom: clamp(5rem, 11vw, 9rem);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.7);
    margin-bottom: clamp(2rem, 6vw, 4.5rem);
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .phero .label {
    color: #aab4ea;
    margin-bottom: 1rem;
  }
  .phero-title {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(3rem, 6.6vw, 7rem);
    line-height: 0.97;
    letter-spacing: -0.005em;
    max-width: min(48vw, 760px);
  }
  .phero-title .lt {
    display: block;
    font-weight: 300;
  }
  .phero-intro {
    max-width: min(40vw, 32rem);
    margin-top: 1.6rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgb(255 255 255 / 0.85);
  }
  @media (max-width: 900px) {
    .phero {
      --cut: polygon(0 95%, 78% 100%, 100% 97%, 100% 101%, 0 101%);
    }
    .phero-slab {
      width: 100%;
      clip-path: polygon(0 0, 100% 0, 100% 62%, 0 88%);
    }
    .phero-title,
    .phero-intro {
      max-width: none;
    }
  }
</style>
