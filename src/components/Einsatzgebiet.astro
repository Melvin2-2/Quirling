---
/**
 * Einsatzgebiet (Audit LOCAL-02): kurzer Text und schematische Karte.
 * Die Karte liegt transparent auf der Seite: Hamburg kräftig, das Umland hellblau und nach außen verblassend.
 * Eigene Grafik, keine eingebettete Fremdkarte, keine Cookies.
 */
import Icon from '~/components/Icon.astro';
import { laender } from '~/data/karte-nord';
import { url } from '~/lib/url';

// Ausschnitt Norddeutschland (Einheiten der Quellkarte, ca. 1 Einheit ≈ 1 km), Hamburg etwas unter der Mitte
const vb = '156 50 220 212';
// Umrechnung Längen-/Breitengrad in Kartenkoordinaten, kalibriert an den Umrissen von Hamburg und Bremen
const xy = (lon: number, lat: number) => ({ x: 246.6 + (lon - 9.73) * 63.3, y: 144.4 + (53.74 - lat) * 106.4 });
const staedte = [
  { n: 'Kiel', ...xy(10.13, 54.32), dx: 3, dy: 1.6 },
  { n: 'Lübeck', ...xy(10.69, 53.87), dx: 3, dy: 1.6 },
  { n: 'Schwerin', ...xy(11.41, 53.63), dx: 3, dy: 1.6 },
  { n: 'Lüneburg', ...xy(10.41, 53.25), dx: 3, dy: 1.6 },
  { n: 'Stade', ...xy(9.48, 53.6), dx: -3, dy: 1.6, end: true },
  { n: 'Bremen', ...xy(8.8, 53.08), dx: 3, dy: 1.6 },
];
// Firmensitz Tilsiter Straße, Hamburg-Wandsbek (aus der Lage im Stadtgebiet abgeleitet, schematisch)
const sitz = { x: 268.9, y: 160.7 };
---

<section class="eg" aria-labelledby="eg-h">
  <div class="container eg-grid">
    <div class="eg-text">
      <h2 class="h-sec" id="eg-h">Unser Revier.<br /><span class="lt">Rund um die Elbe.</span></h2>
      <p class="eg-p">
        Zuhause sind wir in Hamburg-Wandsbek. Von hier aus bauen wir in ganz Hamburg und in der Metropolregion, in Schleswig-Holstein und Niedersachsen.
      </p>
      <p class="eg-p">Ihr Bauvorhaben liegt weiter draußen? Fragen Sie uns gern an.</p>
      <a class="eg-link" href={url('/kontakt/')}><span>Projekt anfragen</span><Icon name="arrow" /></a>
    </div>
    <figure class="eg-map">
      <svg viewBox={vb} role="img" aria-labelledby="eg-cap">
        <defs>
          <!-- weicher Rand: die Karte verblasst nach außen -->
          <radialGradient id="eg-fade" cx="266" cy="156" r="106" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#fff" stop-opacity="1" />
            <stop offset="0.5" stop-color="#fff" stop-opacity="0.85" />
            <stop offset="1" stop-color="#fff" stop-opacity="0" />
          </radialGradient>
          <mask id="eg-mask" maskUnits="userSpaceOnUse" x="156" y="50" width="220" height="212">
            <rect x="156" y="50" width="220" height="212" fill="url(#eg-fade)" />
          </mask>
        </defs>
        <g mask="url(#eg-mask)">
          {['sh', 'ni', 'mv', 'hb', 'bb'].map((id) => <path d={laender[id]} class="eg-land-f" />)}
        </g>
        <path d={laender.hh} class="eg-hh" />
        <!-- Firmensitz als Raute -->
        <rect x={sitz.x - 2.4} y={sitz.y - 2.4} width="4.8" height="4.8" transform={`rotate(45 ${sitz.x} ${sitz.y})`} class="eg-sitz" />
        <!-- wichtige Städte im Umland -->
        <g class="eg-towns">
          {staedte.map((s) => (
            <g>
              <circle cx={s.x} cy={s.y} r="1.3" class="eg-dot" />
              <text x={s.x + s.dx} y={s.y + s.dy} text-anchor={s.end ? 'end' : 'start'} class="eg-town">{s.n}</text>
            </g>
          ))}
        </g>
        <g class="eg-lbl">
          <text x="249" y="189" class="eg-city">Hamburg</text>
          <text x="280" y="156" class="eg-small">Firmensitz</text>
          <text x="280" y="161.5" class="eg-small">Wandsbek</text>
          <text x="196" y="112" class="eg-land">Schleswig-Holstein</text>
          <text x="214" y="226" class="eg-land">Niedersachsen</text>
          <text x="322" y="112" class="eg-land">Mecklenburg-</text>
          <text x="322" y="118" class="eg-land">Vorpommern</text>
        </g>
      </svg>
      <figcaption id="eg-cap">
        <span class="visually-hidden">Schematische Karte: Hamburg mit Firmensitz in Wandsbek, im Umland Kiel, Lübeck, Schwerin, Lüneburg, Stade und Bremen.</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .eg {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    background: var(--stone-50);
  }
  .eg-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .eg-text {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  /* zwei Zeilen, jede bleibt zusammen */
  .eg-text .h-sec {
    white-space: nowrap;
    font-size: clamp(2.1rem, 4.4vw, 4.2rem);
  }
  .eg-p {
    margin: 0;
    max-width: 40ch;
    font-size: clamp(1.1rem, 1.4vw, 1.25rem);
    font-weight: 300;
    line-height: 1.6;
    color: var(--ink);
  }
  .eg-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue);
    text-decoration: none;
  }
  .eg-link:hover span {
    text-decoration: underline;
  }
  .eg-map {
    margin: 0;
    display: grid;
    gap: 0.2rem;
    justify-items: end;
  }
  .eg-map svg {
    display: block;
    width: 100%;
    max-width: 620px;
    height: auto;
  }
  .eg-land-f {
    fill: #c9d0f5;
    stroke: var(--stone-50);
    stroke-width: 0.8;
  }
  .eg-hh {
    fill: #3948a4;
    stroke: #3948a4;
    stroke-width: 0.4;
  }
  .eg-sitz {
    fill: #ffffff;
    stroke: #121735;
    stroke-width: 0.8;
  }
  .eg-lbl text {
    font-family: var(--font-body);
    paint-order: stroke;
    stroke: var(--stone-50);
    stroke-width: 1.2px;
    stroke-linejoin: round;
  }
  .eg-city {
    font-family: var(--font-head) !important;
    font-stretch: 68%;
    font-weight: 800;
    font-size: 8.5px;
    text-transform: uppercase;
    fill: #121735;
  }
  .eg-small {
    font-size: 4.2px;
    font-weight: 600;
    fill: #121735;
  }
  .eg-land {
    font-size: 4px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    fill: #5b6188;
  }
  .eg-dot {
    fill: #121735;
  }
  .eg-town {
    font-family: var(--font-body);
    font-size: 4.3px;
    font-weight: 600;
    fill: #2c335f;
    paint-order: stroke;
    stroke: var(--stone-50);
    stroke-width: 1.2px;
    stroke-linejoin: round;
  }
  @media (max-width: 900px) {
    .eg-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .eg-map {
      justify-items: center;
    }
  }
</style>
