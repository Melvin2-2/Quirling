---
/**
 * „Bauen liegt in der Familie.“ – senkrecht, ohne Fotos.
 * Links eine Leiste mit allen Jahren: die aktuelle Station wird groß und blau,
 * darunter ihr Wert, danach wieder klein. Rechts je Station ein Satz, der sich
 * Wort für Wort einfärbt; die Kernaussage (zwischen Sternchen) steht in Blau.
 * Platz für kurze Geschichten von Thomas Quirling: Feld „story“ füllen, dann erscheint sie.
 */
import { url } from '~/lib/url';
import { firma, GRUENDUNGSJAHR } from '~/data/site';

type Station = { k: string; wert: string; satz: string; href?: string; story?: string };
const stationen: Station[] = [
  { k: 'Damals', wert: 'Persönlich', satz: 'Der Vater unseres Gründers lernt auf dem Bau, *was gute Arbeit ausmacht.* Die Begeisterung gibt er weiter.', story: '' },
  { k: String(GRUENDUNGSJAHR), wert: 'Persönlich', satz: 'Thomas Quirling *gründet die Quirling GmbH* in Hamburg. Er führt sie bis heute selbst.', story: '' },
  { k: '1997', wert: 'Persönlich', satz: 'Am Tegelweg bauen wir das Haus der Familie Quirling. *Es wird unser erster Firmensitz.*', href: '/referenzen/?p=tegelweg', story: '' },
  { k: '2006', wert: 'Sorgfältig', satz: 'In Buchholz bauen wir den Rohbau für *35 Reihenhäuser.* Eines unserer größten Wohnprojekte.', href: '/referenzen/?p=reihenhaeuser-buchholz', story: '' },
  { k: '2019', wert: 'Verbindlich', satz: 'Nach über 20 Jahren am Tegelweg ziehen wir in die Tilsiter Straße. Hier ist *viel Platz, um weiter zu wachsen.*', story: '' },
  { k: 'Heute', wert: 'Verbindlich', satz: `Über ${firma.projekteAnzahl} Projekte. *Einige Kollegen sind seit über 30 Jahren dabei.*`, story: '' },
];
// Satz in Wörter zerlegen; Wörter zwischen zwei Sternchen sind die Kernaussage
const words = (t: string) => {
  let hl = false;
  return t.split(' ').map((w) => {
    const start = w.startsWith('*');
    if (start) hl = true;
    const end = w.endsWith('*') || w.endsWith('*.') || w.endsWith('*,');
    const clean = w.split('*').join('');
    const out = { w: clean, hl };
    if (end) hl = false;
    return out;
  });
};
---

<section class="wg" data-wg aria-labelledby="wg-h">
  <div class="container wg-in">
    <div class="wg-side">
      <div class="wg-sticky">
        <h2 class="h-sec" id="wg-h">Bauen liegt<br /><span class="lt">in der Familie.</span></h2>
        <!-- Leiste mit allen Stationen: aktuelle groß und blau, darunter ihr Wert -->
        <ol class="wg-rail" aria-hidden="true">
          <span class="wg-rail-line"><span class="wg-rail-fill" data-wg-fill></span></span>
          {
            stationen.map((s, i) => (
              <li data-wg-rail={s.k} class:list={{ 'is-on': i === 0 }}>
                <span class="wg-ry">{s.k}</span>
                <span class="wg-rw">{s.wert}.</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <ol class="wg-list">
      {
        stationen.map((s) => (
          <li class="wg-st" data-wg-st data-k={s.k} data-wert={s.wert}>
            <span class="wg-k">{s.k}</span>
            <p class="wg-satz" data-wg-satz>
              {words(s.satz).map((w) => (
                <span class:list={['wg-w', { 'is-hl': w.hl }]}>{w.w} </span>
              ))}
            </p>
            {s.href && (
              <a class="wg-link" href={url(s.href)}>
                Zur Referenz
              </a>
            )}
            {s.story && (
              <blockquote class="wg-story">
                „{s.story}“<cite>Thomas Quirling</cite>
              </blockquote>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .wg {
    padding-block: clamp(5rem, 9vw, 8rem);
  }
  .wg-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
  }
  .wg-side {
    grid-column: 1 / 6;
  }
  .wg-sticky {
    position: sticky;
    top: 16vh;
    display: grid;
    gap: clamp(1.6rem, 4vh, 2.8rem);
  }
  .wg-sticky .h-sec {
    font-size: clamp(2.2rem, 3.6vw, 3.8rem);
  }
  /* Leiste mit allen Stationen: klein grau, aktiv groß blau mit Wert, danach klein dunkel */
  .wg-rail {
    position: relative;
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0 0 0 1.6rem;
    display: grid;
    gap: 0.7rem;
  }
  .wg-rail-line {
    position: absolute;
    left: 0.32rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--stone-200);
  }
  .wg-rail-fill {
    position: absolute;
    inset: 0;
    background: var(--blue);
    transform-origin: top;
    transform: scaleY(var(--p, 0));
  }
  .wg-rail li {
    position: relative;
    display: grid;
  }
  .wg-rail li::before {
    content: '';
    position: absolute;
    left: calc(-1.6rem + 0.33rem - 4.5px);
    top: 0.32rem;
    width: 9px;
    height: 9px;
    background: var(--stone-50);
    border: 1.5px solid #b9bdd3;
    transform: rotate(45deg);
    transition:
      background 0.3s ease,
      border-color 0.3s ease;
  }
  .wg-ry {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 1.1rem;
    line-height: 0.9;
    text-transform: uppercase;
    white-space: nowrap;
    color: #b9bdd3;
    transition:
      font-size 0.55s var(--ease),
      color 0.35s ease;
  }
  .wg-rw {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.25rem, 1.7vw, 1.7rem);
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--navy);
    transition:
      max-height 0.55s var(--ease),
      opacity 0.35s ease,
      margin 0.55s var(--ease);
  }
  .wg-rail li.is-past .wg-ry {
    color: var(--navy);
  }
  .wg-rail li.is-past::before,
  .wg-rail li.is-on::before {
    background: var(--blue);
    border-color: var(--blue);
  }
  .wg-rail li.is-on::before {
    top: clamp(1.2rem, 2.2vw, 2.4rem);
  }
  .wg-rail li.is-on .wg-ry {
    font-size: clamp(3.6rem, 6.6vw, 7rem);
    color: var(--blue);
  }
  .wg-rail li.is-on .wg-rw {
    max-height: 3rem;
    opacity: 1;
    margin: 0.5rem 0 0.4rem;
  }
  /* rechts: ein Satz je Station */
  .wg-list {
    grid-column: 7 / 13;
    list-style: none;
    margin: 0;
    padding: 18vh 0 22vh;
    display: grid;
    gap: clamp(5rem, 22vh, 12rem);
  }
  .wg-st {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  .wg-k {
    display: none;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--blue);
  }
  .wg-satz {
    margin: 0;
    font-size: clamp(1.5rem, 2.2vw, 2.15rem);
    font-weight: 300;
    line-height: 1.35;
    letter-spacing: -0.005em;
    color: var(--navy);
  }
  /* Wort für Wort einfärben (nur mit Bewegung) */
  .wg.is-live .wg-w {
    color: #c3c8de;
    transition: color 0.25s ease;
  }
  .wg.is-live .wg-w.is-on {
    color: var(--navy);
  }
  /* Kernaussage */
  .wg-w.is-hl,
  .wg.is-live .wg-w.is-hl.is-on {
    color: var(--blue);
    font-weight: 400;
  }
  .wg-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue);
    text-decoration: none;
    border-bottom: 1px solid #9aa6ee;
    padding-bottom: 2px;
  }
  .wg-link:hover {
    border-color: var(--blue);
  }
  .wg-story {
    margin: 0.4rem 0 0;
    padding-left: 1rem;
    border-left: 3px solid var(--blue);
    font-size: 1.1rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--ink-2);
  }
  .wg-story cite {
    display: block;
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue);
  }

  @media (max-width: 900px) {
    .wg-in {
      grid-template-columns: minmax(0, 1fr);
    }
    .wg-side,
    .wg-list {
      grid-column: 1 / -1;
    }
    .wg-sticky {
      position: static;
    }
    .wg-rail {
      display: none;
    }
    .wg-list {
      padding: 1rem 0 0;
      gap: 2.6rem;
    }
    .wg-k {
      display: block;
    }
    .wg-satz {
      font-size: 1.35rem;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-wg]');
  if (root && window.matchMedia('(min-width: 901px) and (prefers-reduced-motion: no-preference)').matches) {
    const stations = Array.from(root.querySelectorAll<HTMLElement>('[data-wg-st]'));
    const fill = root.querySelector<HTMLElement>('[data-wg-fill]')!;
    const rail = Array.from(root.querySelectorAll<HTMLElement>('[data-wg-rail]'));
    const list = root.querySelector<HTMLElement>('.wg-list')!;
    root.classList.add('is-live');
    let current = stations[0]?.dataset.k ?? '';
    let raf = 0;
    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      let active = stations[0]!;
      stations.forEach((s) => {
        const r = s.getBoundingClientRect();
        if (r.top < vh * 0.55) active = s;
        // Satz färbt sich ein, während er von 80 % auf 45 % der Bildschirmhöhe wandert
        const satz = s.querySelector<HTMLElement>('[data-wg-satz]')!;
        const sr = satz.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (vh * 0.8 - sr.top) / (vh * 0.35)));
        const ws = satz.children;
        const n = Math.round(p * ws.length);
        for (let i = 0; i < ws.length; i++) ws[i]!.classList.toggle('is-on', i < n);
      });
      const k = active.dataset.k!;
      if (k !== current) {
        current = k;
        const idx = stations.indexOf(active);
        rail.forEach((r, i) => {
          r.classList.toggle('is-on', i === idx);
          r.classList.toggle('is-past', i < idx);
        });
      }
      // Fortschritt über den ganzen Abschnitt
      const lr = list.getBoundingClientRect();
      const prog = Math.min(1, Math.max(0, (vh * 0.55 - lr.top) / Math.max(1, lr.height - vh * 0.3)));
      fill.style.setProperty('--p', prog.toFixed(3));
    };
    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(update);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }
</script>
