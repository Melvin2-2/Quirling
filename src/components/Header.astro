---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, firma } from '~/data/site';
import { url, isActive } from '~/lib/url';

interface Props {
  /** Kopfzeile startet transparent über einem dunklen Bild/Video */
  overlay?: boolean;
}
const { overlay = true } = Astro.props;
const current = Astro.url.pathname;
const mainItems = nav.filter((n) => n.href !== '/kontakt/');
---

<header class="site-header" data-header data-overlay={overlay ? 'true' : 'false'}>
  <div class="container bar">
    <a class="brand" href={url('/')} aria-label="Quirling Bauunternehmen, zur Startseite">
      <Logo class="logo logo-color" tone="color" />
      <Logo class="logo logo-light" tone="light" />
    </a>

    <nav class="main-nav" aria-label="Hauptnavigation">
      <ul>
        {
          mainItems.map((item) => (
            <li class:list={[{ 'has-sub': item.children }]}>
              <a href={url(item.href)} class:list={[{ active: isActive(current, item.href) }]}>
                {item.label}
                {item.children && <Icon name="chevron" class="chev" />}
              </a>
              {item.children && (
                <div class="sub">
                  <div class="sub-inner">
                    {item.children.map((c, i) => (
                      <a href={url(c.href)} class="sub-link">
                        <span class="sub-nr">0{i + 1}</span>
                        <span class="sub-title">{c.label}</span>
                        <span class="sub-text">{c.text}</span>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <a class="phone" href={firma.telefonHref}><Icon name="phone" /><span>{firma.telefon}</span></a>
      <a class="phone cta" href={url('/kontakt/')}><Icon name="mail" /><span>Kontakt</span></a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-nav" data-burger>
        <span class="visually-hidden">Menü öffnen</span>
        <i></i><i></i>
      </button>
    </div>
  </div>

  <div class="mobile-nav" id="mobile-nav" data-mobile-nav>
    <div class="container mobile-inner">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={url(item.href)} class="m-main">
                {item.label}
              </a>
              {item.children && (
                <ul class="m-sub">
                  {item.children.map((c) => (
                    <li>
                      <a href={url(c.href)}>{c.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
      <div class="m-contact">
        <a href={firma.telefonHref}><Icon name="phone" />{firma.telefon}</a>
        <a href={`mailto:${firma.email}`}><Icon name="mail" />{firma.email}</a>
      </div>
    </div>
  </div>
</header>

<style>
  /* Oben steht die Kopfzeile still auf der Seite; erst beim Hochscrollen erscheint sie fixiert und weiß */
  .site-header {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 100;
    color: var(--ink);
    transition:
      transform 0.5s var(--ease),
      background 0.35s ease,
      box-shadow 0.35s ease,
      color 0.35s ease;
  }
  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .brand {
    flex: none;
    display: block;
    position: relative;
  }
  .brand :global(.logo) {
    height: 50px;
    width: calc(50px * 623 / 171);
    transition: opacity 0.3s ease;
  }
  .brand :global(.logo-light) {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  /* Zustand: transparent über Hero */
  .site-header[data-overlay='true']:not(.is-solid) {
    color: #fff;
  }
  .site-header[data-overlay='true']:not(.is-solid) .brand :global(.logo-color) {
    opacity: 0;
  }
  .site-header[data-overlay='true']:not(.is-solid) .brand :global(.logo-light) {
    opacity: 1;
  }
  .site-header[data-overlay='true']:not(.is-solid)::before {
    content: '';
    position: absolute;
    inset: 0 0 -40px 0;
    background: linear-gradient(rgb(10 12 30 / 0.55), transparent);
    pointer-events: none;
    z-index: -1;
  }
  .site-header.is-solid,
  .site-header[data-overlay='false'] {
    background: rgb(255 255 255 / 0.96);
    backdrop-filter: blur(10px);
    box-shadow: 0 1px 0 var(--line);
  }
  .site-header.is-fixed {
    position: fixed;
  }
  .site-header.no-anim {
    transition: none !important;
  }
  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .main-nav {
    margin-left: auto;
  }
  .main-nav > ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .main-nav > ul > li > a {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.6rem 0.85rem;
    font-family: var(--font-head);
    font-stretch: 118%;
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    position: relative;
  }
  .main-nav > ul > li > a::after {
    content: '';
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.25rem;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease);
  }
  .main-nav > ul > li > a:hover::after,
  .main-nav > ul > li > a.active::after {
    transform: scaleX(1);
  }
  :global(.chev) {
    width: 1rem;
    height: 1rem;
    transition: transform 0.3s var(--ease);
  }
  .has-sub {
    position: relative;
  }
  .has-sub:hover :global(.chev),
  .has-sub:focus-within :global(.chev) {
    transform: rotate(180deg);
  }
  .sub {
    position: absolute;
    top: 100%;
    left: 50%;
    padding-top: 0.9rem;
    transform: translate(-50%, 10px);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s ease,
      transform 0.4s var(--ease),
      visibility 0s 0.3s;
  }
  .has-sub:hover .sub,
  .has-sub:focus-within .sub {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition-delay: 0s;
  }
  /* „Unternehmen“ steht weit rechts: Untermenü rechtsbündig, damit es nie über den Rand ragt */
  .main-nav > ul > li:nth-child(3) .sub {
    left: auto;
    right: 0;
    transform: translate(0, 10px);
  }
  .main-nav > ul > li:nth-child(3):hover .sub,
  .main-nav > ul > li:nth-child(3):focus-within .sub {
    transform: translate(0, 0);
  }
  .sub-inner {
    display: grid;
    grid-template-columns: repeat(3, 15rem);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    box-shadow: 0 30px 60px -20px rgb(18 23 53 / 0.35);
  }
  .sub-link {
    display: grid;
    gap: 0.35rem;
    align-content: start;
    padding: 1.4rem 1.4rem 1.6rem;
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    transition: background 0.25s ease;
  }
  .sub-link:hover {
    background: var(--stone-50);
  }
  .sub-nr {
    font-family: var(--font-head);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--blue);
    letter-spacing: 0.1em;
  }
  .sub-title {
    font-family: var(--font-head);
    font-stretch: 110%;
    font-weight: 620;
    font-size: 1.05rem;
    line-height: 1.2;
  }
  .sub-text {
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--ink-3);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  .phone {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-head);
    font-stretch: 105%;
    font-weight: 560;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
  }
  .phone :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .phone:hover span {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .burger {
    display: none;
    width: 46px;
    height: 46px;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    position: relative;
  }
  .burger i {
    position: absolute;
    left: 11px;
    right: 11px;
    height: 2px;
    background: currentColor;
    transition:
      transform 0.4s var(--ease),
      top 0.4s var(--ease);
  }
  .burger i:first-of-type {
    top: 18px;
  }
  .burger i:last-of-type {
    top: 27px;
  }
  .menu-open .burger i:first-of-type {
    top: 22px;
    transform: rotate(45deg);
  }
  .menu-open .burger i:last-of-type {
    top: 22px;
    transform: rotate(-45deg);
  }

  .mobile-nav {
    position: fixed;
    inset: 0;
    top: var(--header-h);
    background: var(--navy);
    color: #fff;
    overflow-y: auto;
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition:
      clip-path 0.6s var(--ease),
      visibility 0s 0.6s;
  }
  .menu-open .mobile-nav {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    transition-delay: 0s;
  }
  .mobile-inner {
    padding-block: 2rem 3rem;
  }
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-nav > .mobile-inner > ul > li {
    border-bottom: 1px solid var(--line-light);
    padding-block: 1rem;
  }
  .m-main {
    font-family: var(--font-head);
    font-stretch: 115%;
    font-weight: 620;
    font-size: 1.9rem;
    text-decoration: none;
  }
  .m-sub {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.6rem !important;
  }
  .m-sub a {
    color: rgb(255 255 255 / 0.72);
    text-decoration: none;
  }
  .m-contact {
    display: grid;
    gap: 0.9rem;
    margin-top: 2rem;
  }
  .m-contact a {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    text-decoration: none;
  }
  .m-contact :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .menu-open.site-header {
    background: var(--navy);
    color: #fff;
    box-shadow: none;
  }
  .menu-open .brand :global(.logo-color) {
    opacity: 0 !important;
  }
  .menu-open .brand :global(.logo-light) {
    opacity: 1 !important;
  }

  @media (max-width: 1180px) {
    .phone span {
      display: none;
    }
  }
  @media (max-width: 1023px) {
    :global(:root) {
      --header-h: 72px;
    }
    .main-nav,
    .phone,
    .cta {
      display: none;
    }
    .burger {
      display: block;
    }
    .actions {
      margin-left: auto;
    }
    .brand :global(.logo) {
      height: 42px;
      width: calc(42px * 623 / 171);
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  if (header && burger) {
    let lastY = window.scrollY;
    const fixHidden = () => {
      // ohne Animation aus dem Seitenfluss lösen und oberhalb des Bildschirms parken
      header.classList.add('no-anim', 'is-fixed', 'is-solid', 'is-hidden');
      void header.offsetWidth;
      header.classList.remove('no-anim');
    };
    const onScroll = () => {
      const y = window.scrollY;
      if (header.classList.contains('menu-open')) return;
      const fixed = header.classList.contains('is-fixed');
      const hh = header.offsetHeight;
      if (fixed && y <= 2) {
        header.classList.add('no-anim');
        header.classList.remove('is-fixed', 'is-solid', 'is-hidden');
        void header.offsetWidth;
        header.classList.remove('no-anim');
      } else if (y > lastY) {
        // runter scrollen: Kopfzeile bleibt oben auf der Seite bzw. verschwindet
        if (!fixed && y > hh) fixHidden();
        else if (fixed) header.classList.add('is-hidden');
      } else if (y < lastY - 1 && y > hh) {
        // hoch scrollen: weiße Kopfzeile einblenden
        if (!fixed) fixHidden();
        requestAnimationFrame(() => header.classList.remove('is-hidden'));
      }
      lastY = y;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    burger.addEventListener('click', () => {
      const open = !header.classList.contains('menu-open');
      header.classList.toggle('menu-open', open);
      burger.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      window.dispatchEvent(new CustomEvent(open ? 'quirling:lock' : 'quirling:unlock'));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('menu-open')) burger.click();
    });
  }
</script>
