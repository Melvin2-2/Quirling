---
/**
 * Projektkachel wie auf der Referenzseite: Bild, dunkler Verlauf, Kategorie in Mono,
 * Titel schmal. Öffnet das Projekt im Seitenfenster der Referenzseite.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '~/lib/url';

interface Props {
  project: CollectionEntry<'projekte'>;
  sizes?: string;
  class?: string;
}
const { project, sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw', class: cls } = Astro.props;
const p = project.data;
---

<a class:list={['ptile', cls]} href={url(`/referenzen/?p=${project.id}`)}>
  <Image src={p.bilder[0]!} alt={`${p.title}: ${p.leistung}`} widths={[480, 800, 1200]} sizes={sizes} />
  <span class="ptile-info">
    <span class="ptile-cat">{p.kategorien[0]}</span>
    <span class="ptile-title">{p.title}</span>
  </span>
</a>

<style>
  .ptile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    background: var(--stone-200);
  }
  .ptile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
  }
  .ptile::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(18 23 53 / 0.85), rgb(18 23 53 / 0) 55%);
    transition: background 0.4s ease;
  }
  .ptile:hover :global(img) {
    transform: scale(1.05);
  }
  .ptile:hover::after {
    background: linear-gradient(to top, rgb(18 23 53 / 0.92), rgb(18 23 53 / 0.25) 70%);
  }
  .ptile-info {
    position: absolute;
    left: 1.1rem;
    right: 1.1rem;
    bottom: 1rem;
    z-index: 1;
    display: grid;
    gap: 0.3rem;
  }
  .ptile-cat {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #c9d0f5;
  }
  .ptile-title {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.3rem, 1.6vw, 1.6rem);
    line-height: 1;
    text-transform: uppercase;
  }
</style>
