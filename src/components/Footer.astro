---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { firma, leistungen } from '~/data/site';
import { url } from '~/lib/url';
const { claim = true } = Astro.props as { claim?: boolean };
const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <div class="container">
    {claim && (
    <div class="claim">
      <div class="claim-l">
        <p class="h2 claim-t">Projekt geplant?<br /><span class="lt">Wir sind ganz Ohr.</span></p>
        <a class="claim-btn" href={url('/kontakt/')}><span>Projekt anfragen</span><Icon name="arrow" /></a>
      </div>
      <div class="claim-r">
        <a class="h2 claim-tel" href={firma.telefonHref}>{firma.telefon}</a>
        <a class="h2 claim-mail" href={`mailto:${firma.email}`}>{firma.email}</a>
      </div>
    </div>
    )}

    <div class="cols">
      <div class="col brand">
        <Logo variant="stacked" tone="light" class="flogo" />
      </div>
      <div class="col">
        <h2 class="fh">Kontakt</h2>
        <address>
          {firma.langname}<br />
          {firma.strasse}<br />
          {`${firma.plz} ${firma.ort}`}
        </address>
        <p class="fl">
          <a href={firma.telefonHref}>Tel. {firma.telefon}</a><br />
          <a href={`mailto:${firma.email}`}>{firma.email}</a>
        </p>
      </div>
      <div class="col">
        <h2 class="fh">Leistungen</h2>
        <ul>
          {
            leistungen.map((l) => (
              <li>
                <a href={url(`/leistungen/${l.slug}/`)}>{l.title}</a>
              </li>
            ))
          }
          <li><a href={url('/referenzen/')}>Referenzen</a></li>
        </ul>
      </div>
      <div class="col">
        <h2 class="fh">Unternehmen</h2>
        <ul>
          <li><a href={url('/unternehmen/')}>Über uns</a></li>
          <li><a href={url("/unternehmen/team/")}>Team</a></li>
          <li><a href={url('/unternehmen/zertifikate/')}>Zertifikate & Downloads</a></li>
          <li><a href={url('/karriere/')}>Karriere</a></li>
        </ul>
      </div>
    </div>

    <div class="bottom">
      <span>© {year} {firma.name}</span>
      <nav aria-label="Rechtliches">
        <a href={url('/impressum/')}>Impressum</a>
        <a href={url('/datenschutz/')}>Datenschutz</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    /* kompakt: der Aufruf zur Anfrage bleibt das auffälligste Element */
    padding-block: clamp(3.2rem, 5.2vw, 4.4rem) 1.3rem;
    position: relative;
    overflow: hidden;
  }
  /* links Satz und Knopf, rechts Telefon und E-Mail direkt untereinander, unten bündig */
  .claim {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 2rem;
    padding-bottom: clamp(2rem, 3.2vw, 2.6rem);
    border-bottom: 1px solid var(--line-light);
  }
  .claim-l {
    display: grid;
    justify-items: start;
    gap: clamp(1.2rem, 1.8vw, 1.6rem);
  }
  .claim-r {
    display: grid;
    justify-items: end;
    gap: 0.55rem;
  }
  .claim-t {
    color: #fff !important;
    margin: 0;
    line-height: 0.95;
  }
  /* Telefon und E-Mail in der Größe der Überschrift, rechtsbündig */
  .claim-tel,
  .claim-mail {
    margin: 0;
    font-size: clamp(1.6rem, 2.3vw, 2.2rem) !important;
    color: #fff !important;
    text-decoration: none;
    white-space: nowrap;
    line-height: 1;
    transition: color 0.2s ease;
  }
  .claim-mail {
    text-transform: none;
    font-weight: 300 !important;
  }
  .claim-tel:hover,
  .claim-mail:hover {
    color: #c9d0f5 !important;
  }
  /* „Sprechen wir.“ als Knopf, so hoch wie eine Zeile der Überschrift */
  .claim-btn {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0 1.5rem;
    height: clamp(2.6rem, 3.6vw, 3.4rem);
    background: #fff;
    color: var(--navy);
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease;
  }
  .claim-btn :global(svg) {
    width: 1.2em;
    height: 1.2em;
    transition: transform 0.35s var(--ease);
  }
  .claim-btn:hover {
    background: #9aa6ee;
  }
  .claim-btn:hover :global(svg) {
    transform: translateX(4px);
  }
  @media (max-width: 700px) {
    .claim {
      grid-template-columns: minmax(0, 1fr);
    }
    .claim-r {
      justify-items: start;
    }
  }
  .cols {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1fr 1fr;
    gap: 1.6rem 2.5rem;
    padding-block: clamp(1.8rem, 3vw, 2.4rem);
    font-size: 0.98rem;
    line-height: 1.6;
  }
  .brand :global(.flogo) {
    width: 150px;
    height: auto;
  }
  .fh {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #aab4ea;
    margin-bottom: 0.7rem;
  }
  address {
    font-style: normal;
    color: rgb(255 255 255 / 0.78);
    margin-bottom: 0.5rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.25rem;
  }
  .col a {
    text-decoration: none;
    color: rgb(255 255 255 / 0.85);
    transition: color 0.2s ease;
  }
  .col a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line-light);
    font-size: 0.86rem;
    color: rgb(255 255 255 / 0.6);
  }
  .bottom nav {
    display: flex;
    gap: 1.5rem;
  }
  .bottom a {
    text-decoration: none;
  }
  .bottom a:hover {
    color: #fff;
  }
  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
