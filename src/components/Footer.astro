---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { firma, leistungen } from '~/data/site';
import { url } from '~/lib/url';
const year = new Date().getFullYear();
---

<footer class="site-footer on-dark">
  <div class="container">
    <div class="claim" data-reveal>
      <p class="accent">{firma.slogan}</p>
      <a class="btn white" href={url('/kontakt/')}><span>Projekt besprechen</span><Icon name="arrow" /></a>
    </div>

    <div class="cols">
      <div class="col brand">
        <Logo variant="stacked" tone="light" class="flogo" />
      </div>
      <div class="col">
        <h2 class="fh">Kontakt</h2>
        <address>
          {firma.langname}<br />
          {firma.strasse}<br />
          {`${firma.plz} ${firma.ort}`}
        </address>
        <p class="fl">
          <a href={firma.telefonHref}>Tel. {firma.telefon}</a><br />
          <a href={`mailto:${firma.email}`}>{firma.email}</a>
        </p>
      </div>
      <div class="col">
        <h2 class="fh">Leistungen</h2>
        <ul>
          {
            leistungen.map((l) => (
              <li>
                <a href={url(`/leistungen/${l.slug}/`)}>{l.title}</a>
              </li>
            ))
          }
          <li><a href={url('/referenzen/')}>Referenzen</a></li>
        </ul>
      </div>
      <div class="col">
        <h2 class="fh">Unternehmen</h2>
        <ul>
          <li><a href={url('/unternehmen/')}>Über uns</a></li>
          <li><a href={url('/unternehmen/team/')}>Team</a></li>
          <li><a href={url('/unternehmen/zertifikate/')}>Zertifikate & Downloads</a></li>
          <li><a href={url('/karriere/')}>Karriere</a></li>
        </ul>
      </div>
    </div>

    <div class="bottom">
      <span>© {year} {firma.name} · {firma.registergericht} {firma.hrb}</span>
      <nav aria-label="Rechtliches">
        <a href={url('/impressum/')}>Impressum</a>
        <a href={url('/datenschutz/')}>Datenschutz</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: clamp(4rem, 8vw, 7rem) 2rem;
    position: relative;
    overflow: hidden;
  }
  .claim {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--line-light);
  }
  .claim p {
    font-size: clamp(2rem, 4.6vw, 4.2rem);
    line-height: 1.08;
    color: #fff !important;
    margin: 0;
  }
  .cols {
    display: grid;
    grid-template-columns: 1.1fr 1fr 1fr 1fr;
    gap: 2.5rem;
    padding-block: clamp(3rem, 5vw, 4.5rem);
  }
  .brand :global(.flogo) {
    width: 150px;
    height: auto;
  }
  .fh {
    font-size: 0.78rem;
    font-stretch: 118%;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #aab4ea;
    margin-bottom: 1.2rem;
  }
  address {
    font-style: normal;
    color: rgb(255 255 255 / 0.78);
    margin-bottom: 1rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .col a {
    text-decoration: none;
    color: rgb(255 255 255 / 0.85);
    transition: color 0.2s ease;
  }
  .col a:hover {
    color: #fff;
    text-decoration: underline;
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-light);
    font-size: 0.9rem;
    color: rgb(255 255 255 / 0.6);
  }
  .bottom nav {
    display: flex;
    gap: 1.5rem;
  }
  .bottom a {
    text-decoration: none;
  }
  .bottom a:hover {
    color: #fff;
  }
  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 520px) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
