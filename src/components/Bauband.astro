---
/**
 * „Bauen liegt in der Familie.“ als Bauband: ein Zeitstrahl wie ein Maßband,
 * die Jahre im echten Abstand. Beim Scrollen fährt das Band seitlich durch,
 * oben rechts steht groß das aktuelle Jahr. Stationen hängen abwechselnd über
 * und unter dem Band, Projekte mit Foto und Link zur Referenz.
 * Desktop: Abschnitt bleibt stehen, das Band folgt dem Scrollen.
 * Mobil und bei „Bewegung reduzieren“: das Band lässt sich wischen.
 */
import { Image } from 'astro:assets';
import { url } from '~/lib/url';
import { firma, GRUENDUNGSJAHR } from '~/data/site';
import historisch from '~/assets/site/historisch.jpg';
import thomas from '~/assets/team/thomas-quirling.jpg';
import tegelweg from '~/assets/projects/tegelweg/01.jpg';
import hanseforum from '~/assets/projects/hanseforum/01.jpg';
import buchholz from '~/assets/projects/reihenhaeuser-buchholz/01.jpg';
import pferdemarkt from '~/assets/projects/pferdemarkt/03.jpg';
import buero from '~/assets/site/buero-tilsiter-strasse.jpg';

const START = 1990;
const HEUTE = new Date().getFullYear();

// insight: kurzer Satz von Thomas Quirling zur Station; wird nur angezeigt, wenn gefüllt.
const stationen = [
  { yr: -3.7, k: 'Damals', t: 'Das Handwerk im Blut', d: 'Der Vater unseres Gründers lernt auf dem Bau, was gute Arbeit ausmacht.', bild: historisch, pos: '50% 40%', insight: '' },
  { yr: GRUENDUNGSJAHR - START, k: String(GRUENDUNGSJAHR), t: 'Die Gründung', d: 'Thomas Quirling gründet die Quirling GmbH in Hamburg und führt sie bis heute selbst.', bild: thomas, pos: '50% 20%', insight: '' },
  { yr: 1997 - START, k: '1997', t: 'Tegelweg', d: 'Ein Doppelhaus, schlüsselfertig gebaut.', bild: tegelweg, pos: '50% 50%', href: '/referenzen/?p=tegelweg', insight: '' },
  { yr: 2001 - START, k: '2001', t: 'Hanseforum', d: 'Beton- und Stahlbetonbau für ein Bürogebäude mit Tiefgarage.', bild: hanseforum, pos: '50% 50%', href: '/referenzen/?p=hanseforum', insight: '' },
  { yr: 2006 - START, k: '2006', t: 'Buchholz', d: 'Rohbau für 35 Reihenhäuser.', bild: buchholz, pos: '50% 50%', href: '/referenzen/?p=reihenhaeuser-buchholz', insight: '' },
  { yr: 2016 - START, k: '2016', t: 'Pferdemarkt', d: '25 barrierefreie Wohnungen mit Tiefgarage.', bild: pferdemarkt, pos: '50% 50%', href: '/referenzen/?p=pferdemarkt', insight: '' },
  { yr: 2019 - START, k: '2019', t: 'Neues Büro', d: 'Umzug in die Tilsiter Straße 174 in Wandsbek.', bild: buero, pos: '50% 40%', insight: '' },
  { yr: HEUTE - START, k: 'Heute', t: 'Ein Team, das bleibt', d: '', bild: null, pos: '', insight: '' },
];
const ticks = Array.from({ length: HEUTE - START + 1 }, (_, i) => START + i);
---

<section class="bb" data-bb aria-labelledby="bb-h">
  <div class="bb-pin">
    <div class="container bb-head">
      <div class="bb-text">
        <h2 class="h-sec" id="bb-h">Bauen liegt<br /><span class="lt">in der Familie.</span></h2>
        <p class="small">Vom Gerüst des Vaters zum eigenen Betrieb mit über {firma.projekteAnzahl} Projekten. Unser Weg, Station für Station.</p>
      </div>
      <p class="bb-year" aria-hidden="true"><span data-bb-year>Damals</span></p>
    </div>

    <div class="bb-stage" data-bb-stage>
      <ol class="bb-track" data-bb-track style={`--yr-max:${HEUTE - START}`}>
        <!-- Maßband -->
        <li class="bb-rule" aria-hidden="true">
          <span class="bb-before"></span>
          <span class="bb-line"><span class="bb-fill" data-bb-fill></span></span>
          {
            ticks.map((y) => (
              <span class:list={['bb-tick', { 'is-major': y % 5 === 0 }]} style={`--yr:${y - START}`}>
                {y % 5 === 0 && <span class="bb-tl">{y}</span>}
              </span>
            ))
          }
        </li>
        {
          stationen.map((s, i) => (
            <li class:list={['bb-st', i % 2 ? 'is-down' : 'is-up', { 'is-now': s.k === 'Heute' }]} style={`--yr:${s.yr}`} data-bb-st={s.k}>
              <span class="bb-mark" aria-hidden="true" />
              <div class="bb-card">
                {s.bild && (
                  <div class="bb-img">
                    <Image src={s.bild} alt="" widths={[300, 500]} sizes="250px" style={`object-position:${s.pos}`} />
                  </div>
                )}
                <span class="bb-k">{s.k}</span>
                {s.href ? (
                  <a class="bb-t" href={url(s.href)}>
                    {s.t}
                  </a>
                ) : (
                  <span class="bb-t">{s.t}</span>
                )}
                {s.d && <p class="bb-d">{s.d}</p>}
                {s.k === 'Heute' && (
                  <div class="bb-now">
                    <span>
                      <b>{firma.projekteAnzahl}+</b>Projekte
                    </span>
                    <span>
                      <b>30+</b>Jahre sind einige Kollegen schon dabei
                    </span>
                  </div>
                )}
                {s.insight && (
                  <blockquote class="bb-ins">
                    „{s.insight}“<cite>Thomas Quirling</cite>
                  </blockquote>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .bb {
    --px: 76px;
    --x0: 320px;
    --cw: clamp(190px, 25vh, 250px);
    position: relative;
  }
  .bb-pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    padding-top: clamp(5.5rem, 11vh, 7.5rem);
    overflow: hidden;
  }
  .bb-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
  }
  .bb-text {
    display: grid;
    gap: 0.9rem;
  }
  .bb-text .h-sec {
    font-size: clamp(2.2rem, 3.8vw, 4rem);
  }
  .bb-text .small {
    margin: 0;
    max-width: 46ch;
  }
  /* großes laufendes Jahr */
  .bb-year {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(4rem, 9vw, 9rem);
    line-height: 0.8;
    text-transform: uppercase;
    color: var(--blue);
    overflow: hidden;
  }
  .bb-year span {
    display: inline-block;
  }
  .bb-year span.is-in {
    animation: bb-in 0.45s var(--ease);
  }
  @keyframes bb-in {
    from {
      transform: translateY(60%);
      opacity: 0;
    }
  }
  /* Bühne mit dem Band */
  .bb-stage {
    position: relative;
    overflow: hidden;
    padding-left: var(--content-left);
  }
  .bb-track {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    height: 100%;
    width: calc(var(--x0) + (var(--yr-max, 36) * var(--px)) + var(--cw) + 80px);
    will-change: transform;
  }
  .bb-rule {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 0;
  }
  .bb-before {
    position: absolute;
    left: 0;
    width: var(--x0);
    top: -1px;
    border-top: 2px dashed var(--stone-200);
  }
  .bb-line {
    position: absolute;
    left: var(--x0);
    right: 0;
    top: -1px;
    height: 2px;
    background: var(--stone-200);
  }
  .bb-fill {
    position: absolute;
    left: calc(var(--x0) * -1);
    top: 0;
    height: 2px;
    width: var(--fill, 0px);
    background: var(--blue);
  }
  .bb-tick {
    position: absolute;
    left: calc(var(--x0) + var(--yr) * var(--px));
    top: -4px;
    width: 1px;
    height: 8px;
    background: #b9bdd3;
  }
  .bb-tick.is-major {
    top: -9px;
    height: 18px;
    width: 1.5px;
    background: var(--blue);
  }
  .bb-tl {
    position: absolute;
    left: 5px;
    top: 20px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }
  /* Station: Raute auf dem Band, Karte darüber oder darunter */
  .bb-st {
    position: absolute;
    left: calc(var(--x0) + var(--yr) * var(--px));
    top: 50%;
    width: 0;
    height: 0;
  }
  .bb-mark {
    position: absolute;
    left: -7px;
    top: -7px;
    width: 14px;
    height: 14px;
    background: var(--stone-50);
    border: 2px solid var(--blue);
    transform: rotate(45deg);
    transition: background 0.3s ease;
    z-index: 1;
  }
  .bb-st.is-on .bb-mark {
    background: var(--blue);
  }
  .bb-mark::after {
    content: '';
    position: absolute;
  }
  .bb-card {
    position: absolute;
    left: -1px;
    width: var(--cw);
    display: grid;
    gap: 0.3rem;
    padding-left: 1rem;
    border-left: 1px solid var(--stone-200);
  }
  .is-up .bb-card {
    bottom: 14px;
    padding-bottom: 0.4rem;
  }
  .is-down .bb-card {
    top: 14px;
    padding-top: 0.6rem;
  }
  .bb-img {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    margin-bottom: 0.45rem;
    clip-path: polygon(0 0, 100% 0, 100% 88%, 84% 100%, 0 100%);
    background: var(--stone-200);
  }
  .bb-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .bb-st:hover .bb-img :global(img) {
    transform: scale(1.05);
  }
  .bb-k {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--blue);
  }
  .bb-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 1.15rem;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--navy);
    text-decoration: none;
  }
  a.bb-t {
    text-decoration: underline;
    text-decoration-color: #9aa6ee;
    text-underline-offset: 3px;
  }
  a.bb-t:hover {
    color: var(--blue);
  }
  .bb-d {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.45;
    color: var(--ink-2);
  }
  /* Heute: zwei Zahlen statt Bild */
  .bb-now {
    display: grid;
    gap: 0.7rem;
    margin-top: 0.5rem;
  }
  .bb-now span {
    display: grid;
    font-size: 0.9rem;
    font-weight: 300;
    line-height: 1.35;
    color: var(--ink-2);
  }
  .bb-now b {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(2.6rem, 4vw, 3.6rem);
    line-height: 0.9;
    color: var(--blue);
  }
  .bb-ins {
    margin: 0.4rem 0 0;
    padding-left: 0.8rem;
    border-left: 3px solid var(--blue);
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.45;
    color: var(--navy);
  }
  .bb-ins cite {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue);
  }

  /* Mobil: kein Festhalten, das Band wird gewischt */
  @media (max-width: 900px) {
    .bb {
      --px: 56px;
      --x0: 250px;
      --cw: 210px;
      height: auto !important;
      padding-block: clamp(4rem, 10vw, 6rem);
    }
    .bb-pin {
      position: static;
      height: auto;
      display: block;
      padding-top: 0;
    }
    .bb-head {
      align-items: flex-end;
    }
    .bb-year {
      display: none;
    }
    .bb-stage {
      height: 640px;
      margin-top: 1.5rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
      padding-left: var(--gutter);
    }
    .bb-stage::-webkit-scrollbar {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bb {
      height: auto !important;
    }
    .bb-pin {
      position: static;
      height: auto;
    }
    .bb-stage {
      height: 640px;
      overflow-x: auto;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>('[data-bb]');
  if (root) {
    const stage = root.querySelector<HTMLElement>('[data-bb-stage]')!;
    const track = root.querySelector<HTMLElement>('[data-bb-track]')!;
    const fill = root.querySelector<HTMLElement>('[data-bb-fill]')!;
    const year = root.querySelector<HTMLElement>('[data-bb-year]')!;
    const stations = Array.from(root.querySelectorAll<HTMLElement>('[data-bb-st]'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = '';

    // Position einer Station auf dem Band (in px, relativ zum Bandanfang)
    const posOf = (el: HTMLElement) => el.offsetLeft;

    // „Mitte“ = Stelle des Bandes, die gerade in der Bildschirmmitte steht
    const update = (center: number) => {
      fill.style.setProperty('--fill', `${Math.max(0, center)}px`);
      let active = stations[0]!;
      stations.forEach((s) => {
        const on = posOf(s) <= center + 1;
        s.classList.toggle('is-on', on);
        if (on) active = s;
      });
      const k = active.dataset.bbSt!;
      if (k !== current) {
        current = k;
        year.textContent = k;
        year.classList.remove('is-in');
        void year.offsetWidth;
        year.classList.add('is-in');
      }
    };

    const mm = gsap.matchMedia();
    mm.add('(min-width: 901px) and (prefers-reduced-motion: no-preference)', () => {
      let dist = 0;
      const measure = () => {
        const left = parseFloat(getComputedStyle(stage).paddingLeft) || 0;
        dist = Math.max(0, track.offsetWidth + left - window.innerWidth + left);
        root.style.height = `${window.innerHeight + dist}px`;
      };
      measure();
      const st = ScrollTrigger.create({
        trigger: root,
        start: 'top top',
        end: 'bottom bottom',
        invalidateOnRefresh: true,
        onRefreshInit: measure,
        onUpdate: (self) => {
          const x = -self.progress * dist;
          track.style.transform = `translate3d(${x}px,0,0)`;
          const left = parseFloat(getComputedStyle(stage).paddingLeft) || 0;
          // Lesepunkt wandert mit: am Anfang links, am Ende rechts, damit erste und letzte Station aktiv werden
          update(window.innerWidth * (0.3 + 0.5 * self.progress) - left - x);
        },
      });
      update(window.innerWidth * 0.3 - (parseFloat(getComputedStyle(stage).paddingLeft) || 0));
      return () => {
        st.kill();
        root.style.height = '';
        track.style.transform = '';
      };
    });
    mm.add('(max-width: 900px), (prefers-reduced-motion: reduce)', () => {
      const onScroll = () => {
        const max = Math.max(1, stage.scrollWidth - stage.clientWidth);
        const p = stage.scrollLeft / max;
        update(stage.scrollLeft + stage.clientWidth * (0.3 + 0.6 * p));
      };
      stage.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
      return () => stage.removeEventListener('scroll', onScroll);
    });
    if (reduce) update(stage.scrollLeft + stage.clientWidth * 0.5);
  }
</script>
