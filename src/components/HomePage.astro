---
import { Image, getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import QHammer from '~/components/QHammer.astro';
import Picto from '~/components/Picto.astro';
import type { PictoName } from '~/components/Picto.astro';
import { firma, leistungen, GRUENDUNGSJAHR } from '~/data/site';
import { url } from '~/lib/url';
import heroPoster from '~/assets/site/hero-poster.jpg';
import filmPoster from '~/assets/site/film-poster.jpg';
import { leistungBild } from '~/data/leistung-bilder';
import { mark } from '~/lib/logo-paths';
import handwerkFoto from '~/assets/site/handwerk-schalung.jpg';
import historisch from '~/assets/site/historisch.jpg';

interface Props {
  /** Typografie-Variante: 'a' (Standard), 'b' oder 'c' (Entwürfe) */
  typo?: 'a' | 'b' | 'c';
  /** Hintergrund der Leistungen: Raster, nur Farbe oder Rauten-Komposition */
  svcBg?: 'raster' | 'farbe' | 'rauten';
  noindex?: boolean;
  title?: string;
}
const { typo = 'c', noindex = false, title = 'Start' } = Astro.props;

const heroPosterImg = await getImage({ src: heroPoster, width: 1920, format: 'jpg', quality: 70 });
const filmPosterImg = await getImage({ src: filmPoster, width: 1600, format: 'jpg', quality: 70 });

/* Leistungen: Bilder folgen der Diagonale der Linie */
const svcInfo: Record<string, { text: string; more: string; facts: [PictoName, string][] }> = {
  rohbau: {
    more: 'Rohbau aus der Nähe',
    text: 'Rohbauten in Beton- und Stahlbetonbauweise für Wohnanlagen, Büro- und Geschäftshäuser sowie Lagergebäude. Mit eigener Mannschaft, vom Fundament bis zur letzten Decke.',
    facts: [
      ['rohbau', 'Ortbeton'],
      ['gebaeude', 'Tiefgaragen'],
      ['bewehrung', 'Schalungsbau'],
    ],
  },
  'schluesselfertiges-bauen': {
    more: 'So läuft schlüsselfertig',
    text: 'Den Rohbau führen wir selbst aus, alle weiteren Gewerke koordinieren wir. Sie haben einen festen Ansprechpartner, der Termine, Qualität und Kosten im Blick behält.',
    facts: [
      ['helm', 'Ein Ansprechpartner'],
      ['kalender', 'Alle Gewerke'],
      ['schluessel', 'Schlüsselübergabe'],
    ],
  },
  'umbau-sanierung': {
    more: 'Umbauten ansehen',
    text: 'Umbauten, Erweiterungen und Sanierungen, von der Stadtvilla bis zum historischen Gebäude. Wir schauen genau hin, bevor wir loslegen, und arbeiten sauber bis zum Schluss.',
    facts: [
      ['umbau', 'Erweiterungen'],
      ['hammer', 'Bauen im Bestand'],
      ['gebaeude', 'Stadtvillen'],
    ],
  },
};
const services = await Promise.all(
  leistungen.map(async (l) => {
    const info = svcInfo[l.slug]!;
    // gleiche Bilder wie auf der Leistungsübersicht (src/data/leistung-bilder.ts)
    const img = await leistungBild(l.slug, 'start');
    return { ...l, ...info, img };
  }),
);

/* Drei Projekte zum Durchscrollen */
const fakt = (fakten: { label: string; value: string }[], label: string) => fakten.find((f) => f.label === label)?.value;
const showcase = await Promise.all(
  ['hanseforum', 'prime-selfstorage-harburg', 'bellevue-50'].map(async (id) => {
    const p = (await getEntry('projekte', id))!;
    const adresse = fakt(p.data.fakten, 'Adresse')?.split('\n') ?? [];
    return { id, ...p.data, strasse: adresse[0] ?? '', ort: (adresse[1] ?? '').replace(/^\d{5}\s*/, '') };
  }),
);



/* Zahlen: drei Stufen, die nach rechts ansteigen */
const zahlen = [
  { n: GRUENDUNGSJAHR, plus: false, t: 'Gegründet in Hamburg' },
  { n: firma.projekteAnzahl, plus: true, t: 'Projekte realisiert' },
  { n: firma.mitarbeiter, plus: false, t: 'Mitarbeiter im Team' },
];

const werte = [
  {
    icon: 'familie',
    t: 'Persönlich',
    d: 'Sie sprechen direkt mit denen, die entscheiden.',
  },
  {
    icon: 'dialog',
    t: 'Verbindlich',
    d: 'Klare Absprachen, feste Termine.',
  },
  {
    icon: 'hammer',
    t: 'Sorgfältig',
    d: 'Sauber bis zum Schluss.',
  },
] as const;
---

<Base title={title} noindex={noindex} typo={typo}>
  <!-- ======================= HERO ======================= -->
  <section class="hero" data-hero>
    <div class="hero-media">
      <video class="hero-video" autoplay muted loop playsinline preload="auto" poster={heroPosterImg.src} data-autoplay aria-hidden="true">
        <source src={url('/video/hero-540.mp4')} type="video/mp4" media="(max-width: 767px)" />
        <source src={url('/video/hero-1080.mp4')} type="video/mp4" />
      </video>
      <div class="hero-slab" aria-hidden="true"></div>
    </div>
    <div class="hero-cut" aria-hidden="true"></div>
    <div class="container hero-content">
      <h1 class="hero-title">Was wir<br />zusagen,<br /><span class="lt">steht.</span></h1>
      <p class="hero-sub">Rohbau, schlüsselfertiges Bauen und Umbau in Hamburg. Seit {GRUENDUNGSJAHR}.</p>
      <div class="hero-cta">
        <a class="pill fill" href={url('/kontakt/')}><span>Projekt anfragen</span><Icon name="arrow" /></a>
        <a class="pill light" href={url('/referenzen/')}><span>Referenzen ansehen</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- ======================= EINSTIEG ======================= -->
  <section class="intro" data-intro>
    <div class="container intro-grid">
      <div class="intro-text">
        <h2 class="intro-h">Rohbau ist<br /><span class="lt">unser Ding.</span></h2>
        <p class="intro-p">
          Schalen, bewehren, betonieren: Wir bauen Rohbauten für Wohnanlagen, Büro- und Gewerbebauten in Hamburg und Umgebung. Mit eigener
          Mannschaft, vom Fundament bis zur letzten Decke.
        </p>
        <a class="block-btn" href={url('/unternehmen/')}>
          <span>Kennste uns schon?</span>
          <Icon name="arrow" />
        </a>
      </div>
      <div class="intro-visual">
        <div class="intro-img">
          <Image src={handwerkFoto} alt="Schalung mit Quirling-Logo und Bewehrung auf einer Baustelle" widths={[700, 1100, 1600]} sizes="(min-width: 900px) 50vw, 100vw" />
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= LEISTUNGEN: Übersicht (eigene blaue Fläche) ======================= -->
  <section class="overview" id="leistungen" aria-labelledby="svc-h">
    <div class="container ov-in">
      <div class="ov-top">
        <h2 id="svc-h" class="svc-head" data-follow data-svc-head>Was wir <span class="lt">bauen.</span></h2>
        <p class="ov-p">
          Vom ersten Spatenstich bis zur Schlüsselübergabe: Wir übernehmen den Rohbau in Beton und Stahlbeton, bauen auf Wunsch schlüsselfertig und
          bringen Bestandsgebäude wieder in Form. Immer mit eigener Mannschaft und einem festen Ansprechpartner.
        </p>
      </div>
      <!-- nur Stichworte, davor jeweils eine kleine Raute -->
      <div class="ov">
        {
          leistungen.map((l) => (
            <a class="ov-col" href={url(`/leistungen/${l.slug}/`)} data-follow>
              <h3 class="ov-t" set:html={l.title} />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================= LEISTUNGEN: einzeln ======================= -->
  <section class="services">
    {
      services.map((s, i) => (
        <article class:list={['svc', `svc-${i + 1}`]} data-svc>
          <a class="svc-visual" href={url(`/leistungen/${s.slug}/`)} tabindex="-1" aria-hidden="true">
            <span class="cut-img svc-img">
              <Image src={s.img} alt="" widths={[600, 1000, 1400]} sizes="(min-width: 900px) 40vw, 100vw" />
            </span>
          </a>
          <div class="container svc-grid">
            <div class="svc-text" data-follow>
              <h3 class="svc-title">{s.title}</h3>
              <p>{s.text}</p>
              <ul class="svc-facts">
                {s.facts.map(([icon, t]) => (
                  <li>
                    <Picto name={icon} class="svc-ico" />
                    <span>{t}</span>
                  </li>
                ))}
              </ul>
              <a class="svc-more" href={url(`/leistungen/${s.slug}/`)}>
                <span>{s.more}</span>
                <Icon name="arrow" />
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <!-- ======================= PROJEKTE (3 × scrollen) ======================= -->
  <section class="show" data-show aria-labelledby="show-h">
    <div class="show-in">
      <div class="show-text">
        <h2 id="show-h" class="show-h">Projekte,<br /><span class="lt">die stehen.</span></h2>
        <div class="show-items">
          {
            showcase.map((p, i) => (
              <div class:list={['show-item', { 'is-active': i === 0 }]} data-show-item>
                <h3 class="show-title">{p.title}</h3>
                <p class="show-desc">
                  {p.leistung}
                  <span class="show-meta">{p.ort}</span>
                </p>
              </div>
            ))
          }
        </div>
        <a class="svc-more show-all" href={url('/referenzen/')}><span>Alle Projekte ansehen</span><Icon name="arrow" /></a>
      </div>
      <div class="show-stage">
        {
          showcase.map((p, i) => (
            <a class="show-img" href={url(`/referenzen/?p=${p.id}`)} data-show-img tabindex="-1" style={`z-index:${i + 1}`}>
              <Image src={p.bilder[0]!} alt={`${p.title}: ${p.leistung}`} widths={[900, 1400, 2000]} sizes="(min-width: 900px) 62vw, 100vw" />
              <span class="show-cap">
                <strong>{p.title}</strong>
                {p.kategorien[0]} · {p.ort}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================= FAMILIE UND ERFAHRUNG ======================= -->
  <section class="figs" data-figs-sec aria-labelledby="figs-h">
    <!-- historisches Foto randlos von Kante zu Kante, Innenkante mit Knick -->
    <figure class="figs-photo">
      <span class="figs-img" data-figs-img>
        <Image src={historisch} alt="Historisches Foto einer Baumannschaft auf einem Gerüst" widths={[800, 1200, 1600]} sizes="(min-width: 900px) 46vw, 100vw" />
      </span>
      <figcaption class="figs-cap">Der Vater unseres Gründers in seiner Lehrzeit.</figcaption>
    </figure>
    <div class="container figs-in">
      <div class="figs-side">
        <h2 id="figs-h" class="figs-h">Bauen liegt<br /><span class="lt">in der Familie.</span></h2>
        <ul class="vals">
          {werte.map((w) => <li>{w.t}</li>)}
        </ul>
        <p class="figs-p">
          Schon der Vater unseres Gründers stand auf dem Gerüst. Seit {GRUENDUNGSJAHR} führt die Familie Quirling das Unternehmen selbst. Hinter jedem
          Bauvorhaben stehen Menschen mit Namen, die für ihr Wort einstehen.
        </p>
        <div class="figs-steps">
          {
            zahlen.map((z) => (
              <div class="fg" data-follow>
                <strong>
                  <span class="flap" data-flap={String(z.n)}>{z.n}</span>
                  {z.plus && <sup>+</sup>}
                </strong>
                <p>{z.t}</p>
              </div>
            ))
          }
        </div>
        <a class="block-btn" href={url('/unternehmen/team/')}>
          <span>Wer steckt dahinter?</span>
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <!-- ======================= FILM (Raute) ======================= -->
  <section class="film" data-film>
    <div class="film-sticky">
      <div class="film-frame" data-film-frame>
        <video autoplay muted loop playsinline preload="none" poster={filmPosterImg.src} data-autoplay aria-hidden="true">
          <source src={url('/video/film-loop.mp4')} type="video/mp4" />
        </video>
      </div>
      <!-- Bildmarke: die graue Raute des Logos wird zum Fenster für das Video -->
      <svg class="film-logo" data-film-logo viewBox="120 62 354.5 247" aria-hidden="true">
        {mark.map((m, i) => (i === 0 ? <path class="fl-raute" fill="#868484" d={m.d} /> : null))}
        <g class="fl-q" data-film-q>
          {mark.slice(1).map((m) => <path fill={m.role === 'white' ? '#ffffff' : m.role === 'grey' ? '#868484' : '#3948A4'} d={m.d} />)}
        </g>
      </svg>
      <div class="film-ui" data-film-ui>
        <h2 class="h-display">Quirling<br /><span class="lt">von oben.</span></h2>
        <a class="pill fill" href={url('/kontakt/')}><span>Projekt anfragen</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- ======================= KARRIERE: helles Band zwischen Video und Footer ======================= -->
  <aside class="job" aria-label="Karriere">
    <div class="container job-in">
      <p class="job-h" data-follow><QHammer class="job-hammer" color="#121735" highlight="#3948A4" />Bock auf Beton? Komm ins Team.</p>
      <a class="job-btn" href={url('/karriere/')} data-follow><span>Mit anpacken</span><Icon name="arrow" /></a>
    </div>
  </aside>
</Base>

<style>
  /* ---------- Bausteine ---------- */
  /* Navy-Parallelogramm hinter dem Bild: neigt sich wie das Bild,
     steht nur leicht über (überall gleich, links hinter dem Bild) */
  .block {
    position: absolute;
    width: 40%;
    background: var(--navy);
    pointer-events: none;
    clip-path: polygon(0 0, 60% 0, 100% 100%, 12% 100%);
  }
  .block-l {
    left: -8%;
    top: 12%;
    bottom: -7%;
  }
  .block-r {
    right: -7%;
    top: -5%;
    bottom: -6%;
    clip-path: polygon(40% 0, 100% 0, 88% 100%, 0 100%);
  }
  .cut-img {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--stone-200);
  }
  .cut-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Linie ---------- */
  :global(main) {
    position: relative;
    --ov-cut: clamp(2rem, 4vw, 3.5rem);
  }

  /* ======================= HERO ======================= */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    color: #fff;
    z-index: 2;
    /* Unterkante deutet eine Raute an, Spitze rechts */
    --hero-cut: polygon(0 90%, 78% 100%, 100% 94%, 100% 101%, 0 101%);
  }
  /* Das Video selbst wird bewusst NICHT zugeschnitten: Chrome zeichnet zugeschnittene
     Video-Ebenen beim Hoch- und Runterscrollen teils unvollständig. Die schräge Unterkante
     entsteht durch eine Fläche in Seitenfarbe, die über dem unteren Videorand liegt. */
  .hero-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--navy);
  }
  .hero-cut {
    position: absolute;
    inset: 0;
    background: var(--stone-50);
    clip-path: var(--hero-cut);
    pointer-events: none;
  }
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-slab {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--content-left) + min(58vw, 1000px));
    background: rgb(18 23 53 / 0.82);
    clip-path: polygon(0 0, 100% 0, 66% 100%, 0 100%);
  }
  .hero-content {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-top: var(--header-h);
    padding-bottom: 4rem;
  }
  .hero-title {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.4rem, 4.6vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    margin-bottom: 1.4rem;
    /* bleibt mit Abstand innerhalb der schrägen blauen Fläche */
    max-width: min(42vw, 660px);
    white-space: nowrap;
  }

  .hero-sub {
    margin: 0 0 2rem;
    max-width: 24rem;
    font-size: clamp(1.05rem, 1.3vw, 1.25rem);
    font-weight: 300;
    line-height: 1.5;
    color: rgb(255 255 255 / 0.9);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
  }
  .hero-cta .pill,
  .film-ui .pill {
    padding: 0.95rem 1.5rem;
    font-size: 0.86rem;
  }
  /* gefüllter Knopf für die Anfrage: weiß auf dunklem Grund */
  .pill.fill {
    background: #fff;
    border-color: #fff;
    color: var(--navy);
  }
  .pill.fill:hover {
    background: #9aa6ee;
    border-color: #9aa6ee;
    color: var(--navy);
  }

  /* ======================= EINSTIEG ======================= */
  .intro {
    position: relative;
    overflow-x: clip;
    padding-block: clamp(3.4rem, 5.4vw, 4.6rem) clamp(3.8rem, 6.2vw, 5.4rem);
  }
  .intro-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  .intro-text {
    grid-column: 1 / 7;
    display: grid;
    gap: clamp(1.6rem, 3vw, 2.4rem);
    align-content: start;
  }
  .intro-h {
    font-family: var(--font-head);
    text-transform: uppercase;
    color: var(--blue);
    margin: 0;
  }
  .intro-p {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(1.16rem, 1.36vw, 1.32rem);
    line-height: 1.65;
    font-weight: 300;
    color: var(--ink);
  }
  /* Bild randlos bis an den rechten Rand, Innenkante mit Knick */
  /* Desktop: Bild liegt hinter dem Raster und schließt oben an die Hero-Kante und unten an die
     Kante der Leistungsübersicht an. Die genaue Form setzt das Skript (fitIntro). */
  .intro-visual {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 53%;
    right: 0;
    z-index: 3;
  }
  .intro-img {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: polygon(14% 0, 100% 0, 100% 100%, 8% 100%, 0 58%);
  }
  .intro-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* dunkler Knopf unter dem Text (Einstieg und Familie) */
  .block-btn {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.15rem 1.5rem 1.05rem;
    line-height: 1;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.25rem, 1.6vw, 1.55rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease;
  }
  .block-btn :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    transition: transform 0.35s var(--ease);
  }
  .block-btn:hover {
    background: var(--blue);
  }
  .block-btn:hover :global(svg) {
    transform: translateX(4px);
  }

  /* ======================= FAMILIE UND ERFAHRUNG ======================= */
  .figs {
    position: relative;
    overflow-x: clip;
    padding-block: clamp(4.5rem, 7vw, 6.5rem);
  }
  .figs-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
  }
  /* Foto füllt die linke Seite von Ober- bis Unterkante. Die Innenkante setzt die schräge Kante
     der Projekte darüber gerade fort (fitFigs setzt Breite und Form). */
  .figs-photo {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 44%;
    margin: 0;
    z-index: 2;
  }
  .figs-img {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 86% 100%, 0 100%);
    background: var(--stone-200);
  }
  .figs-img :global(img) {
    width: 100%;
    height: 112%;
    object-fit: cover;
    object-position: 80% 0%;
  }
  .figs-cap {
    position: absolute;
    left: var(--content-left);
    bottom: 1.4rem;
    padding: 0.5rem 0.8rem 0.45rem;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .figs-side {
    grid-column: 6 / 13;
    padding-left: clamp(1rem, 3vw, 3rem);
    display: grid;
    gap: clamp(1.6rem, 2.6vw, 2.2rem);
    justify-items: start;
  }
  .figs-side .block-btn {
    margin-top: 0.4rem;
  }
  .figs-h {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(3rem, 5.6vw, 6rem);
    line-height: 0.9;
    color: var(--blue);
    margin: 0;
  }
  .figs-p {
    margin: 0;
    max-width: 34rem;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.65;
    color: var(--ink-2);
  }
  /* drei Zahlen nebeneinander, jede mit einer Linie, die sich zeichnet */
  .figs-steps {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: clamp(2rem, 4.5vw, 4.5rem);
    margin-top: 0.6rem;
  }
  .fg {
    display: grid;
    gap: 0.1rem;
    align-content: start;
  }
  .fg[data-follow] {
    opacity: 1;
    transform: none;
  }
  .fg strong {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(3rem, 5vw, 5.2rem);
    line-height: 1.08;
    color: var(--blue);
    font-variant-numeric: tabular-nums;
    display: inline-flex;
    align-items: flex-start;
  }
  .fg strong :global(sup) {
    font-size: 0.45em;
    vertical-align: top;
    margin-left: 0.05em;
  }
  .fg p {
    margin: 0;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.4;
    color: var(--ink);
  }
  /* drei Werte als eine ruhige Zeile, jeweils mit Raute */
  .vals {
    list-style: none;
    margin: -0.4rem 0 0.2rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem clamp(1.4rem, 2.6vw, 2.4rem);
  }
  .vals li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.5rem, 2vw, 2rem);
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--navy);
  }
  .vals li::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    background: var(--navy);
    transform: rotate(45deg);
  }
  /* Klapptafel-Effekt in der Quirling-Schrift: ohne Täfelchen, nur die Ziffern klappen um */
  .flap {
    display: inline-flex;
  }
  .flap :global(.sf) {
    position: relative;
    display: inline-block;
    width: 0.5em;
    height: 1.08em;
    perspective: 3em;
  }
  .flap :global(.sf-h) {
    position: absolute;
    left: 0;
    right: 0;
    height: 50%;
    overflow: hidden;
    color: var(--blue);
    backface-visibility: hidden;
  }
  .flap :global(.sf-h > span) {
    display: block;
    height: 1.08em;
    line-height: 1.08em;
    text-align: center;
  }
  .flap :global(.sf-top),
  .flap :global(.sf-ft) {
    top: 0;
    transform-origin: 50% 100%;
  }
  .flap :global(.sf-bot),
  .flap :global(.sf-fb) {
    bottom: 0;
    transform-origin: 50% 0;
  }
  .flap :global(.sf-bot > span),
  .flap :global(.sf-fb > span) {
    transform: translateY(-50%);
  }
  .flap :global(.sf-ft),
  .flap :global(.sf-fb) {
    z-index: 2;
  }
  .flap :global(.sf-fb) {
    transform: rotateX(90deg);
  }
  /* Einblenden, sobald die Linie die Stelle erreicht */
  [data-follow] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.9s ease,
      transform 0.9s var(--ease);
  }
  [data-follow].is-in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-follow] {
      opacity: 1;
      transform: none;
    }
  }
  /* ======================= LEISTUNGEN ======================= */
  /* Übersicht: abgegrenzte blaue Fläche, Oberkante als angedeutete Raute */
  .overview {
    position: relative;
    z-index: 3;
    background: #e6e9f6;
    padding-block: clamp(6rem, 10vw, 8.5rem) clamp(5.5rem, 8vw, 7rem);
    /* Ober- und Unterkante mit Knick wie die angedeutete Raute */
    clip-path: polygon(
      0 0,
      78% clamp(2rem, 4vw, 3.5rem),
      100% clamp(0.8rem, 1.6vw, 1.4rem),
      100% calc(100% - clamp(2rem, 4vw, 3.5rem)),
      22% 100%,
      0 calc(100% - clamp(0.8rem, 1.6vw, 1.4rem))
    );
  }
  .ov-top {
    display: grid;
    gap: clamp(1.4rem, 2.5vw, 2rem);
    max-width: 44rem;
  }
  .ov-top .svc-head {
    margin: 0;
    padding: 0;
  }
  .ov-p {
    margin: 0;
    font-size: clamp(1.16rem, 1.36vw, 1.32rem);
    font-weight: 300;
    line-height: 1.65;
    color: var(--ink);
  }
  .services {
    position: relative;
    overflow-x: clip;
    /* schiebt sich unter die geknickte Unterkante der Übersicht: das erste Bild schließt dort bündig an */
    margin-top: calc(-1 * var(--ov-cut));
    --band: clamp(1.6rem, 3.2vw, 3rem);
  }
  .svc-head {
    position: relative;
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 6vw, 6.2rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--blue);
    padding-bottom: clamp(1rem, 2vw, 1.6rem);
    margin-bottom: clamp(1rem, 3vw, 2rem);
  }
  /* wird von links nach rechts aufgedeckt, während die Linie darunter entlangläuft */
  .svc-head[data-follow] {
    opacity: 1;
    transform: none;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1.3s cubic-bezier(0.45, 0, 0.2, 1);
  }
  .svc-head[data-follow].is-in {
    clip-path: inset(0 -2% 0 0);
  }
  /* erst als Kontur aufgedeckt, dann füllt sich die Schrift von links nach rechts */
  @media (prefers-reduced-motion: no-preference) {
    .svc-head[data-follow] {
      color: transparent;
      -webkit-text-stroke: 1.5px var(--blue);
      background-image: linear-gradient(90deg, var(--blue) 0 50%, transparent 50% 100%);
      background-size: 200% 100%;
      background-position: 100% 0;
      -webkit-background-clip: text;
      background-clip: text;
      transition:
        clip-path 1.3s cubic-bezier(0.45, 0, 0.2, 1),
        background-position 1.5s cubic-bezier(0.6, 0, 0.2, 1) 1.1s;
    }
    .svc-head[data-follow].is-in {
      background-position: 0 0;
    }
  }
  /* Stichworte: drei Spalten, jeweils mit einer kleinen Raute als Marker */
  .ov {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
    margin-top: clamp(3rem, 5vw, 4rem);
  }
  .ov-col {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: inherit;
    text-decoration: none;
  }
  /* Raute: dreht sich beim Erscheinen ein */
  .ov-col::before,
  .svc-more::before {
    content: '';
    flex: none;
    width: 0.62rem;
    height: 0.62rem;
    background: var(--blue);
    transform: rotate(45deg);
    transition: transform 0.8s var(--ease) 0.25s;
  }
  .ov-col[data-follow]:not(.is-in)::before {
    transform: rotate(-135deg) scale(0);
  }
  .ov-col:hover::before,
  .svc-more:hover::before {
    transform: rotate(135deg);
  }
  .show .svc-more::before {
    display: none;
  }
  .ov-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.45rem, 2vw, 2.1rem);
    line-height: 1;
    color: var(--blue);
    margin: 0;
    hyphens: manual;
  }
  .ov-col:hover .ov-t {
    color: var(--navy);
  }

  /* Leistungen einzeln: drei Bänder ohne Abstand. Die Bilder füllen die volle Bandhöhe und schließen
     oben und unten bündig an; das mittlere Band liegt hellblau mit schrägen Kanten darüber. */
  .svc {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(26rem, 36vw, 34rem);
  }
  .svc-1 {
    padding-block: calc(var(--ov-cut) + 3.5rem) calc(var(--band) + 3.5rem);
  }
  .svc-2 {
    z-index: 2;
    margin-block: calc(-1 * var(--band));
    padding-block: calc(var(--band) + 3.5rem);
    background: #e6e9f6;
    clip-path: polygon(0 var(--band), 100% 0, 100% 100%, 0 calc(100% - var(--band)));
  }
  .svc-3 {
    padding-block: calc(var(--band) + 3.5rem) 3.5rem;
  }
  .svc-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(2.5rem, 5vw, 5rem);
  }
  .svc-1 .svc-text,
  .svc-3 .svc-text {
    grid-column: 1 / 7;
  }
  .svc-2 .svc-text {
    grid-column: 7 / 13;
  }
  /* Bilder rechts, links, rechts: volle Bandhöhe, bis an den Bildschirmrand */
  .svc-visual {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 42%;
    display: block;
  }
  .svc-2 .svc-visual {
    right: auto;
    left: 0;
  }
  .svc-visual[data-follow] {
    opacity: 1;
    transform: none;
  }
  .svc-img {
    position: absolute;
    inset: 0;
    /* Bild rechts: Innenkante links mit Knick */
    clip-path: polygon(14% 0, 100% 0, 100% 100%, 8% 100%, 0 56%);
  }
  .svc-2 .svc-img {
    /* Bild links: gespiegelt */
    clip-path: polygon(0 0, 86% 0, 100% 56%, 92% 100%, 0 100%);
  }
  /* Bild steht immer; etwas höher als der Ausschnitt, damit es beim Scrollen leicht mitlaufen kann */
  .svc-img :global(img) {
    position: absolute;
    left: 0;
    top: -8%;
    width: 100%;
    height: 116%;
  }
  .svc-text[data-follow] {
    opacity: 1;
    transform: none;
  }
  .svc-title,
  .svc-text > p,
  .svc-facts li {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.9s ease,
      transform 1s var(--ease);
  }
  .svc-text.is-in .svc-title,
  .svc-text.is-in > p,
  .svc-text.is-in .svc-facts li {
    opacity: 1;
    transform: none;
  }
  .svc-text.is-in > p {
    transition-delay: 0.12s;
  }
  .svc-text.is-in .svc-facts li:nth-child(1) {
    transition-delay: 0.24s;
  }
  .svc-text.is-in .svc-facts li:nth-child(2) {
    transition-delay: 0.32s;
  }
  .svc-text.is-in .svc-facts li:nth-child(3) {
    transition-delay: 0.4s;
  }
  .svc-title {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(1.8rem, 2.6vw, 2.7rem);
    line-height: 0.98;
    text-transform: uppercase;
    overflow-wrap: normal;
    color: var(--blue);
    margin-bottom: 1.2rem;
    hyphens: manual;
  }
  .svc-more {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 0.8rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.2rem, 1.5vw, 1.45rem);
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--blue);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .svc-more :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    transition: transform 0.35s var(--ease);
  }
  .svc-more:hover :global(svg) {
    transform: translateX(5px);
  }
  .svc-more:hover {
    color: var(--navy);
  }
  /* Der Link kommt mit dem Scrollweg herein (Skript setzt --p von 0 bis 1) */
  .svc .svc-more {
    --p: 1;
    opacity: var(--p);
    transform: translateX(calc((1 - var(--p)) * -48px));
  }
  .svc .svc-more::before {
    transform: rotate(calc(45deg - (1 - var(--p)) * 180deg)) scale(var(--p));
    transition: none;
  }
  .svc .svc-more:hover::before {
    transform: rotate(135deg);
    transition: transform 0.6s var(--ease);
  }
  /* beim Überfahren läuft eine feine Linie unter dem Text durch */
  .svc-more > span {
    position: relative;
    padding-bottom: 0.3em;
  }
  .svc-more > span::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease);
  }
  .svc-more:hover > span::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  @media (prefers-reduced-motion: reduce) {
    .svc-title,
    .svc-text > p,
    .svc-facts li {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
  .svc-text p {
    color: var(--ink-2);
    max-width: 52ch;
    margin: 0 0 1.6rem;
  }
  /* alle drei Punkte immer in einer Zeile: Größen folgen der Spaltenbreite */
  .svc-facts {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: flex;
    flex-wrap: nowrap;
    gap: 1.1rem clamp(0.9rem, 1.7vw, 1.6rem);
  }
  /* Icon neben dem Text, Text zurückhaltend und kurz */
  .svc-facts li {
    display: grid;
    grid-template-columns: var(--ico) auto;
    gap: 0.6rem;
    white-space: nowrap;
    align-items: center;
    font-size: clamp(0.85rem, 1.08vw, 1.1rem);
    font-weight: 300;
    line-height: 1.4;
    color: var(--ink-2);
    --ico: clamp(28px, 2.8vw, 40px);
  }
  .svc-facts :global(.svc-ico) {
    width: var(--ico);
    height: var(--ico);
    color: var(--blue);
  }

  /* ======================= PROJEKTE ======================= */
  .show {
    position: relative;
    z-index: 2;
    background: var(--navy);
    color: #fff;
  }
  /* Desktop: die Bühne bleibt per CSS stehen (kein Einrasten durch Pinning), die Höhe gibt die Scrollstrecke vor */
  @media (min-width: 901px) {
    .show {
      height: calc(100vh + 2 * 50vh);
    }
    .show-in {
      position: sticky;
      top: 0;
    }
  }
  .show-in {
    display: grid;
    grid-template-columns: calc(var(--content-left) + clamp(330px, 30vw, 540px)) 1fr;
    height: 100vh;
    min-height: 640px;
  }
  .show-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: calc(var(--header-h) + 1rem) clamp(2rem, 4vw, 4rem) 3rem var(--content-left);
  }
  .show-h {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.1rem, 3.3vw, 3.6rem);
    line-height: 0.95;
    white-space: nowrap;
    overflow-wrap: normal;
    hyphens: manual;
    color: #9aa6ee;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .show-items {
    display: grid;
    margin-bottom: 2.5rem;
    perspective: 900px;
  }
  /* Titel klappen um wie die Blätter einer Anzeigetafel: das alte fällt nach unten weg, das neue klappt von oben herein */
  .show-item {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: rotateX(-92deg);
    transform-origin: 50% 0;
    backface-visibility: hidden;
    transition:
      transform 0.55s cubic-bezier(0.3, 1.3, 0.5, 1) 0.22s,
      opacity 0.2s ease 0.22s,
      visibility 0s 0.22s;
  }
  .show-item.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .show-item.is-out {
    opacity: 0;
    visibility: hidden;
    transform: rotateX(92deg);
    transform-origin: 50% 100%;
    transition:
      transform 0.32s cubic-bezier(0.6, 0, 0.9, 0.4),
      opacity 0.12s ease 0.22s,
      visibility 0s 0.34s;
  }
  @media (prefers-reduced-motion: reduce) {
    .show-item,
    .show-item.is-out {
      transform: none;
      transition: opacity 0.3s ease;
    }
  }
  .show-title {
    font-stretch: 125%;
    font-weight: 700;
    font-size: clamp(1.3rem, 1.8vw, 1.65rem);
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 0.7rem;
  }
  .show-desc {
    color: rgb(255 255 255 / 0.72);
    font-size: 0.9rem;
    max-width: 24rem;
    margin-bottom: 1.4rem;
  }
  .show-meta {
    display: block;
    margin-top: 0.3rem;
    color: #9aa6ee;
  }
  .show .show-all {
    align-self: flex-start;
    color: #fff;
  }
  .show .show-all:hover {
    color: #c9d0f5;
  }
  .show .show-all :global(svg) {
    display: inline;
  }
  .show-stage {
    position: relative;
    overflow: hidden;
    clip-path: polygon(14% 0, 100% 0, 100% 100%, 0 100%);
  }
  .show-img {
    position: absolute;
    inset: 0;
    display: block;
  }
  .show-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .show-cap {
    display: none;
  }
  /* ======================= KARRIERE ======================= */
  /* helles Band, die schräge Oberkante schneidet leicht ins Video */
  .job {
    position: relative;
    z-index: 3;
    margin-top: calc(clamp(1.2rem, 2.4vw, 2rem) * -1);
    /* unten Platz für den Knick des Footers, der in das Band hineinragt */
    padding-block: clamp(2.6rem, 3.8vw, 3.2rem) calc(clamp(1.8rem, 2.6vw, 2.2rem) + clamp(2.6rem, 5.4vw, 5rem));
    background: #e6e9f6;
    color: var(--navy);
    clip-path: polygon(0 clamp(1.2rem, 2.4vw, 2rem), 78% 0, 100% clamp(0.6rem, 1.2vw, 1rem), 100% 100%, 0 100%);
  }
  .job-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
  }
  .job-h {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.9rem, 3vw, 2.9rem);
    line-height: 0.95;
    text-transform: uppercase;
  }
  .job :global(.job-hammer) {
    display: inline-block;
    width: 0.95em;
    height: 0.95em;
    margin-right: 0.45em;
    vertical-align: -0.1em;
  }
  /* Knopf genau so hoch wie die Schriftzeile */
  .job-btn {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    height: clamp(1.9rem, 3vw, 2.9rem);
    padding: 0.1rem 1.3rem 0;
    background: var(--blue);
    color: #fff;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.2rem, 1.5vw, 1.4rem);
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.25s ease;
  }
  .job-btn :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    transition: transform 0.35s var(--ease);
  }
  .job-btn:hover {
    background: var(--navy);
  }
  .job-btn:hover :global(svg) {
    transform: translateX(4px);
  }
  /* ======================= FILM ======================= */
  .film {
    position: relative;
    height: 160vh;
    background: #e6e9f6;
  }
  .film-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: grid;
    place-items: center;
    z-index: 2;
  }
  /* Startform = Raute des Logos (Punkte aus der Bildmarke, Breite 34 vw, mittig); das Skript rechnet sie exakt nach */
  .film-frame {
    position: absolute;
    inset: 0;
    background: var(--navy);
    clip-path: polygon(33% 50%, 50.4% 30%, 67.8% 51.5%, 49.8% 70.5%);
  }
  .film-logo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(34vw, 62vh);
    height: auto;
    translate: -50% -50%;
    z-index: 3;
    overflow: visible;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .film-logo {
      display: none;
    }
    .film-frame {
      clip-path: none;
    }
  }
  .fl-q {
    transform-box: view-box;
    transform-origin: 297px 185px;
  }
  .film-frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(18 23 53 / 0.2);
  }
  .film-ui {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    padding-inline: var(--gutter);
    display: grid;
    justify-items: center;
    gap: clamp(1.4rem, 2.4vw, 2rem);
  }

  /* ======================= TYPOGRAFIE-ENTWURF B ======================= */
  :global(html.typo-b) .hero-title {
    font-weight: 900;
    font-size: clamp(2.6rem, 5.2vw, 5.4rem);
    line-height: 0.9;
    letter-spacing: -0.025em;
  }
  :global(html.typo-b) .intro-h {
    font-weight: 900;
    font-size: clamp(1.6rem, 2.35vw, 2.7rem);
  }
  :global(html.typo-b) .svc-head {
    font-weight: 900;
    font-size: clamp(3rem, 7vw, 7.4rem);
    line-height: 0.88;
  }
  :global(html.typo-b) .svc-title {
    font-weight: 900;
    font-size: clamp(1.7rem, 2.5vw, 2.6rem);
    line-height: 0.95;
  }
  :global(html.typo-b) .show-h {
    font-weight: 900;
    font-size: clamp(2rem, 3.25vw, 3.6rem);
    line-height: 0.9;
  }
  :global(html.typo-b) .show-title {
    font-weight: 900;
