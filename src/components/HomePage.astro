---
import { Image, getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import QHammer from '~/components/QHammer.astro';
import ValueIcon from '~/components/ValueIcon.astro';
import Picto from '~/components/Picto.astro';
import type { PictoName } from '~/components/Picto.astro';
import { firma, leistungen, GRUENDUNGSJAHR } from '~/data/site';
import { url } from '~/lib/url';
import heroPoster from '~/assets/site/hero-poster.jpg';
import filmPoster from '~/assets/site/film-poster.jpg';
import { leistungBild } from '~/data/leistung-bilder';
import { mark } from '~/lib/logo-paths';
import handwerkFoto from '~/assets/site/handwerk-schalung.jpg';
import historisch from '~/assets/site/historisch.jpg';

interface Props {
  /** Typografie-Variante: 'a' (Standard), 'b' oder 'c' (Entwürfe) */
  typo?: 'a' | 'b' | 'c';
  /** Hintergrund der Leistungen: Raster, nur Farbe oder Rauten-Komposition */
  svcBg?: 'raster' | 'farbe' | 'rauten';
  noindex?: boolean;
  title?: string;
}
const { typo = 'c', noindex = false, title = 'Start' } = Astro.props;

const heroPosterImg = await getImage({ src: heroPoster, width: 1920, format: 'jpg', quality: 70 });
const filmPosterImg = await getImage({ src: filmPoster, width: 1600, format: 'jpg', quality: 70 });

/* Leistungen: Bilder folgen der Diagonale der Linie */
const svcInfo: Record<string, { text: string; facts: [PictoName, string][] }> = {
  rohbau: {
    text: 'Rohbauten in Beton- und Stahlbetonbauweise für Wohnanlagen, Büro- und Geschäftshäuser sowie Lagergebäude. Mit eigener Mannschaft, vom Fundament bis zur letzten Decke.',
    facts: [
      ['rohbau', 'Fundamente und Bodenplatten'],
      ['gebaeude', 'Tiefgaragen und Untergeschosse'],
      ['bewehrung', 'Wände und Decken in Ortbeton'],
    ],
  },
  'schluesselfertiges-bauen': {
    text: 'Den Rohbau führen wir selbst aus, alle weiteren Gewerke koordinieren wir. Sie haben einen festen Ansprechpartner, der Termine, Qualität und Kosten im Blick behält.',
    facts: [
      ['helm', 'Rohbau in eigener Ausführung'],
      ['kalender', 'Termine und Gewerke im Griff'],
      ['schluessel', 'Übergabe aus einer Hand'],
    ],
  },
  'umbau-sanierung': {
    text: 'Umbauten, Erweiterungen und Sanierungen, von der Stadtvilla bis zum historischen Gebäude. Wir schauen genau hin, bevor wir loslegen, und arbeiten sauber bis zum Schluss.',
    facts: [
      ['umbau', 'Umbau und Erweiterung'],
      ['hammer', 'Sanierung im Bestand'],
      ['siegel', 'Sorgfalt bis ins Detail'],
    ],
  },
};
const services = await Promise.all(
  leistungen.map(async (l) => {
    const info = svcInfo[l.slug]!;
    // gleiche Bilder wie auf der Leistungsübersicht (src/data/leistung-bilder.ts)
    const img = await leistungBild(l.slug, 'start');
    return { ...l, ...info, img };
  }),
);

/* Drei Projekte zum Durchscrollen */
const fakt = (fakten: { label: string; value: string }[], label: string) => fakten.find((f) => f.label === label)?.value;
const showcase = await Promise.all(
  ['hanseforum', 'prime-selfstorage-harburg', 'bellevue-50'].map(async (id) => {
    const p = (await getEntry('projekte', id))!;
    const adresse = fakt(p.data.fakten, 'Adresse')?.split('\n') ?? [];
    return { id, ...p.data, strasse: adresse[0] ?? '', ort: (adresse[1] ?? '').replace(/^\d{5}\s*/, '') };
  }),
);



/* Zahlen: drei Stufen, die nach rechts ansteigen */
const zahlen = [
  { n: GRUENDUNGSJAHR, from: 1960, plus: false, l: 'Gegründet in Hamburg', t: 'Bis heute inhabergeführt.' },
  { n: firma.projekteAnzahl, from: 0, plus: true, l: 'Projekte realisiert', t: 'Vom Einfamilienhaus bis zum Bürogebäude.' },
  { n: null, txt: 'HH', from: 0, plus: false, l: 'Hamburg und Umgebung', t: 'Kurze Wege zu jeder Baustelle.' },
];

const werte = [
  {
    icon: 'familie',
    t: 'Persönlich',
    d: 'Sie sprechen direkt mit denen, die entscheiden.',
  },
  {
    icon: 'dialog',
    t: 'Verbindlich',
    d: 'Klare Absprachen, feste Termine.',
  },
  {
    icon: 'hammer',
    t: 'Sorgfältig',
    d: 'Bis zum Schluss. Bis ins Detail.',
  },
] as const;
---

<Base title={title} noindex={noindex} typo={typo}>
  <!-- Blaue Linie: startet an der Spitze des Hero und endet in der Film-Raute -->
  <svg class="flow" data-flow aria-hidden="true">
    <path data-flow-path></path>
    <g data-flow-branches></g>
    <g data-flow-svc></g>
  </svg>

  <!-- ======================= HERO ======================= -->
  <section class="hero" data-hero>
    <div class="hero-media">
      <video class="hero-video" autoplay muted loop playsinline preload="auto" poster={heroPosterImg.src} data-autoplay aria-hidden="true">
        <source src={url('/video/hero-540.mp4')} type="video/mp4" media="(max-width: 767px)" />
        <source src={url('/video/hero-1080.mp4')} type="video/mp4" />
      </video>
      <div class="hero-slab" aria-hidden="true"></div>
    </div>
    <div class="hero-cut" aria-hidden="true"></div>
    <div class="container hero-content">
      <h1 class="hero-title">Was wir<br />zusagen,<br /><span class="lt">steht.</span></h1>
      <a class="pill light" href={url('/referenzen/')}><span>Referenzen ansehen</span><Icon name="arrow" /></a>
    </div>
  </section>

  <!-- ======================= EINSTIEG ======================= -->
  <section class="intro" data-intro>
    <div class="container intro-grid">
      <div class="intro-text">
        <h2 class="intro-h">Wir lieben<br /><span class="lt">Beton.</span></h2>
        <p class="intro-p">
          Schalen, bewehren, betonieren: Seit {GRUENDUNGSJAHR} ist der Rohbau unser Handwerk. Als Familienbetrieb aus Hamburg bauen wir mit eigener
          Mannschaft Wohnhäuser, Büros und Hallen. Und wir freuen uns jedes Mal, wenn aus einem Plan ein Gebäude wird.
        </p>
      </div>
      <div class="intro-visual">
        <div class="intro-img">
          <Image src={handwerkFoto} alt="Schalung mit Quirling-Logo und Bewehrung auf einer Baustelle" widths={[700, 1100, 1600]} sizes="(min-width: 900px) 50vw, 100vw" />
        </div>
        <!-- Knopf liegt halb über dem Bild -->
        <a class="intro-btn" href={url('/unternehmen/')}>
          <span>Kennste<br />uns schon?</span>
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <!-- ======================= LEISTUNGEN: Übersicht (eigene blaue Fläche) ======================= -->
  <section class="overview" id="leistungen" aria-labelledby="svc-h">
    <div class="container ov-in">
      <div class="ov-top">
        <h2 id="svc-h" class="svc-head" data-follow data-svc-head>Was wir <span class="lt">bauen.</span></h2>
        <p class="ov-p">
          Vom ersten Spatenstich bis zur Schlüsselübergabe: Wir übernehmen den Rohbau in Beton und Stahlbeton, bauen auf Wunsch schlüsselfertig und
          bringen Bestandsgebäude wieder in Form. Immer mit eigener Mannschaft und einem festen Ansprechpartner.
        </p>
      </div>
      <!-- nur Stichworte, die Linie zeigt mit Pfeilen von unten hinein -->
      <div class="ov">
        {
          leistungen.map((l) => (
            <a class="ov-col" href={url(`/leistungen/${l.slug}/`)} data-line-up>
              <h3 class="ov-t" set:html={l.title} />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================= LEISTUNGEN: einzeln ======================= -->
  <section class="services">
    {
      services.map((s, i) => (
        <article class:list={['svc', `svc-${i + 1}`]} data-svc>
          <div class="container svc-grid">
            <a class="svc-visual" href={url(`/leistungen/${s.slug}/`)} tabindex="-1" aria-hidden="true">
              <span class="cut-img svc-img">
                <Image src={s.img} alt="" widths={[600, 1000, 1400]} sizes="(min-width: 900px) 50vw, 100vw" />
              </span>
            </a>
            <div class="svc-text">
              <h3 class="svc-title">{s.title}</h3>
              <p>{s.text}</p>
              <ul class="svc-facts">
                {s.facts.map(([icon, t]) => (
                  <li>
                    <Picto name={icon} class="svc-ico" />
                    <span>{t}</span>
                  </li>
                ))}
              </ul>
              <a class="svc-more" href={url(`/leistungen/${s.slug}/`)} data-follow data-line-link>
                <span>Mal genauer hingucken</span>
                <Icon name="arrow" />
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <!-- ======================= WERTE ======================= -->
  <section class="values on-blue" data-values>
    <span class="rail rail-values" aria-hidden="true"><span data-values-bar></span></span>
    <div class="container values-grid">
      <div class="values-head">
        <h2 class="values-h">Familien&shy;betrieb.</h2>
        <p class="values-core">Hinter jedem Bauvorhaben steht die Familie Quirling. Mit Namen und Handschlag.</p>
      </div>
      <ul class="values-list">
        {
          werte.map((w) => (
            <li class="value" data-follow data-to-rail>
              <div class="value-text">
                <h3>{w.t}</h3>
                <p>{w.d}</p>
              </div>
              <ValueIcon name={w.icon} class="value-icon" frame={false} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ======================= KENNZAHLEN / ÜBER UNS ======================= -->
  <section class="figs" data-figs-sec aria-labelledby="figs-h">
    <!-- Foto randlos von Kante zu Kante, Knopf liegt auf dem Knick -->
    <div class="figs-photo">
      <span class="figs-img" data-figs-img>
        <Image src={historisch} alt="Historisches Foto einer Baumannschaft auf einem Gerüst" widths={[800, 1200, 1600]} sizes="(min-width: 900px) 52vw, 100vw" />
      </span>
      <a class="intro-btn figs-btn" href={url('/unternehmen/')}>
        <span>Wer steckt<br />dahinter?</span>
        <Icon name="arrow" />
      </a>
    </div>
    <div class="container figs-in">
      <div class="figs-side">
        <h2 id="figs-h" class="figs-h">Gebaut auf<br /><span class="lt">Erfahrung.</span></h2>
        <p class="figs-p">Von Thomas Quirling gegründet und bis heute inhabergeführt. Was damals mit einer kleinen Mannschaft begann, ist heute ein fester Name im Hamburger Rohbau.</p>
        <div class="figs-steps">
          {
            zahlen.map((z, i) => (
              <div class:list={['fg-par', `fg-par-${i + 1}`]} data-par={String(i + 1)}>
                <div class="fg" data-follow>
                  <strong>
                    {z.n !== null ? <span data-num={z.n} data-num-from={z.from}>{z.n}</span> : z.txt}
                    {z.plus && <sup>+</sup>}
                  </strong>
                  <span class="fg-l">{z.l}</span>
                  <p>{z.t}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= PROJEKTE (3 × scrollen) ======================= -->
  <section class="show" data-show aria-labelledby="show-h">
    <div class="show-in">
      <div class="show-text">
        <h2 id="show-h" class="show-h">Projekte,<br /><span class="lt">die stehen.</span></h2>
        <div class="show-items">
          {
            showcase.map((p, i) => (
              <div class:list={['show-item', { 'is-active': i === 0 }]} data-show-item>
                <h3 class="show-title">{p.title}</h3>
                <p class="show-desc">
                  {p.leistung}
                  <span class="show-meta">{p.ort}</span>
                </p>
              </div>
            ))
          }
        </div>
        <a class="svc-more show-all" href={url('/referenzen/')}><span>Alle Projekte angucken</span><Icon name="arrow" /></a>
      </div>
      <div class="show-stage">
        {
          showcase.map((p, i) => (
            <a class="show-img" href={url(`/referenzen/?p=${p.id}`)} data-show-img tabindex="-1" style={`z-index:${i + 1}`}>
              <Image src={p.bilder[0]!} alt={`${p.title}: ${p.leistung}`} widths={[900, 1400, 2000]} sizes="(min-width: 900px) 62vw, 100vw" />
              <span class="show-cap">
                <strong>{p.title}</strong>
                {p.kategorien[0]} · {p.ort}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================= FILM (Raute) ======================= -->
  <section class="film" data-film>
    <div class="film-sticky">
      <div class="film-frame" data-film-frame>
        <video autoplay muted loop playsinline preload="none" poster={filmPosterImg.src} data-autoplay aria-hidden="true">
          <source src={url('/video/film-loop.mp4')} type="video/mp4" />
        </video>
      </div>
      <!-- Bildmarke: die graue Raute des Logos wird zum Fenster für das Video -->
      <svg class="film-logo" data-film-logo viewBox="120 62 354.5 247" aria-hidden="true">
        {mark.map((m, i) => (i === 0 ? <path class="fl-raute" fill="#868484" d={m.d} /> : null))}
        <g class="fl-q" data-film-q>
          {mark.slice(1).map((m) => <path fill={m.role === 'white' ? '#ffffff' : m.role === 'grey' ? '#868484' : '#3948A4'} d={m.d} />)}
        </g>
      </svg>
      <div class="film-ui" data-film-ui>
        <h2 class="h-display">Quirling<br /><span class="lt">von oben.</span></h2>
      </div>
    </div>
  </section>

  <!-- ======================= MIT ANPACKEN: zwischen Video und Footer ======================= -->
  <div class="join">
    <div class="join-pos">
      <a class="ja" href={url('/karriere/')} data-follow>
        <span class="ja-l">Werde Teil des Teams</span>
        <span class="ja-h"><QHammer class="ja-hammer" color="#121735" highlight="#3948A4" />Mit anpacken</span>
        <span class="ja-btn">Zur Karriere <Icon name="arrow" /></span>
      </a>
    </div>
  </div>
</Base>

<style>
  /* ---------- Bausteine ---------- */
  /* Navy-Parallelogramm hinter dem Bild: neigt sich wie das Bild,
     steht nur leicht über (überall gleich, links hinter dem Bild) */
  .block {
    position: absolute;
    width: 40%;
    background: var(--navy);
    pointer-events: none;
    clip-path: polygon(0 0, 60% 0, 100% 100%, 12% 100%);
  }
  .block-l {
    left: -8%;
    top: 12%;
    bottom: -7%;
  }
  .block-r {
    right: -7%;
    top: -5%;
    bottom: -6%;
    clip-path: polygon(40% 0, 100% 0, 88% 100%, 0 100%);
  }
  .cut-img {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--stone-200);
  }
  .cut-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Linie ---------- */
  :global(main) {
    position: relative;
  }
  .flow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }
  .flow :global(path) {
    fill: none;
    stroke: var(--blue);
    stroke-width: 1.5;
  }


  /* ======================= HERO ======================= */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    color: #fff;
    z-index: 2;
    /* Unterkante deutet eine Raute an, Spitze rechts */
    --hero-cut: polygon(0 90%, 78% 100%, 100% 94%, 100% 101%, 0 101%);
  }
  /* Das Video selbst wird bewusst NICHT zugeschnitten: Chrome zeichnet zugeschnittene
     Video-Ebenen beim Hoch- und Runterscrollen teils unvollständig. Die schräge Unterkante
     entsteht durch eine Fläche in Seitenfarbe, die über dem unteren Videorand liegt. */
  .hero-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--navy);
  }
  .hero-cut {
    position: absolute;
    inset: 0;
    background: var(--stone-50);
    clip-path: var(--hero-cut);
    pointer-events: none;
  }
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-slab {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--content-left) + min(58vw, 1000px));
    background: rgb(18 23 53 / 0.82);
    clip-path: polygon(0 0, 100% 0, 66% 100%, 0 100%);
  }
  .hero-content {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-top: var(--header-h);
    padding-bottom: 4rem;
  }
  .hero-title {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.4rem, 4.6vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    margin-bottom: 2.6rem;
    /* bleibt mit Abstand innerhalb der schrägen blauen Fläche */
    max-width: min(42vw, 660px);
    white-space: nowrap;
  }

  /* ======================= EINSTIEG ======================= */
  .intro {
    position: relative;
    overflow-x: clip;
    padding-block: clamp(3.5rem, 6vw, 5rem) clamp(4rem, 7vw, 6rem);
  }
  .intro-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  .intro-text {
    grid-column: 1 / 7;
    display: grid;
    gap: clamp(1.6rem, 3vw, 2.4rem);
    align-content: start;
  }
  .intro-h {
    font-family: var(--font-head);
    text-transform: uppercase;
    color: var(--blue);
    margin: 0;
  }
  .intro-h .lt {
    font-weight: 300;
  }
  .intro-p {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(1.1rem, 1.3vw, 1.25rem);
    line-height: 1.65;
    font-weight: 300;
    color: var(--ink);
  }
  /* Bild randlos bis an den rechten Rand, Innenkante mit Knick */
  /* Desktop: Bild liegt hinter dem Raster und schließt oben an die Hero-Kante und unten an die
     Kante der Leistungsübersicht an. Die genaue Form setzt das Skript (fitIntro). */
  .intro-visual {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 53%;
    right: 0;
    z-index: 3;
  }
  .intro-img {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: polygon(14% 0, 100% 0, 100% 100%, 8% 100%, 0 58%);
  }
  .intro-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Knopf liegt halb auf der Bildkante */
  /* sitzt genau auf dem Knick der Bildkante (Lage setzt fitIntro) */
  .intro-btn {
    position: absolute;
    left: var(--kx, 0px);
    top: var(--ky, 58%);
    transform: translate(-30%, -50%);
    display: inline-flex;
    align-items: flex-end;
    gap: 1.2rem;
    padding: 1.3rem 1.5rem 1.2rem;
    line-height: 0.95;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.4rem, 1.9vw, 1.85rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 0 20px 40px -20px rgb(18 23 53 / 0.6);
    z-index: 2;
    transition: background 0.25s ease;
  }
  .intro-btn :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    transition: transform 0.35s var(--ease);
  }
  .intro-btn:hover {
    background: var(--blue);
  }
  .intro-btn:hover :global(svg) {
    transform: translateX(4px);
  }

  /* ======================= KENNZAHLEN / ÜBER UNS ======================= */
  .figs {
    position: relative;
    overflow-x: clip;
    padding-block: clamp(4.5rem, 7vw, 6.5rem);
  }
  .figs-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
  }
  /* Foto füllt die linke Hälfte von Ober- bis Unterkante, Innenkante mit Knick nach rechts */
  .figs-photo {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 50%;
    z-index: 2;
  }
  .figs-img {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: polygon(0 0, 86% 0, 100% 52%, 90% 100%, 0 100%);
    background: var(--stone-200);
  }
  .figs-img :global(img) {
    width: 100%;
    height: 112%;
    object-fit: cover;
    object-position: 50% 40%;
  }
  .figs-btn {
    left: 100%;
    top: 52%;
    transform: translate(-72%, -50%);
  }
  .figs-side {
    grid-column: 7 / 13;
    padding-left: clamp(1rem, 3vw, 3rem);
    display: grid;
    gap: clamp(1.2rem, 2vw, 1.6rem);
    justify-items: start;
  }
  .figs-h {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 4.6vw, 4.8rem);
    line-height: 0.92;
    color: var(--blue);
    margin: 0;
  }
  .figs-h .lt {
    font-weight: 300;
  }
  .figs-p {
    margin: 0;
    max-width: 30rem;
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.65;
    color: var(--ink-2);
  }
  /* drei Zahlen als Treppe, die nach rechts ansteigt; jede Stufe mit eigener Linie */
  .figs-steps {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: end;
    gap: clamp(1rem, 2vw, 2rem);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .fg-par-1 {
    margin-bottom: 0;
  }
  .fg-par-2 {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .fg-par-3 {
    margin-bottom: clamp(4rem, 8vw, 7rem);
  }
  .fg {
    position: relative;
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-top: 1rem;
  }
  .fg::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.9s var(--ease) 0.2s;
  }
  .fg.is-in::before {
    transform: scaleX(1);
  }
  .fg strong {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(3rem, 5vw, 5.2rem);
    line-height: 0.88;
    color: var(--blue);
    font-variant-numeric: tabular-nums;
  }
  .fg strong :global(sup) {
    font-size: 0.45em;
    vertical-align: top;
    margin-left: 0.05em;
  }
  .fg-l {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--blue);
  }
  .fg p {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--ink-2);
  }
  /* Einblenden, sobald die Linie die Stelle erreicht */
  [data-follow] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.9s ease,
      transform 0.9s var(--ease);
  }
  [data-follow].is-in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-follow] {
      opacity: 1;
      transform: none;
    }
  }
  /* ======================= LEISTUNGEN ======================= */
  /* Übersicht: abgegrenzte blaue Fläche, Oberkante als angedeutete Raute */
  .overview {
    position: relative;
    background: #e6e9f6;
    padding-block: clamp(6rem, 10vw, 8.5rem) clamp(6rem, 9vw, 8rem);
    /* Ober- und Unterkante mit Knick wie die angedeutete Raute */
    clip-path: polygon(
      0 0,
      78% clamp(2rem, 4vw, 3.5rem),
      100% clamp(0.8rem, 1.6vw, 1.4rem),
      100% calc(100% - clamp(2rem, 4vw, 3.5rem)),
      22% 100%,
      0 calc(100% - clamp(0.8rem, 1.6vw, 1.4rem))
    );
  }
  .ov-top {
    display: grid;
    gap: clamp(1.4rem, 2.5vw, 2rem);
    max-width: 44rem;
  }
  .ov-top .svc-head {
    margin: 0;
    padding: 0;
  }
  .ov-p {
    margin: 0;
    font-size: clamp(1.1rem, 1.3vw, 1.25rem);
    font-weight: 300;
    line-height: 1.65;
    color: var(--ink);
  }
  .services {
    position: relative;
    overflow-x: clip;
    padding-block: clamp(4rem, 7vw, 6rem);
  }
  .svc-head {
    position: relative;
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 6vw, 6.2rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--blue);
    padding-bottom: clamp(1rem, 2vw, 1.6rem);
    margin-bottom: clamp(1rem, 3vw, 2rem);
  }
  /* wird von links nach rechts aufgedeckt, während die Linie darunter entlangläuft */
  .svc-head[data-follow] {
    opacity: 1;
    transform: none;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1.3s cubic-bezier(0.45, 0, 0.2, 1);
  }
  .svc-head[data-follow].is-in {
    clip-path: inset(0 -2% 0 0);
  }
  /* erst als Kontur aufgedeckt, dann füllt sich die Schrift von links nach rechts */
  @media (prefers-reduced-motion: no-preference) {
    .svc-head[data-follow] {
      color: transparent;
      -webkit-text-stroke: 1.5px var(--blue);
      background-image: linear-gradient(90deg, var(--blue) 0 50%, transparent 50% 100%);
      background-size: 200% 100%;
      background-position: 100% 0;
      -webkit-background-clip: text;
      background-clip: text;
      transition:
        clip-path 1.3s cubic-bezier(0.45, 0, 0.2, 1),
        background-position 1.5s cubic-bezier(0.6, 0, 0.2, 1) 1.1s;
    }
    .svc-head[data-follow].is-in {
      background-position: 0 0;
    }
  }
  /* Stichworte: drei Spalten, die Linie läuft darunter und zeigt mit Pfeilen von unten hinein */
  .ov {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
    margin-top: clamp(3.5rem, 6vw, 5rem);
    padding-bottom: clamp(4rem, 6vw, 5rem);
  }
  .ov-col {
    display: grid;
    gap: 0.7rem;
    align-content: start;
    justify-items: start;
    color: inherit;
    text-decoration: none;
  }
  .ov-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.45rem, 2vw, 2.1rem);
    line-height: 1;
    color: var(--blue);
    margin: 0;
    hyphens: manual;
  }
  .ov-col:hover .ov-t {
    color: var(--navy);
  }

  /* Leistungen einzeln: Bilder abwechselnd links / rechts, bis an den Bildschirmrand */
  .svc {
    padding-block: clamp(2rem, 3.5vw, 3rem);
  }
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    /* breite Fuge: hier läuft die Linie zwischen Bild und Text */
    column-gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  /* Bilder rechts, links, rechts; jeweils randlos bis an den Bildschirmrand */
  .svc-1 .svc-visual,
  .svc-3 .svc-visual {
    grid-column: 9 / 13;
    grid-row: 1;
    margin-right: calc(-1 * var(--content-left));
  }
  .svc-1 .svc-text,
  .svc-3 .svc-text {
    grid-column: 1 / 9;
    grid-row: 1;
  }
  .svc-2 .svc-visual {
    grid-column: 1 / 5;
    margin-left: calc(-1 * var(--content-left));
  }
  .svc-2 .svc-text {
    grid-column: 5 / 13;
  }
  /* Link immer außen, damit die Linie lang über die Zeile läuft */
  @media (min-width: 901px) {
    .svc-2 .svc-more {
      display: flex;
      width: fit-content;
      margin-left: auto;
    }
  }
  .svc-visual {
    position: relative;
    z-index: 2;
    display: block;
  }

  .svc-img {
    position: relative;
    aspect-ratio: 5 / 6;
    /* Bild rechts: Innenkante links mit Knick, Unterkante steigt leicht an */
    clip-path: polygon(14% 0, 100% 0, 100% 93%, 8% 100%, 0 58%);
  }
  .svc-2 .svc-img {
    /* Bild links: gespiegelt */
    clip-path: polygon(0 0, 86% 0, 100% 58%, 92% 100%, 0 93%);
  }
  .svc-img :global(img) {
    transition: transform 1.2s var(--ease);
  }
  .svc-visual:hover .svc-img :global(img) {
    transform: scale(1.03);
  }
  .svc-title {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(1.8rem, 2.6vw, 2.7rem);
    line-height: 0.98;
    text-transform: uppercase;
    overflow-wrap: normal;
    color: var(--blue);
    margin-bottom: 1.2rem;
    hyphens: manual;
  }
  /* Links als eigenständige Schaltflächen: kräftig, groß, mit Unterstrich */
  .svc-more {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 0.8rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.2rem, 1.5vw, 1.45rem);
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--blue);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .svc-more :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    transition: transform 0.35s var(--ease);
  }
  .svc-more:hover :global(svg) {
    transform: translateX(5px);
  }
  .svc-more:hover {
    color: var(--navy);
  }
  /* auf dem Desktop übernimmt die Linie den Pfeil */
  @media (min-width: 901px) {
    .svc-more :global(svg) {
      display: none;
    }
  }
  .svc-more[data-follow] {
    transform: translateX(14px);
    transition:
      opacity 0.5s ease 0.35s,
      transform 0.6s var(--ease) 0.35s;
  }
  .svc-more[data-follow].is-in {
    transform: none;
  }
  .svc-text p {
    color: var(--ink-2);
    max-width: 52ch;
    margin: 0 0 1.8rem;
  }
  .svc-facts {
    list-style: none;
    margin: 0 0 2.6rem;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem 1.8rem;
  }
  /* Icon neben dem Text, Text zurückhaltend */
  .svc-facts li {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 0.75rem;
    align-items: center;
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .svc-facts :global(.svc-ico) {
    width: 34px;
    height: 34px;
    color: var(--blue);
  }

  /* ======================= PROJEKTE ======================= */
  .show {
    position: relative;
    z-index: 2;
    background: var(--navy);
    color: #fff;
  }
  .show-in {
    display: grid;
    grid-template-columns: calc(var(--content-left) + clamp(330px, 30vw, 540px)) 1fr;
    height: 100vh;
    min-height: 640px;
  }
  .show-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: calc(var(--header-h) + 1rem) clamp(2rem, 4vw, 4rem) 3rem var(--content-left);
  }
  .show-h {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.1rem, 3.3vw, 3.6rem);
    line-height: 0.95;
    white-space: nowrap;
    overflow-wrap: normal;
    hyphens: manual;
    color: #9aa6ee;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .show-items {
    display: grid;
    margin-bottom: 2.5rem;
  }
  .show-item {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s ease,
      visibility 0s 0.5s;
  }
  .show-item.is-active {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .show-title {
    font-stretch: 125%;
    font-weight: 700;
    font-size: clamp(1.3rem, 1.8vw, 1.65rem);
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 0.7rem;
  }
  .show-desc {
    color: rgb(255 255 255 / 0.72);
    font-size: 0.9rem;
    max-width: 24rem;
    margin-bottom: 1.4rem;
  }
  .show-meta {
    display: block;
    margin-top: 0.3rem;
    color: #9aa6ee;
  }
  .show .show-all {
    align-self: flex-start;
    color: #fff;
  }
  .show .show-all:hover {
    color: #c9d0f5;
  }
  .show .show-all :global(svg) {
    display: inline;
  }
  .show-stage {
    position: relative;
    overflow: hidden;
    clip-path: polygon(14% 0, 100% 0, 100% 100%, 0 100%);
  }
  .show-img {
    position: absolute;
    inset: 0;
    display: block;
  }
  .show-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .show-cap {
    display: none;
  }
  /* Linie am Rand: nimmt die Hauptlinie in den farbigen Flächen auf (gleiche Stärke) */
  .rail {
    position: absolute;
    top: 0;
    bottom: 0;
    right: var(--rail-r, 34px);
    width: 1.5px;
    background: rgb(255 255 255 / 0.2);
    z-index: 20;
    pointer-events: none;
  }
  .rail span {
    position: absolute;
    inset: 0;
    background: #fff;
    transform: scaleY(0);
    transform-origin: top;
  }
  /* ======================= WERTE ======================= */
  .values {
    position: relative;
    z-index: 2;
    /* überlappt die Projekt-Sektion minimal: keine helle Haarlinie durch Subpixel-Rundung */
    margin-top: -2px;
    padding-block: clamp(5rem, 9vw, 8rem) clamp(6rem, 10vw, 9rem);
  }
  .values-grid {
    display: grid;
    /* minmax(0, …): die Spalten dürfen nie über das Raster hinauswachsen */
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(3rem, 8vw, 9rem);
    align-items: center;
  }
  .values-h {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 5.2vw, 5.4rem);
    line-height: 0.95;
    hyphens: manual;
    margin-bottom: 1.6rem;
  }
  .values-core {
    font-family: var(--font-head);
    font-stretch: 112%;
    font-weight: 300;
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    line-height: 1.4;
    max-width: 24rem;
    color: #fff !important;
    margin: 0;
  }
  .values-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2.4rem, 4.4vw, 3.8rem);
  }
  .value {
    --icon-gap: clamp(4rem, 11vw, 11rem);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    padding-right: var(--icon-gap);
    text-align: right;
  }
  /* Abzweig: von der Randlinie zum Piktogramm */
  .value::after {
    content: '';
    position: absolute;
    top: 50%;
    /* Lage und Länge werden per Skript gemessen: vom Piktogramm bis exakt zur Linie */
    left: var(--branch-left, 100%);
    width: var(--branch-w, 0px);
    height: 1.5px;
    background: rgb(255 255 255 / 0.7);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.6s var(--ease);
  }
  .value.is-in::after {
    transform: scaleX(1);
  }
  .values[data-values] .value[data-follow] {
    opacity: 1;
    transform: none;
  }
  .value-text {
    min-width: 0;
    overflow-wrap: break-word;
    opacity: 0;
    transition: opacity 0.6s ease 0.9s;
  }
  .value.is-in .value-text {
    opacity: 1;
  }
  .value :global(.value-icon) {
    flex: none;
    color: #fff;
    --vicon-bg: #3948a4;
  }
  .value :global(.vicon-art) {
    width: 62px;
    height: 62px;
  }
  /* Piktogramm zeichnet sich, wenn der Abzweig ankommt */
  .value :global(.vicon-art path) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.2s ease 0.5s;
  }
  .value.is-in :global(.vicon-art path) {
    stroke-dashoffset: 0;
  }
  .value :global(.vicon-hammer) {
    width: 56px;
    height: 56px;
    clip-path: inset(0 0 0 100%);
    transition: clip-path 1s ease 0.5s;
  }
  .value.is-in :global(.vicon-hammer) {
    clip-path: inset(0 0 0 0);
  }
  @media (prefers-reduced-motion: reduce) {
    .value-text {
      opacity: 1;
    }
    .value :global(.vicon-art path) {
      stroke-dashoffset: 0;
    }
    .value :global(.vicon-hammer) {
      clip-path: none;
    }
  }
  .value h3 {
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(1.6rem, 2.6vw, 2.5rem);
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: 0.45rem;
  }
  .value p {
    font-size: 1.02rem;
    color: rgb(255 255 255 / 0.82);
    margin: 0;
  }

  /* ======================= MIT ANPACKEN ======================= */
  /* liegt auf der Kante zwischen Video und Footer, halb im Bild, halb im Footer */
  .join {
    position: relative;
    z-index: 6;
    height: 0;
    overflow-x: clip;
    overflow-y: visible;
  }
  .join-pos {
    position: absolute;
    right: calc(var(--content-left) + 6%);
    top: 0;
    transform: translateY(-50%);
  }
  .ja-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.2rem 0.8rem;
    background: var(--blue);
    color: #fff;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
    transition: background 0.25s ease;
  }
  .ja-btn :global(svg) {
    width: 1.1em;
    height: 1.1em;
    transition: transform 0.35s var(--ease);
  }
  .ja:hover .ja-btn {
    background: #2b3889;
  }
  .ja:hover .ja-btn :global(svg) {
    transform: translateX(4px);
  }

  /* --- A: hellblaue Fläche mit Knick-Unterkante, Knopf hängt halb heraus --- */
  .ja {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 0.6rem;
    padding: clamp(1.4rem, 2.4vw, 2rem) clamp(1.6rem, 2.8vw, 2.4rem) clamp(2.8rem, 4vw, 3.4rem);
    color: var(--navy);
    text-decoration: none;
    filter: drop-shadow(0 22px 30px rgb(18 23 53 / 0.35));
  }
  .ja::before {
    content: '';
    position: absolute;
    inset: 0;
    background: #9aa6ee;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 1.6rem), 64% 100%, 0 calc(100% - 0.6rem));
    z-index: -1;
  }
  .ja-l {
    font-family: var(--font-mono);
    font-size: clamp(0.78rem, 1vw, 0.9rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ja-h {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.2rem, 4.4vw, 4.2rem);
    line-height: 0.92;
  }
  .ja-h :global(.ja-hammer) {
    width: 1em;
    height: 1em;
  }
  .ja-btn {
    position: absolute;
    left: clamp(1.6rem, 2.8vw, 2.4rem);
    bottom: 0;
    transform: translateY(50%);
  }
  .ja[data-follow] {
    transform: rotate(-3deg) scale(1.3);
    transition:
      opacity 0.35s ease,
      transform 0.55s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .ja[data-follow].is-in {
    transform: rotate(-3deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .ja[data-follow],
    .ja[data-follow].is-in {
      transform: rotate(-3deg);
    }
  }
  /* ======================= FILM ======================= */
  .film {
    position: relative;
    height: 260vh;
    background: var(--navy);
    margin-top: -1px;
  }
  .film-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: grid;
    place-items: center;
    z-index: 2;
  }
  /* Startform = Raute des Logos (Punkte aus der Bildmarke, Breite 34 vw, mittig); das Skript rechnet sie exakt nach */
  .film-frame {
    position: absolute;
    inset: 0;
    background: var(--navy);
    clip-path: polygon(33% 50%, 50.4% 30%, 67.8% 51.5%, 49.8% 70.5%);
  }
  .film-logo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(34vw, 62vh);
    height: auto;
    translate: -50% -50%;
    z-index: 3;
    overflow: visible;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .film-logo {
      display: none;
    }
    .film-frame {
      clip-path: none;
    }
  }
  .fl-q {
    transform-box: view-box;
    transform-origin: 297px 185px;
  }
  /* Linienende im stehenden Bereich: läuft von oben genau in die Rautenspitze */
  .film-feed {
    position: absolute;
    left: calc(50% - 0.75px);
    top: 40px;
    width: 1.5px;
    height: calc(22% - 40px);
    background: var(--blue);
    z-index: 3;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .film-feed.is-on {
    opacity: 1;
  }
  .film-frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(18 23 53 / 0.35);
  }
  .film-ui {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    padding-inline: var(--gutter);
  }

  /* ======================= TYPOGRAFIE-ENTWURF B ======================= */
  :global(html.typo-b) .hero-title {
    font-weight: 900;
    font-size: clamp(2.6rem, 5.2vw, 5.4rem);
    line-height: 0.9;
    letter-spacing: -0.025em;
  }
