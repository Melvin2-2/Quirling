</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- Hero: Navy-Schräge wandert beim Scrollen nach rechts und deckt das Video zu ---------- */
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const slab = hero?.querySelector<HTMLElement>('.hero-slab');
    if (!hero || !slab) return;
    const desktop = window.matchMedia('(min-width: 901px)').matches;
    const trigger = { trigger: hero, start: 'top top', end: 'bottom top', scrub: true };
    if (desktop) {
      // Breite so weit, dass auch die schräge Unterkante (66 %) den rechten Rand überdeckt
      gsap.fromTo(
        slab,
        { width: () => getComputedStyle(slab).width, backgroundColor: 'rgba(18, 23, 53, 0.82)' },
        { width: () => `${window.innerWidth * 1.6}px`, backgroundColor: 'rgba(18, 23, 53, 1)', ease: 'none', scrollTrigger: trigger },
      );
    } else {
      gsap.fromTo(
        slab,
        { clipPath: 'polygon(0 0, 100% 0, 100% 62%, 0 88%)', backgroundColor: 'rgba(18, 23, 53, 0.82)' },
        { clipPath: 'polygon(0 0, 100% 0, 100% 110%, 0 110%)', backgroundColor: 'rgba(18, 23, 53, 1)', ease: 'none', scrollTrigger: trigger },
      );
    }
  });

  /* ---------- Projekte: 3 große Bilder, 3 × scrollen (Desktop) ---------- */
  mm.add('(prefers-reduced-motion: no-preference) and (min-width: 901px)', () => {
    const show = document.querySelector<HTMLElement>('[data-show]');
    if (!show) return;
    const imgs = Array.from(show.querySelectorAll<HTMLElement>('[data-show-img]'));
    const items = Array.from(show.querySelectorAll<HTMLElement>('[data-show-item]'));
    // -1: noch kein Titel sichtbar; der erste klappt herein, sobald der Abschnitt ankommt
    let active = -1;
    items.forEach((it) => it.classList.remove('is-active'));
    const setActive = (i: number) => {
      if (i === active) return;
      const prev = active >= 0 ? items[active] : undefined;
      active = i;
      items.forEach((it, j) => {
        it.classList.toggle('is-active', j === i);
        it.classList.toggle('is-out', it === prev);
      });
      // nach dem Wegklappen wieder in die Ausgangslage, damit das Blatt beim nächsten Mal von oben kommt
      window.setTimeout(() => prev?.classList.remove('is-out'), 380);
    };
    const arrive = ScrollTrigger.create({
      trigger: show,
      start: 'top 18%',
      onEnter: () => setActive(0),
      onLeaveBack: () => setActive(-1),
    });
    imgs.forEach((img, i) => i > 0 && gsap.set(img, { clipPath: 'inset(100% 0% 0% 0%)' }));
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: show,
        start: 'top top',
        end: 'bottom bottom',
        scrub: 0.5,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          // der Titel wechselt, wenn das nächste Bild gut zur Hälfte aufgedeckt ist
          if (active < 0) return;
          setActive(Math.min(imgs.length - 1, Math.floor(self.progress * (imgs.length - 1) + 0.4)));
        },
      },
    });
    imgs.slice(1).forEach((img, i) => {
      tl.to(img, { clipPath: 'inset(0% 0% 0% 0%)', ease: 'none', duration: 1 });
      const inner = img.querySelector('img');
      if (inner) tl.fromTo(inner, { scale: 1.12 }, { scale: 1, ease: 'none', duration: 1 }, '<');
      if (i < imgs.length - 2) tl.to({}, { duration: 0.05 });
    });
    tl.to({}, { duration: 0.06 });
    return () => {
      arrive.kill();
      items.forEach((it, j) => it.classList.toggle('is-active', j === 0));
    };
  });

  /* ---------- Leistungen: Hintergrund blendet weich ein und aus ---------- */
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const bg = document.querySelector<HTMLElement>('[data-svc-bg]');
    const sec = document.querySelector<HTMLElement>('[data-services]');
    if (!bg || !sec) return;
    gsap.fromTo(bg, { opacity: 0 }, { opacity: 1, ease: 'none', scrollTrigger: { trigger: sec, start: 'top 95%', end: 'top 30%', scrub: true } });
    gsap.fromTo(bg, { opacity: 1 }, { opacity: 0, ease: 'none', immediateRender: false, scrollTrigger: { trigger: sec, start: 'bottom 75%', end: 'bottom 10%', scrub: true } });
    gsap.fromTo(bg, { backgroundPosition: '0px 0px' }, { backgroundPosition: '0px -140px', ease: 'none', scrollTrigger: { trigger: sec, start: 'top bottom', end: 'bottom top', scrub: true } });
    // Rauten-Variante: jede Raute wandert unterschiedlich weit (Parallaxe)
    bg.querySelectorAll<HTMLElement>('[data-rh]').forEach((r) => {
      const dy = Number(r.dataset.rh);
      gsap.fromTo(r, { y: -dy / 2, rotate: 0 }, { y: dy, rotate: dy > 0 ? 4 : -4, ease: 'none', scrollTrigger: { trigger: sec, start: 'top bottom', end: 'bottom top', scrub: true } });
    });
  });

  /* ---------- Film: das Logo erscheint, die Raute wird zum Video und öffnet sich ---------- */
  const RAUTE = [
    [120.73, 184.07],
    [296.89, 63.0],
    [473.44, 192.9],
    [290.58, 308.03],
  ];
  const filmClip = (frame: HTMLElement, logo: SVGSVGElement, f: number) => {
    // Raute des Logos in Bildschirmkoordinaten, um ihre Mitte um Faktor f vergrößert
    const fr = frame.getBoundingClientRect();
    const lr = logo.getBoundingClientRect();
    const sx = lr.width / 354.5;
    const sy = lr.height / 247;
    const cx = lr.left - fr.left + (297 - 120) * sx;
    const cy = lr.top - fr.top + (185 - 62) * sy;
    return `polygon(${RAUTE.map(([x, y]) => {
      const px = lr.left - fr.left + (x! - 120) * sx;
      const py = lr.top - fr.top + (y! - 62) * sy;
      return `${(cx + (px - cx) * f).toFixed(1)}px ${(cy + (py - cy) * f).toFixed(1)}px`;
    }).join(', ')})`;
  };
  mm.add(
    { desktop: '(prefers-reduced-motion: no-preference) and (min-width: 901px)', mobile: '(prefers-reduced-motion: no-preference) and (max-width: 900px)' },
    () => {
      const film = document.querySelector<HTMLElement>('[data-film]');
      const frame = document.querySelector<HTMLElement>('[data-film-frame]');
      const logo = document.querySelector<SVGSVGElement>('[data-film-logo]');
      const q = document.querySelector('[data-film-q]');
      const raute = logo?.querySelector('.fl-raute');
      const ui = document.querySelector('[data-film-ui]');
      if (!film || !frame || !logo || !q || !raute) return;
      // beginnt schon beim Hereinscrollen, damit sich das Logo ohne Halt auflöst
      // startet erst, wenn das Logo fast mittig steht: man sieht es in Ruhe und dann wegfliegen
      const st = { trigger: film, start: 'top 55%', end: 'bottom bottom', scrub: 0.6 };
      const state = { f: 1 };
      const apply = () => (frame.style.clipPath = filmClip(frame, logo, state.f));
      apply();
      const tl = gsap.timeline({ scrollTrigger: { ...st, onRefresh: apply } });
      // 1. Q und Hammer lösen sich, die graue Fläche gibt das Video frei
      tl.to(q, { opacity: 0, scale: 1.6, duration: 0.24, ease: 'power1.in' }, 0.12);
      tl.to(raute, { opacity: 0, duration: 0.16, ease: 'none' }, 0.24);
      // 2. die Raute öffnet sich ohne Halt, bis das ganze Video zu sehen ist
      tl.to(state, { f: 11, duration: 0.5, ease: 'power1.inOut', onUpdate: apply }, 0.32);
      if (ui) {
        gsap.set(ui, { autoAlpha: 0, y: 30 });
        tl.to(ui, { autoAlpha: 1, y: 0, duration: 0.12 }, 0.56);
      }
      window.addEventListener('resize', apply);
      return () => {
        window.removeEventListener('resize', apply);
        frame.style.removeProperty('clip-path');
      };
    },
  );

  /* ---------- Inhalte blenden ein, sobald sie beim Scrollen ins Bild kommen ---------- */
  const box = (el: Element | null) => {
    if (!el) return null;
    const r = el.getBoundingClientRect();
    return { top: r.top + window.scrollY, bottom: r.bottom + window.scrollY, left: r.left + window.scrollX, right: r.right + window.scrollX };
  };
  const target = () => (reduce ? Infinity : window.scrollY + window.innerHeight * 0.85);
  const followers = Array.from(document.querySelectorAll<HTMLElement>('[data-follow]'));
  const follow = () => {
    const t = target();
    // Leistungen erst, wenn sie gut im Bild sind: so bleibt der Blick länger bei der Übersicht
    const tLate = reduce ? Infinity : window.scrollY + window.innerHeight * 0.74;
    followers.forEach((el) => {
      if (el.classList.contains('is-in')) return;
      if (box(el)!.top + 24 <= (el.closest('.services') ? tLate : t)) {
        el.classList.add('is-in');
        el.querySelectorAll<HTMLElement>('[data-flap]').forEach((f) => setTimeout(() => runFlap(f), 200));
      }
    });
  };

  /* ---------- Einstieg: Bild schließt bündig an Hero- und Übersichtskante an ---------- */
  const fitIntro = () => {
    const vis = document.querySelector<HTMLElement>('.intro-visual');
    const img = vis?.querySelector<HTMLElement>('.intro-img');
    const heroEl = document.querySelector('[data-hero]');
    const ovEl = document.querySelector('.overview');
    if (!vis || !img || !heroEl || !ovEl) return;
    if (window.innerWidth <= 900) {
      img.style.removeProperty('top');
      img.style.removeProperty('bottom');
      img.style.removeProperty('clip-path');
      return;
    }
    const W = document.documentElement.clientWidth;
    const h = box(heroEl)!;
    const o = box(ovEl)!;
    const v = box(vis)!;
    const H = h.bottom - h.top;
    const k = W * 0.78;
    // Unterkante Hero: polygon(0 90%, 78% 100%, 100% 94%)
    const heroY = (x: number) => (x <= k ? h.top + H * (0.9 + (0.1 * x) / k) : h.top + H * (1 - (0.06 * (x - k)) / (W - k)));
    // Oberkante Übersicht: polygon(0 0, 78% a, 100% b)
    const a = Math.min(56, Math.max(32, W * 0.04));
    const b = Math.min(22.4, Math.max(12.8, W * 0.016));
    const ovY = (x: number) => (x <= k ? o.top + (a * x) / k : o.top + a + ((b - a) * (x - k)) / (W - k));
    const w = W - v.left;
    const xs = [v.left + w * 0.14, k, W].filter((x, i, arr) => i === 0 || x > arr[0]!);
    const xb = [v.left + w * 0.08, k, W].filter((x, i, arr) => i === 0 || x > arr[0]!);
    const tops = xs.map((x) => ({ x, y: heroY(x) - 1 }));
    const bots = xb.map((x) => ({ x, y: ovY(x) + 1 }));
    const top = Math.min(...tops.map((p) => p.y));
    const bottom = Math.max(...bots.map((p) => p.y));
    const kinkY = tops[0]!.y + (bots[0]!.y - tops[0]!.y) * 0.58;
    const pts = [...tops, ...bots.reverse(), { x: v.left, y: kinkY }].map((p) => `${(p.x - v.left).toFixed(1)}px ${(p.y - top).toFixed(1)}px`);
    img.style.top = `${top - v.top}px`;
    img.style.bottom = `${v.bottom - bottom}px`;
    img.style.clipPath = `polygon(${pts.join(', ')})`;
  };

  /* ---------- Über uns: Klapptafel wie am Flughafen ---------- */
  const DIGITS = '0123456789';
  const LETTERS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const flapCell = (ch: string) => {
    const c = document.createElement('span');
    c.className = 'sf';
    c.dataset.c = ch;
    c.innerHTML = ['sf-top', 'sf-bot', 'sf-ft', 'sf-fb'].map((k) => `<span class="sf-h ${k}"><span>${ch}</span></span>`).join('');
    return c;
  };
  // ein Umklappen: obere Hälfte fällt nach vorn, die neue untere Hälfte klappt herunter
  const flapStep = (cell: HTMLElement, next: string) =>
    new Promise<void>((done) => {
      const cur = cell.dataset.c ?? ' ';
      const [top, bot, ft, fb] = Array.from(cell.children) as HTMLElement[];
      top!.firstElementChild!.textContent = next;
      bot!.firstElementChild!.textContent = cur;
      ft!.firstElementChild!.textContent = cur;
      fb!.firstElementChild!.textContent = next;
      gsap
        .timeline({
          onComplete: () => {
            bot!.firstElementChild!.textContent = next;
            ft!.firstElementChild!.textContent = next;
            cell.dataset.c = next;
            gsap.set(ft!, { rotationX: 0 });
            gsap.set(fb!, { rotationX: 90 });
            done();
          },
        })
        .fromTo(ft!, { rotationX: 0 }, { rotationX: -90, duration: 0.055, ease: 'power1.in' })
        .fromTo(fb!, { rotationX: 90 }, { rotationX: 0, duration: 0.055, ease: 'power1.out' });
    });
  const flapEls = Array.from(document.querySelectorAll<HTMLElement>('[data-flap]'));
  if (!reduce) {
    flapEls.forEach((el) => {
      const target = el.dataset.flap ?? '';
      // jede Zelle so breit wie ihr Zielzeichen, damit am Ende nichts springt
      el.innerHTML = [...target].map((ch) => `<span style="display:inline-block">${ch}</span>`).join('');
      const widths = Array.from(el.children).map((c) => c.getBoundingClientRect().width);
      el.textContent = '';
      el.setAttribute('aria-label', target);
      widths.forEach((w) => {
        const cell = flapCell(' ');
        cell.style.width = `${w}px`;
        el.appendChild(cell);
      });
    });
  }
  const runFlap = async (el: HTMLElement) => {
    if (reduce || el.dataset.done) return;
    el.dataset.done = '1';
    const target = [...(el.dataset.flap ?? '')];
    const cells = Array.from(el.querySelectorAll<HTMLElement>('.sf'));
    await Promise.all(
      cells.map(async (cell, i) => {
        const ch = target[i]!;
        const pool = /\d/.test(ch) ? DIGITS : LETTERS;
        const start = Math.floor(Math.random() * pool.length);
        // halbe Dauer: halb so viele Blätter
        const steps = 3 + i * 2;
        for (let k = 0; k < steps; k++) await flapStep(cell, pool[(start + k) % pool.length]!);
        await flapStep(cell, ch);
      }),
    );
    // danach wieder normaler Text, ohne Fuge zwischen den Hälften
    el.textContent = el.dataset.flap ?? '';
  };

  /* ---------- Leistungen: Bilder laufen beim Scrollen leicht mit ---------- */
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    document.querySelectorAll<HTMLElement>('.svc-img img').forEach((img) => {
      gsap.fromTo(img, { yPercent: -5 }, { yPercent: 5, ease: 'none', scrollTrigger: { trigger: img.closest('.svc'), start: 'top bottom', end: 'bottom top', scrub: true } });
    });
  });

  /* ---------- Leistungen: der Link gleitet mit dem Scrollweg herein, die Raute dreht sich dabei ein ---------- */
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const links = Array.from(document.querySelectorAll<HTMLElement>('.svc .svc-more'));
    const tweens = links.map((a) =>
      gsap.fromTo(a, { '--p': 0 }, { '--p': 1, ease: 'none', scrollTrigger: { trigger: a, start: 'top 92%', end: 'top 62%', scrub: 0.6 } }),
    );
    return () => {
      tweens.forEach((t) => t.kill());
      links.forEach((a) => a.style.removeProperty('--p'));
    };
  });

  /* ---------- Familie: Fotokante setzt die schräge Kante der Projekte (oben 14 %, unten 0 %) fort ---------- */
  const fitFigs = () => {
    const photo = document.querySelector<HTMLElement>('.figs-photo');
    const img = photo?.querySelector<HTMLElement>('.figs-img');
    const stage = document.querySelector('.show-stage');
    if (!photo || !img || !stage) return;
    if (window.innerWidth <= 900) {
      photo.style.removeProperty('width');
      img.style.removeProperty('clip-path');
      return;
    }
    const st = stage.getBoundingClientRect();
    const h = photo.getBoundingClientRect().height;
    const slope = (st.width * 0.14) / st.height;
    // oben genau dort, wo die Kante der Projekte endet; nach unten im selben Winkel weiter
    const x0 = st.left;
    const x1 = x0 - slope * h;
    photo.style.width = `${x0}px`;
    img.style.clipPath = `polygon(0 0, ${x0.toFixed(1)}px 0, ${x1.toFixed(1)}px ${h.toFixed(1)}px, 0 ${h.toFixed(1)}px)`;
  };

  /* ---------- Familie: das Foto bewegt sich beim Scrollen leicht mit ---------- */
  mm.add('(prefers-reduced-motion: no-preference) and (min-width: 901px)', () => {
    const sec = document.querySelector('[data-figs-sec]');
    const img = sec?.querySelector('[data-figs-img] img');
    if (!sec || !img) return;
    gsap.fromTo(img, { yPercent: -8 }, { yPercent: 0, ease: 'none', scrollTrigger: { trigger: sec, start: 'top bottom', end: 'bottom top', scrub: true } });
  });

  window.addEventListener('scroll', follow, { passive: true });
  window.addEventListener('resize', () => {
    fitIntro();
    fitFigs();
    follow();
  });
  window.addEventListener('load', () => {
    ScrollTrigger.refresh();
    fitIntro();
    fitFigs();
    follow();
  });
  ScrollTrigger.addEventListener('refresh', () => {
    fitIntro();
    fitFigs();
  });
  fitIntro();
  fitFigs();
  follow();
  document.fonts?.ready.then(fitIntro);
</script>
