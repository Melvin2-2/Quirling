  /* ======================= RESPONSIVE ======================= */
  @media (max-width: 900px) {
    .hero {
      --hero-cut: polygon(0 94%, 78% 100%, 100% 96%, 100% 101%, 0 101%);
    }
    .hero-slab {
      width: 100%;
      clip-path: polygon(0 0, 100% 0, 100% 62%, 0 88%);
    }
    .hero-content {
      justify-content: flex-start;
      padding-top: calc(var(--header-h) + 4rem);
