<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- Hero: Navy-Schräge wandert beim Scrollen nach rechts und deckt das Video zu ---------- */
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const slab = hero?.querySelector<HTMLElement>('.hero-slab');
    if (!hero || !slab) return;
    const desktop = window.matchMedia('(min-width: 901px)').matches;
    const trigger = { trigger: hero, start: 'top top', end: 'bottom top', scrub: true };
    if (desktop) {
      // Breite so weit, dass auch die schräge Unterkante (66 %) den rechten Rand überdeckt
      gsap.fromTo(
        slab,
        { width: () => getComputedStyle(slab).width, backgroundColor: 'rgba(18, 23, 53, 0.82)' },
        { width: () => `${window.innerWidth * 1.6}px`, backgroundColor: 'rgba(18, 23, 53, 1)', ease: 'none', scrollTrigger: trigger },
      );
    } else {
      gsap.fromTo(
        slab,
        { clipPath: 'polygon(0 0, 100% 0, 100% 52%, 0 78%)', backgroundColor: 'rgba(18, 23, 53, 0.82)' },
        { clipPath: 'polygon(0 0, 100% 0, 100% 110%, 0 110%)', backgroundColor: 'rgba(18, 23, 53, 1)', ease: 'none', scrollTrigger: trigger },
      );
    }
  });

  /* ---------- Projekte: 3 große Bilder, 3 × scrollen (Desktop) ---------- */
  mm.add('(prefers-reduced-motion: no-preference) and (min-width: 901px)', () => {
    const show = document.querySelector<HTMLElement>('[data-show]');
    if (!show) return;
    const imgs = Array.from(show.querySelectorAll<HTMLElement>('[data-show-img]'));
    const items = Array.from(show.querySelectorAll<HTMLElement>('[data-show-item]'));
    const setActive = (i: number) =>
      items.forEach((it, j) => {
        it.classList.toggle('is-active', j === i);
        it.querySelector('a')?.setAttribute('tabindex', j === i ? '0' : '-1');
      });
    imgs.forEach((img, i) => i > 0 && gsap.set(img, { clipPath: 'inset(100% 0% 0% 0%)' }));
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: show,
        start: 'top top',
        end: () => `+=${(imgs.length - 1) * window.innerHeight * 1.05}`,
        pin: true,
        scrub: 1.2,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          setActive(Math.min(imgs.length - 1, Math.round(self.progress * (imgs.length - 1))));
        },
      },
    });
    tl.to({}, { duration: 0.12 });
    imgs.slice(1).forEach((img, i) => {
      tl.to(img, { clipPath: 'inset(0% 0% 0% 0%)', ease: 'power1.inOut', duration: 1 });
      const inner = img.querySelector('img');
      if (inner) tl.fromTo(inner, { scale: 1.12 }, { scale: 1, ease: 'power1.out', duration: 1 }, '<');
      if (i < imgs.length - 2) tl.to({}, { duration: 0.12 });
    });
    tl.to({}, { duration: 0.12 });
  });

  /* ---------- Leistungen: Hintergrund blendet weich ein und aus ---------- */
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const bg = document.querySelector<HTMLElement>('[data-svc-bg]');
    const sec = document.querySelector<HTMLElement>('[data-services]');
    if (!bg || !sec) return;
    gsap.fromTo(bg, { opacity: 0 }, { opacity: 1, ease: 'none', scrollTrigger: { trigger: sec, start: 'top 95%', end: 'top 30%', scrub: true } });
    gsap.fromTo(bg, { opacity: 1 }, { opacity: 0, ease: 'none', immediateRender: false, scrollTrigger: { trigger: sec, start: 'bottom 75%', end: 'bottom 10%', scrub: true } });
    gsap.fromTo(bg, { backgroundPosition: '0px 0px' }, { backgroundPosition: '0px -140px', ease: 'none', scrollTrigger: { trigger: sec, start: 'top bottom', end: 'bottom top', scrub: true } });
    // Rauten-Variante: jede Raute wandert unterschiedlich weit (Parallaxe)
    bg.querySelectorAll<HTMLElement>('[data-rh]').forEach((r) => {
      const dy = Number(r.dataset.rh);
      gsap.fromTo(r, { y: -dy / 2, rotate: 0 }, { y: dy, rotate: dy > 0 ? 4 : -4, ease: 'none', scrollTrigger: { trigger: sec, start: 'top bottom', end: 'bottom top', scrub: true } });
    });
  });

  /* ---------- Film: das Logo erscheint, die Raute wird zum Video und öffnet sich ---------- */
  const RAUTE = [
    [120.73, 184.07],
    [296.89, 63.0],
    [473.44, 192.9],
    [290.58, 308.03],
  ];
  const filmClip = (frame: HTMLElement, logo: SVGSVGElement, f: number) => {
    // Raute des Logos in Bildschirmkoordinaten, um ihre Mitte um Faktor f vergrößert
    const fr = frame.getBoundingClientRect();
    const lr = logo.getBoundingClientRect();
    const sx = lr.width / 354.5;
    const sy = lr.height / 247;
    const cx = lr.left - fr.left + (297 - 120) * sx;
    const cy = lr.top - fr.top + (185 - 62) * sy;
    return `polygon(${RAUTE.map(([x, y]) => {
      const px = lr.left - fr.left + (x! - 120) * sx;
      const py = lr.top - fr.top + (y! - 62) * sy;
      return `${(cx + (px - cx) * f).toFixed(1)}px ${(cy + (py - cy) * f).toFixed(1)}px`;
    }).join(', ')})`;
  };
  mm.add(
    { desktop: '(prefers-reduced-motion: no-preference) and (min-width: 901px)', mobile: '(prefers-reduced-motion: no-preference) and (max-width: 900px)' },
    (ctx) => {
      const film = document.querySelector<HTMLElement>('[data-film]');
      const frame = document.querySelector<HTMLElement>('[data-film-frame]');
      const logo = document.querySelector<SVGSVGElement>('[data-film-logo]');
      const q = document.querySelector('[data-film-q]');
      const raute = logo?.querySelector('.fl-raute');
      const ui = document.querySelector('[data-film-ui]');
      if (!film || !frame || !logo || !q || !raute) return;
      const desktop = !!ctx.conditions?.desktop;
      const st = { trigger: film, start: desktop ? 'top top' : 'top 20%', end: 'bottom bottom', scrub: 0.6 };
      const state = { f: 1 };
      const apply = () => (frame.style.clipPath = filmClip(frame, logo, state.f));
      apply();
      const tl = gsap.timeline({ scrollTrigger: { ...st, onRefresh: apply } });
      // 1. Q und Hammer lösen sich, die graue Fläche gibt das Video frei
      tl.to(q, { opacity: 0, scale: 1.35, duration: 0.22, ease: 'power2.in' }, 0.04);
      tl.to(raute, { opacity: 0, duration: 0.18, ease: 'none' }, 0.1);
      // 2. die Raute öffnet sich weich über den ganzen Bildschirm
      tl.to(state, { f: 5.2, duration: 0.7, ease: 'power2.inOut', onUpdate: apply }, 0.22);
      if (ui) {
        gsap.set(ui, { autoAlpha: 0, y: 30 });
        tl.to(ui, { autoAlpha: 1, y: 0, duration: 0.2 }, 0.72);
      }
      window.addEventListener('resize', apply);
      return () => {
        window.removeEventListener('resize', apply);
        frame.style.removeProperty('clip-path');
      };
    },
  );

  /* ---------- Die blaue Linie ---------- */
  const svg = document.querySelector<SVGSVGElement>('[data-flow]');
  const path = svg?.querySelector<SVGPathElement>('[data-flow-path]');
  const branchG = svg?.querySelector<SVGGElement>('[data-flow-branches]');
  let total = 0;
  const samples: { len: number; y: number }[] = [];
  let branches: { el: SVGPathElement; len: number; y: number; shown: boolean }[] = [];
  const svcG = svg?.querySelector<SVGGElement>('[data-flow-svc]');
  let svcPaths: { el: SVGPathElement; len: number; y0: number; y1: number }[] = [];
  let tipEnd = Infinity;
  let railX = 0;
  // Abzweige (Werte, Karriere) enden exakt an der Linie
  const toRail = () => {
    const valuesRail = document.querySelector('.rail-values');
    const vx = valuesRail ? valuesRail.getBoundingClientRect().left + 0.75 : railX;
    // Werte: Abzweig beginnt rechts neben dem Piktogramm und endet genau auf der Linie
    document.querySelectorAll<HTMLElement>('.value').forEach((el) => {
      const icon = el.querySelector('.value-icon');
      if (!icon || !vx) return;
      const r = el.getBoundingClientRect();
      const start = icon.getBoundingClientRect().right + 14;
      el.style.setProperty('--branch-left', `${start - r.left}px`);
      el.style.setProperty('--branch-w', `${Math.max(0, vx - start)}px`);
    });
    document.querySelectorAll<HTMLElement>('[data-to-rail]').forEach((el) => {
      const inValues = !!el.closest('[data-values]');
      const x = inValues ? vx : railX;
      if (!x) return;
      // bei den Karriere-Punkten verlängert der Wert das Element selbst, daher an der Liste messen
      const ref = inValues ? el : el.parentElement!;
      el.style.setProperty('--to-rail', `${Math.max(0, x - ref.getBoundingClientRect().right)}px`);
    });
  };

  const box = (el: Element | null) => {
    if (!el) return null;
    const r = el.getBoundingClientRect();
    return { top: r.top + window.scrollY, bottom: r.bottom + window.scrollY, left: r.left + window.scrollX, right: r.right + window.scrollX };
  };
  // Vorlauf der Linie vor dem Scrollstand
  let svcTop = Infinity;
  let svcBottom = Infinity;
  const lead = (y: number, vh: number) => {
    // in den Leistungen zeichnet sich die Linie erst, wenn man hinschaut
    if (y > svcTop - vh && y < svcBottom - vh * 0.6) {
      const r = vh * 0.4;
      const inF = Math.min(1, (y - (svcTop - vh)) / r);
      const outF = Math.min(1, (svcBottom - vh * 0.6 - y) / r);
      return 0.8 - 0.25 * Math.min(inF, outF);
    }
    return 0.8;
  };
  const target = () => {
    if (reduce) return Infinity;
    const vh = window.innerHeight;
    return window.scrollY + vh * lead(window.scrollY, vh);
  };

  const build = () => {
    if (!svg || !path || !branchG || !svcG || window.innerWidth <= 900) return;
    const doc = document.documentElement;
    const W = doc.clientWidth;
    const cont = document.querySelector<HTMLElement>('.intro .container');
    if (!cont) return;
    const cb = box(cont)!;
    const pad = parseFloat(getComputedStyle(cont).paddingLeft);
    // Randspuren links und rechts neben dem Inhalt
    const L = Math.max(34, cb.left + pad - 36);
    const R = Math.min(W - 34, cb.right - pad + 36);
    const svcSec = box(document.querySelector('.services'))!;
    svcTop = svcSec.top;
    svcBottom = svcSec.bottom;
    const film = box(document.querySelector('[data-film]'))!;
    const vh = window.innerHeight;
    const ax = W * 0.78; // Spitze der Raute (Hero und Leistungsübersicht)
    const tipY = film.top + vh * 0.22;
    const defs: { d: string; y: number }[] = [];

    // Übersicht: die Linie läuft unter den drei Stichworten durch, je ein Pfeil zeigt von unten hinein
    const cols = Array.from(document.querySelectorAll<HTMLElement>('[data-line-up]')).map((c) => box(c)!);
    const yU = Math.max(...cols.map((c) => c.bottom)) + 48;
    const colX = cols.map((c) => c.left + 8);
    cols.forEach((c, i) => {
      const x = colX[i]!;
      const end = c.bottom + 14;
      defs.push({ d: `M${x} ${yU} V${end} M${x - 7} ${end + 9} L${x} ${end} L${x + 7} ${end + 9}`, y: yU });
    });

    // Leistungen einzeln: Linie entlang der geknickten Bildkante (genau ein Knick),
    // eigene Pfade, die sich mit dem Scrollen durch die Zeile aufbauen
    svcG!.innerHTML = '';
    svcPaths = [];
    document.querySelectorAll<HTMLElement>('[data-svc]').forEach((r) => {
      const img = box(r.querySelector('.svc-img'))!;
      const link = r.querySelector<HTMLElement>('[data-line-link]');
      const text = box(r.querySelector('.svc-text'))!;
      const imageLeft = img.right <= text.left;
      const w = img.right - img.left;
      const h = img.bottom - img.top;
      const off = imageLeft ? 22 : -22;
      // Innenkante: oben 14 % eingerückt, Knick bei 58 % genau an der Kante, unten 8 % eingerückt
      const pts = imageLeft
        ? [
            { x: img.right - w * 0.14, y: img.top },
            { x: img.right, y: img.top + h * 0.58 },
            { x: img.right - w * 0.08, y: img.bottom },
          ]
        : [
            { x: img.left + w * 0.14, y: img.top },
            { x: img.left, y: img.top + h * 0.58 },
            { x: img.left + w * 0.08, y: img.bottom },
          ];
      const edge = (y: number) => {
        const [a, k, z] = pts as [{ x: number; y: number }, { x: number; y: number }, { x: number; y: number }];
        if (y <= k.y) return a.x + ((k.x - a.x) * (y - a.y)) / (k.y - a.y);
        return k.x + ((z.x - k.x) * (y - k.y)) / (z.y - k.y);
      };
      const pd = pts.map((pt, i) => `${i ? 'L' : 'M'}${pt.x + off} ${pt.y}`).join(' ');
      const el = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      el.setAttribute('d', pd);
      svcG!.appendChild(el);
      const len = el.getTotalLength();
      el.style.strokeDasharray = `${len}`;
      el.style.strokeDashoffset = `${len}`;
      svcPaths.push({ el, len, y0: img.top, y1: img.bottom });
      if (link) {
        const lb = box(link)!;
        const y = (lb.top + lb.bottom) / 2;
        link.dataset.lineX = String(edge(y) + off);
      }
    });

    // Die Linie beginnt an der Spitze der Leistungsübersicht und endet mit der letzten Leistung
    const ov = box(document.querySelector('.overview'))!;
    const kink = Math.min(56, Math.max(32, W * 0.04));
    const d = [`M${ax} ${ov.top + kink}`, `L${R} ${ov.top + kink + 140}`, `V${yU}`, `H${colX[0] ?? L}`].join(' ');

    // Koordinaten relativ zu <main>; die Grafik ist so hoch wie <main> und endet damit vor dem Footer
    const mainEl = svg.parentElement!;
    const mainTop = box(mainEl)!.top;
    svg.setAttribute('viewBox', `0 ${mainTop} ${W} ${mainEl.offsetHeight}`);
    svg.setAttribute('preserveAspectRatio', 'none');
    path.setAttribute('d', d);

    // Abzweige mit Pfeilspitze zu „Mehr über uns“ und „Mehr erfahren“, je nach Seite von links oder rechts
    document.querySelectorAll<HTMLElement>('[data-line-link]').forEach((a) => {
      const b = box(a)!;
      const y = (b.top + b.bottom) / 2;
      const from = Number(a.dataset.lineX ?? R);
      if (from < b.left) {
        const e = b.left - 20;
        defs.push({ d: `M${from} ${y} H${e} M${e - 8} ${y - 7} L${e} ${y} L${e - 8} ${y + 7}`, y });
      } else {
        const e = b.right + 20;
        defs.push({ d: `M${from} ${y} H${e} M${e + 8} ${y - 7} L${e} ${y} L${e + 8} ${y + 7}`, y });
      }
      a.dataset.followY = String(y);
    });
    // Randlinie in Projekten und Werten auf derselben Höhe wie die Hauptlinie
    doc.style.setProperty('--rail-r', `${W - R}px`);
    doc.style.setProperty('--rail-l', `${L}px`);
    railX = R;
    toRail();
    tipEnd = tipY;
    branchG.innerHTML = '';
    branches = defs.map(({ d: bd, y }) => {
      const el = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      el.setAttribute('d', bd);
      el.setAttribute('class', 'branch');
      branchG.appendChild(el);
      const len = el.getTotalLength();
      el.style.strokeDasharray = `${len}`;
      el.style.strokeDashoffset = `${len}`;
      return { el, len, y, shown: false };
    });

    total = path.getTotalLength();
    samples.length = 0;
    for (let l = 0; l <= total; l += 24) samples.push({ len: l, y: path.getPointAtLength(l).y });
    samples.push({ len: total, y: path.getPointAtLength(total).y });
    path.style.strokeDasharray = `${total}`;
    draw(true);
  };

  const draw = (instant = false) => {
    if (!path || !total) return;
    const t = target();
    branches.forEach((b) => {
      const show = b.y <= t;
      if (show === b.shown) return;
      b.shown = show;
      gsap.to(b.el, { strokeDashoffset: show ? 0 : b.len, duration: instant || reduce ? 0 : 0.5, ease: 'power2.out', overwrite: true });
    });
    document.querySelector('[data-film-feed]')?.classList.toggle('is-on', t >= tipEnd);
    // Leistungslinien: wachsen, während man durch die Zeile scrollt
    const ts = window.scrollY + window.innerHeight * 0.7;
    svcPaths.forEach((sp) => {
      const f = reduce ? 1 : Math.min(1, Math.max(0, (ts - sp.y0) / (sp.y1 - sp.y0)));
      sp.el.style.strokeDashoffset = String(sp.len * (1 - f));
    });
    if (reduce) {
      path.style.strokeDashoffset = '0';
      return;
    }
    let len = 0;
    for (const s of samples) {
      if (s.y <= t) len = s.len;
      else break;
    }
    gsap.to(path, { strokeDashoffset: total - len, duration: instant ? 0 : 0.9, ease: 'power2.out', overwrite: true });
  };

  /* Inhalte blenden ein, sobald die Linie (bzw. der Scrollstand) sie erreicht – auch mobil ohne Linie */
  const followers = Array.from(document.querySelectorAll<HTMLElement>('[data-follow]'));
  const valuesSec = document.querySelector<HTMLElement>('[data-values]');
  const valuesBar = document.querySelector<HTMLElement>('[data-values-bar]');
  const follow = () => {
    const t = target();
    followers.forEach((el) => {
      const y = el.dataset.followY ? Number(el.dataset.followY) : box(el)!.top + 24;
      if (!el.classList.contains('is-in') && y <= t) {
        el.classList.add('is-in');
        el.querySelectorAll<HTMLElement>('[data-num]').forEach((c) => setTimeout(() => countUp(c), 250));
      }
    });
    // Randlinie der Werte wächst mit dem Scrollen
    if (valuesSec && valuesBar) {
      const v = box(valuesSec)!;
      const f = Math.min(1, Math.max(0, (t - v.top) / (v.bottom - v.top)));
      valuesBar.style.transform = `scaleY(${reduce ? 1 : f})`;
    }
  };

  /* ---------- Einstieg: Bild schließt bündig an Hero- und Übersichtskante an ---------- */
  const fitIntro = () => {
    const vis = document.querySelector<HTMLElement>('.intro-visual');
    const img = vis?.querySelector<HTMLElement>('.intro-img');
    const heroEl = document.querySelector('[data-hero]');
    const ovEl = document.querySelector('.overview');
    if (!vis || !img || !heroEl || !ovEl) return;
    if (window.innerWidth <= 900) {
      img.style.removeProperty('top');
      img.style.removeProperty('bottom');
      img.style.removeProperty('clip-path');
      vis.style.removeProperty('--kx');
      vis.style.removeProperty('--ky');
      return;
    }
    const W = document.documentElement.clientWidth;
    const h = box(heroEl)!;
    const o = box(ovEl)!;
    const v = box(vis)!;
    const H = h.bottom - h.top;
    const k = W * 0.78;
    // Unterkante Hero: polygon(0 90%, 78% 100%, 100% 94%)
    const heroY = (x: number) => (x <= k ? h.top + H * (0.9 + (0.1 * x) / k) : h.top + H * (1 - (0.06 * (x - k)) / (W - k)));
    // Oberkante Übersicht: polygon(0 0, 78% a, 100% b)
    const a = Math.min(56, Math.max(32, W * 0.04));
    const b = Math.min(22.4, Math.max(12.8, W * 0.016));
    const ovY = (x: number) => (x <= k ? o.top + (a * x) / k : o.top + a + ((b - a) * (x - k)) / (W - k));
    const w = W - v.left;
    const xs = [v.left + w * 0.14, k, W].filter((x, i, arr) => i === 0 || x > arr[0]!);
    const xb = [v.left + w * 0.08, k, W].filter((x, i, arr) => i === 0 || x > arr[0]!);
    const tops = xs.map((x) => ({ x, y: heroY(x) - 1 }));
    const bots = xb.map((x) => ({ x, y: ovY(x) + 1 }));
    const top = Math.min(...tops.map((p) => p.y));
    const bottom = Math.max(...bots.map((p) => p.y));
    const kinkY = tops[0]!.y + (bots[0]!.y - tops[0]!.y) * 0.58;
    const pts = [...tops, ...bots.reverse(), { x: v.left, y: kinkY }].map((p) => `${(p.x - v.left).toFixed(1)}px ${(p.y - top).toFixed(1)}px`);
    vis.style.setProperty('--kx', '0px');
    vis.style.setProperty('--ky', `${kinkY - v.top}px`);
    img.style.top = `${top - v.top}px`;
    img.style.bottom = `${v.bottom - bottom}px`;
    img.style.clipPath = `polygon(${pts.join(', ')})`;
  };

  /* ---------- Zahlen zählen hoch, sobald sie erscheinen ---------- */
  const counters = Array.from(document.querySelectorAll<HTMLElement>('[data-num]'));
  if (!reduce) counters.forEach((c) => (c.textContent = c.dataset.numFrom ?? '0'));
  const countUp = (c: HTMLElement) => {
    if (c.dataset.done) return;
    c.dataset.done = '1';
    const to = Number(c.dataset.num);
    const from = Number(c.dataset.numFrom ?? 0);
    if (reduce) {
      c.textContent = String(to);
      return;
    }
    const t0 = performance.now();
    const dur = 1600;
    const step = (now: number) => {
      const p = Math.min(1, (now - t0) / dur);
      const e = 1 - Math.pow(1 - p, 3);
      c.textContent = String(Math.round(from + (to - from) * e));
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  /* ---------- Über uns: Foto und Zahlen bewegen sich unterschiedlich schnell ---------- */
  mm.add('(prefers-reduced-motion: no-preference) and (min-width: 901px)', () => {
    const sec = document.querySelector('[data-figs-sec]');
    if (!sec) return;
    const st = { trigger: sec, start: 'top bottom', end: 'bottom top', scrub: true };
    const img = sec.querySelector('[data-figs-img] img');
    if (img) gsap.fromTo(img, { yPercent: -8 }, { yPercent: 0, ease: 'none', scrollTrigger: st });
    sec.querySelectorAll<HTMLElement>('[data-par]').forEach((el) => {
      const n = Number(el.dataset.par);
      gsap.fromTo(el, { y: 30 * n }, { y: -30 * n, ease: 'none', scrollTrigger: { ...st } });
    });
  });

  const onScroll = () => {
    draw();
    follow();
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', () => {
    fitIntro();
    build();
    toRail();
  });
  window.addEventListener('load', () => {
    ScrollTrigger.refresh();
    fitIntro();
    build();
    follow();
  });
  ScrollTrigger.addEventListener('refresh', () => {
    fitIntro();
    build();
  });
  fitIntro();
  build();
  toRail();
  follow();
  document.fonts?.ready.then(() => {
    build();
    toRail();
  });
</script>
