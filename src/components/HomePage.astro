---
import { Image, getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import QHammer from '~/components/QHammer.astro';
import ValueIcon from '~/components/ValueIcon.astro';
import { firma, leistungen, GRUENDUNGSJAHR } from '~/data/site';
import { url } from '~/lib/url';
import heroPoster from '~/assets/site/hero-poster.jpg';
import filmPoster from '~/assets/site/film-poster.jpg';
import { leistungBild } from '~/data/leistung-bilder';

interface Props {
  /** Typografie-Variante: 'a' (Standard), 'b' oder 'c' (Entwürfe) */
  typo?: 'a' | 'b' | 'c';
  /** Hintergrund der Leistungen: Raster, nur Farbe oder Rauten-Komposition */
  svcBg?: 'raster' | 'farbe' | 'rauten';
  noindex?: boolean;
  title?: string;
}
const { typo = 'c', svcBg = 'farbe', noindex = false, title = 'Start' } = Astro.props;

const heroPosterImg = await getImage({ src: heroPoster, width: 1920, format: 'jpg', quality: 70 });
const filmPosterImg = await getImage({ src: filmPoster, width: 1600, format: 'jpg', quality: 70 });

/* Leistungen: Bilder folgen der Diagonale der Linie */
const svcInfo: Record<string, { a: string; b: string; text: string }> = {
  rohbau: {
    a: 'Rohbau &',
    b: 'Stahlbetonbau',
    text: 'Rohbauten in Beton- und Stahlbetonbauweise. Vom Fundament über die Tiefgarage bis zur letzten Decke.',
  },
  'schluesselfertiges-bauen': {
    a: 'Schlüssel\u00adfertiges',
    b: 'Bauen',
    text: 'Vom Rohbau bis zur Übergabe koordinieren wir alle Gewerke. Mit einem festen Ansprechpartner.',
  },
  'umbau-sanierung': {
    a: 'Umbau &',
    b: 'Sanierung',
    text: 'Umbauten, Erweiterungen und Sanierungen im Bestand. Von der Stadtvilla bis zum Alsterpalais.',
  },
};
const services = await Promise.all(
  leistungen.map(async (l) => {
    const info = svcInfo[l.slug]!;
    // gleiche Bilder wie auf der Leistungsübersicht (src/data/leistung-bilder.ts)
    const img = await leistungBild(l.slug, 'start');
    return { ...l, ...info, img };
  }),
);

/* Drei Projekte zum Durchscrollen */
const fakt = (fakten: { label: string; value: string }[], label: string) => fakten.find((f) => f.label === label)?.value;
const showcase = await Promise.all(
  ['hanseforum', 'prime-selfstorage-harburg', 'bellevue-50'].map(async (id) => {
    const p = (await getEntry('projekte', id))!;
    const adresse = fakt(p.data.fakten, 'Adresse')?.split('\n') ?? [];
    return { id, ...p.data, strasse: adresse[0] ?? '', ort: (adresse[1] ?? '').replace(/^\d{5}\s*/, '') };
  }),
);



const werte = [
  {
    icon: 'familie',
    t: 'Persönlich',
    d: 'Sie sprechen direkt mit denen, die entscheiden.',
  },
  {
    icon: 'dialog',
    t: 'Verbindlich',
    d: 'Klare Absprachen, feste Termine.',
  },
  {
    icon: 'hammer',
    t: 'Sorgfältig',
    d: 'Bis zum Schluss. Bis ins Detail.',
  },
] as const;
---

<Base title={title} noindex={noindex} typo={typo}>
  <!-- Blaue Linie: startet an der Spitze des Hero und endet in der Film-Raute -->
  <svg class="flow" data-flow aria-hidden="true">
    <path data-flow-path></path>
    <g data-flow-branches></g>
  </svg>

  <!-- ======================= HERO ======================= -->
  <section class="hero" data-hero>
    <div class="hero-media">
      <video class="hero-video" autoplay muted loop playsinline preload="auto" poster={heroPosterImg.src} data-autoplay aria-hidden="true">
        <source src={url('/video/hero-540.mp4')} type="video/mp4" media="(max-width: 767px)" />
        <source src={url('/video/hero-1080.mp4')} type="video/mp4" />
      </video>
      <div class="hero-slab" aria-hidden="true"></div>
    </div>
    <div class="hero-cut" aria-hidden="true"></div>
    <div class="container hero-content">
      <h1 class="hero-title">Was wir<br />zusagen,<br /><span class="lt">steht.</span></h1>
      <a class="pill light" href={url('/referenzen/')}><span>Referenzen ansehen</span><Icon name="arrow" /></a>
    </div>
  </section>

  <!-- ======================= EINSTIEG ======================= -->
  <section class="intro" data-intro>
    <div class="container intro-grid">
      <h2 class="intro-h">Wir lieben<br /><span class="lt">Beton.</span></h2>
      <div class="intro-text">
        <p class="intro-p">
          Schalen, bewehren, betonieren: Seit {GRUENDUNGSJAHR} ist der Rohbau unser Handwerk. Als Familienbetrieb aus Hamburg bauen wir mit eigener
          Mannschaft Wohnhäuser, Büros und Hallen. Und wir freuen uns jedes Mal, wenn aus einem Plan ein Gebäude wird.
        </p>
        <a class="svc-more" href={url('/unternehmen/')} data-follow data-line-link>
          <span>Mehr über uns</span>
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </section>

  <!-- ======================= LEISTUNGEN ======================= -->
  <section class="services" id="leistungen" data-services aria-labelledby="svc-h">
    <div class:list={['svc-bg', `svc-bg-${svcBg}`]} data-svc-bg aria-hidden="true">
      {
        svcBg === 'rauten' && (
          <>
            <span class="rh rh-1" data-rh="-160" />
            <span class="rh rh-2" data-rh="120" />
            <span class="rh rh-3" data-rh="-80" />
            <span class="rh rh-4" data-rh="200" />
          </>
        )
      }
    </div>
    <div class="container">
      <h2 id="svc-h" class="svc-head" data-follow data-svc-head>Was wir <span class="lt">bauen.</span></h2>
      <!-- Übersicht: alle drei Leistungen nebeneinander, die Linie kommt von unten mit Pfeilen -->
      <div class="ov">
        {
          leistungen.map((l) => (
            <a class="ov-col" href={url(`/leistungen/${l.slug}/`)} data-line-up>
              <h3 class="ov-t" set:html={l.title} />
              <p>{l.kurz}</p>
              <span class="text-link">
                <span>Mehr erfahren</span>
                <Icon name="arrow" />
              </span>
            </a>
          ))
        }
      </div>
    </div>
    {
      services.map((s, i) => (
        <article class:list={['svc', `svc-${i + 1}`]} data-svc>
          <div class="container svc-grid">
            <a class="svc-visual" href={url(`/leistungen/${s.slug}/`)} tabindex="-1" aria-hidden="true">
              <span class="block block-in" />
              <span class="cut-img svc-img">
                <Image src={s.img} alt="" widths={[600, 1000, 1400]} sizes="(min-width: 900px) 50vw, 100vw" />
              </span>
            </a>
            <div class="svc-text">
              <h3 class="svc-title">{s.title}</h3>
              <p>{s.text}</p>
              <a class="svc-more" href={url(`/leistungen/${s.slug}/`)} data-follow data-line-link>
                <span>Mehr erfahren</span>
                <Icon name="arrow" />
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <!-- ======================= WERTE ======================= -->
  <section class="values on-blue" data-values>
    <span class="rail rail-values" aria-hidden="true"><span data-values-bar></span></span>
    <div class="container values-grid">
      <div class="values-head">
        <h2 class="values-h">Familien&shy;betrieb.</h2>
        <p class="values-core">Hinter jedem Bauvorhaben steht die Familie Quirling. Mit Namen und Handschlag.</p>
      </div>
      <ul class="values-list">
        {
          werte.map((w) => (
            <li class="value" data-follow data-to-rail>
              <div class="value-text">
                <h3>{w.t}</h3>
                <p>{w.d}</p>
              </div>
              <ValueIcon name={w.icon} class="value-icon" frame={false} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ======================= KENNZAHLEN (diagonal) ======================= -->
  <section class="figs" aria-label="Quirling in Zahlen">
    <div class="container">
      <div class="figs-field" data-figs>
        <div class="fg fg-1" data-follow>
          <strong>{GRUENDUNGSJAHR}</strong>
          <span>Gegründet in Hamburg</span>
        </div>
        <div class="fg fg-2" data-follow>
          <strong>{firma.mitarbeiter}</strong>
          <span>Profis im Team</span>
        </div>
        <div class="fg fg-3" data-follow>
          <strong>{firma.projekteAnzahl}<sup>+</sup></strong>
          <span>Projekte realisiert</span>
        </div>
        <div class="fg fg-4" data-follow>
          <strong>Hamburg &amp; Umgebung</strong>
          <span>Unser Einsatzgebiet</span>
        </div>
      </div>
      <a class="svc-more figs-more" href={url('/unternehmen/')} data-follow data-line-link>
        <span>Mehr über uns</span>
        <Icon name="arrow" />
      </a>
    </div>
  </section>

  <!-- ======================= PROJEKTE (3 × scrollen) ======================= -->
  <section class="show" data-show aria-labelledby="show-h">
    <div class="show-in">
      <div class="show-text">
        <h2 id="show-h" class="show-h">Projekte,<br /><span class="lt">die stehen.</span></h2>
        <div class="show-items">
          {
            showcase.map((p, i) => (
              <div class:list={['show-item', { 'is-active': i === 0 }]} data-show-item>
                <h3 class="show-title">{p.title}</h3>
                <p class="show-desc">
                  {p.leistung}
                  <span class="show-meta">{p.ort}</span>
                </p>
              </div>
            ))
          }
        </div>
        <a class="text-link show-all" href={url('/referenzen/')}><span>Alle Referenzen</span><Icon name="arrow" /></a>
      </div>
      <div class="show-stage">
        {
          showcase.map((p, i) => (
            <a class="show-img" href={url(`/referenzen/?p=${p.id}`)} data-show-img tabindex="-1" style={`z-index:${i + 1}`}>
              <Image src={p.bilder[0]!} alt={`${p.title}: ${p.leistung}`} widths={[900, 1400, 2000]} sizes="(min-width: 900px) 62vw, 100vw" />
              <span class="show-cap">
                <strong>{p.title}</strong>
                {p.kategorien[0]} · {p.ort}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================= FILM (Raute) ======================= -->
  <section class="film" data-film>
    <div class="film-sticky">
      <span class="film-feed" data-film-feed aria-hidden="true"></span>
      <div class="film-frame" data-film-frame>
        <video autoplay muted loop playsinline preload="none" poster={filmPosterImg.src} data-autoplay aria-hidden="true">
          <source src={url('/video/film-loop.mp4')} type="video/mp4" />
        </video>
      </div>
      <div class="film-ui" data-film-ui>
        <h2 class="h-display">Quirling<br /><span class="lt">von oben.</span></h2>
      </div>
    </div>
  </section>

  <!-- ======================= MIT ANPACKEN (Stempel) ======================= -->
  <section class="join" aria-label="Karriere">
    <div class="container join-in">
      <div class="career-stamp" data-follow>
        <span class="cl-a"><QHammer class="cl-hammer" color="#fff" highlight="#3948A4" />Mit anpacken</span>
        <span class="cl-b">Werde Teil des Teams</span>
      </div>
      <a class="pill join-btn" href={url('/karriere/')}><span>Zur Karriere</span><Icon name="arrow" /></a>
    </div>
  </section>
</Base>

<style>
  /* ---------- Bausteine ---------- */
  /* Navy-Parallelogramm hinter dem Bild: neigt sich wie das Bild,
     steht nur leicht über (überall gleich, links hinter dem Bild) */
  .block {
    position: absolute;
    width: 40%;
    background: var(--navy);
    pointer-events: none;
    clip-path: polygon(0 0, 60% 0, 100% 100%, 12% 100%);
  }
  .block-l {
    left: -8%;
    top: 12%;
    bottom: -7%;
  }
  .block-r {
    right: -7%;
    top: -5%;
    bottom: -6%;
    clip-path: polygon(40% 0, 100% 0, 88% 100%, 0 100%);
  }
  .cut-img {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--stone-200);
  }
  .cut-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Linie ---------- */
  :global(main) {
    position: relative;
  }
  .flow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }
  .flow :global(path) {
    fill: none;
    stroke: var(--blue);
    stroke-width: 1.5;
  }


  /* ======================= HERO ======================= */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    color: #fff;
    z-index: 2;
    /* Unterkante deutet eine Raute an, Spitze rechts */
    --hero-cut: polygon(0 90%, 78% 100%, 100% 94%, 100% 101%, 0 101%);
  }
  /* Das Video selbst wird bewusst NICHT zugeschnitten: Chrome zeichnet zugeschnittene
     Video-Ebenen beim Hoch- und Runterscrollen teils unvollständig. Die schräge Unterkante
     entsteht durch eine Fläche in Seitenfarbe, die über dem unteren Videorand liegt. */
  .hero-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--navy);
  }
  .hero-cut {
    position: absolute;
    inset: 0;
    background: var(--stone-50);
    clip-path: var(--hero-cut);
    pointer-events: none;
  }
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-slab {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--content-left) + min(58vw, 1000px));
    background: rgb(18 23 53 / 0.82);
    clip-path: polygon(0 0, 100% 0, 66% 100%, 0 100%);
  }
  .hero-content {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-top: var(--header-h);
    padding-bottom: 4rem;
  }
  .hero-title {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.4rem, 4.6vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.01em;
    margin-bottom: 2.6rem;
    /* bleibt mit Abstand innerhalb der schrägen blauen Fläche */
    max-width: min(42vw, 660px);
    white-space: nowrap;
  }

  /* ======================= EINSTIEG ======================= */
  .intro {
    overflow-x: clip;
    padding-block: clamp(7rem, 12vw, 11rem) clamp(5rem, 9vw, 8rem);
  }
  .intro-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
    align-items: end;
  }
  .intro-h {
    grid-column: 1 / 8;
    font-family: var(--font-head);
    text-transform: uppercase;
    color: var(--blue);
    margin: 0;
  }
  .intro-h .lt {
    font-weight: 300;
  }
  .intro-text {
    grid-column: 8 / 13;
    display: grid;
    gap: 1.4rem;
    justify-items: start;
    padding-bottom: 0.6rem;
  }
  .intro-p {
    margin: 0;
    font-size: clamp(1.1rem, 1.3vw, 1.25rem);
    line-height: 1.6;
    font-weight: 300;
    color: var(--ink);
  }

  /* ======================= KENNZAHLEN ======================= */
  .figs {
    padding-block: clamp(2rem, 4vw, 3rem) clamp(4rem, 7vw, 6rem);
  }
  .figs-field {
    position: relative;
    height: clamp(560px, 56vw, 760px);
  }
  .fg {
    position: absolute;
    display: grid;
    gap: 0.6rem;
  }
  .fg strong {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    line-height: 0.9;
    color: var(--blue);
    letter-spacing: -0.02em;
  }
  .fg sup {
    font-size: 0.45em;
    vertical-align: top;
    margin-left: 0.05em;
  }
  .fg span {
    font-family: var(--font-head);
    font-stretch: 115%;
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .figs-more {
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  /* Einblenden, sobald die Linie die Stelle erreicht */
  [data-follow] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.9s ease,
      transform 0.9s var(--ease);
  }
  [data-follow].is-in {
    opacity: 1;
    transform: none;
  }
  .fg[data-follow].is-in {
    transition-delay: 0.12s;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-follow] {
      opacity: 1;
      transform: none;
    }
  }
  /* Zickzack entlang der Diagonale: links oben → rechts → links → rechts unten */
  .fg-1 {
    left: 0;
    top: 0;
  }
  .fg-1 strong {
    font-size: clamp(4.5rem, 12vw, 11rem);
  }
  .fg-2 {
    left: 64%;
    top: 24%;
  }
  .fg-2 strong {
    font-size: clamp(3.4rem, 8vw, 7.4rem);
  }
  .fg-3 {
    left: 3%;
    top: 46%;
  }
  .fg-3 strong {
    font-size: clamp(3.8rem, 9vw, 8.4rem);
  }
  .fg-4 {
    left: 50%;
    top: 78%;
  }
  .fg-4 strong {
    font-size: clamp(1.4rem, 2.6vw, 2.3rem);
    text-transform: uppercase;
  }

  /* ======================= LEISTUNGEN ======================= */
  .services {
    position: relative;
    overflow-x: clip;
    padding-block: clamp(4rem, 7vw, 6rem);
  }
  .services > .container,
  .services > .svc {
    position: relative;
    z-index: 1;
  }
  /* Eigener Hintergrund für die Leistungen: zartes Blau mit Bauplan-Raster.
     Ränder laufen weich aus, die Deckkraft folgt dem Scrollen (kein harter Übergang). */
  .svc-bg {
    position: absolute;
    inset: -22vh 0;
    z-index: 0;
    pointer-events: none;
    background-color: var(--tint);
    background-image:
      linear-gradient(rgb(57 72 164 / 0.075) 1px, transparent 1px),
      linear-gradient(90deg, rgb(57 72 164 / 0.075) 1px, transparent 1px);
    background-size: 56px 56px;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 22vh, #000 calc(100% - 22vh), transparent 100%);
    mask-image: linear-gradient(to bottom, transparent 0, #000 22vh, #000 calc(100% - 22vh), transparent 100%);
    opacity: 0;
  }
  /* Variante „nur Farbe“: ruhige Fläche ohne Textur */
  .svc-bg-farbe {
    background-image: none;
    background-color: #e6e9f6;
  }
  /* Variante „Rauten“: große, transparente Rauten in Logo-Proportion, die beim Scrollen
     unterschiedlich schnell wandern (Tiefenwirkung) */
  .svc-bg-rauten {
    background-image: none;
    background-color: #e9ecf8;
    overflow: hidden;
  }
  .rh {
    position: absolute;
    aspect-ratio: 352 / 245;
    clip-path: polygon(49.8% 0, 100% 53.3%, 48% 100%, 0 49.6%);
    will-change: transform;
  }
  .rh-1 {
    width: 74vw;
    left: -24vw;
    top: 14%;
    background: rgb(57 72 164 / 0.08);
  }
  .rh-2 {
    width: 46vw;
    right: -10vw;
    top: 30%;
    background: rgb(57 72 164 / 0.11);
  }
  .rh-3 {
    width: 30vw;
    left: 30vw;
    top: 62%;
    background: rgb(18 23 53 / 0.06);
  }
  .rh-4 {
    width: 58vw;
    right: -18vw;
    top: 66%;
    background: rgb(57 72 164 / 0.06);
  }
  @media (prefers-reduced-motion: reduce) {
    .svc-bg {
      opacity: 1;
    }
  }
  .svc-head {
    position: relative;
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 6vw, 6.2rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--blue);
    padding-bottom: clamp(1rem, 2vw, 1.6rem);
    margin-bottom: clamp(1rem, 3vw, 2rem);
  }
  /* wird von links nach rechts aufgedeckt, während die Linie darunter entlangläuft */
  .svc-head[data-follow] {
    opacity: 1;
    transform: none;
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1.3s cubic-bezier(0.45, 0, 0.2, 1);
  }
  .svc-head[data-follow].is-in {
    clip-path: inset(0 -2% 0 0);
  }
  /* erst als Kontur aufgedeckt, dann füllt sich die Schrift von links nach rechts */
  @media (prefers-reduced-motion: no-preference) {
    .svc-head[data-follow] {
      color: transparent;
      -webkit-text-stroke: 1.5px var(--blue);
      background-image: linear-gradient(90deg, var(--blue) 0 50%, transparent 50% 100%);
      background-size: 200% 100%;
      background-position: 100% 0;
      -webkit-background-clip: text;
      background-clip: text;
      transition:
        clip-path 1.3s cubic-bezier(0.45, 0, 0.2, 1),
        background-position 1.5s cubic-bezier(0.6, 0, 0.2, 1) 1.1s;
    }
    .svc-head[data-follow].is-in {
      background-position: 0 0;
    }
  }
  /* Übersicht: drei Spalten, die Linie läuft darunter und zeigt mit Pfeilen von unten hinein */
  .ov {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-bottom: clamp(5rem, 8vw, 7rem);
  }
  .ov-col {
    display: grid;
    gap: 1rem;
    align-content: start;
    justify-items: start;
    color: inherit;
    text-decoration: none;
  }
  .ov-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.8rem, 2.6vw, 2.7rem);
    line-height: 0.97;
    color: var(--blue);
    margin: 0;
    hyphens: manual;
  }
  .ov-col p {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .ov-col:hover .ov-t {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }

  /* Leistungen einzeln: Bilder abwechselnd links / rechts, bis an den Bildschirmrand */
  .svc {
    padding-block: clamp(2.75rem, 5vw, 4.5rem);
  }
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    /* breite Fuge: hier läuft die Linie zwischen Bild und Text */
    column-gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .svc-1 .svc-visual,
  .svc-3 .svc-visual {
    grid-column: 1 / 8;
    margin-left: calc(-1 * var(--content-left));
  }
  .svc-1 .svc-text,
  .svc-3 .svc-text {
    grid-column: 8 / 13;
  }
  .svc-2 .svc-visual {
    grid-column: 6 / 13;
    grid-row: 1;
    margin-right: calc(-1 * var(--content-left));
  }
  .svc-2 .svc-text {
    grid-column: 1 / 6;
    grid-row: 1;
  }
  .svc-visual {
    position: relative;
    z-index: 2;
    display: block;
  }

  .svc-img {
    position: relative;
    aspect-ratio: 16 / 10;
    /* nur die Innenkante ist schräg, die Außenkante liegt am Bildschirmrand */
    clip-path: polygon(0 0, 100% 0, 91% 100%, 0 100%);
  }
  .svc-2 .svc-img {
    clip-path: polygon(9% 0, 100% 0, 100% 100%, 0 100%);
  }
  /* Navy-Block an der Innenkante unten */
  .block-in {
    right: -5%;
    top: 34%;
    bottom: -6%;
    width: 26%;
    clip-path: polygon(30% 0, 64% 0, 100% 100%, 0 100%);
  }
  .svc-2 .block-in {
    right: auto;
    left: -5%;
    clip-path: polygon(36% 0, 70% 0, 100% 100%, 0 100%);
  }

  .svc-img :global(img) {
    transition: transform 1.2s var(--ease);
  }
  .svc-visual:hover .svc-img :global(img) {
    transform: scale(1.03);
  }
  .svc-title {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(1.8rem, 2.6vw, 2.7rem);
    line-height: 0.98;
    text-transform: uppercase;
    overflow-wrap: normal;
    color: var(--blue);
    margin-bottom: 1.2rem;
    hyphens: manual;
  }
  .svc-more {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-head);
    font-stretch: 120%;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--blue);
    text-decoration: none;
  }
  .svc-more :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    transition: transform 0.35s var(--ease);
  }
  .svc-more:hover :global(svg) {
    transform: translateX(5px);
  }
  .svc-more:hover span {
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }
  /* auf dem Desktop übernimmt die Linie den Pfeil */
  @media (min-width: 901px) {
    .svc-more :global(svg) {
      display: none;
    }
  }
  .svc-more[data-follow] {
    transform: translateX(14px);
    transition:
      opacity 0.5s ease 0.35s,
      transform 0.6s var(--ease) 0.35s;
  }
  .svc-more[data-follow].is-in {
    transform: none;
  }
  .svc-text p {
    font-size: 0.95rem;
    color: var(--ink-2);
    margin-bottom: 1.8rem;
  }

  /* ======================= PROJEKTE ======================= */
  .show {
    position: relative;
    z-index: 2;
    background: var(--navy);
    color: #fff;
  }
  .show-in {
    display: grid;
    grid-template-columns: calc(var(--content-left) + clamp(330px, 30vw, 540px)) 1fr;
    height: 100vh;
    min-height: 640px;
  }
  .show-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: calc(var(--header-h) + 1rem) clamp(2rem, 4vw, 4rem) 3rem var(--content-left);
  }
  .show-h {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.1rem, 3.3vw, 3.6rem);
    line-height: 0.95;
    white-space: nowrap;
    overflow-wrap: normal;
    hyphens: manual;
    color: #9aa6ee;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .show-items {
    display: grid;
    margin-bottom: 2.5rem;
  }
  .show-item {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s ease,
      visibility 0s 0.5s;
  }
  .show-item.is-active {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .show-title {
    font-stretch: 125%;
    font-weight: 700;
    font-size: clamp(1.3rem, 1.8vw, 1.65rem);
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 0.7rem;
  }
  .show-desc {
    color: rgb(255 255 255 / 0.72);
    font-size: 0.9rem;
    max-width: 24rem;
    margin-bottom: 1.4rem;
  }
  .show-meta {
    display: block;
    margin-top: 0.3rem;
    color: #9aa6ee;
  }
  .show .show-all {
    align-self: flex-start;
    color: #fff;
  }
  .show-stage {
    position: relative;
    overflow: hidden;
    clip-path: polygon(14% 0, 100% 0, 100% 100%, 0 100%);
  }
  .show-img {
    position: absolute;
    inset: 0;
    display: block;
  }
  .show-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .show-cap {
    display: none;
  }
  /* Linie am Rand: nimmt die Hauptlinie in den farbigen Flächen auf (gleiche Stärke) */
  .rail {
    position: absolute;
    top: 0;
    bottom: 0;
    right: var(--rail-r, 34px);
    width: 1.5px;
    background: rgb(255 255 255 / 0.2);
    z-index: 20;
    pointer-events: none;
  }
  .rail span {
    position: absolute;
    inset: 0;
    background: #fff;
    transform: scaleY(0);
    transform-origin: top;
  }
  /* ======================= WERTE ======================= */
  .values {
    position: relative;
    z-index: 2;
    /* überlappt die Projekt-Sektion minimal: keine helle Haarlinie durch Subpixel-Rundung */
    margin-top: -2px;
    padding-block: clamp(6rem, 11vw, 10rem) clamp(8rem, 15vw, 14rem);
  }
  .values-grid {
    display: grid;
    /* minmax(0, …): die Spalten dürfen nie über das Raster hinauswachsen */
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(3rem, 8vw, 9rem);
    align-items: center;
  }
  .values-h {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 5.2vw, 5.4rem);
    line-height: 0.95;
    hyphens: manual;
    margin-bottom: 1.6rem;
  }
  .values-core {
    font-family: var(--font-head);
    font-stretch: 112%;
    font-weight: 300;
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    line-height: 1.4;
    max-width: 24rem;
    color: #fff !important;
    margin: 0;
  }
  .values-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }
  .value {
    --icon-gap: clamp(4rem, 11vw, 11rem);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    padding-right: var(--icon-gap);
    text-align: right;
  }
  /* Abzweig: von der Randlinie zum Piktogramm */
  .value::after {
    content: '';
    position: absolute;
    top: 50%;
    /* Lage und Länge werden per Skript gemessen: vom Piktogramm bis exakt zur Linie */
    left: var(--branch-left, 100%);
    width: var(--branch-w, 0px);
    height: 1.5px;
    background: rgb(255 255 255 / 0.7);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.6s var(--ease);
  }
  .value.is-in::after {
    transform: scaleX(1);
  }
  .values[data-values] .value[data-follow] {
    opacity: 1;
    transform: none;
  }
  .value-text {
    min-width: 0;
    overflow-wrap: break-word;
    opacity: 0;
    transition: opacity 0.6s ease 0.9s;
  }
  .value.is-in .value-text {
    opacity: 1;
  }
  .value :global(.value-icon) {
    flex: none;
    color: #fff;
    --vicon-bg: #3948a4;
  }
  .value :global(.vicon-art) {
    width: 76px;
    height: 76px;
  }
  /* Piktogramm zeichnet sich, wenn der Abzweig ankommt */
  .value :global(.vicon-art path) {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.2s ease 0.5s;
  }
  .value.is-in :global(.vicon-art path) {
    stroke-dashoffset: 0;
  }
  .value :global(.vicon-hammer) {
    width: 66px;
    height: 66px;
    clip-path: inset(0 0 0 100%);
    transition: clip-path 1s ease 0.5s;
  }
  .value.is-in :global(.vicon-hammer) {
    clip-path: inset(0 0 0 0);
  }
  @media (prefers-reduced-motion: reduce) {
    .value-text {
      opacity: 1;
    }
    .value :global(.vicon-art path) {
      stroke-dashoffset: 0;
    }
    .value :global(.vicon-hammer) {
      clip-path: none;
    }
  }
  .value h3 {
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(1.6rem, 2.6vw, 2.5rem);
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: 0.45rem;
  }
  .value p {
    font-size: 1.02rem;
    color: rgb(255 255 255 / 0.82);
    margin: 0;
  }

  /* ======================= MIT ANPACKEN ======================= */
  .join {
    position: relative;
    padding-block: clamp(5rem, 10vw, 8rem);
    overflow-x: clip;
  }
  .join-in {
    display: grid;
    justify-items: center;
    gap: clamp(1.8rem, 3vw, 2.6rem);
  }
  /* Stempel ploppt auf, sobald man ihn erreicht */
  .career-stamp {
    display: grid;
    justify-items: center;
  }
  .career-stamp[data-follow] {
    transform: rotate(-4deg) scale(1.35);
    transition:
      opacity 0.35s ease,
      transform 0.55s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  .career-stamp[data-follow].is-in {
    transform: rotate(-4deg) scale(1);
  }
  .cl-a,
  .cl-b {
    background: var(--blue);
    color: #fff;
    font-family: var(--font-head);
    font-stretch: 125%;
    text-transform: uppercase;
    line-height: 1;
  }
  .cl-a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    font-size: clamp(2rem, 4.4vw, 4.2rem);
    padding: 0.8rem 1.4rem 0.7rem;
  }
  .cl-a :global(.cl-hammer) {
    width: 1.1em;
    height: 1.1em;
  }
  .cl-b {
    font-weight: 300;
    font-size: clamp(1.1rem, 2vw, 1.8rem);
    padding: 0.45rem 1.4rem 0.6rem;
    background: var(--navy);
  }
  /* ======================= FILM ======================= */
  .film {
    position: relative;
    height: 200vh;
  }
  .film-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: grid;
    place-items: center;
    z-index: 2;
  }
  .film-frame {
    position: absolute;
    inset: 0;
    background: var(--navy);
    clip-path: polygon(50% 22%, 70% 50%, 50% 78%, 30% 50%);
  }
  /* Linienende im stehenden Bereich: läuft von oben genau in die Rautenspitze */
  .film-feed {
    position: absolute;
    left: calc(50% - 0.75px);
    top: 40px;
    width: 1.5px;
    height: calc(22% - 40px);
    background: var(--blue);
    z-index: 3;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .film-feed.is-on {
    opacity: 1;
  }
  .film-frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(18 23 53 / 0.35);
  }
  .film-ui {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    padding-inline: var(--gutter);
  }

  /* ======================= TYPOGRAFIE-ENTWURF B ======================= */
  :global(html.typo-b) .hero-title {
    font-weight: 900;
    font-size: clamp(2.6rem, 5.2vw, 5.4rem);
    line-height: 0.9;
    letter-spacing: -0.025em;
  }
  :global(html.typo-b) .intro-h {
    font-weight: 900;
    font-size: clamp(1.6rem, 2.35vw, 2.7rem);
  }
  :global(html.typo-b) .svc-head {
    font-weight: 900;
    font-size: clamp(3rem, 7vw, 7.4rem);
    line-height: 0.88;
  }
  :global(html.typo-b) .svc-title {
    font-weight: 900;
    font-size: clamp(1.7rem, 2.5vw, 2.6rem);
    line-height: 0.95;
  }
  :global(html.typo-b) .show-h {
    font-weight: 900;
    font-size: clamp(2rem, 3.25vw, 3.6rem);
    line-height: 0.9;
  }
  :global(html.typo-b) .show-title {
    font-weight: 900;
    font-size: clamp(1.4rem, 2vw, 1.9rem);
  }
  :global(html.typo-b) .values-h {
    font-weight: 900;
    font-size: clamp(3rem, 6vw, 6.4rem);
    line-height: 0.88;
  }
  :global(html.typo-b) .value h3 {
    font-weight: 900;
    font-size: clamp(1.6rem, 2.4vw, 2.5rem);
  }
  :global(html.typo-b) .fg strong {
    font-weight: 900;
  }
  /* Fließtexte kleiner, ruhiger */
  :global(html.typo-b) .intro-p,
  :global(html.typo-b) .svc-text p,
  :global(html.typo-b) .show-desc,
  :global(html.typo-b) .value p {
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.7;
  }
  :global(html.typo-b) .values-core {
    font-family: var(--font-body);
    font-stretch: normal;
    font-weight: 300;
    font-size: clamp(1rem, 1.2vw, 1.15rem);
    line-height: 1.6;
  }
  /* technische Beschriftungen in Mono */
  :global(html.typo-b) .fg span,
  :global(html.typo-b) .svc-more,
  :global(html.typo-b) .show-meta,
  :global(html.typo-b) .cl-b {
    font-family: var(--font-mono);
    font-stretch: normal;
    font-weight: 500;
    letter-spacing: 0.08em;
  }
  :global(html.typo-b) .fg span {
    font-size: 0.72rem;
  }
  :global(html.typo-b) .fg span,
  :global(html.typo-b) .svc-more,
  :global(html.typo-b) .show-meta,
  :global(html.typo-b) .cl-b {
    letter-spacing: 0.04em;
  }

  /* ======================= TYPOGRAFIE-ENTWURF C ======================= */
  /* schmale, hohe Überschriften – größer gesetzt */
  :global(html.typo-c) .hero-title,
  :global(html.typo-c) .intro-h,
  :global(html.typo-c) .svc-head,
  :global(html.typo-c) .svc-title,
  :global(html.typo-c) .show-h,
  :global(html.typo-c) .show-title,
  :global(html.typo-c) .values-h,
  :global(html.typo-c) .value h3,
  :global(html.typo-c) .fg strong,
  :global(html.typo-c) .cl-a {
    font-stretch: 68%;
    letter-spacing: -0.005em;
  }
  :global(html.typo-c) .hero-title {
    font-weight: 800;
    font-size: clamp(3.2rem, 7vw, 7.4rem);
    line-height: 0.86;
  }
  :global(html.typo-c) .intro-h {
    font-weight: 800;
    font-size: clamp(3.4rem, 8vw, 8.4rem);
    line-height: 0.92;
  }
  :global(html.typo-c) .svc-head {
    font-weight: 800;
    font-size: clamp(3.6rem, 9vw, 9.6rem);
    line-height: 0.86;
  }
  :global(html.typo-c) .svc-title {
    font-weight: 800;
    font-size: clamp(2.2rem, 3.4vw, 3.6rem);
    line-height: 0.9;
  }
  :global(html.typo-c) .show-h {
    font-weight: 800;
    font-size: clamp(2.8rem, 4.6vw, 5.2rem);
    line-height: 0.86;
  }
  :global(html.typo-c) .show-title {
    font-weight: 800;
    font-size: clamp(1.7rem, 2.6vw, 2.5rem);
  }
  :global(html.typo-c) .values-h {
    font-weight: 800;
    font-size: clamp(3.6rem, 7.4vw, 8rem);
    line-height: 0.86;
  }
  :global(html.typo-c) .value h3 {
    font-weight: 800;
    font-size: clamp(2rem, 3.2vw, 3.2rem);
  }
  :global(html.typo-c) .fg strong {
    font-weight: 800;
  }
  :global(html.typo-c) .fg-1 strong {
    font-size: clamp(5.5rem, 15vw, 14rem);
  }
  :global(html.typo-c) .fg-3 strong {
    font-size: clamp(4.6rem, 11vw, 10.4rem);
  }
  :global(html.typo-c) .fg-2 strong {
    font-size: clamp(4rem, 9.5vw, 9rem);
  }

  /* ======================= RESPONSIVE ======================= */
  @media (max-width: 900px) {
    .flow {
      display: none;
    }
    .hero {
      --hero-cut: polygon(0 94%, 78% 100%, 100% 96%, 100% 101%, 0 101%);
    }
    .hero-slab {
      width: 100%;
      clip-path: polygon(0 0, 100% 0, 100% 52%, 0 78%);
    }
    .hero-content {
      justify-content: flex-start;
      padding-top: calc(var(--header-h) + 4rem);
    }
    .hero-title {
      max-width: none;
      font-size: clamp(2.2rem, 10vw, 3.2rem);
      overflow-wrap: normal;
    }
    .intro {
      padding-top: 5rem;
    }
    .intro-grid,
    .ov {
      grid-template-columns: minmax(0, 1fr);
    }
    .intro-h,
    .intro-text {
      grid-column: 1 / -1;
    }
    .ov {
      padding-bottom: 2rem;
    }
    .figs-field {
      height: auto;
      display: grid;
      gap: 2.5rem;
    }
    .fg {
      position: static;
    }
    .fg-2,
    .fg-4 {
      justify-self: end;
      text-align: right;
    }
    .svc-grid {
      grid-template-columns: 1fr;
    }
    .svc .svc-visual,
    .svc .svc-text {
      grid-column: auto;
      grid-row: auto;
    }
    .svc .svc-visual {
      margin-inline: calc(-1 * var(--gutter));
    }
    .svc .svc-img {
      clip-path: none;
    }
    .block-in {
      display: none;
    }
    .svc-visual {
      margin-bottom: 2.5rem;
    }
    .rail-values {
      right: 8px;
    }
    .values {
      --rail-gap: 8px;
    }
    .svc-grid > *,
    .intro-grid > * {
      min-width: 0;
    }
    .svc-title {
      font-size: clamp(1.35rem, 7.2vw, 1.9rem);
    }
    .cl-a {
      font-size: clamp(1.4rem, 8vw, 2.2rem);
    }
    .show-in {
      grid-template-columns: 1fr;
      height: auto;
    }
    .show-text {
      padding: var(--section) var(--gutter) 2rem;
    }
    .show-items {
      display: none;
    }
    .show-stage {
      display: grid;
      gap: 1.5rem;
      clip-path: none;
      padding: 0 var(--gutter) var(--section);
    }
    .show-img {
      position: relative;
      aspect-ratio: 4 / 3;
      color: #fff;
      text-decoration: none;
    }
    .show-cap {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 2.5rem 1rem 1rem;
      background: linear-gradient(transparent, rgb(18 23 53 / 0.85));
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .show-cap strong {
      display: block;
      font-family: var(--font-head);
      font-stretch: 125%;
      font-weight: 800;
      font-size: 1.15rem;
    }
    .values-grid {
      grid-template-columns: 1fr;
    }
    .values-grid > * {
      min-width: 0;
    }
    .values-h {
      font-size: clamp(1.9rem, 8.6vw, 2.6rem);
    }
    .value {
      --icon-gap: 1.25rem;
      gap: 1rem;
    }
    .value :global(.vicon-art) {
      width: 48px;
      height: 48px;
    }
    .svc-head {
      white-space: normal;
    }
    .hero-title,
    .show-h,
    .intro-h {
      white-space: normal;
    }
    .value h3 {
      font-size: clamp(0.95rem, 4.6vw, 1.5rem);
    }
    .value-text {
      min-width: 0;
    }
    .film {
      height: auto;
    }
    .film-sticky {
      position: relative;
      height: 80svh;
    }
    .film-frame {
      clip-path: polygon(50% 4%, 100% 50%, 50% 96%, 0% 50%);
    }
    .film-feed {
      display: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- Hero: Navy-Schräge wandert beim Scrollen nach rechts und deckt das Video zu ---------- */
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const slab = hero?.querySelector<HTMLElement>('.hero-slab');
    if (!hero || !slab) return;
    const desktop = window.matchMedia('(min-width: 901px)').matches;
    const trigger = { trigger: hero, start: 'top top', end: 'bottom top', scrub: true };
    if (desktop) {
      // Breite so weit, dass auch die schräge Unterkante (66 %) den rechten Rand überdeckt
      gsap.fromTo(
        slab,
        { width: () => getComputedStyle(slab).width, backgroundColor: 'rgba(18, 23, 53, 0.82)' },
        { width: () => `${window.innerWidth * 1.6}px`, backgroundColor: 'rgba(18, 23, 53, 1)', ease: 'none', scrollTrigger: trigger },
      );
    } else {
      gsap.fromTo(
        slab,
        { clipPath: 'polygon(0 0, 100% 0, 100% 52%, 0 78%)', backgroundColor: 'rgba(18, 23, 53, 0.82)' },
        { clipPath: 'polygon(0 0, 100% 0, 100% 110%, 0 110%)', backgroundColor: 'rgba(18, 23, 53, 1)', ease: 'none', scrollTrigger: trigger },
      );
    }
  });

  /* ---------- Projekte: 3 große Bilder, 3 × scrollen (Desktop) ---------- */
  mm.add('(prefers-reduced-motion: no-preference) and (min-width: 901px)', () => {
    const show = document.querySelector<HTMLElement>('[data-show]');
    if (!show) return;
    const imgs = Array.from(show.querySelectorAll<HTMLElement>('[data-show-img]'));
    const items = Array.from(show.querySelectorAll<HTMLElement>('[data-show-item]'));
    const setActive = (i: number) =>
      items.forEach((it, j) => {
        it.classList.toggle('is-active', j === i);
        it.querySelector('a')?.setAttribute('tabindex', j === i ? '0' : '-1');
      });
    imgs.forEach((img, i) => i > 0 && gsap.set(img, { clipPath: 'inset(100% 0% 0% 0%)' }));
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: show,
        start: 'top top',
        end: () => `+=${(imgs.length - 1) * window.innerHeight * 1.05}`,
        pin: true,
        scrub: 1.2,
        invalidateOnRefresh: true,
        onUpdate: (self) => {
          setActive(Math.min(imgs.length - 1, Math.round(self.progress * (imgs.length - 1))));
        },
      },
    });
    tl.to({}, { duration: 0.12 });
    imgs.slice(1).forEach((img, i) => {
      tl.to(img, { clipPath: 'inset(0% 0% 0% 0%)', ease: 'power1.inOut', duration: 1 });
      const inner = img.querySelector('img');
      if (inner) tl.fromTo(inner, { scale: 1.12 }, { scale: 1, ease: 'power1.out', duration: 1 }, '<');
      if (i < imgs.length - 2) tl.to({}, { duration: 0.12 });
    });
    tl.to({}, { duration: 0.12 });
  });

  /* ---------- Leistungen: Hintergrund blendet weich ein und aus ---------- */
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    const bg = document.querySelector<HTMLElement>('[data-svc-bg]');
    const sec = document.querySelector<HTMLElement>('[data-services]');
    if (!bg || !sec) return;
    gsap.fromTo(bg, { opacity: 0 }, { opacity: 1, ease: 'none', scrollTrigger: { trigger: sec, start: 'top 95%', end: 'top 30%', scrub: true } });
    gsap.fromTo(bg, { opacity: 1 }, { opacity: 0, ease: 'none', immediateRender: false, scrollTrigger: { trigger: sec, start: 'bottom 75%', end: 'bottom 10%', scrub: true } });
    gsap.fromTo(bg, { backgroundPosition: '0px 0px' }, { backgroundPosition: '0px -140px', ease: 'none', scrollTrigger: { trigger: sec, start: 'top bottom', end: 'bottom top', scrub: true } });
    // Rauten-Variante: jede Raute wandert unterschiedlich weit (Parallaxe)
    bg.querySelectorAll<HTMLElement>('[data-rh]').forEach((r) => {
      const dy = Number(r.dataset.rh);
      gsap.fromTo(r, { y: -dy / 2, rotate: 0 }, { y: dy, rotate: dy > 0 ? 4 : -4, ease: 'none', scrollTrigger: { trigger: sec, start: 'top bottom', end: 'bottom top', scrub: true } });
    });
  });

  /* ---------- Film: Raute öffnet sich ---------- */
  mm.add('(prefers-reduced-motion: no-preference) and (min-width: 901px)', () => {
    const film = document.querySelector('[data-film]');
    const frame = document.querySelector('[data-film-frame]');
    const ui = document.querySelector('[data-film-ui]');
    if (!film || !frame) return;
    const tl = gsap.timeline({ scrollTrigger: { trigger: film, start: 'top top', end: 'bottom bottom', scrub: 0.6 } });
    tl.fromTo(frame, { clipPath: 'polygon(50% 22%, 70% 50%, 50% 78%, 30% 50%)' }, { clipPath: 'polygon(50% -60%, 160% 50%, 50% 160%, -60% 50%)', ease: 'none', duration: 1 });
    // Spitze wandert von 22 % nach oben aus dem Bild: bei 22/82 der Strecke erreicht sie den Rand
    const feed = document.querySelector('[data-film-feed]');
    if (feed) {
      const h0 = window.innerHeight * 0.22 - 40;
      tl.fromTo(feed, { height: h0 }, { height: 0, ease: 'none', duration: Math.max(0.01, h0 / (window.innerHeight * 0.82)) }, 0);
    }
    if (ui) {
      gsap.set(ui, { autoAlpha: 0, y: 30 });
      tl.to(ui, { autoAlpha: 1, y: 0, duration: 0.35 }, 0.55);
    }
  });

  /* ---------- Die blaue Linie ---------- */
  const svg = document.querySelector<SVGSVGElement>('[data-flow]');
  const path = svg?.querySelector<SVGPathElement>('[data-flow-path]');
  const branchG = svg?.querySelector<SVGGElement>('[data-flow-branches]');
  let total = 0;
  const samples: { len: number; y: number }[] = [];
  let branches: { el: SVGPathElement; len: number; y: number; shown: boolean }[] = [];
  let tipEnd = Infinity;
  let railX = 0;
  // Abzweige (Werte, Karriere) enden exakt an der Linie
  const toRail = () => {
    const valuesRail = document.querySelector('.rail-values');
    const vx = valuesRail ? valuesRail.getBoundingClientRect().left + 0.75 : railX;
    // Werte: Abzweig beginnt rechts neben dem Piktogramm und endet genau auf der Linie
    document.querySelectorAll<HTMLElement>('.value').forEach((el) => {
      const icon = el.querySelector('.value-icon');
      if (!icon || !vx) return;
      const r = el.getBoundingClientRect();
      const start = icon.getBoundingClientRect().right + 14;
      el.style.setProperty('--branch-left', `${start - r.left}px`);
      el.style.setProperty('--branch-w', `${Math.max(0, vx - start)}px`);
    });
    document.querySelectorAll<HTMLElement>('[data-to-rail]').forEach((el) => {
      const inValues = !!el.closest('[data-values]');
      const x = inValues ? vx : railX;
      if (!x) return;
      // bei den Karriere-Punkten verlängert der Wert das Element selbst, daher an der Liste messen
      const ref = inValues ? el : el.parentElement!;
      el.style.setProperty('--to-rail', `${Math.max(0, x - ref.getBoundingClientRect().right)}px`);
    });
  };

  const box = (el: Element | null) => {
    if (!el) return null;
    const r = el.getBoundingClientRect();
    return { top: r.top + window.scrollY, bottom: r.bottom + window.scrollY, left: r.left + window.scrollX, right: r.right + window.scrollX };
  };
  // Vorlauf der Linie vor dem Scrollstand. Im Zahlenbereich läuft sie weiter voraus,
  // damit die Kennzahlen früh erscheinen. Die Rampen sind flach genug, dass die Linie nie zurückläuft.
  let figsTop = Infinity;
  let figsBottom = Infinity;
  const lead = (y: number, vh: number) => {
    const base = 0.8;
    const extra = 0.2;
    const upStart = figsTop - vh * 1.25;
    const upEnd = figsTop - vh * 0.95;
    const downStart = figsBottom - vh * 0.55;
    const downEnd = downStart + vh * 0.7;
    if (y <= upStart || y >= downEnd) return base;
    if (y < upEnd) return base + (extra * (y - upStart)) / (upEnd - upStart);
    if (y <= downStart) return base + extra;
    return base + extra * (1 - (y - downStart) / (downEnd - downStart));
  };
  const target = () => {
    if (reduce) return Infinity;
    const vh = window.innerHeight;
    return window.scrollY + vh * lead(window.scrollY, vh);
  };

  const build = () => {
    if (!svg || !path || !branchG || window.innerWidth <= 900) return;
    const doc = document.documentElement;
    const W = doc.clientWidth;
    const cont = document.querySelector<HTMLElement>('.intro .container');
    if (!cont) return;
    const cb = box(cont)!;
    const pad = parseFloat(getComputedStyle(cont).paddingLeft);
    // Randspuren links und rechts neben dem Inhalt
    const L = Math.max(34, cb.left + pad - 36);
    const R = Math.min(W - 34, cb.right - pad + 36);
    const hero = box(document.querySelector('[data-hero]'))!;
    const figs = box(document.querySelector('[data-figs]'))!;
    figsTop = figs.top;
    figsBottom = figs.bottom;
    const film = box(document.querySelector('[data-film]'))!;
    const vh = window.innerHeight;
    const ax = W * 0.78; // Spitze der Hero-Unterkante
    const cx = W / 2;
    const tipY = film.top + vh * 0.22;
    const defs: { d: string; y: number }[] = [];

    // Einstieg: „Mehr über uns“ hängt an der rechten Randspur
    const introLink = document.querySelector<HTMLElement>('[data-intro] [data-line-link]');
    if (introLink) introLink.dataset.lineX = String(R);

    // Übersicht: die Linie läuft unter den drei Spalten durch, je ein Pfeil zeigt von unten hinein
    const cols = Array.from(document.querySelectorAll<HTMLElement>('[data-line-up]')).map((c) => box(c)!);
    const yU = Math.max(...cols.map((c) => c.bottom)) + 56;
    const colX = cols.map((c) => c.left + 8);
    cols.forEach((c, i) => {
      const x = colX[i]!;
      const end = c.bottom + 14;
      defs.push({ d: `M${x} ${yU} V${end} M${x - 7} ${end + 9} L${x} ${end} L${x + 7} ${end + 9}`, y: yU });
    });

    // Leistungen einzeln: die Linie läuft im Zickzack durch die Fuge zwischen Bild und Text
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-svc]')).map((r) => {
      const v = box(r.querySelector('.svc-visual'))!;
      const t = box(r.querySelector('.svc-text'))!;
      const seam = v.right <= t.left ? (v.right + t.left) / 2 : (t.right + v.left) / 2;
      const link = r.querySelector<HTMLElement>('[data-line-link]');
      if (link) link.dataset.lineX = String(seam);
      return { top: Math.min(v.top, t.top), bottom: Math.max(v.bottom, t.bottom), seam };
    });

    // Zahlen: „Mehr über uns“ hängt an der linken Randspur
    const figsLink = document.querySelector<HTMLElement>('.figs [data-line-link]');
    if (figsLink) figsLink.dataset.lineX = String(L);
    const figsLinkY = figsLink ? (box(figsLink)!.top + box(figsLink)!.bottom) / 2 : figs.bottom;

    const d: string[] = [`M${ax} ${hero.bottom}`, `L${R} ${hero.bottom + 140}`, `V${yU}`, `H${colX[0] ?? L}`];
    rows.forEach((r, i) => {
      const above = i === 0 ? r.top - 56 : (rows[i - 1]!.bottom + r.top) / 2;
      d.push(`V${above}`, `H${r.seam}`);
    });
    const last = rows[rows.length - 1];
    if (last) d.push(`V${last.bottom + 56}`);
    // weiter am rechten Rand durch „Familienbetrieb“, dann diagonal durch die Zahlen
    d.push(`H${R}`, `V${figs.top}`, `H${ax}`, `L${L} ${figs.bottom}`, `V${figsLinkY + 64}`, `H${R}`, `V${film.top + 40}`, `H${cx}`, `V${tipY}`);

    // Koordinaten relativ zu <main>; die Grafik ist so hoch wie <main> und endet damit vor dem Footer
    const mainEl = svg.parentElement!;
    const mainTop = box(mainEl)!.top;
    svg.setAttribute('viewBox', `0 ${mainTop} ${W} ${mainEl.offsetHeight}`);
    svg.setAttribute('preserveAspectRatio', 'none');
    path.setAttribute('d', d.join(' '));

    // Abzweige von der Diagonale zu den Kennzahlen (gleiche Linienstärke)
    const xOnDiag = (y: number) => ax + ((y - figs.top) / (figs.bottom - figs.top)) * (L - ax);
    // Zahlen mit festem Abstand neben die Diagonale setzen (auch auf breiten Bildschirmen nie auf der Linie)
    const fieldW = figs.right - figs.left;
    document.querySelectorAll<HTMLElement>('.fg').forEach((fg) => {
      const num = box(fg.querySelector('strong'))!;
      const y = (num.top + num.bottom) / 2;
      const x = xOnDiag(y);
      const w = fg.offsetWidth;
      const rightSide = fg.classList.contains('fg-2') || fg.classList.contains('fg-4');
      // rechts der Linie mit deutlich mehr Abstand, links mit mindestens 72 px
      const gap = rightSide ? 150 : 72;
      const left = rightSide ? Math.min(x + gap - figs.left, fieldW - w) : Math.max(0, Math.min(fg.offsetLeft, x - gap - w - figs.left));
      fg.style.left = `${left}px`;
      const fb = box(fg)!;
      const end = fb.right < x ? fb.right + 24 : fb.left - 24;
      defs.push({ d: `M${x} ${y} H${end}`, y });
      fg.dataset.followY = String(y);
    });
    // Abzweige mit Pfeilspitze zu „Mehr über uns“ und „Mehr erfahren“, je nach Seite von links oder rechts
    document.querySelectorAll<HTMLElement>('[data-line-link]').forEach((a) => {
      const b = box(a)!;
      const y = (b.top + b.bottom) / 2;
      const from = Number(a.dataset.lineX ?? R);
      if (from < b.left) {
        const e = b.left - 14;
        defs.push({ d: `M${from} ${y} H${e} M${e - 8} ${y - 7} L${e} ${y} L${e - 8} ${y + 7}`, y });
      } else {
        const e = b.right + 16;
        defs.push({ d: `M${from} ${y} H${e} M${e + 8} ${y - 7} L${e} ${y} L${e + 8} ${y + 7}`, y });
      }
      a.dataset.followY = String(y);
    });
    // Randlinie in Projekten und Werten auf derselben Höhe wie die Hauptlinie
    doc.style.setProperty('--rail-r', `${W - R}px`);
    doc.style.setProperty('--rail-l', `${L}px`);
    railX = R;
    toRail();
    tipEnd = tipY;
    branchG.innerHTML = '';
    branches = defs.map(({ d: bd, y }) => {
      const el = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      el.setAttribute('d', bd);
      el.setAttribute('class', 'branch');
      branchG.appendChild(el);
      const len = el.getTotalLength();
      el.style.strokeDasharray = `${len}`;
      el.style.strokeDashoffset = `${len}`;
      return { el, len, y, shown: false };
    });

    total = path.getTotalLength();
    samples.length = 0;
    for (let l = 0; l <= total; l += 24) samples.push({ len: l, y: path.getPointAtLength(l).y });
    samples.push({ len: total, y: path.getPointAtLength(total).y });
    path.style.strokeDasharray = `${total}`;
    draw(true);
  };

  const draw = (instant = false) => {
    if (!path || !total) return;
    const t = target();
    branches.forEach((b) => {
      const show = b.y <= t;
      if (show === b.shown) return;
      b.shown = show;
      gsap.to(b.el, { strokeDashoffset: show ? 0 : b.len, duration: instant || reduce ? 0 : 0.5, ease: 'power2.out', overwrite: true });
    });
    document.querySelector('[data-film-feed]')?.classList.toggle('is-on', t >= tipEnd);
    if (reduce) {
      path.style.strokeDashoffset = '0';
      return;
    }
    let len = 0;
    for (const s of samples) {
      if (s.y <= t) len = s.len;
      else break;
    }
    gsap.to(path, { strokeDashoffset: total - len, duration: instant ? 0 : 0.9, ease: 'power2.out', overwrite: true });
  };

  /* Inhalte blenden ein, sobald die Linie (bzw. der Scrollstand) sie erreicht – auch mobil ohne Linie */
  const followers = Array.from(document.querySelectorAll<HTMLElement>('[data-follow]'));
  const valuesSec = document.querySelector<HTMLElement>('[data-values]');
  const valuesBar = document.querySelector<HTMLElement>('[data-values-bar]');
  const follow = () => {
    const t = target();
    followers.forEach((el) => {
      const y = el.dataset.followY ? Number(el.dataset.followY) : box(el)!.top + 24;
      if (!el.classList.contains('is-in') && y <= t) el.classList.add('is-in');
    });
    // Randlinie der Werte wächst mit dem Scrollen
    if (valuesSec && valuesBar) {
      const v = box(valuesSec)!;
      const f = Math.min(1, Math.max(0, (t - v.top) / (v.bottom - v.top)));
      valuesBar.style.transform = `scaleY(${reduce ? 1 : f})`;
    }
  };

  const onScroll = () => {
    draw();
    follow();
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', () => {
    build();
    toRail();
  });
  window.addEventListener('load', () => {
    ScrollTrigger.refresh();
    build();
    follow();
  });
  ScrollTrigger.addEventListener('refresh', () => build());
  build();
  toRail();
  follow();
  document.fonts?.ready.then(() => {
    build();
    toRail();
  });
</script>
