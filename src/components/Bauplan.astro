---
/**
 * „Eine Basis, auf die Sie bauen können.“ als Bauzeichnung, die beim Scrollen entsteht:
 * Baugrube und Fundament, dann richtet sich ein Turmdrehkran auf und hebt Decke um Decke ein.
 * Jede Etage trägt eine Zahl. Zum Schluss Richtfest mit der Quirling-Raute auf dem Dach.
 * Der Bau startet, wenn die Zeichnung zur Hälfte im Bild ist, und ist nach sechs Sekunden fertig.
 */
import { firma, JAHRE_ERFAHRUNG, GRUENDUNGSJAHR } from '~/data/site';

// Geschosse von unten nach oben
const etagen = [
  { v: JAHRE_ERFAHRUNG, plus: false, l: 'Jahre Erfahrung', hoehe: '+3,00' },
  { v: firma.projekteAnzahl, plus: true, l: 'Projekte', hoehe: '+6,00' },
  { v: firma.mitarbeiter, plus: false, l: 'Mitarbeiter', hoehe: '+9,00' },
];

// Maße der Zeichnung (viewBox 0 0 640 560)
const G = 470; // Geländeoberkante
const X0 = 100; // Gebäude links
const X1 = 420; // Gebäude rechts
const FH = 100; // Geschosshöhe
const SL = 8; // Deckenstärke
const COLS = [X0, 257, X1 - 6];
const floorBottom = (k: number) => 430 - k * FH; // Unterkante Geschoss k
---

<section class="bp" data-bp aria-labelledby="bp-h">
  <div class="bp-pin">
    <div class="container bp-in">
      <div class="bp-text">
        <h2 class="h-sec" id="bp-h">Eine Basis,<br /><span class="lt">auf die Sie<br />bauen können.</span></h2>
        <p class="small">
          Seit {GRUENDUNGSJAHR} bauen wir in Hamburg, vor allem Rohbau in Beton und Stahlbeton. Mit einem festen Team, das seit Jahren zusammen
          anpackt.
        </p>
      </div>

      <figure class="bp-fig">
        <svg
          class="bp-svg"
          viewBox="0 0 640 520"
          role="img"
          aria-label={`Rohbau mit Fundament ${GRUENDUNGSJAHR} und drei Geschossen: ${JAHRE_ERFAHRUNG} Jahre Erfahrung, über ${firma.projekteAnzahl} Projekte, ${firma.mitarbeiter} Mitarbeiter.`}
        >
          <line class="bp-ground" data-draw x1="20" y1={G} x2="620" y2={G} stroke="currentColor" stroke-width="2"></line>

          <!-- Fundament mit zwei Streifenfundamenten -->
          <path class="bp-found-line" data-draw d={`M80 430 H440 V470 H420 V494 H380 V470 H140 V494 H100 V470 H80 Z`} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="miter"></path>
          <g class="bp-found-txt" data-bp-found-txt>
            <text class="bp-num bp-num-s" x="118" y="461">{GRUENDUNGSJAHR}</text>
            <text class="bp-lab" x="196" y="455">Gegründet in Hamburg</text>
          </g>

          <!-- Geschosse: Stützen, Decke, Zahl, Höhenkote -->
          {
            etagen.map((e, k) => {
              const fb = floorBottom(k);
              const top = fb - FH + SL;
              return (
                <g class="bp-floor" data-bp-floor={k}>
                  <g class="bp-cols" data-bp-cols>
                    {COLS.map((x) => (
                      <rect x={x} y={top} width="6" height={fb - top} fill="currentColor" />
                    ))}
                  </g>
                  <g class="bp-txt" data-bp-txt>
                    <text class="bp-num" x="122" y={fb - 36}>
                      <tspan data-bp-count={e.v}>{e.v}</tspan>
                      {e.plus ? '+' : ''}
                    </text>
                    <text class="bp-lab" x="124" y={fb - 16}>
                      {e.l}
                    </text>
                  </g>
                </g>
              );
            })
          }
          <!-- Decken: werden vom Kran eingehoben -->
          {
            etagen.map((_, k) => {
              const y = floorBottom(k) - FH;
              return (
                <g class="bp-slab" data-bp-slab={k} data-y={y}>
                  <line class="bp-sling" x1="260" y1={y - 34} x2={X0 - 4 + 6} y2={y} stroke="currentColor" stroke-width="1" />
                  <line class="bp-sling" x1="260" y1={y - 34} x2={X1 + 4 - 6} y2={y} stroke="currentColor" stroke-width="1" />
                  <rect x={X0 - 4} y={y} width={X1 - X0 + 8} height={SL} fill="currentColor" />
                </g>
              );
            })
          }

          <!-- Turmdrehkran -->
          <g class="bp-crane" data-bp-crane>
            <g class="bp-mast" data-bp-mast>
              <line x1="536" y1={G} x2="536" y2="48" stroke="currentColor" stroke-width="2"></line>
              <line x1="552" y1={G} x2="552" y2="48" stroke="currentColor" stroke-width="2"></line>
              <path
                d={Array.from({ length: 21 }, (_, i) => `M536 ${G - i * 20} L552 ${G - i * 20 - 20}`).join(' ')}
                stroke="currentColor"
                stroke-width="1"
                fill="none"
              ></path>
              <rect x="526" y={G - 6} width="36" height="6" fill="currentColor"></rect>
            </g>
            <g class="bp-jib" data-bp-jib>
              <line x1="150" y1="40" x2="628" y2="40" stroke="currentColor" stroke-width="2"></line>
              <line x1="150" y1="48" x2="628" y2="48" stroke="currentColor" stroke-width="2"></line>
              <path d={Array.from({ length: 24 }, (_, i) => `M${150 + i * 20} 48 L${160 + i * 20} 40 L${170 + i * 20} 48`).join(' ')} stroke="currentColor" stroke-width="1" fill="none"></path>
              <line x1="544" y1="40" x2="544" y2="10" stroke="currentColor" stroke-width="2"></line>
              <line x1="544" y1="10" x2="160" y2="40" stroke="currentColor" stroke-width="1"></line>
              <line x1="544" y1="10" x2="620" y2="40" stroke="currentColor" stroke-width="1"></line>
              <rect x="598" y="48" width="26" height="22" fill="currentColor"></rect>
              <rect x="554" y="48" width="18" height="14" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
            </g>
            <g class="bp-hoist" data-bp-hoist>
              <rect data-bp-trolley x="253" y="48" width="14" height="6" fill="currentColor"></rect>
              <line data-bp-cable x1="260" y1="54" x2="260" y2="66" stroke="currentColor" stroke-width="1.2"></line>
              <path data-bp-hook d="M260 66 v6 a4 4 0 1 1 -4 4" fill="none" stroke="currentColor" stroke-width="1.8"></path>
            </g>
          </g>

          <!-- Richtfest: Quirling-Raute auf dem Dach -->
          <g class="bp-flag" data-bp-flag>
            <line x1="260" y1="122" x2="260" y2="84" stroke="currentColor" stroke-width="2"></line>
            <path d="M260 66 l14 14 l-14 14 l-14 -14 z" fill="currentColor"></path>
          </g>
        </svg>
      </figure>
    </div>
  </div>
</section>

<style>
  .bp {
    position: relative;
    padding-block: clamp(5rem, 9vw, 8rem);
  }
  .bp-in {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    width: 100%;
  }
  .bp-text {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
  }
  .bp-text .h-sec {
    font-size: clamp(2.8rem, 5.6vw, 6rem);
  }
  .bp-text .small {
    margin: 0;
    max-width: 44ch;
  }
  .bp-fig {
    margin: 0;
  }
  .bp-svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 78svh;
    color: var(--blue);
    overflow: visible;
  }
  .bp-num {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 46px;
    fill: var(--blue);
  }
  .bp-num-s {
    font-size: 30px;
  }
  .bp-lab {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    fill: var(--navy);
  }
  .bp-k {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    fill: var(--blue);
  }
  .bp-mast,
  .bp-cols rect {
    transform-box: fill-box;
    transform-origin: bottom;
  }
  .bp-jib {
    transform-box: fill-box;
    transform-origin: 82% 50%;
  }
  .bp-flag {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }

  @media (max-width: 900px) {
    .bp-in {
      grid-template-columns: minmax(0, 1fr);
    }
    .bp-svg {
      max-height: none;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const root = document.querySelector<HTMLElement>('[data-bp]');
  if (root) {
    const q = <T extends Element = SVGElement>(s: string) => Array.from(root.querySelectorAll<T & Element>(s)) as unknown as T[];
    const one = <T extends Element = SVGElement>(s: string) => root.querySelector(s) as T | null;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Linien zum Zeichnen vorbereiten
    q<SVGGeometryElement>('[data-draw]').forEach((el) => {
      const len = el.getTotalLength();
      el.style.strokeDasharray = `${len}`;
      el.style.strokeDashoffset = `${len}`;
    });

    const trolley = one<SVGRectElement>('[data-bp-trolley]')!;
    const cable = one<SVGLineElement>('[data-bp-cable]')!;
    const hook = one<SVGPathElement>('[data-bp-hook]')!;
    const slabs = q<SVGGElement>('[data-bp-slab]');
    const floors = q<SVGGElement>('[data-bp-floor]');

    // Kranhaken folgt einem Punkt (x = Katze, y = Oberkante der hängenden Decke)
    // Ruheposition des Hakens: knapp über der Raute auf dem Dach
    const REST = 98;
    const hoist = { x: 260, y: REST };
    let active: SVGGElement | null = null;
    const placeHoist = () => {
      const hy = hoist.y - 34;
      trolley.setAttribute('x', String(hoist.x - 7));
      cable.setAttribute('x1', String(hoist.x));
      cable.setAttribute('x2', String(hoist.x));
      cable.setAttribute('y2', String(hy - 10));
      hook.setAttribute('d', `M${hoist.x} ${hy - 10} v6 a4 4 0 1 1 -4 4`);
      if (active) {
        const target = Number(active.dataset.y);
        gsap.set(active, { x: hoist.x - 260, y: hoist.y - target });
      }
    };

    const tl = gsap.timeline({ paused: true, defaults: { ease: 'power2.out' } });
    tl.set(
      [one('[data-bp-found-txt]'), one('[data-bp-crane]'), ...q('[data-bp-txt]')],
      { autoAlpha: 0 },
      0,
    )
      .set(q('[data-bp-cols] rect'), { scaleY: 0 }, 0)
      .set(slabs, { autoAlpha: 0 }, 0)
      .set(one('[data-bp-flag]'), { autoAlpha: 0, scale: 0 }, 0);

    // 1. Gelände und Fundament, der Kran steht schon
    tl.to('[data-bp] .bp-ground', { strokeDashoffset: 0, duration: 0.6, ease: 'none' }, 0)
      .to(one('[data-bp-crane]'), { autoAlpha: 1, duration: 0.4 }, 0.2)
      .to('[data-bp] .bp-found-line', { strokeDashoffset: 0, duration: 0.7, ease: 'none' }, 0.4)
      .to(one('[data-bp-found-txt]'), { autoAlpha: 1, duration: 0.4 }, 0.9)
      .call(() => placeHoist(), [], 1.2);

    // 2. Geschoss für Geschoss: Stützen wachsen, Decke hängt am Haken und senkt sich ein,
    //    danach fährt der Haken ruhig zurück in die Ruheposition
    floors.forEach((f, k) => {
      const t = 1.3 + k * 1.5;
      const slab = slabs[k]!;
      const target = Number(slab.dataset.y);
      tl.to(f.querySelectorAll('[data-bp-cols] rect'), { scaleY: 1, duration: 0.5, ease: 'power3.out' }, t)
        .call(() => {
          active = slab;
          placeHoist();
        }, [], t + 0.3)
        .to(slab, { autoAlpha: 1, duration: 0.15 }, t + 0.3)
        .to(hoist, { y: target, duration: 0.7, ease: 'power2.inOut', onUpdate: placeHoist }, t + 0.35)
        .call(() => (active = null), [], t + 1.05)
        .to(slab.querySelectorAll('.bp-sling'), { autoAlpha: 0, duration: 0.15 }, t + 1.05)
        .to(hoist, { y: REST, duration: 0.4, ease: 'power2.inOut', onUpdate: placeHoist }, t + 1.08)
        .to(f.querySelector('[data-bp-txt]'), { autoAlpha: 1, duration: 0.3 }, t + 1);
      const n = f.querySelector<SVGTSpanElement>('[data-bp-count]');
      if (n) {
        const to = Number(n.dataset.bpCount);
        const c = { v: 0 };
        tl.fromTo(c, { v: 0 }, { v: to, duration: 0.5, ease: 'power1.out', onUpdate: () => (n.textContent = String(Math.round(c.v))) }, t + 1);
      }
    });

    // 3. Richtfest: Raute auf dem Dach, der Haken bleibt in Ruheposition
    const tEnd = 1.3 + 3 * 1.5;
    tl.to(one('[data-bp-flag]'), { autoAlpha: 1, scale: 1, duration: 0.5, ease: 'back.out(2)' }, tEnd - 0.1).to({}, { duration: 0.3 }, tEnd + 0.4);

    // Anfangszustand sofort zeigen (leere Zeichnung), damit beim Start nichts springt
    tl.progress(0.001, true).progress(0, true);
    placeHoist();

    if (reduce) {
      tl.progress(1);
    } else {
      const fig = root.querySelector<HTMLElement>('.bp-fig')!;
      // der Bau startet, wenn die Zeichnung zur Hälfte im Bild ist; Gesamtdauer sechs Sekunden
      tl.duration(6);
      ScrollTrigger.create({
        trigger: fig,
        start: 'center 75%',
        once: true,
        onEnter: () => tl.play(0),
      });
    }
  }
</script>
