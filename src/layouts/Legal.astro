---
import Base from './Base.astro';
import PageHero from '~/components/PageHero.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<Base title={title} description={description}>
  <PageHero title={title} crumbs={[{ label: title }]} size="small" />
  <section class="legal">
    <div class="container">
      <div class="prose">
        <slot />
      </div>
    </div>
  </section>
</Base>

<style>
  .legal {
    padding-block: clamp(2.5rem, 5vw, 4rem) var(--section);
  }
  .prose {
    max-width: 52rem;
    font-size: 0.95rem;
  }
  .prose :global(h2) {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.5rem, 2vw, 1.9rem);
    line-height: 1;
    color: var(--blue);
    margin: 2.8rem 0 0.9rem;
  }
  .prose :global(h3) {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--blue);
    margin: 1.8rem 0 0.6rem;
  }
  .prose :global(a) {
    color: var(--blue);
    overflow-wrap: anywhere;
  }
  .prose :global(p),
  .prose :global(li) {
    color: var(--ink-2);
    line-height: 1.72;
  }
  .prose :global(ul) {
    padding-left: 1.2rem;
    margin: 0 0 1em;
  }
  .prose :global(address) {
    font-style: normal;
    margin-bottom: 1em;
    color: var(--ink-2);
  }
  .prose :global(.box) {
    border: 1px dashed var(--todo);
    background: rgb(208 2 27 / 0.05);
    color: var(--todo);
    padding: 1rem 1.2rem;
    margin-bottom: 2rem;
  }
</style>
