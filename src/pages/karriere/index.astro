---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import { firma } from '~/data/site';
import hero from '~/assets/site/baustelle-team.jpg';

const mailBewerbung = `mailto:${firma.email}?subject=${encodeURIComponent('Bewerbung')}`;

const vorteile = [
  { t: 'Beständiges Team', d: 'Junge und erfahrene Kollegen arbeiten bei uns seit vielen Jahren zusammen. Man kennt sich und kann sich aufeinander verlassen.' },
  { t: 'Vielseitige Bauten', d: 'Wohnungsbau, Büro- und Gewerbebauten, Umbauten von Stadtvillen. Kein Projekt ist wie das andere.' },
  { t: 'Kurze Wege', d: 'Als inhabergeführtes Unternehmen entscheiden wir schnell und sprechen direkt miteinander.' },
  { t: 'Gutes Klima', d: 'Wir bauen auf Partnerschaft mit unseren Mitarbeitern, denn ein zufriedenes Team baut besser.' },
];

// Wen wir suchen: bewusst ohne Datum, die Stellen sind dauerhaft offen.
// Weitere Berufe einfach hier ergänzen.
const stellen = [{ titel: 'Beton- und Stahlbetonbauer (m/w/d)', ort: 'Hamburg', art: 'Vollzeit' }];

---

<Base title="Karriere" description="Karriere bei der Quirling GmbH in Hamburg: Werden Sie Teil unseres Teams auf der Baustelle oder im Büro. Bewerbung gerne per E-Mail.">
  <PageHero
    title="Mit anpacken"
    titleLight="bei Quirling."
    intro="Gute Leute suchen wir immer. Wer gerne baut und Teil eines eingespielten Teams sein möchte, ist bei uns richtig."
    image={hero}
    imageAlt="Zwei Kollegen mit Schutzhelm auf einer Baustelle der Quirling GmbH"
    imageSide="right"
    imagePosition="50% 30%"
    crumbs={[{ label: 'Karriere' }]}
  >
    <a class="pill light hero-btn" href={mailBewerbung}><span>Jetzt bewerben</span><Icon name="arrow" /></a>
  </PageHero>

  <!-- Vorteile -->
  <section class="section">
    <div class="container vt-wrap">
      <div class="vt-head">
        <h2 class="h-sec">Was Sie<br /><span class="lt">erwartet.</span></h2>
      </div>
      <div class="vorteile">
        {
          vorteile.map((v) => (
            <div class="v">
              <h3 class="v-t">{v.t}</h3>
              <p class="small">{v.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Wen wir suchen -->
  <section class="section section-tint">
    <div class="container jobs-wrap">
      <div class="jobs-head">
        <h2 class="h-sec">Wir suchen<br /><span class="lt">Verstärkung.</span></h2>
        <p class="small">
          Bewerben Sie sich einfach per E-Mail an <a href={mailBewerbung}>{firma.email}</a>. Gerne auch per Post oder persönlich bei uns im Büro.
        </p>
      </div>
      <ul class="jobs">
        {
          stellen.map((s) => (
            <li>
              <a class="job" href={mailBewerbung}>
                <span class="job-t">{s.titel}</span>
                <span class="job-m">
                  {s.ort} · {s.art}
                </span>
                <span class="job-i"><Icon name="arrow" /></span>
              </a>
            </li>
          ))
        }
        <li>
          <a class="job job-init" href={mailBewerbung}>
            <span class="job-t">Initiativ&shy;bewerbung</span>
            <span class="job-m">Ihr Beruf ist nicht dabei? Melden Sie sich trotzdem.</span>
            <span class="job-i"><Icon name="arrow" /></span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  :global(.phero) .hero-btn {
    margin-top: 1.6rem;
  }

  .vt-wrap,
  .jobs-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .vt-head,
  .jobs-head {
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  .jobs-head .small {
    margin: 0;
    max-width: 34ch;
  }
  .jobs-head a {
    color: var(--blue);
  }
  .vorteile {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem) clamp(2rem, 4vw, 4rem);
  }
  .v {
    position: relative;
    padding-top: 1.3rem;
  }
  .v::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 3rem;
    height: 2px;
    background: var(--blue);
  }
  .v-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.5rem, 2vw, 2rem);
    line-height: 1;
    color: var(--blue);
    margin: 0.6rem 0 0.7rem;
  }
  .v .small {
    margin: 0;
    max-width: 38ch;
  }

  /* Stellen */
  .jobs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .job {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1.5rem;
    padding: clamp(1.2rem, 2vw, 1.6rem) 1.3rem clamp(1.2rem, 2vw, 1.6rem) 1.6rem;
    background: #fff;
    color: var(--ink);
    text-decoration: none;
    transition: background 0.25s ease;
  }
  .job:hover {
    background: var(--stone-50);
  }
  .job-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.35rem, 1.9vw, 1.9rem);
    line-height: 1;
    color: var(--blue);
  }
  .job-m {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .job-i {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: var(--navy);
    color: #fff;
    transition: background 0.3s ease;
  }
  .job:hover .job-i {
    background: var(--blue);
  }
  .job-i :global(svg) {
    width: 20px;
    height: 20px;
  }
  .job-init {
    background: var(--navy);
  }
  .job-init .job-t {
    color: #fff;
  }
  .job-init .job-m {
    color: #aab4ea;
    text-transform: none;
    letter-spacing: 0;
  }
  .job-init .job-i {
    background: var(--blue);
  }
  .job-init:hover {
    background: #1c2350;
  }


  @media (max-width: 900px) {
    .vt-wrap,
    .jobs-wrap {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .vorteile {
      grid-template-columns: minmax(0, 1fr);
    }
    .job {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .job-m {
      grid-row: 2;
    }
    .job-i {
      grid-row: 1 / 3;
      grid-column: 2;
    }
  }
</style>
