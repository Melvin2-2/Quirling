---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import { firma } from '~/data/site';
import hero from '~/assets/site/baustelle-team.jpg';

const mailBewerbung = `mailto:${firma.email}?subject=${encodeURIComponent('Bewerbung')}`;

// Was dich erwartet: konkret und ehrlich, ohne Werbesprech
const vorteile = [
  { t: 'Ein Team, das bleibt', d: 'Viele Kollegen sind seit Jahrzehnten dabei, einige seit über 30 Jahren. Man kennt sich und kann sich aufeinander verlassen.' },
  { t: 'Faire Bezahlung', d: 'Wir zahlen über dem Branchendurchschnitt, pünktlich und fair. Gute Arbeit soll sich lohnen.' },
  { t: 'Moderne Firmenwagen', d: 'Du fährst mit modernen Firmenfahrzeugen zur Baustelle. Werkzeug und Material sind da, wenn du sie brauchst.' },
  { t: 'Ordentliche Baustellen', d: 'Gut ausgestattete Baucontainer und saubere Sanitäranlagen. Auf dem Bauplatz gibt es einen Gemeinschaftsraum und eine Umkleide.' },
  { t: 'Familiär und verlässlich', d: 'Ein inhabergeführter Betrieb mit kurzen Wegen. Du sprichst direkt mit der Geschäftsführung, und Absprachen gelten.' },
  { t: 'Abwechslung', d: 'Wohnungsbau, Büro- und Gewerbebauten, Umbauten im Bestand. Kein Projekt ist wie das andere.' },
];

// Wen wir suchen: bewusst ohne Datum, die Stellen sind dauerhaft offen.
// Ein Teil ist entweder Fließtext (d) oder eine Liste mit Stichpunkten (punkte).
type Teil = { t: string; d?: string; punkte?: string[] };
const adresse = `${firma.strasse}, ${firma.plz} ${firma.ort}`;
const stellen: { titel: string; ort: string; art: string[]; kurz: string; teile: Teil[] }[] = [
  {
    titel: 'Beton- und Stahlbetonbauer (m/w/d)',
    ort: 'Hamburg und Umgebung',
    art: ['Vollzeit', 'Unbefristet'],
    kurz: 'Schalen, bewehren, betonieren: Rohbau mit einem festen, eingespielten Team.',
    teile: [
      {
        t: 'Wer wir sind',
        d: 'Die Quirling GmbH ist ein inhabergeführtes Bauunternehmen aus Hamburg. Seit 1992 bauen wir Rohbauten in Beton und Stahlbeton, schlüsselfertige Gebäude und Umbauten im Bestand, vom Mehrfamilienhaus mit Tiefgarage bis zur Stadtvilla.',
      },
      {
        t: 'Deine Aufgaben',
        punkte: [
          'Schalen von Fundamenten, Wänden, Stützen und Decken, auch mit Systemschalung',
          'Verlegen und Einbauen der Bewehrung nach Plan',
          'Betonieren, Verdichten und Nachbehandeln',
          'Mitarbeit bei Mauerarbeiten und bei Umbauten im Bestand',
          'Lesen von Bau- und Bewehrungsplänen',
          'Sorgfältiges Arbeiten nach den Vorgaben von Polier und Bauleitung',
        ],
      },
      {
        t: 'Dein Profil',
        punkte: [
          'Abgeschlossene Ausbildung als Beton- und Stahlbetonbauer, Maurer oder Erfahrung im Rohbau',
          'Sicherer Umgang mit Schalung und Bewehrung',
          'Zuverlässigkeit, Sorgfalt und Freude an der Arbeit im Team',
          'Führerschein Klasse B',
        ],
      },
      {
        t: 'Was wir dir bieten',
        punkte: [
          'Unbefristete Festanstellung in Vollzeit',
          'Bezahlung über dem Branchendurchschnitt, pünktlich und fair',
          'Moderne Firmenwagen',
          'Arbeitskleidung und persönliche Schutzausrüstung werden gestellt',
          'Gut ausgestattete Baucontainer und Sanitäranlagen, Gemeinschaftsraum und Umkleide auf dem Bauplatz',
          'Ein festes Team, in dem viele Kollegen seit Jahrzehnten dabei sind',
          'Abwechslungsreiche Baustellen in Hamburg und Umgebung',
          'Kurze Wege und direkter Draht zur Geschäftsführung',
        ],
      },
      {
        t: 'So bewirbst du dich',
        d: `Schick uns deine vollständigen Bewerbungsunterlagen (Anschreiben, Lebenslauf und Zeugnisse) per E-Mail an ${firma.email} oder per Post an ${adresse}. Bei Fragen vorab erreichst du uns unter ${firma.telefon}.`,
      },
    ],
  },
  {
    titel: 'Initiativ\u00adbewerbung',
    ort: 'Hamburg',
    art: ['Baustelle oder Büro'],
    kurz: 'Dein Beruf ist nicht dabei? Bewirb dich trotzdem.',
    teile: [
      {
        t: 'Gute Leute suchen wir immer',
        d: `Ob Maurer, Polier oder Auszubildender: Schick uns deine vollständigen Bewerbungsunterlagen (Anschreiben, Lebenslauf und Zeugnisse) per E-Mail an ${firma.email} oder per Post an ${adresse}. Wir melden uns zeitnah und lernen dich gern persönlich kennen.`,
      },
    ],
  },
];
const mailFor = (titel: string) => `mailto:${firma.email}?subject=${encodeURIComponent(`Bewerbung: ${titel.replace('\u00ad', '')}`)}`;

---

<Base title="Karriere" description="Karriere bei der Quirling GmbH in Hamburg: Werde Teil unseres Teams auf der Baustelle oder im Büro. Faire Bezahlung, moderne Firmenwagen, ein Team, das bleibt.">
  <PageHero
    title="Mit anpacken"
    titleLight="bei Quirling."
    intro="Gute Leute suchen wir immer. Wenn du gern baust und Teil eines eingespielten Teams sein willst, bist du bei uns richtig."
    image={hero}
    imageAlt="Zwei Kollegen mit Schutzhelm auf einer Baustelle der Quirling GmbH"
    imageSide="right"
    imagePosition="50% 30%"
    crumbs={[{ label: 'Karriere' }]}
  >
    <a class="pill light hero-btn" href="#stellen"><span>Offene Stellen</span><Icon name="arrow-down" /></a>
  </PageHero>

  <!-- Vorteile -->
  <section class="section">
    <div class="container vt-wrap">
      <div class="vt-head">
        <h2 class="h-sec">Was dich<br /><span class="lt">erwartet.</span></h2>
      </div>
      <div class="vorteile">
        {
          vorteile.map((v) => (
            <div class="v">
              <h3 class="v-t">{v.t}</h3>
              <p class="small">{v.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Wen wir suchen -->
  <section class="section section-tint" id="stellen">
    <div class="container jobs-wrap">
      <div class="jobs-head">
        <h2 class="h-sec">Wir suchen<br /><span class="lt">Verstärkung.</span></h2>
        <p class="small">
          Bewirb dich einfach per E-Mail an <a href={mailBewerbung}>{firma.email}</a>. Gern auch per Post oder persönlich bei uns im Büro in der Tilsiter
          Straße.
        </p>
        <ul class="steps">
          <li>Du sendest uns deine vollständigen Bewerbungsunterlagen: Anschreiben, Lebenslauf und Zeugnisse.</li>
          <li>Wir melden uns zeitnah bei dir.</li>
          <li>Wir lernen uns in einem persönlichen Gespräch kennen.</li>
        </ul>
      </div>
      <div class="jobs">
        {
          stellen.map((j) => (
            <details class="job">
              <summary>
                <span class="job-t" set:html={j.titel} />
                <span class="job-k">{j.kurz}</span>
                <span class="job-tags">
                  <span class="job-tag">
                    <Icon name="pin" />
                    {j.ort}
                  </span>
                  {j.art.map((a) => (
                    <span class="job-tag">
                      <Icon name="clock" />
                      {a}
                    </span>
                  ))}
                </span>
                <span class="job-i" aria-hidden="true">
                  <span class="job-i-l job-i-more">Details ansehen</span>
                  <span class="job-i-l job-i-less">Schließen</span>
                  <Icon name="plus" />
                </span>
              </summary>
              <div class="job-body">
                <div class="job-cols">
                  {j.teile.map((t) => (
                    <div class:list={['job-part', { 'is-wide': !t.punkte || t.punkte.length > 6 }]}>
                      <h3 class="job-h">{t.t}</h3>
                      {t.d && <p class="small">{t.d}</p>}
                      {t.punkte && (
                        <ul class="job-list">
                          {t.punkte.map((pk) => (
                            <li>{pk}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  ))}
                </div>
                <a class="pill solid" href={mailFor(j.titel)}><span>Jetzt per E-Mail bewerben</span><Icon name="mail" /></a>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  :global(.phero) .hero-btn {
    margin-top: 1.6rem;
  }

  .vt-wrap,
  .jobs-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .vt-head,
  .jobs-head {
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  /* kleiner als sonst, damit „Verstärkung.“ nicht an die Stellen stößt */
  .jobs-head .h-sec {
    font-size: clamp(2.6rem, 4.6vw, 4.8rem);
  }
  .jobs-head .small {
    margin: 0;
    max-width: 34ch;
  }
  .jobs-head a {
    color: var(--blue);
  }
  /* Ablauf der Bewerbung: drei kurze Schritte mit Raute */
  .steps {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .steps li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .steps li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.55em;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--blue);
    transform: rotate(45deg);
  }
  .vorteile {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 3.6vw, 3rem) clamp(2rem, 4vw, 4rem);
  }

  .v-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    line-height: 0.97;
    color: var(--blue);
    margin: 0 0 0.6rem;
  }
  .v .small {
    margin: 0;
    max-width: 38ch;
  }

  /* Stellen: aufklappbar */
  .jobs {
    display: grid;
    gap: 6px;
  }
  .job {
    background: #fff;
  }
  .job summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.45rem 2rem;
    align-items: start;
    padding: clamp(1.3rem, 2.4vw, 2rem) clamp(1.3rem, 2.4vw, 2rem);
    transition: background 0.25s ease;
  }
  .job summary::-webkit-details-marker {
    display: none;
  }
  .job summary:hover {
    background: var(--stone-50);
  }
  .job-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.7rem, 2.6vw, 2.6rem);
    line-height: 0.97;
    color: var(--blue);
  }
  .job-k {
    font-size: 1.125rem;
    font-weight: 300;
    color: var(--ink-2);
  }
  /* Standort und Anstellungsart als klare Schilder */
  .job-tags {
    grid-column: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }
  .job-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.75rem 0.4rem;
    background: #e6e9f6;
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1;
    color: var(--navy);
  }
  .job-tag :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--blue);
  }
  /* deutlicher Knopf zum Aufklappen */
  .job-i {
    grid-column: 2;
    grid-row: 1 / 4;
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.85rem 1.1rem 0.8rem;
    border: 1.5px solid var(--blue);
    color: var(--blue);
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background 0.3s ease,
      color 0.3s ease;
  }
  .job-i :global(svg) {
    width: 18px;
    height: 18px;
    transition: transform 0.4s var(--ease);
  }
  .job-i-less {
    display: none;
  }
  .job[open] .job-i-more {
    display: none;
  }
  .job[open] .job-i-less {
    display: inline;
  }
  .job summary:hover .job-i,
  .job[open] .job-i {
    background: var(--blue);
    color: #fff;
  }
  .job[open] .job-i :global(svg) {
    transform: rotate(45deg);
  }
  .job-body {
    padding: 0 clamp(1.3rem, 2.4vw, 2rem) clamp(1.6rem, 3vw, 2.4rem);
    display: grid;
    gap: 1.8rem;
    justify-items: start;
  }
  .job-cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.8rem 2.4rem;
    width: 100%;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .job-h {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.3rem, 1.6vw, 1.6rem);
    line-height: 1;
    color: var(--blue);
    margin: 0 0 0.6rem;
  }
  .job-cols .small {
    margin: 0;
    max-width: 62ch;
  }
  /* Fließtext-Teile (Wer wir sind, Bewerbung) über die volle Breite */
  .job-part.is-wide {
    grid-column: 1 / -1;
  }
  /* lange Listen über die volle Breite in zwei Spalten */
  .job-part.is-wide .job-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2.4rem;
  }
  .job-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .job-list li {
    position: relative;
    padding-left: 1.3rem;
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .job-list li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 0.6em;
    width: 0.4rem;
    height: 0.4rem;
    background: var(--blue);
    transform: rotate(45deg);
  }

  @media (max-width: 900px) {
    .vt-wrap,
    .jobs-wrap {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .vorteile,
    .job-cols,
    .job-part.is-wide .job-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .job summary {
      grid-template-columns: minmax(0, 1fr);
    }
    .job-i {
      grid-column: 1;
      grid-row: auto;
      justify-self: start;
      margin-top: 0.6rem;
    }
  }
</style>
