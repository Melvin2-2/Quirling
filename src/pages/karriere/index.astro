---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import { firma } from '~/data/site';
import hero from '~/assets/site/baustelle-team.jpg';

const mailBewerbung = `mailto:${firma.email}?subject=${encodeURIComponent('Bewerbung')}`;

const vorteile = [
  { t: 'Beständiges Team', d: 'Junge und erfahrene Kollegen arbeiten bei uns seit vielen Jahren zusammen. Man kennt sich und kann sich aufeinander verlassen.' },
  { t: 'Vielseitige Bauten', d: 'Wohnungsbau, Büro- und Gewerbebauten, Umbauten von Stadtvillen. Kein Projekt ist wie das andere.' },
  { t: 'Kurze Wege', d: 'Als inhabergeführtes Unternehmen entscheiden wir schnell und sprechen direkt miteinander.' },
  { t: 'Gutes Klima', d: 'Wir bauen auf Partnerschaft mit unseren Mitarbeitern, denn ein zufriedenes Team baut besser.' },
];

// Wen wir suchen: bewusst ohne Datum, die Stellen sind dauerhaft offen.
// Weitere Berufe einfach hier ergänzen.
const stellen = [
  {
    titel: 'Beton- und Stahlbetonbauer (m/w/d)',
    meta: 'Hamburg und Umgebung · Vollzeit',
    kurz: 'Schalen, bewehren, betonieren und noch einiges mehr.',
    teile: [
      {
        t: 'Ihre Aufgaben',
        d: 'Bei uns wird es nie langweilig. Sie schalen, bewehren und betonieren Fundamente, Wände und Decken, mauern mit und packen auch bei Umbauten im Bestand an. Jede Baustelle ist anders, vom Mehrfamilienhaus mit Tiefgarage bis zur Stadtvilla.',
      },
      {
        t: 'Ihr Profil',
        d: 'Eine Ausbildung im Bauhandwerk oder Erfahrung im Rohbau, Zuverlässigkeit und Freude an der Arbeit im Team. Flexibilität ist bei uns gefragt, denn kein Tag ist wie der andere.',
      },
      {
        t: 'Was wir bieten',
        d: 'Ein festes, eingespieltes Team, abwechslungsreiche Baustellen in Hamburg und Umgebung und kurze Wege zur Geschäftsführung. Als Familienbetrieb nehmen wir uns Zeit für unsere Leute.',
      },
    ],
  },
  {
    titel: 'Initiativ\u00adbewerbung',
    meta: 'Baustelle oder Büro',
    kurz: 'Ihr Beruf ist nicht dabei? Melden Sie sich trotzdem.',
    teile: [
      {
        t: 'Gute Leute suchen wir immer',
        d: 'Ob Maurer, Polier oder Auszubildender: Schicken Sie uns ein paar Zeilen und Ihren Lebenslauf. Wir melden uns zeitnah und lernen Sie gerne persönlich kennen.',
      },
    ],
  },
];
const mailFor = (titel: string) => `mailto:${firma.email}?subject=${encodeURIComponent(`Bewerbung: ${titel.replace('\u00ad', '')}`)}`;

---

<Base title="Karriere" description="Karriere bei der Quirling GmbH in Hamburg: Werden Sie Teil unseres Teams auf der Baustelle oder im Büro. Bewerbung gerne per E-Mail.">
  <PageHero
    title="Mit anpacken"
    titleLight="bei Quirling."
    intro="Gute Leute suchen wir immer. Wer gerne baut und Teil eines eingespielten Teams sein möchte, ist bei uns richtig."
    image={hero}
    imageAlt="Zwei Kollegen mit Schutzhelm auf einer Baustelle der Quirling GmbH"
    imageSide="right"
    imagePosition="50% 30%"
    crumbs={[{ label: 'Karriere' }]}
  >
    <a class="pill light hero-btn" href="#stellen"><span>Offene Stellen</span><Icon name="arrow-down" /></a>
  </PageHero>

  <!-- Vorteile -->
  <section class="section">
    <div class="container vt-wrap">
      <div class="vt-head">
        <h2 class="h-sec">Was Sie<br /><span class="lt">erwartet.</span></h2>
      </div>
      <div class="vorteile">
        {
          vorteile.map((v) => (
            <div class="v">
              <h3 class="v-t">{v.t}</h3>
              <p class="small">{v.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Wen wir suchen -->
  <section class="section section-tint" id="stellen">
    <div class="container jobs-wrap">
      <div class="jobs-head">
        <h2 class="h-sec">Wir suchen<br /><span class="lt">Verstärkung.</span></h2>
        <p class="small">
          Bewerben Sie sich einfach per E-Mail an <a href={mailBewerbung}>{firma.email}</a>. Gerne auch per Post oder persönlich bei uns im Büro.
        </p>
      </div>
      <div class="jobs">
        {
          stellen.map((j, i) => (
            <details class="job" open={i === 0}>
              <summary>
                <span class="job-top">
                  <span class="job-t" set:html={j.titel} />
                  <span class="job-m">{j.meta}</span>
                </span>
                <span class="job-k">{j.kurz}</span>
                <span class="job-i" aria-hidden="true"><Icon name="plus" /></span>
              </summary>
              <div class="job-body">
                <div class="job-cols">
                  {j.teile.map((t) => (
                    <div>
                      <h3 class="job-h">{t.t}</h3>
                      <p class="small">{t.d}</p>
                    </div>
                  ))}
                </div>
                <a class="pill solid" href={mailFor(j.titel)}><span>Jetzt per E-Mail bewerben</span><Icon name="mail" /></a>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  :global(.phero) .hero-btn {
    margin-top: 1.6rem;
  }

  .vt-wrap,
  .jobs-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .vt-head,
  .jobs-head {
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  /* kleiner als sonst, damit „Verstärkung.“ nicht an die Stellen stößt */
  .jobs-head .h-sec {
    font-size: clamp(2.6rem, 4.6vw, 4.8rem);
  }
  .jobs-head .small {
    margin: 0;
    max-width: 34ch;
  }
  .jobs-head a {
    color: var(--blue);
  }
  .vorteile {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem) clamp(2rem, 4vw, 4rem);
  }
  .v {
    position: relative;
  }
  .v-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 0.97;
    color: var(--blue);
    margin: 0 0 0.8rem;
  }
  .v .small {
    margin: 0;
    max-width: 38ch;
  }

  /* Stellen: aufklappbar */
  .jobs {
    display: grid;
    gap: 6px;
  }
  .job {
    background: #fff;
  }
  .job summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.5rem 1.5rem;
    align-items: center;
    padding: clamp(1.3rem, 2.4vw, 2rem) clamp(1.3rem, 2.4vw, 2rem);
    transition: background 0.25s ease;
  }
  .job summary::-webkit-details-marker {
    display: none;
  }
  .job summary:hover {
    background: var(--stone-50);
  }
  .job-top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1.4rem;
  }
  .job-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.7rem, 2.6vw, 2.6rem);
    line-height: 0.97;
    color: var(--blue);
  }
  .job-m {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .job-k {
    grid-row: 2;
    font-size: 1.0625rem;
    font-weight: 300;
    color: var(--ink-2);
  }
  .job-i {
    grid-row: 1 / 3;
    grid-column: 2;
    width: 46px;
    height: 46px;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--blue);
    color: var(--blue);
    transition:
      background 0.3s ease,
      color 0.3s ease,
      transform 0.4s var(--ease);
  }
  .job-i :global(svg) {
    width: 20px;
    height: 20px;
  }
  .job summary:hover .job-i,
  .job[open] .job-i {
    background: var(--blue);
    color: #fff;
  }
  .job-i :global(svg) {
    transition: transform 0.4s var(--ease);
  }
  .job[open] .job-i :global(svg) {
    transform: rotate(45deg);
  }
  .job-body {
    padding: 0 clamp(1.3rem, 2.4vw, 2rem) clamp(1.6rem, 3vw, 2.4rem);
    display: grid;
    gap: 1.8rem;
    justify-items: start;
  }
  .job-cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 1.4rem 2.4rem;
    width: 100%;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .job-h {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.3rem, 1.6vw, 1.6rem);
    line-height: 1;
    color: var(--blue);
    margin: 0 0 0.6rem;
  }
  .job-cols .small {
    margin: 0;
  }

  @media (max-width: 900px) {
    .vt-wrap,
    .jobs-wrap {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .vorteile {
      grid-template-columns: minmax(0, 1fr);
    }
    .job-i {
      width: 40px;
      height: 40px;
    }
  }
</style>
