---
import { Image, getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import Picto from '~/components/Picto.astro';
import QHammer from '~/components/QHammer.astro';
import { firma, leistungen, GRUENDUNGSJAHR } from '~/data/site';
import { url } from '~/lib/url';
import heroPoster from '~/assets/site/hero-poster.jpg';
import filmPoster from '~/assets/site/film-poster.jpg';
import teamFoto from '~/assets/team/baustellenteam.jpg';

const heroPosterImg = await getImage({ src: heroPoster, width: 1920, format: 'jpg', quality: 70 });
const filmPosterImg = await getImage({ src: filmPoster, width: 1600, format: 'jpg', quality: 70 });

/* Leistungen */
const svcInfo: Record<string, { bild: string; a: string; b: string; text: string }> = {
  rohbau: {
    bild: 'grosse-johannisstrasse',
    a: 'Rohbau &',
    b: 'Stahlbetonbau',
    text: 'Rohbauten in Beton- und Stahlbetonbauweise – vom Fundament über die Tiefgarage bis zur letzten Decke.',
  },
  'schluesselfertiges-bauen': {
    bild: 'steinwegel',
    a: 'Schlüssel­fertiges',
    b: 'Bauen',
    text: 'Vom Rohbau bis zur Übergabe koordinieren wir alle Gewerke – mit einem festen Ansprechpartner.',
  },
  'umbau-sanierung': {
    bild: 'bellevue-50',
    a: 'Umbau &',
    b: 'Sanierung',
    text: 'Umbauten, Erweiterungen und Sanierungen im Bestand – von der Stadtvilla bis zum Alsterpalais.',
  },
};
const services = await Promise.all(
  leistungen.map(async (l) => {
    const info = svcInfo[l.slug]!;
    return { ...l, ...info, img: (await getEntry('projekte', info.bild))!.data.bilder[0]! };
  }),
);

/* Drei Projekte zum Durchscrollen */
const ort = (fakten: { label: string; value: string }[]) =>
  (fakten.find((f) => f.label === 'Adresse')?.value.split('\n').pop() ?? '').replace(/^\d{5}\s*/, '');
const showcase = await Promise.all(
  ['hanseforum', 'kinderwelt', 'horner-landstrasse'].map(async (id) => {
    const p = (await getEntry('projekte', id))!;
    return { id, ...p.data, ort: ort(p.data.fakten) };
  }),
);

const introBild = (await getEntry('projekte', 'milchgrund'))!.data.bilder[0]!;

const fakten = [
  { zahl: String(GRUENDUNGSJAHR), label: 'Gegründet' },
  { zahl: `${firma.projekteAnzahl}+`, label: 'Projekte' },
  { zahl: String(firma.mitarbeiter), label: 'Mitarbeiter' },
  { zahl: 'HH', label: 'Hamburg & Umgebung' },
];

const werte = [
  { picto: 'siegel', t: 'Verlässlich', d: 'Wir stehen zu unserem Wort.' },
  { picto: 'hammer', t: 'Sorgfältig', d: 'Bis zum Schluss – in jedem Detail.' },
  { picto: 'helm', t: 'Partnerschaftlich', d: 'Mit Auftraggebern und im Team.' },
] as const;
---

<Base title="Start">
  <!-- Blaue Linie, die sich beim Scrollen durch die Seite zieht -->
  <svg class="flow" data-flow aria-hidden="true"><path data-flow-path></path></svg>

  <!-- ======================= HERO ======================= -->
  <section class="hero" data-hero>
    <div class="hero-media">
      <video class="hero-video" autoplay muted loop playsinline preload="auto" poster={heroPosterImg.src} data-autoplay aria-hidden="true">
        <source src={url('/video/hero-540.mp4')} type="video/mp4" media="(max-width: 767px)" />
        <source src={url('/video/hero-1080.mp4')} type="video/mp4" />
      </video>
    </div>
    <div class="hero-slab" aria-hidden="true"></div>

    <div class="container hero-content">
      <p class="hero-eyebrow">Bauunternehmen Quirling · Hamburg · seit {GRUENDUNGSJAHR}</p>
      <h1 class="h-display hero-title">Qualität,<br /><span class="lt">die steht.</span></h1>
      <a class="pill light" href={url('/leistungen/')}><span>Leistungen entdecken</span><Icon name="arrow" /></a>
    </div>

    <span class="flow-knot" data-flow-start aria-hidden="true"><QHammer class="knot-hammer" color="#3948A4" /></span>
  </section>

  <!-- ======================= INTRO ======================= -->
  <section class="intro">
    <div class="container intro-grid">
      <div>
        <h2 class="h1 intro-h">Massiv gebaut.<br /><span class="lt">Sorgfältig</span><br /><span class="c-blue">übergeben.</span></h2>
        <p class="intro-p" data-reveal>
          Seit {GRUENDUNGSJAHR} bauen wir in Hamburg und Umgebung – mit einem eingespielten Team, kurzen Wegen und dem Anspruch, jede Arbeit bis zum
          Schluss sorgfältig auszuführen.
        </p>
        <a class="pill" href={url('/unternehmen/')}><span>Mehr über uns</span><Icon name="arrow" /></a>
      </div>
      <div class="intro-visual" data-reveal>
        <span class="slab slab-intro" aria-hidden="true"></span>
        <div class="cut-img intro-img">
          <Image src={introBild} alt="Wohnanlage Milchgrund, Hamburg" widths={[600, 1000, 1400]} sizes="(min-width: 900px) 50vw, 100vw" />
        </div>
      </div>
    </div>
    <div class="container">
      <dl class="figures" data-flow-cross>
        {
          fakten.map((f) => (
            <div class="fig">
              <dd>{f.zahl}</dd>
              <dt>{f.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ======================= LEISTUNGEN ======================= -->
  <section class="services" data-services aria-labelledby="svc-h">
    <div class="container svc-head">
      <p class="eyebrow">Leistungen</p>
      <h2 id="svc-h" class="h2">Was wir <span class="lt">bauen.</span></h2>
    </div>
    {
      services.map((s, i) => (
        <article class:list={['svc', { flip: i % 2 === 1 }]}>
          <div class="container svc-grid">
            <a class="svc-visual" href={url(`/leistungen/${s.slug}/`)} tabindex="-1" aria-hidden="true" data-reveal>
              <span class="slab slab-svc" />
              <span class="cut-img svc-img">
                <Image src={s.img} alt="" widths={[600, 1000, 1400]} sizes="(min-width: 900px) 55vw, 100vw" />
              </span>
            </a>
            <div class="svc-text" data-reveal>
              <span class="svc-picto">
                <Picto name={s.picto} />
              </span>
              <h3 class="h2 svc-title">
                <span class="c-blue">{s.a}</span>
                <br />
                <span class="lt">{s.b}</span>
              </h3>
              <p>{s.text}</p>
              <a class="pill" href={url(`/leistungen/${s.slug}/`)}>
                <span>Mehr erfahren</span>
                <Icon name="arrow" />
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <!-- ======================= PROJEKTE (3 × scrollen) ======================= -->
  <section class="show" data-show aria-labelledby="show-h">
    <div class="show-in">
      <div class="show-text">
        <p class="eyebrow">Referenzen</p>
        <h2 id="show-h" class="h2 show-h">Projekte, <span class="lt">die stehen.</span></h2>
        <div class="show-items">
          {
            showcase.map((p, i) => (
              <div class:list={['show-item', { 'is-active': i === 0 }]} data-show-item>
                <span class="show-nr">
                  {String(i + 1).padStart(2, '0')} <span class="lt">/ {String(showcase.length).padStart(2, '0')}</span>
                </span>
                <h3 class="show-title">{p.title}</h3>
                <p class="show-meta">
                  {p.kategorien[0]} · {p.ort}
                  {p.jahr && ` · ${p.jahr}`}
                </p>
                <p class="show-desc">{p.leistung}</p>
                <a class="link-arrow" href={url(`/referenzen/${p.id}/`)} tabindex={i === 0 ? undefined : -1}>
                  Projekt ansehen <Icon name="arrow" />
                </a>
              </div>
            ))
          }
        </div>
        <a class="pill" href={url('/referenzen/')}><span>Alle Referenzen</span><Icon name="arrow" /></a>
      </div>
      <div class="show-stage">
        {
          showcase.map((p, i) => (
            <a class="show-img" href={url(`/referenzen/${p.id}/`)} data-show-img tabindex="-1" style={`z-index:${i + 1}`}>
              <Image src={p.bilder[0]!} alt={`${p.title} – ${p.leistung}`} widths={[900, 1400, 2000]} sizes="(min-width: 900px) 62vw, 100vw" />
              <span class="show-cap">
                <strong>{p.title}</strong>
                {p.kategorien[0]} · {p.ort}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================= WERTE ======================= -->
  <section class="values on-blue">
    <div class="container">
      <h2 class="h2 values-h">Sorgfältig bauen:<br /><span class="lt">unsere Werte</span></h2>
      <div class="values-grid" data-reveal data-reveal-children>
        {
          werte.map((w) => (
            <div class="value">
              <Picto name={w.picto} class="value-picto" />
              <h3>{w.t}</h3>
              <p>{w.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================= KARRIERE ======================= -->
  <section class="career">
    <div class="container career-grid">
      <div class="career-visual" data-reveal>
        <div class="cut-img career-img">
          <Image src={teamFoto} alt="Das Team der Quirling GmbH" widths={[600, 1000, 1400]} sizes="(min-width: 900px) 50vw, 100vw" />
        </div>
        <div class="career-label">
          <span class="cl-a"><QHammer class="cl-hammer" color="#fff" highlight="#3948A4" />Mit anpacken</span>
          <span class="cl-b">bei Quirling</span>
        </div>
      </div>
      <div class="career-text" data-reveal>
        <p class="career-lead">{firma.mitarbeiter} Profis, ein eingespieltes Team – und Platz für Verstärkung auf der Baustelle und im Büro.</p>
        <ul class="arrows">
          <li>Vielseitige Bauvorhaben in Hamburg</li>
          <li>Festes, beständiges Team</li>
          <li>Kurze Wege, direkte Ansprache</li>
        </ul>
        <a class="pill" href={url('/karriere/')}><span>Jetzt bewerben</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- ======================= FILM (Raute) ======================= -->
  <section class="film" data-film>
    <div class="film-sticky">
      <div class="film-frame" data-film-frame>
        <video autoplay muted loop playsinline preload="none" poster={filmPosterImg.src} data-autoplay aria-hidden="true">
          <source src={url('/video/film-loop.mp4')} type="video/mp4" />
        </video>
      </div>
      <div class="film-ui" data-film-ui>
        <h2 class="h-display">Quirling<br /><span class="lt">von oben.</span></h2>
        <button class="play" type="button" data-film-open>
          <span class="play-ring"><Icon name="play" /></span>
          <span class="play-text">Film ansehen</span>
        </button>
      </div>
    </div>
  </section>

  <dialog class="film-modal" data-film-modal aria-label="Film: Quirling von oben">
    <video class="fm-video" controls playsinline preload="none" poster={filmPosterImg.src} data-film-video>
      <source src={url('/video/quirling-film-720.mp4')} type="video/mp4" />
    </video>
    <button type="button" class="fm-close" data-film-close aria-label="Schließen"><Icon name="close" /></button>
  </dialog>
</Base>

<style>
  /* ---------- Bausteine ---------- */
  .slab {
    position: absolute;
    background: var(--blue);
    pointer-events: none;
  }
  .cut-img {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--stone-200);
  }
  .cut-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Linie ---------- */
  .flow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }
  .flow path {
    fill: none;
    stroke: var(--blue);
    stroke-width: 1.5;
    stroke-linejoin: miter;
  }
  .flow-knot {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #fff;
    display: grid;
    place-items: center;
    transform: translate(-50%, 50%);
    z-index: 3;
    box-shadow: 0 0 0 1.5px var(--blue);
  }
  .flow-knot :global(.knot-hammer) {
    width: 30px;
    height: 30px;
  }

  /* ======================= HERO ======================= */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    color: #fff;
    background: var(--navy);
    z-index: 2;
  }
  .hero-media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-slab {
    position: absolute;
    inset: 0 auto 0 0;
    width: min(60vw, 980px);
    background: rgb(57 72 164 / 0.88);
    clip-path: polygon(0 0, 100% 0, 66% 100%, 0 100%);
  }
  .hero-content {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-top: var(--header-h);
  }
  .hero-eyebrow {
    font-family: var(--font-head);
    font-stretch: 120%;
    font-weight: 500;
    font-size: clamp(0.85rem, 1.1vw, 1.05rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1.4rem;
    color: rgb(255 255 255 / 0.85);
  }
  .hero-title {
    margin-bottom: 2.4rem;
  }

  /* ======================= INTRO ======================= */
  .intro {
    padding-block: clamp(6rem, 11vw, 10rem) clamp(4rem, 7vw, 6rem);
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
  .intro-h {
    color: var(--ink-2);
    margin-bottom: 2rem;
  }
  .intro-p {
    max-width: 30rem;
    color: var(--ink-3);
    margin-bottom: 2rem;
  }
  .intro-visual {
    position: relative;
    padding: 2.5rem 0 2.5rem 2.5rem;
  }
  .slab-intro {
    top: 0;
    bottom: 0;
    right: 0;
    width: 55%;
    clip-path: polygon(34% 0, 100% 0, 100% 100%, 0 100%);
  }
  .intro-img {
    aspect-ratio: 4 / 3;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 12% 100%);
    margin-right: 2.5rem;
  }
  .figures {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: clamp(4rem, 8vw, 7rem) 0 0;
  }
  .fig {
    padding: 2rem 1rem 0 0;
    display: flex;
    flex-direction: column;
  }
  .fig + .fig {
    padding-left: 1.5rem;
    border-left: 1px solid var(--line);
  }
  .fig dd {
    order: -1;
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(2rem, 3.6vw, 3.2rem);
    line-height: 1;
    color: var(--blue);
  }
  .fig dt {
    margin-top: 0.5rem;
    font-family: var(--font-head);
    font-stretch: 115%;
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  /* ======================= LEISTUNGEN ======================= */
  .services {
    padding-block: clamp(3rem, 6vw, 5rem) clamp(5rem, 9vw, 8rem);
  }
  .svc-head {
    margin-bottom: clamp(1rem, 3vw, 2rem);
  }
  .svc-head .h2 {
    color: var(--ink-2);
  }
  .svc {
    padding-block: clamp(3rem, 6vw, 5rem);
  }
  .svc-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
  .svc.flip .svc-visual {
    order: 2;
  }
  .svc-visual {
    position: relative;
    display: block;
    padding: 2rem 0 2rem 2rem;
  }
  .svc.flip .svc-visual {
    padding: 2rem 2rem 2rem 0;
  }
  .slab-svc {
    left: 0;
    top: 0;
    bottom: 0;
    width: 40%;
    clip-path: polygon(0 0, 100% 0, 60% 100%, 0 100%);
  }
  .svc.flip .slab-svc {
    left: auto;
    right: 0;
    clip-path: polygon(40% 0, 100% 0, 100% 100%, 0 100%);
  }
  .svc-img {
    aspect-ratio: 16 / 11;
    clip-path: polygon(0 0, 100% 0, 88% 100%, 0 100%);
  }
  .svc.flip .svc-img {
    clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%);
  }
  .svc-img :global(img) {
    transition: transform 1.2s var(--ease);
  }
  .svc-visual:hover .svc-img :global(img) {
    transform: scale(1.03);
  }
  .svc-text {
    max-width: 30rem;
  }
  .svc-picto {
    display: inline-grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1px solid var(--line);
    margin-bottom: 1.6rem;
  }
  .svc-picto :global(svg) {
    width: 34px;
    height: 34px;
  }
  .svc-title {
    margin-bottom: 1.4rem;
    hyphens: manual;
    overflow-wrap: normal;
  }
  .svc-text p {
    color: var(--ink-3);
    margin-bottom: 2rem;
  }

  /* ======================= PROJEKTE ======================= */
  .show {
    position: relative;
    z-index: 2;
    background: #fff;
  }
  .show-in {
    display: grid;
    grid-template-columns: minmax(340px, 0.72fr) 1.6fr;
    height: 100vh;
    min-height: 620px;
  }
  .show-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: calc(var(--header-h) + 1rem) clamp(2rem, 4vw, 4rem) 3rem max(var(--gutter), calc((100vw - var(--container)) / 2));
  }
  .show-h {
    font-size: clamp(1.6rem, 2.5vw, 2.4rem);
    overflow-wrap: normal;
    hyphens: manual;
    color: var(--ink-2);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .show-items {
    display: grid;
    margin-bottom: 2.5rem;
  }
  .show-item {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s ease,
      visibility 0s 0.5s;
  }
  .show-item.is-active {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .show-nr {
    display: block;
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 1rem;
    color: var(--blue);
    margin-bottom: 1rem;
  }
  .show-title {
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(1.5rem, 2.4vw, 2.2rem);
    text-transform: uppercase;
    line-height: 1.02;
  }
  .show-meta {
    font-family: var(--font-head);
    font-stretch: 115%;
    font-weight: 300;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0.5rem 0 1.2rem;
  }
  .show-desc {
    color: var(--ink-3);
    font-size: 1rem;
    max-width: 24rem;
    margin-bottom: 1.4rem;
  }
  .show-stage {
    position: relative;
    overflow: hidden;
    clip-path: polygon(14% 0, 100% 0, 100% 100%, 0 100%);
  }
  .show-img {
    position: absolute;
    inset: 0;
    display: block;
  }
  .show-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .show-cap {
    display: none;
  }

  /* ======================= WERTE ======================= */
  .values {
    position: relative;
    z-index: 2;
    padding-block: clamp(4.5rem, 9vw, 8rem);
  }
  .values-h {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .value {
    padding: 0 2rem 0.5rem;
    border-left: 1px solid rgb(255 255 255 / 0.35);
  }
  .value :global(.value-picto) {
    width: 60px;
    height: 60px;
    --accent: #c9d0f5;
    stroke-width: 1.2;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .value h3 {
    font-stretch: 125%;
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }
  .value p {
    color: rgb(255 255 255 / 0.82);
    margin: 0;
  }

  /* ======================= KARRIERE ======================= */
  .career {
    padding-block: clamp(5rem, 10vw, 9rem);
  }
  .career-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .career-visual {
    position: relative;
  }
  .career-img {
    aspect-ratio: 4 / 3.2;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 12% 100%);
  }
  .career-label {
    position: absolute;
    left: -1.5rem;
    top: 2rem;
    display: grid;
    justify-items: start;
  }
  .cl-a,
  .cl-b {
    background: var(--blue);
    color: #fff;
    font-family: var(--font-head);
    font-stretch: 125%;
    text-transform: uppercase;
    line-height: 1;
  }
  .cl-a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    font-size: clamp(1.4rem, 2.6vw, 2.3rem);
    padding: 0.7rem 1.1rem 0.6rem;
  }
  .cl-a :global(.cl-hammer) {
    width: 1.1em;
    height: 1.1em;
  }
  .cl-b {
    font-weight: 300;
    font-size: clamp(0.95rem, 1.5vw, 1.3rem);
    padding: 0.35rem 1.1rem 0.5rem;
  }
  .career-lead {
    font-size: clamp(1.15rem, 1.5vw, 1.35rem);
    line-height: 1.5;
    color: var(--ink-2);
    margin-bottom: 1.8rem;
    max-width: 28rem;
  }
  .arrows {
    list-style: none;
    padding: 0;
    margin: 0 0 2.2rem;
    display: grid;
    gap: 0.7rem;
  }
  .arrows li {
    position: relative;
    padding-left: 1.6rem;
    color: var(--ink-2);
  }
  .arrows li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.5em;
    height: 0.5em;
    background: var(--blue);
    transform: rotate(45deg);
  }

  /* ======================= FILM ======================= */
  .film {
    position: relative;
    height: 200vh;
  }
  .film-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: grid;
    place-items: center;
    z-index: 2;
  }
  .film-frame {
    position: absolute;
    inset: 0;
    background: var(--navy);
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
  }
  .film-frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(18 23 53 / 0.4);
  }
  .film-ui {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    display: grid;
    justify-items: center;
    gap: 2rem;
    padding-inline: var(--gutter);
  }
  .play {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    background: none;
    border: 0;
    color: #fff;
    cursor: pointer;
    font: inherit;
    padding: 0;
  }
  .play-ring {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: rgb(255 255 255 / 0.15);
    border: 1px solid rgb(255 255 255 / 0.6);
    backdrop-filter: blur(6px);
    transition: background 0.3s ease;
  }
  .play-ring :global(svg) {
    width: 24px;
    height: 24px;
    margin-left: 4px;
  }
  .play:hover .play-ring {
    background: var(--blue);
    border-color: var(--blue);
  }
  .play-text {
    font-family: var(--font-head);
    font-stretch: 120%;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .film-modal {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(10 12 28 / 0.95);
  }
  .film-modal[open] {
    display: grid;
    place-items: center;
  }
  .fm-video {
    width: min(92vw, 160vh);
    aspect-ratio: 16 / 9;
    background: #000;
  }
  .fm-close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.4);
    background: transparent;
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .fm-close :global(svg) {
    width: 22px;
    height: 22px;
  }

  /* ======================= RESPONSIVE ======================= */
  @media (max-width: 900px) {
    .flow,
    .flow-knot {
      display: none;
    }
    .hero-slab {
      width: 100%;
      clip-path: polygon(0 0, 100% 0, 100% 52%, 0 78%);
    }
    .hero-content {
      justify-content: flex-start;
      padding-top: calc(var(--header-h) + 3rem);
    }
    .intro-grid,
    .svc-grid,
    .career-grid {
      grid-template-columns: 1fr;
    }
    .svc.flip .svc-visual {
      order: 0;
    }
    .figures {
      grid-template-columns: 1fr 1fr;
      border-top: 1px solid var(--line);
    }
    .fig:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
    .fig {
      padding-bottom: 1.4rem;
    }
    .show-in {
      grid-template-columns: 1fr;
      height: auto;
    }
    .show-text {
      padding: var(--section) var(--gutter) 2rem;
    }
    .show-items {
      display: none;
    }
    .show-stage {
      display: grid;
      gap: 1.5rem;
      clip-path: none;
      padding: 0 var(--gutter) var(--section);
    }
    .show-img {
      position: relative;
      aspect-ratio: 4 / 3;
      color: #fff;
      text-decoration: none;
    }
    .show-cap {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 2.5rem 1rem 1rem;
      background: linear-gradient(transparent, rgb(18 23 53 / 0.85));
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .show-cap strong {
      display: block;
      font-family: var(--font-head);
      font-stretch: 125%;
      font-weight: 800;
      font-size: 1.15rem;
    }
    .values-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .value :global(.value-picto) {
      margin-bottom: 1.2rem;
    }
    .career-label {
      left: 0;
    }
    .film {
      height: auto;
    }
    .film-sticky {
      position: relative;
      height: 80svh;
    }
    .film-frame {
      clip-path: polygon(50% 4%, 100% 50%, 50% 96%, 0% 50%);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- Projekte: 3 große Bilder, 3 × scrollen (Desktop) ---------- */
  mm.add('(prefers-reduced-motion: no-preference) and (min-width: 901px)', () => {
    const show = document.querySelector<HTMLElement>('[data-show]');
    if (!show) return;
    const imgs = Array.from(show.querySelectorAll<HTMLElement>('[data-show-img]'));
    const items = Array.from(show.querySelectorAll<HTMLElement>('[data-show-item]'));
    const setActive = (i: number) =>
      items.forEach((it, j) => {
        it.classList.toggle('is-active', j === i);
        it.querySelector('a')?.setAttribute('tabindex', j === i ? '0' : '-1');
      });
    imgs.forEach((img, i) => i > 0 && gsap.set(img, { clipPath: 'inset(100% 0% 0% 0%)' }));
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: show,
        start: 'top top',
        end: () => `+=${imgs.length * window.innerHeight}`,
        pin: true,
        scrub: 0.5,
        invalidateOnRefresh: true,
        onUpdate: (self) => setActive(Math.min(imgs.length - 1, Math.floor(self.progress * imgs.length * 0.999 + 0.15))),
      },
    });
    tl.to({}, { duration: 0.5 });
    imgs.slice(1).forEach((img) => {
      tl.to(img, { clipPath: 'inset(0% 0% 0% 0%)', ease: 'power2.inOut', duration: 1 });
      tl.to({}, { duration: 0.5 });
    });
  });

  /* ---------- Film: Raute öffnet sich ---------- */
  mm.add('(prefers-reduced-motion: no-preference) and (min-width: 901px)', () => {
    const film = document.querySelector('[data-film]');
    const frame = document.querySelector('[data-film-frame]');
    const ui = document.querySelector('[data-film-ui]');
    if (!film || !frame) return;
    const tl = gsap.timeline({ scrollTrigger: { trigger: film, start: 'top top', end: 'bottom bottom', scrub: 0.6 } });
    tl.fromTo(frame, { clipPath: 'polygon(50% 22%, 70% 50%, 50% 78%, 30% 50%)' }, { clipPath: 'polygon(50% -60%, 160% 50%, 50% 160%, -60% 50%)', ease: 'none', duration: 1 });
    if (ui) tl.from(ui, { autoAlpha: 0, y: 30, duration: 0.35 }, 0.55);
  });

  /* ---------- Die blaue Linie ---------- */
  const svg = document.querySelector<SVGSVGElement>('[data-flow]');
  const path = svg?.querySelector<SVGPathElement>('[data-flow-path]');
  const knot = document.querySelector<HTMLElement>('[data-flow-start]');
  let total = 0;
  const samples: { len: number; y: number }[] = [];

  const box = (el: Element | null) => {
    if (!el) return null;
    const r = el.getBoundingClientRect();
    return { top: r.top + window.scrollY, bottom: r.bottom + window.scrollY, left: r.left + window.scrollX, right: r.right + window.scrollX };
  };

  const build = () => {
    if (!svg || !path || window.innerWidth <= 900) return;
    const doc = document.documentElement;
    const cont = document.querySelector<HTMLElement>('.intro .container');
    if (!cont) return;
    const cb = box(cont)!;
    const pad = parseFloat(getComputedStyle(cont).paddingLeft);
    const L = Math.max(34, cb.left + pad - 36);
    const R = Math.min(doc.clientWidth - 34, cb.right - pad + 36);
    const hero = box(document.querySelector('[data-hero]'))!;
    const fig = box(document.querySelector('[data-flow-cross]'))!;
    const svcs = box(document.querySelector('[data-services]'))!;
    const film = box(document.querySelector('[data-film]'))!;
    const vh = window.innerHeight;
    const cx = doc.clientWidth / 2;
    const tipY = film.top + vh * 0.22; // obere Spitze der Raute
    const k = (0.28 * vh) / (0.2 * doc.clientWidth); // gleiche Steigung wie die Kante der Raute
    const turnY = svcs.bottom - 60;
    const d = [
      `M${L} ${hero.bottom}`,
      `V${fig.top}`,
      `H${R}`,
      `V${turnY}`,
      `H${L}`,
      `V${film.top + 40}`,
      `H${cx - (tipY - film.top - 40) / k}`,
      `L${cx} ${tipY}`,
    ].join(' ');
    svg.setAttribute('height', String(doc.scrollHeight));
    svg.setAttribute('viewBox', `0 0 ${doc.clientWidth} ${doc.scrollHeight}`);
    path.setAttribute('d', d);
    if (knot) knot.style.left = `${L}px`;
    total = path.getTotalLength();
    samples.length = 0;
    for (let l = 0; l <= total; l += 24) samples.push({ len: l, y: path.getPointAtLength(l).y });
    samples.push({ len: total, y: path.getPointAtLength(total).y });
    path.style.strokeDasharray = `${total}`;
    draw(true);
  };

  const draw = (instant = false) => {
    if (!path || !total) return;
    if (reduce) {
      path.style.strokeDashoffset = '0';
      return;
    }
    const target = window.scrollY + window.innerHeight * 0.62;
    let len = 0;
    for (const s of samples) {
      if (s.y <= target) len = s.len;
      else break;
    }
    gsap.to(path, { strokeDashoffset: total - len, duration: instant ? 0 : 0.9, ease: 'power2.out', overwrite: true });
  };

  if (svg && path) {
    window.addEventListener('scroll', () => draw(), { passive: true });
    window.addEventListener('resize', () => build());
    window.addEventListener('load', () => {
      ScrollTrigger.refresh();
      build();
    });
    ScrollTrigger.addEventListener('refresh', () => build());
    build();
  }

  /* ---------- Film-Overlay ---------- */
  const modal = document.querySelector<HTMLDialogElement>('[data-film-modal]');
  const video = modal?.querySelector<HTMLVideoElement>('[data-film-video]');
  document.querySelectorAll('[data-film-open]').forEach((b) =>
    b.addEventListener('click', () => {
      if (!modal) return;
      modal.showModal();
      video?.play().catch(() => {});
      window.dispatchEvent(new CustomEvent('quirling:lock'));
    }),
  );
  modal?.querySelector('[data-film-close]')?.addEventListener('click', () => modal.close());
  modal?.addEventListener('click', (e) => e.target === modal && modal.close());
  modal?.addEventListener('close', () => {
    video?.pause();
    window.dispatchEvent(new CustomEvent('quirling:unlock'));
  });
</script>
