---
import { Image, getImage } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import Todo from '~/components/Todo.astro';
import CtaBand from '~/components/CtaBand.astro';
import YouTube from '~/components/YouTube.astro';
import { firma, leistungen, platzhalter, youtubeId, JAHRE_ERFAHRUNG, GRUENDUNGSJAHR } from '~/data/site';
import { url } from '~/lib/url';
import poster from '~/assets/site/zeitraffer-poster.jpg';
import teamFoto from '~/assets/team/baustellenteam.jpg';

const highlights = (await getCollection('projekte', (p) => p.data.highlight !== undefined)).sort(
  (a, b) => (a.data.highlight ?? 0) - (b.data.highlight ?? 0),
);
const anzahlReferenzen = (await getCollection('projekte')).length;
const posterImg = await getImage({ src: poster, width: 1920, format: 'jpg', quality: 70 });

const leistungsBilder: Record<string, string> = {
  rohbau: 'lilienstrasse',
  'schluesselfertiges-bauen': 'steinwegel',
  'umbau-sanierung': 'bellevue-50',
};
const leistungenMitBild = await Promise.all(
  leistungen.map(async (l) => {
    const entry = await getEntry('projekte', leistungsBilder[l.slug]!);
    return { ...l, bild: entry!.data.bilder[0]!, projekt: entry!.data.title };
  }),
);
const videoPoster = (await getEntry('projekte', 'milchgrund'))!.data.bilder[0]!;
---

<Base title="Start">
  <!-- HERO -->
  <section class="hero on-dark" data-hero>
    <div class="hero-frame" data-hero-frame>
      <video
        class="hero-video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={posterImg.src}
        data-autoplay
        aria-hidden="true"
      >
        <source src={url('/video/zeitraffer-540.mp4')} type="video/mp4" media="(max-width: 767px)" />
        <source src={url('/video/zeitraffer-1080.mp4')} type="video/mp4" />
      </video>
      <div class="hero-shade"></div>
    </div>
    <div class="container hero-content" data-hero-content>
      <p class="eyebrow light">Bauunternehmen in Hamburg · seit {GRUENDUNGSJAHR}</p>
      <h1 class="h-display" data-split>
        Gebaut wird immer&nbsp;… <span class="accent hero-accent">bei uns mit Qualität.</span>
      </h1>
      <div class="hero-bottom">
        <p class="hero-lead">
          Rohbau, Beton- und Stahlbetonbau, schlüsselfertiges Bauen sowie Umbau und Sanierung – für Bauherren in Hamburg und
          Umgebung.
        </p>
        <div class="hero-btns">
          <a class="btn white" href={url('/referenzen/')}><span>Unsere Projekte</span><Icon name="arrow" /></a>
          <a class="btn ghost" href={url('/kontakt/')}><span>Kontakt aufnehmen</span></a>
        </div>
      </div>
    </div>
    <a class="scroll-hint" href="#intro" aria-label="Weiter nach unten">
      <span>Scrollen</span>
      <Icon name="arrow-down" />
    </a>
  </section>

  <!-- INTRO + ZAHLEN -->
  <section class="section intro bg-white" id="intro">
    <div class="container">
      <p class="eyebrow">Quirling GmbH Bauunternehmen</p>
      <p class="statement" data-scrub-words>
        Wir erstellen Neubauten und führen vielseitige Umbau- und Sanierungsmaßnahmen aus. Unser Schwerpunkt: Rohbauten in Beton- und
        Stahlbetonbauweise. Eine Basis, auf die Sie bauen können.
      </p>

      <div class="intro-grid">
        <div class="intro-text" data-reveal>
          <p>
            Die Quirling GmbH ist ein dynamisches und flexibles Team, das überwiegend aus jungen und erfahrenen Mitarbeitern besteht.
            Bereits in der Anfangsphase konnten wir mit zufriedenen und treuen Kunden rechnen. Mit unseren kompetenten Mitarbeitern konnten
            wir uns an vielseitigen Bauten beweisen.
          </p>
          <p>
            Wir setzen auf partnerschaftliche Beziehungen und stehen im ständigen Kontakt mit unseren Auftraggebern. Kommunikation wird bei
            uns großgeschrieben. Genauso setzen wir auf Qualität: Bei uns werden die Arbeiten bis zum Schluss sorgfältig ausgeführt.
          </p>
          <a class="link-arrow" href={url('/unternehmen/')}>Mehr über uns <Icon name="arrow" /></a>
        </div>

        <dl class="stats" data-reveal data-reveal-children>
          <div class="stat">
            <dt>Jahre Erfahrung</dt>
            <dd><span data-count={JAHRE_ERFAHRUNG}>{JAHRE_ERFAHRUNG}</span></dd>
          </div>
          <div class="stat">
            <dt>Realisierte Projekte</dt>
            <dd>
              <span class="plus">mehr als</span><span data-count={firma.projekteAnzahl}>{firma.projekteAnzahl}</span>
            </dd>
          </div>
          <div class="stat">
            <dt>Mitarbeiter</dt>
            <dd><Todo hint="Anzahl fehlt">{platzhalter.mitarbeiter}</Todo></dd>
          </div>
          <div class="stat">
            <dt>Einsatzgebiet</dt>
            <dd class="small">Hamburg &amp; Umgebung</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <!-- LEISTUNGEN (gestapelte Karten) -->
  <section class="section leistungen bg-stone">
    <div class="container">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Leistungen</p>
          <h2 class="h2" data-split>Was wir bauen.</h2>
        </div>
        <p class="lead" data-reveal>
          Vom Fundament bis zur Übergabe: Wir übernehmen den Rohbau, bauen schlüsselfertig oder bringen bestehende Gebäude auf den neuesten
          Stand.
        </p>
      </div>

      <div class="stack" data-stack>
        {
          leistungenMitBild.map((l) => (
            <article class="scard" data-stack-card>
              <a class="scard-in" href={url(`/leistungen/${l.slug}/`)}>
                <div class="scard-img media">
                  <Image src={l.bild} alt={`Projekt ${l.projekt}`} widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 55vw, 100vw" />
                </div>
                <div class="scard-text">
                  <span class="scard-nr">{l.nr}</span>
                  <h3 class="h3">{l.title}</h3>
                  <p>{l.kurz}</p>
                  <span class="link-arrow">
                    Mehr erfahren <Icon name="arrow" />
                  </span>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROJEKTE (horizontal) -->
  <section class="projects on-dark" data-hscroll>
    <div class="projects-inner">
      <div class="container proj-head">
        <div>
          <p class="eyebrow light">Ausgewählte Referenzen</p>
          <h2 class="h2" data-split>Projekte, die für uns sprechen.</h2>
        </div>
        <a class="btn ghost" href={url('/referenzen/')}><span>Alle Referenzen</span><Icon name="arrow" /></a>
      </div>
      <div class="track" data-track>
        {
          highlights.map((p, i) => (
            <a class="slide" href={url(`/referenzen/${p.id}/`)}>
              <div class="slide-img media">
                <Image
                  src={p.data.bilder[0]!}
                  alt={`${p.data.title} – ${p.data.leistung}`}
                  widths={[600, 1000, 1400]}
                  sizes="(min-width: 1024px) 42vw, 85vw"
                />
              </div>
              <div class="slide-meta">
                <span class="slide-nr">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="h4">{p.data.title}</h3>
                  <p>
                    {p.data.leistung}
                    {p.data.jahr && <> · {p.data.jahr}</>}
                  </p>
                </div>
              </div>
            </a>
          ))
        }
        <a class="slide slide-more" href={url('/referenzen/')}>
          <span class="more-count">{anzahlReferenzen}</span>
          <span class="more-text">Referenzen online – und mehr als {firma.projekteAnzahl} Projekte seit {GRUENDUNGSJAHR}.</span>
          <span class="link-arrow">Zur Übersicht <Icon name="arrow" /></span>
        </a>
      </div>
      <div class="container progress-wrap"><div class="progress"><span data-progress></span></div></div>
    </div>
  </section>

  <!-- SLOGAN-LAUFBAND -->
  <section class="marquee bg-white" data-marquee aria-label={`${firma.slogan[0]} ${firma.slogan[1]}`}>
    <div class="marquee-track accent" data-marquee-track aria-hidden="true">
      {
        Array.from({ length: 4 }).map(() => (
          <span>
            Gebaut wird immer … <em>bei uns mit Qualität</em>
            <i class="mq-diamond" />
          </span>
        ))
      }
    </div>
  </section>

  <!-- VIDEO -->
  <section class="section video-sec bg-white">
    <div class="container">
      <div class="sec-head">
        <div>
          <p class="eyebrow">Aus der Luft</p>
          <h2 class="h2" data-split>Unsere Baustellen von oben.</h2>
        </div>
        <p class="lead" data-reveal>Drohnenaufnahmen unserer Bauvorhaben in Hamburg – ein Blick auf das, was wir täglich bauen.</p>
      </div>
      <div data-clip class="video-clip">
        <YouTube id={youtubeId} title="Quirling Bauunternehmen – Drohnenaufnahmen" poster={videoPoster} />
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="section team-teaser bg-stone">
    <div class="container team-grid">
      <div class="team-img media parallax" data-parallax>
        <Image src={teamFoto} alt="Das Baustellenteam der Quirling GmbH" widths={[700, 1100, 1600]} sizes="(min-width: 1024px) 58vw, 100vw" />
      </div>
      <div class="team-text" data-reveal>
        <p class="eyebrow">Unternehmen</p>
        <h2 class="h2">Ein eingespieltes, beständiges Team.</h2>
        <p>
          Wir bauen auch auf eine Partnerschaft mit unseren Mitarbeitern und schaffen so ein angenehmes Arbeitsklima. Ein zufriedenes Team
          ist auch für den Auftraggeber nicht nur angenehm, sondern auch vielversprechend.
        </p>
        <div class="team-links">
          <a class="link-arrow" href={url('/unternehmen/team/')}>Unser Team <Icon name="arrow" /></a>
          <a class="link-arrow" href={url('/unternehmen/zertifikate/')}>Zertifikate &amp; Downloads <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- KARRIERE -->
  <section class="section career on-dark">
    <div class="diamond career-diamond" data-spin></div>
    <div class="container career-inner">
      <div>
        <p class="eyebrow light">Karriere</p>
        <h2 class="h1" data-split>Mit anpacken?</h2>
      </div>
      <div data-reveal>
        <p class="lead">
          Wir suchen Menschen, die gerne bauen – auf der Baustelle und im Büro. Bewerben Sie sich unkompliziert per E-Mail.
        </p>
        <a class="btn white" href={url('/karriere/')}><span>Karriere bei Quirling</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* HERO */
  .hero {
    position: relative;
    min-height: 100svh;
    min-height: 620px;
    display: flex;
    align-items: flex-end;
    background: var(--stone-50);
    isolation: isolate;
  }
  .hero-frame {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--navy);
    clip-path: inset(0% 0% 0% 0% round 0px);
    z-index: -1;
  }
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgb(18 23 53 / 0.85) 0%, rgb(18 23 53 / 0.35) 50%, rgb(18 23 53 / 0.3) 100%),
      linear-gradient(to right, rgb(18 23 53 / 0.55), transparent 65%);
  }
  .hero-content {
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: clamp(4.5rem, 10vh, 8rem);
  }
  .hero h1 {
    max-width: 14ch;
  }
  .hero-accent {
    display: block;
    font-size: 0.8em;
    color: #c9d0f5;
    margin-top: 0.15em;
  }
  .hero-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-top: clamp(2rem, 5vh, 3.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line-light);
  }
  .hero-lead {
    max-width: 36rem;
    font-size: clamp(1.05rem, 1.2vw, 1.25rem);
    margin: 0;
  }
  .hero-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .hero .btn.ghost {
    color: #fff;
  }
  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 1.1rem;
    transform: translateX(-50%);
    display: none;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: rgb(255 255 255 / 0.75);
  }
  .scroll-hint :global(svg) {
    width: 1.1rem;
    animation: nudge 2.2s var(--ease) infinite;
  }
  @keyframes nudge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(8px);
    }
  }
  @media (min-width: 1024px) and (min-height: 760px) {
    .scroll-hint {
      display: flex;
    }
  }

  /* INTRO */
  .statement {
    font-family: var(--font-head);
    font-stretch: 108%;
    font-weight: 560;
    font-size: clamp(1.7rem, 3.4vw, 3.1rem);
    line-height: 1.18;
    letter-spacing: -0.015em;
    max-width: 30ch;
    color: var(--ink);
    margin-bottom: clamp(3rem, 7vw, 6rem);
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .intro-text {
    color: var(--ink-2);
    max-width: 38rem;
  }
  .intro-text .link-arrow {
    margin-top: 1rem;
  }
  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .stat {
    padding: 1.6rem 0 1.8rem;
    border-bottom: 1px solid var(--line);
  }
  .stat:nth-child(odd) {
    padding-right: 1.5rem;
    border-right: 1px solid var(--line);
  }
  .stat:nth-child(even) {
    padding-left: 1.5rem;
  }
  .stat dt {
    font-size: 0.95rem;
    color: var(--ink-3);
    order: 2;
  }
  .stat dd {
    margin: 0.3rem 0 0;
    font-family: var(--font-head);
    font-stretch: 118%;
    font-weight: 650;
    font-size: clamp(2.6rem, 5vw, 4.4rem);
    line-height: 1;
    color: var(--blue);
    font-variant-numeric: tabular-nums;
  }
  .stat dd.small {
    font-size: clamp(1.4rem, 2.2vw, 1.9rem);
    line-height: 1.15;
    padding-top: 0.5rem;
  }
  .stat .plus {
    display: block;
    font-size: 0.9rem;
    font-weight: 500;
    font-family: var(--font-body);
    color: var(--ink-3);
    margin-bottom: 0.2rem;
  }

  /* LEISTUNGEN */
  .sec-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 4rem;
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }
  .sec-head .lead {
    max-width: 36rem;
  }
  .stack {
    display: grid;
    gap: 1.5rem;
  }
  .scard {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    transform-origin: center top;
  }
  .scard-in {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    min-height: min(68vh, 600px);
    background: #fff;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 30px 60px -40px rgb(18 23 53 / 0.45);
  }
  .scard-img {
    min-height: 300px;
  }
  .scard-img :global(img) {
    transition: transform 1.2s var(--ease);
  }
  .scard-in:hover .scard-img :global(img) {
    transform: scale(1.04);
  }
  .scard-text {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1.1rem;
    padding: clamp(1.75rem, 4vw, 3.5rem);
  }
  .scard-nr {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 700;
    font-size: clamp(3.5rem, 7vw, 6rem);
    line-height: 1;
    color: var(--stone-200);
    margin-bottom: auto;
  }
  .scard-text p {
    color: var(--ink-2);
    max-width: 30rem;
  }

  /* PROJEKTE */
  .projects {
    overflow: hidden;
  }
  .projects-inner {
    padding-block: clamp(4.5rem, 9vw, 7rem) clamp(3rem, 5vw, 4rem);
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .proj-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .proj-head h2 {
    max-width: 16ch;
  }
  .proj-head .btn {
    color: #fff;
  }
  .track {
    display: flex;
    gap: clamp(1rem, 2vw, 2rem);
    padding-inline: var(--gutter);
    padding-inline-start: max(var(--gutter), calc((100vw - var(--container)) / 2));
    width: max-content;
  }
  .slide {
    width: clamp(280px, 40vw, 640px);
    flex: none;
    text-decoration: none;
    color: #fff;
  }
  .slide-img {
    aspect-ratio: 4 / 3;
    background: #1d2350;
  }
  .slide-img :global(img) {
    transition: transform 1.2s var(--ease);
  }
  .slide:hover .slide-img :global(img) {
    transform: scale(1.05);
  }
  .slide-meta {
    display: flex;
    gap: 1.2rem;
    padding-top: 1.2rem;
  }
  .slide-nr {
    font-family: var(--font-head);
    font-size: 0.85rem;
    color: #aab4ea;
    padding-top: 0.2rem;
  }
  .slide-meta p {
    font-size: 0.95rem;
    margin: 0.3rem 0 0;
    color: rgb(255 255 255 / 0.7);
  }
  .slide-more {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1rem;
    width: clamp(260px, 26vw, 400px);
    aspect-ratio: 3 / 4;
    align-self: flex-start;
    padding: 2rem;
    border: 1px solid var(--line-light);
    transition: background 0.3s ease;
  }
  .slide-more:hover {
    background: var(--blue);
  }
  .more-count {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 700;
    font-size: 5rem;
    line-height: 1;
    margin-bottom: auto;
  }
  .more-text {
    font-size: 1.1rem;
    color: rgb(255 255 255 / 0.85);
  }
  .progress-wrap {
    margin-top: 2.5rem;
  }
  .progress {
    height: 2px;
    background: var(--line-light);
  }
  .progress span {
    display: block;
    height: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }
  @media (max-width: 1023px) {
    .track {
      width: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 1rem;
      scrollbar-width: thin;
    }
    .slide {
      width: 82vw;
      scroll-snap-align: start;
    }
    .slide-more {
      width: 70vw;
      aspect-ratio: auto;
      min-height: 320px;
    }
    .progress-wrap {
      display: none;
    }
  }

  /* MARQUEE */
  .marquee {
    overflow: hidden;
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
    border-bottom: 1px solid var(--line);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    font-size: clamp(2.6rem, 7vw, 6.5rem);
    line-height: 1.1;
    white-space: nowrap;
    color: var(--ink);
  }
  .marquee-track > span {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding-right: 0.5em;
  }
  .marquee-track em {
    font-style: normal;
    color: var(--blue);
  }
  .mq-diamond {
    width: 0.5em;
    aspect-ratio: 352 / 245;
    background: var(--grey);
    clip-path: polygon(49.8% 0, 100% 53.3%, 48% 100%, 0 49.6%);
    margin-left: 0.3em;
  }

  /* VIDEO */
  .video-clip {
    overflow: hidden;
  }

  /* TEAM */
  .team-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .team-img {
    aspect-ratio: 3 / 2;
  }
  .team-text p:not(.eyebrow) {
    color: var(--ink-2);
    margin-top: 1.4rem;
  }
  .team-links {
    display: grid;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  /* KARRIERE */
  .career {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .career-diamond {
    width: min(80vw, 980px);
    left: -20%;
    top: -35%;
    background: linear-gradient(135deg, rgb(57 72 164 / 0.55), rgb(57 72 164 / 0.08));
    z-index: -1;
  }
  .career-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 4rem;
    align-items: end;
  }
  .career .lead {
    margin-bottom: 2rem;
    max-width: 34rem;
  }

  @media (max-width: 900px) {
    .intro-grid,
    .sec-head,
    .team-grid,
    .career-inner {
      grid-template-columns: 1fr;
    }
    .scard-in {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .scard-img {
