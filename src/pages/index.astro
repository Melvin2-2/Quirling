---
import { Image, getImage } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Icon from '~/components/Icon.astro';
import QHammer from '~/components/QHammer.astro';
import ValueIcon from '~/components/ValueIcon.astro';
import { firma, leistungen, GRUENDUNGSJAHR } from '~/data/site';
import { url } from '~/lib/url';
import heroPoster from '~/assets/site/hero-poster.jpg';
import filmPoster from '~/assets/site/film-poster.jpg';
import teamFoto from '~/assets/team/baustellenteam.jpg';

const heroPosterImg = await getImage({ src: heroPoster, width: 1920, format: 'jpg', quality: 70 });
const filmPosterImg = await getImage({ src: filmPoster, width: 1600, format: 'jpg', quality: 70 });

/* Leistungen – Bilder folgen der Diagonale der Linie */
const svcInfo: Record<string, { bild: string; text: string }> = {
  rohbau: {
    bild: 'grosse-johannisstrasse',
    text: 'Rohbauten in Beton- und Stahlbetonbauweise – vom Fundament über die Tiefgarage bis zur letzten Decke.',
  },
  'schluesselfertiges-bauen': {
    bild: 'steinwegel',
    text: 'Vom Rohbau bis zur Übergabe koordinieren wir alle Gewerke – mit einem festen Ansprechpartner.',
  },
  'umbau-sanierung': {
    bild: 'bellevue-59',
    text: 'Umbauten, Erweiterungen und Sanierungen im Bestand – von der Stadtvilla bis zum Alsterpalais.',
  },
};
const services = await Promise.all(
  leistungen.map(async (l) => {
    const info = svcInfo[l.slug]!;
    return { ...l, ...info, img: (await getEntry('projekte', info.bild))!.data.bilder[0]! };
  }),
);

/* Drei Projekte zum Durchscrollen */
const fakt = (fakten: { label: string; value: string }[], label: string) => fakten.find((f) => f.label === label)?.value;
const showcase = await Promise.all(
  ['hanseforum', 'prime-selfstorage-barmbek', 'bellevue-50'].map(async (id) => {
    const p = (await getEntry('projekte', id))!;
    const adresse = fakt(p.data.fakten, 'Adresse')?.split('\n') ?? [];
    return { id, ...p.data, strasse: adresse[0] ?? '', ort: (adresse[1] ?? '').replace(/^\d{5}\s*/, '') };
  }),
);

const introBild = (await getEntry('projekte', 'milchgrund'))!.data.bilder[0]!;

const werte = [
  {
    icon: 'familie',
    t: 'Persönlich',
    d: 'Familiengeführt mit kurzen Wegen: Sie sprechen direkt mit den Menschen, die entscheiden.',
  },
  {
    icon: 'dialog',
    t: 'Partnerschaftlich',
    d: 'Wir stehen im ständigen Kontakt mit unseren Auftraggebern – Kommunikation wird bei uns großgeschrieben.',
  },
  {
    icon: 'hammer',
    t: 'Sorgfältig',
    d: 'Unsere Arbeiten werden bis zum Schluss sorgfältig ausgeführt – eine Basis, auf die Sie bauen können.',
  },
] as const;
---

<Base title="Start">
  <!-- Blaue Linie: startet an der Spitze des Hero und endet in der Film-Raute -->
  <svg class="flow" data-flow aria-hidden="true">
    <g data-flow-marks></g>
    <path data-flow-path></path>
  </svg>

  <!-- ======================= HERO ======================= -->
  <section class="hero" data-hero>
    <div class="hero-media">
      <video class="hero-video" autoplay muted loop playsinline preload="auto" poster={heroPosterImg.src} data-autoplay aria-hidden="true">
        <source src={url('/video/hero-540.mp4')} type="video/mp4" media="(max-width: 767px)" />
        <source src={url('/video/hero-1080.mp4')} type="video/mp4" />
      </video>
    </div>
    <div class="hero-slab" aria-hidden="true"></div>
    <div class="container hero-content">
      <h1 class="h-display hero-title">Was wir zusagen,<br /><span class="lt">steht.</span></h1>
      <a class="pill light" href={url('/leistungen/')}><span>Leistungen entdecken</span><Icon name="arrow" /></a>
    </div>
  </section>

  <!-- ======================= INTRO ======================= -->
  <section class="intro">
    <div class="container intro-grid">
      <div class="intro-text">
        <h2 class="h1 intro-h">Massiv gebaut.<br /><span class="lt">Sorgfältig übergeben.</span></h2>
        <p class="intro-p" data-reveal>
          Seit {GRUENDUNGSJAHR} bauen wir in Hamburg und Umgebung – familiengeführt, mit einem eingespielten Team und dem Anspruch, jede Arbeit bis
          zum Schluss sorgfältig auszuführen.
        </p>
        <a class="pill" href={url('/unternehmen/')}><span>Mehr über uns</span><Icon name="arrow" /></a>
      </div>
      <div class="intro-visual" data-reveal>
        <span class="slab slab-intro" aria-hidden="true"></span>
        <div class="cut-img intro-img">
          <Image src={introBild} alt="Wohnanlage Milchgrund, Hamburg" widths={[600, 1000, 1400]} sizes="(min-width: 900px) 50vw, 100vw" />
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= KENNZAHLEN (diagonal) ======================= -->
  <section class="figs" aria-label="Quirling in Zahlen">
    <div class="container">
      <div class="figs-field" data-figs>
        <div class="fg fg-1" data-reveal>
          <strong>{GRUENDUNGSJAHR}</strong>
          <span>Gegründet in Hamburg</span>
        </div>
        <div class="fg fg-2" data-reveal>
          <strong>{firma.mitarbeiter}</strong>
          <span>Profis im Team</span>
        </div>
        <div class="fg fg-3" data-reveal>
          <strong>{firma.projekteAnzahl}<sup>+</sup></strong>
          <span>Projekte realisiert</span>
        </div>
        <div class="fg fg-4" data-reveal>
          <strong>Hamburg &amp; Umgebung</strong>
          <span>Unser Einsatzgebiet</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ======================= LEISTUNGEN ======================= -->
  <section class="services" data-services aria-labelledby="svc-h">
    <div class="container">
      <h2 id="svc-h" class="h2 svc-head">Was wir bauen.</h2>
    </div>
    {
      services.map((s, i) => (
        <article class:list={['svc', `svc-${i + 1}`]} data-svc>
          <div class="container svc-grid">
            <a class="svc-visual" href={url(`/leistungen/${s.slug}/`)} tabindex="-1" aria-hidden="true" data-reveal>
              <span class="slab slab-svc" />
              <span class="cut-img svc-img">
                <Image src={s.img} alt="" widths={[600, 1000, 1400]} sizes="(min-width: 900px) 50vw, 100vw" />
              </span>
            </a>
            <div class="svc-text" data-reveal>
              <h3 class="svc-title">{s.title}</h3>
              <p>{s.text}</p>
              <a class="pill" href={url(`/leistungen/${s.slug}/`)}>
                <span>Mehr erfahren</span>
                <Icon name="arrow" />
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <!-- ======================= PROJEKTE (3 × scrollen) ======================= -->
  <section class="show" data-show aria-labelledby="show-h">
    <div class="show-in">
      <div class="show-text">
        <h2 id="show-h" class="h2 show-h">Projekte,<br /><span class="lt">die stehen.</span></h2>
        <div class="show-items">
          {
            showcase.map((p, i) => (
              <div class:list={['show-item', { 'is-active': i === 0 }]} data-show-item>
                <span class="show-nr">
                  {String(i + 1).padStart(2, '0')} <span class="lt">/ {String(showcase.length).padStart(2, '0')}</span>
                </span>
                <h3 class="show-title">{p.title}</h3>
                <p class="show-desc">{p.leistung}</p>
                <dl class="show-facts">
                  <div>
                    <dt>Ort</dt>
                    <dd>{p.ort}</dd>
                  </div>
                  {p.jahr && (
                    <div>
                      <dt>Fertigstellung</dt>
                      <dd>{p.jahr}</dd>
                    </div>
                  )}
                  <div>
                    <dt>Kategorie</dt>
                    <dd>{p.kategorien[0]}</dd>
                  </div>
                </dl>
                <a class="link-arrow" href={url(`/referenzen/${p.id}/`)} tabindex={i === 0 ? undefined : -1}>
                  Projekt ansehen <Icon name="arrow" />
                </a>
              </div>
            ))
          }
        </div>
        <a class="pill light" href={url('/referenzen/')}><span>Alle Referenzen</span><Icon name="arrow" /></a>
      </div>
      <div class="show-stage">
        {
          showcase.map((p, i) => (
            <a class="show-img" href={url(`/referenzen/${p.id}/`)} data-show-img tabindex="-1" style={`z-index:${i + 1}`}>
              <Image src={p.bilder[0]!} alt={`${p.title} – ${p.leistung}`} widths={[900, 1400, 2000]} sizes="(min-width: 900px) 62vw, 100vw" />
              <span class="show-cap">
                <strong>{p.title}</strong>
                {p.kategorien[0]} · {p.ort}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================= WERTE ======================= -->
  <section class="values on-blue">
    <div class="container">
      <h2 class="h2 values-h">Familienbetrieb.<br /><span class="lt">Seit {GRUENDUNGSJAHR}.</span></h2>
      <div class="values-grid" data-reveal data-reveal-children>
        {
          werte.map((w) => (
            <div class="value">
              <ValueIcon name={w.icon} class="value-icon" />
              <h3>{w.t}</h3>
              <p>{w.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================= KARRIERE ======================= -->
  <section class="career">
    <div class="container career-grid">
      <div class="career-visual" data-reveal>
        <div class="cut-img career-img">
          <Image src={teamFoto} alt="Das Team der Quirling GmbH mit Geschäftsführer Thomas Quirling" widths={[700, 1100, 1440]} sizes="(min-width: 900px) 55vw, 100vw" />
        </div>
        <div class="career-label">
          <span class="cl-a"><QHammer class="cl-hammer" color="#fff" highlight="#3948A4" />Mit anpacken</span>
          <span class="cl-b">bei Quirling</span>
        </div>
      </div>
      <div class="career-text" data-reveal>
        <h2 class="h2 career-h">Werde Teil<br /><span class="lt">des Teams.</span></h2>
        <p class="career-lead">
          Wir sind ein familiengeführtes Team aus erfahrenen Profis und jungen Kollegen – und suchen Verstärkung auf der Baustelle und im Büro.
        </p>
        <ul class="arrows">
          <li>Vielseitige Bauvorhaben in Hamburg</li>
          <li>Festes, eingespieltes Team</li>
          <li>Kurze Wege zur Geschäftsführung</li>
        </ul>
        <a class="pill" href={url('/karriere/')}><span>Jetzt bewerben</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- ======================= FILM (Raute) ======================= -->
  <section class="film" data-film>
    <div class="film-sticky">
      <div class="film-frame" data-film-frame>
        <video autoplay muted loop playsinline preload="none" poster={filmPosterImg.src} data-autoplay aria-hidden="true">
          <source src={url('/video/film-loop.mp4')} type="video/mp4" />
        </video>
      </div>
      <div class="film-ui" data-film-ui>
        <h2 class="h-display">Quirling<br /><span class="lt">von oben.</span></h2>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Bausteine ---------- */
  .slab {
    position: absolute;
    background: var(--blue);
    pointer-events: none;
  }
  .cut-img {
    display: block;
    position: relative;
    overflow: hidden;
    background: var(--stone-200);
  }
  .cut-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- Linie ---------- */
  .flow {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }
  .flow :global(path) {
    fill: none;
    stroke: var(--blue);
    stroke-width: 1.5;
  }
  .flow :global(.mark) {
    fill: var(--tint);
    stroke: var(--blue);
    stroke-width: 1;
    opacity: 0;
    transition: opacity 0.8s ease;
  }
  .flow :global(.mark.is-on) {
    opacity: 1;
  }

  /* ======================= HERO ======================= */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 640px;
    color: #fff;
    background: var(--navy);
    z-index: 2;
    /* Unterkante deutet eine Raute an – Spitze rechts */
    clip-path: polygon(0 0, 100% 0, 100% 94%, 78% 100%, 0 90%);
  }
  .hero-media {
    position: absolute;
    inset: 0;
  }
  .hero-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-slab {
    position: absolute;
    inset: 0 auto 0 0;
    width: min(60vw, 980px);
    background: rgb(57 72 164 / 0.88);
    clip-path: polygon(0 0, 100% 0, 66% 100%, 0 100%);
  }
  .hero-content {
    position: relative;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding-top: var(--header-h);
    padding-bottom: 4rem;
  }
  .hero-title {
    margin-bottom: 2.6rem;
  }

  /* ======================= INTRO ======================= */
  .intro {
    padding-block: clamp(7rem, 12vw, 11rem) clamp(3rem, 6vw, 5rem);
  }
  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
  .intro-h {
    color: var(--blue);
    margin-bottom: 2rem;
  }
  .intro-p {
    max-width: 30rem;
    color: var(--ink-2);
    margin-bottom: 2rem;
  }
  .intro-visual {
    position: relative;
    z-index: 2;
    padding: 2.5rem 0 2.5rem 2.5rem;
  }
  .slab-intro {
    top: 0;
    bottom: 0;
    right: 0;
    width: 55%;
    background: var(--navy);
    clip-path: polygon(34% 0, 100% 0, 100% 100%, 0 100%);
  }
  .intro-img {
    aspect-ratio: 4 / 3;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 12% 100%);
    margin-right: 2.5rem;
  }

  /* ======================= KENNZAHLEN ======================= */
  .figs {
    padding-block: clamp(2rem, 4vw, 3rem) clamp(4rem, 7vw, 6rem);
  }
  .figs-field {
    position: relative;
    height: clamp(560px, 56vw, 760px);
  }
  .fg {
    position: absolute;
    display: grid;
    gap: 0.6rem;
  }
  .fg strong {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    line-height: 0.9;
    color: var(--blue);
    letter-spacing: -0.02em;
  }
  .fg sup {
    font-size: 0.45em;
    vertical-align: top;
    margin-left: 0.05em;
  }
  .fg span {
    font-family: var(--font-head);
    font-stretch: 115%;
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-2);
  }
  /* Zickzack entlang der Diagonale: links oben → rechts → links → rechts unten */
  .fg-1 {
    left: 0;
    top: 0;
  }
  .fg-1 strong {
    font-size: clamp(4.5rem, 12vw, 11rem);
  }
  .fg-2 {
    left: 64%;
    top: 24%;
  }
  .fg-2 strong {
    font-size: clamp(3.4rem, 8vw, 7.4rem);
  }
  .fg-3 {
    left: 3%;
    top: 46%;
  }
  .fg-3 strong {
    font-size: clamp(3.8rem, 9vw, 8.4rem);
    color: var(--navy);
  }
  .fg-4 {
    left: 50%;
    top: 78%;
  }
  .fg-4 strong {
    font-size: clamp(1.4rem, 2.6vw, 2.3rem);
    text-transform: uppercase;
  }

  /* ======================= LEISTUNGEN ======================= */
  .services {
    background: var(--stone-100);
    padding-block: clamp(5rem, 9vw, 8rem);
  }
  .svc-head {
    color: var(--blue);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .svc {
    padding-block: clamp(3.5rem, 6vw, 5.5rem);
  }
  .svc-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: center;
  }
  /* Bilder treppen sich entlang der Diagonale nach rechts unten */
  .svc-1 .svc-visual {
    grid-column: 1 / 7;
  }
  .svc-1 .svc-text {
    grid-column: 8 / 13;
  }
  .svc-2 .svc-visual {
    grid-column: 2 / 8;
  }
  .svc-2 .svc-text {
    grid-column: 9 / 13;
  }
  .svc-3 .svc-visual {
    grid-column: 7 / 13;
    grid-row: 1;
  }
  .svc-3 .svc-text {
    grid-column: 1 / 6;
    grid-row: 1;
  }
  .svc-visual {
    position: relative;
    z-index: 2;
    display: block;
    padding: 1.5rem 0 1.5rem 1.5rem;
  }
  .svc-3 .svc-visual {
    padding: 1.5rem 1.5rem 1.5rem 0;
  }
  .slab-svc {
    left: 0;
    top: 0;
    bottom: 0;
    width: 40%;
    clip-path: polygon(0 0, 100% 0, 60% 100%, 0 100%);
  }
  .svc-2 .slab-svc {
    background: var(--navy);
  }
  .svc-3 .slab-svc {
    left: auto;
    right: 0;
    clip-path: polygon(40% 0, 100% 0, 100% 100%, 0 100%);
  }
  .svc-img {
    aspect-ratio: 16 / 11;
    clip-path: polygon(0 0, 100% 0, 88% 100%, 0 100%);
  }
  .svc-3 .svc-img {
    clip-path: polygon(12% 0, 100% 0, 100% 100%, 0 100%);
  }
  .svc-img :global(img) {
    transition: transform 1.2s var(--ease);
  }
  .svc-visual:hover .svc-img :global(img) {
    transform: scale(1.03);
  }
  .svc-title {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(1.5rem, 2.4vw, 2.2rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 1.2rem;
    hyphens: manual;
  }
  .svc-text p {
    color: var(--ink-2);
    margin-bottom: 1.8rem;
  }

  /* ======================= PROJEKTE ======================= */
  .show {
    position: relative;
    z-index: 2;
    background: var(--navy);
    color: #fff;
  }
  .show-in {
    display: grid;
    grid-template-columns: minmax(340px, 0.72fr) 1.6fr;
    height: 100vh;
    min-height: 640px;
  }
  .show-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: calc(var(--header-h) + 1rem) clamp(2rem, 4vw, 4rem) 3rem max(var(--gutter), calc((100vw - var(--container)) / 2));
  }
  .show-h {
    font-size: clamp(1.7rem, 2.6vw, 2.5rem);
    color: #9aa6ee;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .show-items {
    display: grid;
    margin-bottom: 2.5rem;
  }
  .show-item {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.5s ease,
      visibility 0s 0.5s;
  }
  .show-item.is-active {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .show-nr {
    display: block;
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 0.95rem;
    color: #9aa6ee;
    margin-bottom: 1rem;
  }
  .show-title {
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(1.5rem, 2.3vw, 2.1rem);
    text-transform: uppercase;
    line-height: 1.02;
    margin-bottom: 0.8rem;
  }
  .show-desc {
    color: rgb(255 255 255 / 0.75);
    font-size: 1rem;
    max-width: 24rem;
    margin-bottom: 1.4rem;
  }
  .show-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 2rem;
    margin: 0 0 1.6rem;
  }
  .show-facts dt {
    font-family: var(--font-head);
    font-stretch: 115%;
    font-weight: 600;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #9aa6ee;
  }
  .show-facts dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-head);
    font-stretch: 110%;
    font-weight: 500;
  }
  .show .link-arrow {
    color: #fff;
  }
  .show-stage {
    position: relative;
    overflow: hidden;
    clip-path: polygon(14% 0, 100% 0, 100% 100%, 0 100%);
  }
  .show-img {
    position: absolute;
    inset: 0;
    display: block;
  }
  .show-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .show-cap {
    display: none;
  }

  /* ======================= WERTE ======================= */
  .values {
    position: relative;
    z-index: 2;
    padding-block: clamp(5rem, 9vw, 8rem);
  }
  .values-h {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
  }
  .value :global(.value-icon) {
    color: #fff;
    --vicon-bg: #3948a4;
    margin-bottom: 2rem;
  }
  .value h3 {
    font-stretch: 125%;
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 0.7rem;
  }
  .value p {
    color: rgb(255 255 255 / 0.85);
    margin: 0;
    max-width: 22rem;
  }

  /* ======================= KARRIERE ======================= */
  .career {
    padding-block: clamp(5rem, 10vw, 9rem);
  }
  .career-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .career-visual {
    position: relative;
    z-index: 2;
  }
  .career-img {
    aspect-ratio: 3 / 2;
    /* nur die obere linke Ecke anschneiden – dort steht niemand */
    clip-path: polygon(9% 0, 100% 0, 100% 100%, 0 100%, 0 14%);
  }
  .career-label {
    position: absolute;
    left: -1.25rem;
    bottom: -1.5rem;
    display: grid;
    justify-items: start;
  }
  .cl-a,
  .cl-b {
    background: var(--blue);
    color: #fff;
    font-family: var(--font-head);
    font-stretch: 125%;
    text-transform: uppercase;
    line-height: 1;
  }
  .cl-a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 800;
    font-size: clamp(1.3rem, 2.4vw, 2.1rem);
    padding: 0.7rem 1.1rem 0.6rem;
  }
  .cl-a :global(.cl-hammer) {
    width: 1.1em;
    height: 1.1em;
  }
  .cl-b {
    font-weight: 300;
    font-size: clamp(0.9rem, 1.4vw, 1.2rem);
    padding: 0.35rem 1.1rem 0.5rem;
    background: var(--navy);
  }
  .career-h {
    color: var(--blue);
    margin-bottom: 1.6rem;
  }
  .career-lead {
    color: var(--ink-2);
    margin-bottom: 1.6rem;
    max-width: 28rem;
  }
  .arrows {
    list-style: none;
    padding: 0;
    margin: 0 0 2.2rem;
    display: grid;
    gap: 0.6rem;
  }
  .arrows li {
    position: relative;
    padding-left: 1.6rem;
    color: var(--ink);
  }
  .arrows li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.5em;
    height: 0.5em;
    background: var(--blue);
    transform: rotate(45deg);
  }

  /* ======================= FILM ======================= */
  .film {
    position: relative;
    height: 200vh;
  }
  .film-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
    display: grid;
    place-items: center;
    z-index: 2;
  }
  .film-frame {
    position: absolute;
    inset: 0;
    background: var(--navy);
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
  }
  .film-frame video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .film-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(18 23 53 / 0.35);
  }
  .film-ui {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    padding-inline: var(--gutter);
  }

  /* ======================= RESPONSIVE ======================= */
  @media (max-width: 900px) {
    .flow {
      display: none;
    }
    .hero {
      clip-path: polygon(0 0, 100% 0, 100% 96%, 78% 100%, 0 94%);
    }
    .hero-slab {
      width: 100%;
      clip-path: polygon(0 0, 100% 0, 100% 52%, 0 78%);
    }
    .hero-content {
      justify-content: flex-start;
      padding-top: calc(var(--header-h) + 4rem);
    }
    .intro {
      padding-top: 5rem;
    }
    .intro-grid,
    .career-grid {
      grid-template-columns: 1fr;
    }
    .figs-field {
      height: auto;
      display: grid;
      gap: 2.5rem;
    }
    .fg {
      position: static;
    }
    .fg-2,
    .fg-4 {
      justify-self: end;
      text-align: right;
    }
    .svc-grid {
      grid-template-columns: 1fr;
    }
    .svc .svc-visual,
    .svc .svc-text {
      grid-column: auto;
      grid-row: auto;
    }
    .show-in {
      grid-template-columns: 1fr;
      height: auto;
    }
    .show-text {
      padding: var(--section) var(--gutter) 2rem;
    }
    .show-items {
      display: none;
    }
    .show-stage {
      display: grid;
      gap: 1.5rem;
      clip-path: none;
      padding: 0 var(--gutter) var(--section);
    }
    .show-img {
      position: relative;
      aspect-ratio: 4 / 3;
      color: #fff;
      text-decoration: none;
    }
    .show-cap {
      display: block;
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      padding: 2.5rem 1rem 1rem;
      background: linear-gradient(transparent, rgb(18 23 53 / 0.85));
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .show-cap strong {
      display: block;
      font-family: var(--font-head);
      font-stretch: 125%;
      font-weight: 800;
      font-size: 1.15rem;
    }
    .values-grid {
      grid-template-columns: 1fr;
    }
    .values-h {
      font-size: clamp(1.5rem, 7.4vw, 2.2rem);
    }
    .career-label {
      left: 0;
    }
    .film {
      height: auto;
    }
    .film-sticky {
      position: relative;
      height: 80svh;
    }
    .film-frame {
      clip-path: polygon(50% 4%, 100% 50%, 50% 96%, 0% 50%);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const mm = gsap.matchMedia();
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- Projekte: 3 große Bilder, 3 × scrollen (Desktop) ---------- */
  mm.add('(prefers-reduced-motion: no-preference) and (min-width: 901px)', () => {
    const show = document.querySelector<HTMLElement>('[data-show]');
    if (!show) return;
    const imgs = Array.from(show.querySelectorAll<HTMLElement>('[data-show-img]'));
    const items = Array.from(show.querySelectorAll<HTMLElement>('[data-show-item]'));
    const setActive = (i: number) =>
      items.forEach((it, j) => {
        it.classList.toggle('is-active', j === i);
        it.querySelector('a')?.setAttribute('tabindex', j === i ? '0' : '-1');
      });
    imgs.forEach((img, i) => i > 0 && gsap.set(img, { clipPath: 'inset(100% 0% 0% 0%)' }));
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: show,
        start: 'top top',
        end: () => `+=${imgs.length * window.innerHeight}`,
        pin: true,
        scrub: 0.5,
        invalidateOnRefresh: true,
        onUpdate: (self) => setActive(Math.min(imgs.length - 1, Math.floor(self.progress * imgs.length * 0.999 + 0.15))),
      },
    });
    tl.to({}, { duration: 0.5 });
    imgs.slice(1).forEach((img) => {
      tl.to(img, { clipPath: 'inset(0% 0% 0% 0%)', ease: 'power2.inOut', duration: 1 });
      tl.to({}, { duration: 0.5 });
    });
  });

  /* ---------- Film: Raute öffnet sich ---------- */
  mm.add('(prefers-reduced-motion: no-preference) and (min-width: 901px)', () => {
    const film = document.querySelector('[data-film]');
    const frame = document.querySelector('[data-film-frame]');
    const ui = document.querySelector('[data-film-ui]');
    if (!film || !frame) return;
    const tl = gsap.timeline({ scrollTrigger: { trigger: film, start: 'top top', end: 'bottom bottom', scrub: 0.6 } });
    tl.fromTo(frame, { clipPath: 'polygon(50% 22%, 70% 50%, 50% 78%, 30% 50%)' }, { clipPath: 'polygon(50% -60%, 160% 50%, 50% 160%, -60% 50%)', ease: 'none', duration: 1 });
    if (ui) tl.from(ui, { autoAlpha: 0, y: 30, duration: 0.35 }, 0.55);
  });

  /* ---------- Die blaue Linie ---------- */
  const svg = document.querySelector<SVGSVGElement>('[data-flow]');
  const path = svg?.querySelector<SVGPathElement>('[data-flow-path]');
  const marksG = svg?.querySelector<SVGGElement>('[data-flow-marks]');
  let total = 0;
  const samples: { len: number; y: number }[] = [];
  let marks: { el: SVGPolygonElement; y: number }[] = [];

  const box = (el: Element | null) => {
    if (!el) return null;
    const r = el.getBoundingClientRect();
    return { top: r.top + window.scrollY, bottom: r.bottom + window.scrollY, left: r.left + window.scrollX, right: r.right + window.scrollX };
  };
  // Raute in Logo-Proportion (352 × 245) um einen Mittelpunkt
  const rhomb = (x: number, y: number, w: number) => {
    const h = w * (245 / 352);
    return `${x - 0.002 * w},${y - h / 2} ${x + w / 2},${y + 0.033 * h} ${x - 0.02 * w},${y + h / 2} ${x - w / 2},${y - 0.004 * h}`;
  };

  const build = () => {
    if (!svg || !path || !marksG || window.innerWidth <= 900) return;
    const doc = document.documentElement;
    const W = doc.clientWidth;
    const cont = document.querySelector<HTMLElement>('.intro .container');
    if (!cont) return;
    const cb = box(cont)!;
    const pad = parseFloat(getComputedStyle(cont).paddingLeft);
    const L = Math.max(34, cb.left + pad - 36);
    const R = Math.min(W - 34, cb.right - pad + 36);
    const hero = box(document.querySelector('[data-hero]'))!;
    const figs = box(document.querySelector('[data-figs]'))!;
    const rows = Array.from(document.querySelectorAll('[data-svc]')).map((r) => box(r)!);
    const film = box(document.querySelector('[data-film]'))!;
    const vh = window.innerHeight;
    const ax = W * 0.78; // Spitze der Hero-Unterkante
    const cx = W / 2;
    const tipY = film.top + vh * 0.22;
    const k = (0.28 * vh) / (0.2 * W); // Steigung der Rautenkante
    const sTop = rows[0]!.top + 40;
    const sBot = rows[rows.length - 1]!.bottom - 40;
    const d = [
      `M${ax} ${hero.bottom}`,
      `V${figs.top}`,
      `L${L} ${figs.bottom}`,
      `V${sTop}`,
      `L${R} ${sBot}`,
      `V${film.top + 40}`,
      `H${cx + (tipY - film.top - 40) / k}`,
      `L${cx} ${tipY}`,
    ].join(' ');
    svg.setAttribute('height', String(doc.scrollHeight));
    svg.setAttribute('viewBox', `0 0 ${W} ${doc.scrollHeight}`);
    path.setAttribute('d', d);

    // Rauten zwischen den Leistungen – auf der Diagonale aufgereiht
    marksG.innerHTML = '';
    marks = [];
    const xAt = (y: number) => L + ((y - sTop) / (sBot - sTop)) * (R - L);
    for (let i = 0; i < rows.length - 1; i++) {
      const y = (rows[i]!.bottom + rows[i + 1]!.top) / 2;
      const p = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
      p.setAttribute('points', rhomb(xAt(y), y, 104));
      p.setAttribute('class', 'mark');
      marksG.appendChild(p);
      marks.push({ el: p, y });
    }

    total = path.getTotalLength();
    samples.length = 0;
    for (let l = 0; l <= total; l += 24) samples.push({ len: l, y: path.getPointAtLength(l).y });
    samples.push({ len: total, y: path.getPointAtLength(total).y });
    path.style.strokeDasharray = `${total}`;
    draw(true);
  };

  const draw = (instant = false) => {
    if (!path || !total) return;
    const target = reduce ? Infinity : window.scrollY + window.innerHeight * 0.62;
    marks.forEach((m) => m.el.classList.toggle('is-on', m.y <= target));
    if (reduce) {
      path.style.strokeDashoffset = '0';
      return;
    }
    let len = 0;
    for (const s of samples) {
      if (s.y <= target) len = s.len;
      else break;
    }
    gsap.to(path, { strokeDashoffset: total - len, duration: instant ? 0 : 0.9, ease: 'power2.out', overwrite: true });
  };

  if (svg && path) {
    window.addEventListener('scroll', () => draw(), { passive: true });
    window.addEventListener('resize', () => build());
    window.addEventListener('load', () => {
      ScrollTrigger.refresh();
      build();
    });
    ScrollTrigger.addEventListener('refresh', () => build());
    build();
  }
</script>
