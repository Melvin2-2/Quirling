---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import { url } from '~/lib/url';
---

<Base title="Seite nicht gefunden">
  <PageHero
    eyebrow="Fehler 404"
    title="Hier wird"
    titleLight="noch gebaut."
    intro="Die gesuchte Seite gibt es leider nicht oder nicht mehr. Vielleicht finden Sie hier, was Sie suchen."
    size="medium"
  >
    <div class="links">
      <a class="pill light" href={url('/')}><span>Zur Startseite</span><Icon name="arrow" /></a>
      <a class="text-link" href={url('/referenzen/')}><span>Referenzen</span><Icon name="arrow" /></a>
      <a class="text-link" href={url('/kontakt/')}><span>Kontakt</span><Icon name="arrow" /></a>
    </div>
  </PageHero>
  <div class="spacer"></div>
</Base>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: 1.8rem;
  }
  .links .text-link {
    color: #fff;
  }
  .spacer {
    height: clamp(3rem, 8vw, 6rem);
  }
</style>
