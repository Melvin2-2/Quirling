---
import { Image, getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import { kategorien, leistungen, firma } from '~/data/site';
import { url } from '~/lib/url';
import hero from '~/assets/site/baustelle-kraene.jpg';

const projekte = (await getCollection('projekte')).sort(
  (a, b) => (a.data.highlight ?? 99) - (b.data.highlight ?? 99) || (b.data.jahr ?? 0) - (a.data.jahr ?? 0),
);
// große Fassung jedes Galeriebildes für die Vergrößerung (Lightbox)
const gross = Object.fromEntries(
  await Promise.all(
    projekte.map(async (p) => [
      p.id,
      await Promise.all(p.data.bilder.map(async (b) => (await getImage({ src: b, width: Math.min(b.width, 2400), format: 'webp', quality: 85 })).src)),
    ]),
  ),
) as Record<string, string[]>;
const bereichName = (slug: string) => leistungen.find((l) => l.slug === slug)?.title.replace('­', '') ?? '';
---

<Base title="Referenzen" description="Ein Auszug unserer Projekte: Wohnungsbau, Bürogebäude, Industriebau, Häuser und Umbauten in Hamburg und Umgebung.">
  <PageHero
    title="Projekte,"
    titleLight="die stehen."
    intro={`Eine Auswahl aus mehr als ${firma.projekteAnzahl} Projekten seit 1992. Überwiegend Rohbau, dazu zahlreiche Umbauten und Sanierungen.`}
    image={hero}
    imageAlt="Große Baustelle mit mehreren Kränen und Gerüsten in Lüneburg"
    imagePosition="60% 40%"
    crumbs={[{ label: 'Referenzen' }]}
    size="medium"
  />

  <div class="refs" data-refs>
    <!-- Filter: Gebäudeart und Leistung, die Leiste läuft beim Scrollen mit -->
    <div class="fbar" data-fbar>
      <div class="container fbar-in">
        <!-- Reiter: zeigt, dass es zwei Filter gibt; die Optionen stehen daneben in einer Zeile -->
        <div class="ftabs" role="tablist" aria-label="Filter wählen">
          <button type="button" class="ftab is-on" role="tab" aria-selected="true" data-tab="kategorie">Gebäude</button>
          <button type="button" class="ftab" role="tab" aria-selected="false" data-tab="leistung">Leistung</button>
        </div>
        <div class="fpanes">
          <div class="frow" role="group" aria-label="Nach Gebäudeart filtern" data-filters="kategorie" data-pane="kategorie">
            <button type="button" class="f is-active" data-filter="alle" aria-pressed="true">Alle</button>
            {
              kategorien.map((k) => (
                <button type="button" class="f" data-filter={k} aria-pressed="false">
                  {k}
                </button>
              ))
            }
          </div>
          <div class="frow" role="group" aria-label="Nach Leistung filtern" data-filters="leistung" data-pane="leistung" hidden>
            <button type="button" class="f is-active" data-filter="alle" aria-pressed="true">Alle</button>
            {
              leistungen.map((l) => (
                <button type="button" class="f" data-filter={l.slug} aria-pressed="false" set:html={l.title} />
              ))
            }
          </div>
        </div>
        <!-- aktiver Filter aus dem anderen Reiter als kleines Schild -->
        <div class="fchips" data-fchips></div>
      </div>
    </div>

    <!-- Kacheln -->
    <div class="grid-wrap">
      <ul class="tiles" data-tiles>
        {
          projekte.map((p) => (
            <li class="tile" data-cats={p.data.kategorien.join('|')} data-bereich={p.data.bereich} data-id={p.id}>
              <a class="tile-in" href={url(`/referenzen/?p=${p.id}`)} data-open={p.id} aria-controls="projekt-panel">
                <span class="tile-img">
                  <Image src={p.data.bilder[0]!} alt="" widths={[500, 800, 1200]} sizes="(min-width: 1100px) 30vw, (min-width: 700px) 46vw, 100vw" />
                </span>
                <span class="tile-info">
                  <span class="tile-title">{p.data.title}</span>
                  <span class="tile-more" aria-hidden="true"><Icon name="arrow" /></span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="empty" data-empty hidden>Keine Projekte zu dieser Auswahl. Probieren Sie eine andere Kombination.</p>
    </div>
  </div>

  <!-- Seitenfenster -->
  <aside class="panel" id="projekt-panel" data-panel aria-hidden="true" aria-label="Projektdetails" data-lenis-prevent>
    <div class="panel-bar">
      <div class="panel-nav">
        <button type="button" class="pbtn" data-prev aria-label="Vorheriges Projekt"><Icon name="arrow" class="flip" /></button>
        <button type="button" class="pbtn" data-next aria-label="Nächstes Projekt"><Icon name="arrow" /></button>
        <button type="button" class="pbtn close" data-close aria-label="Schließen"><Icon name="close" /></button>
      </div>
    </div>
    <div class="panel-body" data-panel-body></div>
  </aside>

  <!-- Vergrößerung -->
  <div class="lb" data-lb hidden role="dialog" aria-modal="true" aria-label="Bildansicht" data-lenis-prevent>
    <div class="lb-stage" data-lb-stage>
      <img class="lb-img" data-lb-img alt="" draggable="false" />
    </div>
    <div class="lb-bar">
      <span class="lb-hint">Mausrad, Doppelklick oder zwei Finger zum Zoomen</span>
      <div class="lb-nav">
        <button type="button" class="pbtn" data-lb-out aria-label="Verkleinern"><Icon name="minus" /></button>
        <button type="button" class="pbtn" data-lb-in aria-label="Vergrößern"><Icon name="plus" /></button>
        <button type="button" class="pbtn" data-lb-prev aria-label="Vorheriges Bild"><Icon name="arrow" class="flip" /></button>
        <button type="button" class="pbtn" data-lb-next aria-label="Nächstes Bild"><Icon name="arrow" /></button>
        <button type="button" class="pbtn close" data-lb-close aria-label="Schließen"><Icon name="close" /></button>
      </div>
    </div>
  </div>

  <!-- Inhalte der Seitenfenster (werden erst beim Öffnen eingefügt, Bilder laden dann) -->
  {
    projekte.map((p) => (
      <template data-project={p.id}>
        <header class="pp-head">
          <span class="label">{p.data.kategorien.join(' · ')}</span>
          <h2 class="pp-title">{p.data.title}</h2>
          <p class="pp-lead">{p.data.leistung}</p>
          <dl class="pp-facts">
            <div>
              <dt>Leistungsbereich</dt>
              <dd>
                <a href={url(`/leistungen/${p.data.bereich}/`)}>{bereichName(p.data.bereich)}</a>
              </dd>
            </div>
            {p.data.fakten.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd set:html={f.value.replace(/\n/g, '<br />')} />
              </div>
            ))}
          </dl>
        </header>
        <div class="pp-galerie">
          {p.data.bilder.map((b, i) => (
            <Image
              src={b}
              alt={`${p.data.title}, Bild ${i + 1}`}
              widths={[600, 1000, 1600]}
              sizes={i === 0 ? '(min-width: 900px) 66vw, 100vw' : '(min-width: 900px) 33vw, 100vw'}
              loading={i < 3 ? 'eager' : 'lazy'}
              data-zoom={gross[p.id]![i]}
            />
          ))}
        </div>
      </template>
    ))
  }
</Base>

<style>
  /* ---------- Filter: läuft beim Scrollen mit ---------- */
  .refs {
    padding-block: 0 var(--section);
  }
  :global(:root) {
    --panel-w: 66.667vw;
  }
  .fbar {
    position: sticky;
    top: var(--fbar-top, 0px);
    z-index: 30;
    background: rgb(246 247 251 / 0.94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    margin-bottom: 6px;
    transition: top 0.35s var(--ease);
  }
  .fbar-in {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 1.6rem;
    padding-block: 0.55rem;
  }
  .ftabs {
    display: inline-flex;
    padding: 3px;
    background: #e6e9f6;
  }
  .ftab {
    border: 0;
    background: none;
    padding: 0.5rem 0.85rem 0.42rem;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
    transition:
      background 0.25s ease,
      color 0.25s ease;
  }
  .ftab.is-on {
    background: var(--navy);
    color: #fff;
  }
  .fpanes {
    min-width: 0;
  }
  .frow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.6rem;
    padding-left: 1.6rem;
    border-left: 1px solid var(--line);
  }
  .frow[hidden] {
    display: none;
  }
  .fchips {
    display: flex;
    gap: 0.5rem;
  }
  .fchips :global(.fchip) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--blue);
    background: #fff;
    padding: 0.4rem 0.55rem 0.35rem 0.7rem;
    cursor: pointer;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 0.95rem;
    text-transform: uppercase;
    color: var(--blue);
  }
  .fchips :global(.fchip span[aria-hidden]) {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1.1rem;
    line-height: 0.6;
  }
  .fchips :global(.fchip:hover) {
    background: var(--blue);
    color: #fff;
  }
  .f {
    position: relative;
    background: none;
    border: 0;
    padding: 0.7rem 0 0.6rem;
    cursor: pointer;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink-3);
    transition: color 0.25s ease;
  }
  .f::before {
    content: '';
    position: absolute;
    left: -0.95rem;
    top: 50%;
    width: 0.45rem;
    height: 0.45rem;
    margin-top: -0.25rem;
    background: var(--blue);
    transform: rotate(45deg) scale(0);
    transition: transform 0.35s var(--ease);
  }
  .f:hover,
  .f.is-active {
    color: var(--blue);
  }
  .f.is-active::before {
    transform: rotate(45deg) scale(1);
  }
  .f.is-empty:not(.is-active) {
    opacity: 0.35;
  }

  /* ---------- Kacheln: Galerie mit dezentem Titel darunter ---------- */
  /* Galerie in Containerbreite, nicht bis an den Rand */
  .grid-wrap {
    padding-inline: var(--content-left);
  }
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.4rem, 2.2vw, 2rem) 10px;
  }
  .tile[hidden] {
    display: none;
  }
  /* Bild mit dezentem Titel darunter */
  .tile-in {
    display: grid;
    gap: 0.6rem;
    color: var(--navy);
    text-decoration: none;
  }
  .tile-img {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--stone-200);
  }
  .tile-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .tile-in:hover .tile-img :global(img) {
    transform: scale(1.04);
  }
  .tile.is-current .tile-img {
    outline: 3px solid var(--blue);
    outline-offset: -3px;
  }
  .tile-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .tile-title {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.05rem, 1.25vw, 1.25rem);
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    transition: color 0.25s ease;
  }
  .tile-in:hover .tile-title,
  .tile.is-current .tile-title {
    color: var(--blue);
  }
  /* kleine Pfeil-Raute, füllt sich beim Überfahren */
  .tile-more {
    position: relative;
    flex: none;
    width: 1.8rem;
    height: 1.8rem;
    display: grid;
    place-items: center;
    color: var(--blue);
    transition: color 0.3s ease;
  }
  .tile-more::before {
    content: '';
    position: absolute;
    inset: 0.3rem;
    border: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition:
      transform 0.4s var(--ease),
      background 0.3s ease;
  }
  .tile-more :global(svg) {
    position: relative;
    width: 0.8rem;
    height: 0.8rem;
  }
  .tile-in:hover .tile-more {
    color: #fff;
  }
  .tile-in:hover .tile-more::before {
    background: var(--blue);
    border-color: var(--blue);
    transform: rotate(135deg);
  }
  /* bei offenem Seitenfenster: links nur noch eine Spalte */
  :global(body.panel-open) .tiles {
    grid-template-columns: minmax(0, 1fr);
  }
  @media (max-width: 1100px) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .empty {
    color: var(--ink-3);
    padding: 2rem var(--content-left);
  }
  @media (prefers-reduced-motion: reduce) {
    .tile.will-in .tile-in {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Seitenfenster ---------- */
  .panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--panel-w);
    z-index: 120;
    display: flex;
    flex-direction: column;
    background: #fff;
    box-shadow: -30px 0 60px -30px rgb(18 23 53 / 0.35);
    transform: translateX(105%);
    transition:
      transform 0.6s var(--ease),
      visibility 0s 0.6s;
    visibility: hidden;
  }
  .panel.is-open {
    transform: none;
    visibility: visible;
    transition: transform 0.6s var(--ease);
  }
  /* Galerie rückt nach links, wenn das Fenster offen ist */
  :global(body.panel-open) .grid-wrap {
    padding-right: calc(var(--panel-w) + var(--gutter));
    padding-left: var(--gutter);
  }
  .panel-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1rem;
    padding: 1rem clamp(1.25rem, 2.5vw, 2rem);
    border-bottom: 1px solid var(--line);
    background: #fff;
  }
  .panel-nav {
    display: flex;
    gap: 0.4rem;
  }
  .pbtn {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    background: none;
    border: 1px solid var(--line);
    color: var(--blue);
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }
  .pbtn:hover {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }
  .pbtn.close {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
  .pbtn :global(svg) {
    width: 18px;
    height: 18px;
  }
  .pbtn :global(.flip) {
    transform: rotate(180deg);
  }
  .panel-body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.25rem, 2.5vw, 2rem) 3rem;
  }
  .panel-body :global(.pp-head) {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    margin-bottom: clamp(1.6rem, 3vw, 2.4rem);
  }
  .panel-body :global(.pp-title) {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(2.4rem, 4.2vw, 4.6rem);
    line-height: 0.97;
    text-transform: uppercase;
    color: var(--blue);
    margin: 0;
  }
  .panel-body :global(.pp-lead) {
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 60ch;
    margin: 0.2rem 0 0;
  }
  /* Infos direkt unter dem Titel, nebeneinander */
  .panel-body :global(.pp-facts) {
    width: 100%;
    margin: 1rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.2rem 2rem;
  }
  .panel-body :global(.pp-facts > div) {
    position: relative;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }
  .panel-body :global(.pp-facts dt) {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 0.35rem;
  }
  .panel-body :global(.pp-facts dd) {
    margin: 0;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .panel-body :global(.pp-facts a) {
    color: var(--blue);
  }
  /* Galerie: erstes Bild groß, danach zweispaltig */
  .panel-body :global(.pp-galerie) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }
  .panel-body :global(.pp-galerie img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .panel-body :global(.pp-galerie img) {
    cursor: zoom-in;
  }
  .panel-body :global(.pp-galerie img:first-child) {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }
  /* ---------- Vergrößerung ---------- */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgb(18 23 53 / 0.97);
    display: flex;
    flex-direction: column;
  }
  .lb[hidden] {
    display: none;
  }
  .lb-stage {
    flex: 1;
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    touch-action: none;
    cursor: zoom-in;
  }
  .lb-stage.is-zoomed {
    cursor: grab;
  }
  .lb-stage.is-dragging {
    cursor: grabbing;
  }
  .lb-img {
    max-width: 94vw;
    max-height: calc(100svh - 90px);
    object-fit: contain;
    user-select: none;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .lb-img.is-anim {
    transition: transform 0.3s var(--ease);
  }
  .lb-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.8rem clamp(1rem, 2.5vw, 2rem) 1rem;
  }
  .lb-hint {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #aab4ea;
  }
  .lb-nav {
    display: flex;
    gap: 0.4rem;
    margin-left: auto;
  }
  .lb .pbtn {
    color: #fff;
    border-color: rgb(255 255 255 / 0.25);
  }
  .lb .pbtn.close {
    background: var(--blue);
    border-color: var(--blue);
  }

  @media (max-width: 900px) {
    .lb-hint {
      display: none;
    }
    :global(:root) {
      --panel-w: 100vw;
    }
    :global(body.panel-open) .grid-wrap {
      padding: 0 var(--gutter);
    }
    .grid-wrap {
      padding-inline: var(--gutter);
    }
    .frow {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      gap: 1.4rem;
    }
    .f {
      flex: none;
    }
    .fbar-in {
      grid-template-columns: auto minmax(0, 1fr);
      row-gap: 0.4rem;
      column-gap: 0.8rem;
    }
    .fpanes {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .frow {
      padding-left: 0;
      border-left: 0;
    }
    .fchips {
      justify-self: end;
    }
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.1rem 6px;
    }
    .tile-title {
      font-size: 0.95rem;
    }
    .tile-more {
      display: none;
    }
    :global(body.panel-open) .tiles {
      grid-template-columns: minmax(0, 1fr);
    }
    .panel-body :global(.pp-galerie) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  import { createLightbox } from '~/scripts/lightbox';
  const refs = document.querySelector<HTMLElement>('[data-refs]')!;
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('[data-tiles] .tile'));
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const panel = document.querySelector<HTMLElement>('[data-panel]')!;
  const body = panel.querySelector<HTMLElement>('[data-panel-body]')!;
  let current: string | null = null;

  /* ---------- Filter: Gebäudeart und Leistung lassen sich kombinieren ---------- */
  const state: Record<string, string> = { kategorie: 'alle', leistung: 'alle' };
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-filters]'));
  // Reiter: Gebäude oder Leistung; der jeweils andere aktive Filter erscheint als Schild
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-tab]'));
  const chips = document.querySelector<HTMLElement>('[data-fchips]');
  let tab = 'kategorie';
  const renderChips = () => {
    if (!chips) return;
    chips.replaceChildren();
    groups.forEach((g) => {
      const key = g.dataset.filters!;
      if (key === tab || state[key] === 'alle') return;
      const label = (g.querySelector<HTMLElement>('.is-active')?.textContent ?? '').replace(/\u00ad/g, '');
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'fchip';
      b.setAttribute('aria-label', `Filter ${label} entfernen`);
      const t = document.createElement('span');
      t.textContent = label;
      const x = document.createElement('span');
      x.setAttribute('aria-hidden', 'true');
      x.textContent = '×';
      b.append(t, x);
      b.addEventListener('click', () => {
        state[key] = 'alle';
        applyFilter();
        const u = new URL(location.href);
        u.searchParams.delete(key);
        history.replaceState(null, '', u);
      });
      chips.append(b);
    });
  };
  const showTab = (t: string) => {
    tab = t;
    tabs.forEach((b) => {
      const on = b.dataset.tab === t;
      b.classList.toggle('is-on', on);
      b.setAttribute('aria-selected', String(on));
    });
    groups.forEach((g) => (g.hidden = g.dataset.pane !== t));
    renderChips();
  };
  tabs.forEach((b) => b.addEventListener('click', () => showTab(b.dataset.tab!)));
  const matches = (t: HTMLElement, k: string, l: string) =>
    (k === 'alle' || (t.dataset.cats ?? '').split('|').includes(k)) && (l === 'alle' || t.dataset.bereich === l);
  const applyFilter = () => {
    tiles.forEach((t) => {
      t.hidden = !matches(t, state.kategorie!, state.leistung!);
    });
    const visible = tiles.filter((t) => !t.hidden).length;
    if (empty) empty.hidden = visible > 0;
    groups.forEach((g) => {
      const key = g.dataset.filters!;
      g.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => {
        const on = b.dataset.filter === state[key];
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', String(on));
        // Optionen ohne Treffer in der aktuellen Kombination abblenden
        const v = b.dataset.filter ?? 'alle';
        const hits = tiles.some((t) => (key === 'kategorie' ? matches(t, v, state.leistung!) : matches(t, state.kategorie!, v)));
        b.classList.toggle('is-empty', !hits);
      });
    });
    renderChips();
    reveal();
  };
  groups.forEach((g) =>
    g.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!b) return;
      const key = g.dataset.filters!;
      state[key] = b.dataset.filter ?? 'alle';
      applyFilter();
      const u = new URL(location.href);
      if (state[key] === 'alle') u.searchParams.delete(key);
      else u.searchParams.set(key, state[key]!);
      history.replaceState(null, '', u);
      const top = document.querySelector('[data-tiles]')!.getBoundingClientRect().top + window.scrollY - 140;
      if (window.scrollY > top) window.scrollTo({ top, behavior: 'smooth' });
    }),
  );

  /* ---------- Kacheln gleiten beim Hereinscrollen herein ---------- */
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-in');
        io.unobserve(e.target);
      }),
    { rootMargin: '0px 0px -8% 0px' },
  );
  function reveal() {
    if (reduceMotion) return;
    tiles.forEach((t) => {
      if (t.hidden || t.classList.contains('is-in')) return;
      t.classList.add('will-in');
      io.observe(t);
    });
  }

  /* ---------- Filterleiste rückt unter die Kopfzeile, solange diese sichtbar ist ---------- */
  const fbar = document.querySelector<HTMLElement>('[data-fbar]');
  const header = document.querySelector<HTMLElement>('.site-header');
  const syncBar = () => {
    if (!fbar || !header) return;
    const visible = header.classList.contains('is-fixed') && !header.classList.contains('is-hidden');
    fbar.style.setProperty('--fbar-top', visible ? `${header.offsetHeight}px` : '0px');
  };
  if (header) new MutationObserver(syncBar).observe(header, { attributes: true, attributeFilter: ['class'] });
  syncBar();

  /* ---------- Seitenfenster ---------- */
  const visibleIds = () => tiles.filter((t) => !t.hidden).map((t) => t.dataset.id!);

  /* Beim Umschalten des Rasters bleibt die gewählte Kachel im Blick */
  const lenis = () => (window as unknown as { __lenis?: { scrollTo: (y: number, o?: object) => void } }).__lenis;
  const keepInView = (id: string | null, change: () => void) => {
    const tile = id ? document.querySelector<HTMLElement>(`.tile[data-id="${CSS.escape(id)}"]`) : null;
    const before = tile?.getBoundingClientRect().top ?? 0;
    change();
    if (!tile) return;
    const r = tile.getBoundingClientRect();
    const barBottom = document.querySelector<HTMLElement>('[data-fbar]')?.getBoundingClientRect().bottom ?? 0;
    const minTop = barBottom + 16;
    // exakt dieselbe Bildschirmposition wie vorher; nur wenn die Kachel dann
    // unter der Filterleiste oder unten aus dem Bild läge, so wenig wie nötig verschieben
    let wanted = before;
    const maxTop = window.innerHeight - 16 - r.height;
    if (wanted > maxTop) wanted = maxTop;
    if (wanted < minTop) wanted = minTop;
    const y = window.scrollY + r.top - wanted;
    const root = document.documentElement;
    root.setAttribute('data-hold-header', '');
    const l = lenis();
    if (l) l.scrollTo(y, { immediate: true, force: true });
    else window.scrollTo({ top: y, behavior: 'instant' as ScrollBehavior });
    setTimeout(() => root.removeAttribute('data-hold-header'), 120);
  };

  const open = (id: string, updateUrl = true) => {
    const tpl = document.querySelector<HTMLTemplateElement>(`template[data-project="${CSS.escape(id)}"]`);
    if (!tpl) return;
    body.replaceChildren(tpl.content.cloneNode(true));
    body.scrollTop = 0;
    current = id;
    tiles.forEach((t) => t.classList.toggle('is-current', t.dataset.id === id));
    panel.classList.add('is-open');
    panel.setAttribute('aria-hidden', 'false');
    if (!document.body.classList.contains('panel-open')) keepInView(id, () => document.body.classList.add('panel-open'));
    if (updateUrl) {
      const u = new URL(location.href);
      u.searchParams.set('p', id);
      history.replaceState(null, '', u);
    }
  };
  const close = () => {
    panel.classList.remove('is-open');
    panel.setAttribute('aria-hidden', 'true');
    const last = current;
    keepInView(last, () => document.body.classList.remove('panel-open'));
    tiles.forEach((t) => t.classList.remove('is-current'));
    current = null;
    const u = new URL(location.href);
    u.searchParams.delete('p');
    history.replaceState(null, '', u);
    if (last) document.querySelector<HTMLElement>(`[data-open="${CSS.escape(last)}"]`)?.focus({ preventScroll: true });
  };
  const step = (dir: number) => {
    if (!current) return;
    const ids = visibleIds();
    const i = ids.indexOf(current);
    const next = ids[(i + dir + ids.length) % ids.length];
    if (!next) return;
    open(next);
    document.querySelector<HTMLElement>(`.tile[data-id="${CSS.escape(next)}"]`)?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  };

  refs.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-open]');
    if (!a) return;
    e.preventDefault();
    const id = a.dataset.open!;
    if (id === current) close();
    else open(id);
  });
  panel.querySelector('[data-close]')!.addEventListener('click', close);
  panel.querySelector('[data-prev]')!.addEventListener('click', () => step(-1));
  panel.querySelector('[data-next]')!.addEventListener('click', () => step(1));
  document.addEventListener('keydown', (e) => {
    if (!current || lb.isOpen()) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') step(1);
    if (e.key === 'ArrowLeft') step(-1);
  });

  /* ---------- Vergrößerung mit Zoom ---------- */
  const lb = createLightbox(document.querySelector<HTMLElement>('[data-lb]')!);
  body.addEventListener('click', (e) => {
    const img = (e.target as HTMLElement).closest<HTMLImageElement>('img[data-zoom]');
    if (!img) return;
    const all = Array.from(body.querySelectorAll<HTMLImageElement>('img[data-zoom]'));
    lb.open(
      all.map((i) => ({ src: i.dataset.zoom!, alt: i.alt })),
      all.indexOf(img),
    );
  });

  /* ---------- Zustand aus der URL (z. B. Links von der Startseite) ---------- */
  const params = new URL(location.href).searchParams;
  for (const key of ['kategorie', 'leistung']) {
    const v = params.get(key);
    if (v) state[key] = v;
  }
  applyFilter();
  const p = params.get('p');
  if (p) open(p, false);
</script>
