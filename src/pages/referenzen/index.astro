---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import { kategorien, leistungen, firma } from '~/data/site';
import { url } from '~/lib/url';

const projekte = (await getCollection('projekte')).sort(
  (a, b) => (a.data.highlight ?? 99) - (b.data.highlight ?? 99) || (b.data.jahr ?? 0) - (a.data.jahr ?? 0),
);
const hero = (await getEntry('projekte', 'hanseforum'))!.data.bilder[0]!;
const bereichName = (slug: string) => leistungen.find((l) => l.slug === slug)?.title.replace('­', '') ?? '';
---

<Base title="Referenzen" description="Ein Auszug unserer Projekte: Wohnungsbau, Bürogebäude, Industriebau, Häuser und Umbauten in Hamburg und Umgebung.">
  <PageHero
    title="Projekte,"
    titleLight="die stehen."
    intro={`Eine Auswahl aus mehr als ${firma.projekteAnzahl} Projekten seit 1992. Überwiegend Rohbau, dazu zahlreiche Umbauten und Sanierungen.`}
    image={hero}
    imageAlt="Hanseforum am Axel-Springer-Platz, Hamburg"
    crumbs={[{ label: 'Referenzen' }]}
    size="medium"
  />

  <div class="refs" data-refs>
    <!-- Filter -->
    <div class="container">
      <div class="filters" role="group" aria-label="Projekte filtern" data-filters>
        <button type="button" class="f is-active" data-filter="alle" aria-pressed="true">
          Alle
        </button>
        {
          kategorien.map((k) => (
            <button type="button" class="f" data-filter={k} aria-pressed="false">
              {k}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Kacheln -->
    <div class="grid-wrap">
      <ul class="tiles" data-tiles>
        {
          projekte.map((p) => (
            <li class="tile" data-cats={p.data.kategorien.join('|')} data-id={p.id}>
              <a class="tile-in" href={url(`/referenzen/?p=${p.id}`)} data-open={p.id} aria-controls="projekt-panel">
                <Image src={p.data.bilder[0]!} alt="" widths={[400, 700, 1000]} sizes="(min-width: 1200px) 33vw, (min-width: 700px) 50vw, 100vw" />
                <span class="tile-info">
                  <span class="tile-cat">{p.data.kategorien[0]}</span>
                  <span class="tile-title">{p.data.title}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="empty" data-empty hidden>Keine Projekte in dieser Kategorie.</p>
    </div>
  </div>

  <!-- Seitenfenster -->
  <aside class="panel" id="projekt-panel" data-panel aria-hidden="true" aria-label="Projektdetails" data-lenis-prevent>
    <div class="panel-bar">
      <div class="panel-nav">
        <button type="button" class="pbtn" data-prev aria-label="Vorheriges Projekt"><Icon name="arrow" class="flip" /></button>
        <button type="button" class="pbtn" data-next aria-label="Nächstes Projekt"><Icon name="arrow" /></button>
        <button type="button" class="pbtn close" data-close aria-label="Schließen"><Icon name="close" /></button>
      </div>
    </div>
    <div class="panel-body" data-panel-body></div>
  </aside>

  <!-- Inhalte der Seitenfenster (werden erst beim Öffnen eingefügt, Bilder laden dann) -->
  {
    projekte.map((p) => (
      <template data-project={p.id}>
        <header class="pp-head">
          <span class="label">{p.data.kategorien.join(' · ')}</span>
          <h2 class="pp-title">{p.data.title}</h2>
          <p class="pp-lead">{p.data.leistung}</p>
          <dl class="pp-facts">
            <div>
              <dt>Leistungsbereich</dt>
              <dd>
                <a href={url(`/leistungen/${p.data.bereich}/`)}>{bereichName(p.data.bereich)}</a>
              </dd>
            </div>
            {p.data.fakten.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd set:html={f.value.replace(/\n/g, '<br />')} />
              </div>
            ))}
          </dl>
        </header>
        <div class="pp-galerie">
          {p.data.bilder.map((b, i) => (
            <Image
              src={b}
              alt={`${p.data.title}, Bild ${i + 1}`}
              widths={[600, 1000, 1600]}
              sizes={i === 0 ? '(min-width: 900px) 66vw, 100vw' : '(min-width: 900px) 33vw, 100vw'}
              loading={i < 3 ? 'eager' : 'lazy'}
            />
          ))}
        </div>
      </template>
    ))
  }
</Base>

<style>
  /* ---------- Filter ---------- */
  .refs {
    padding-block: clamp(2.5rem, 5vw, 4rem) var(--section);
  }
  :global(:root) {
    --panel-w: 66.667vw;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
    border-bottom: 1px solid var(--line);
    margin-bottom: 6px;
  }
  .f {
    position: relative;
    background: none;
    border: 0;
    padding: 1rem 0 0.9rem;
    cursor: pointer;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--ink-3);
    transition: color 0.25s ease;
  }
  .f::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--blue);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--ease);
  }
  .f:hover,
  .f.is-active {
    color: var(--blue);
  }
  .f.is-active::after {
    transform: scaleX(1);
  }

  /* ---------- Kacheln: eng und groß ---------- */
  .grid-wrap {
    padding-inline: var(--content-left);
    transition: padding 0.6s var(--ease);
  }
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 400px), 1fr));
    gap: 6px;
  }
  .tile[hidden] {
    display: none;
  }
  .tile-in {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    background: var(--stone-200);
  }
  .tile-in :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
  }
  .tile-in::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(18 23 53 / 0.85), rgb(18 23 53 / 0) 55%);
    transition: background 0.4s ease;
  }
  .tile-in:hover :global(img) {
    transform: scale(1.05);
  }
  .tile-in:hover::after {
    background: linear-gradient(to top, rgb(18 23 53 / 0.92), rgb(18 23 53 / 0.25) 70%);
  }
  .tile.is-current .tile-in {
    outline: 3px solid var(--blue);
    outline-offset: -3px;
  }
  .tile-info {
    position: absolute;
    left: 1.1rem;
    right: 1.1rem;
    bottom: 1rem;
    z-index: 1;
    display: grid;
    gap: 0.3rem;
  }
  .tile-cat {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #c9d0f5;
  }
  .tile-title {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.3rem, 1.6vw, 1.6rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .empty {
    color: var(--ink-3);
  }

  /* ---------- Seitenfenster ---------- */
  .panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--panel-w);
    z-index: 120;
    display: flex;
    flex-direction: column;
    background: #fff;
    box-shadow: -30px 0 60px -30px rgb(18 23 53 / 0.35);
    transform: translateX(105%);
    transition:
      transform 0.6s var(--ease),
      visibility 0s 0.6s;
    visibility: hidden;
  }
  .panel.is-open {
    transform: none;
    visibility: visible;
    transition: transform 0.6s var(--ease);
  }
  /* Galerie rückt nach links, wenn das Fenster offen ist */
  :global(body.panel-open) .grid-wrap {
    padding-right: calc(var(--panel-w) + 6px);
    padding-left: 6px;
  }
  .panel-bar {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1rem;
    padding: 1rem clamp(1.25rem, 2.5vw, 2rem);
    border-bottom: 1px solid var(--line);
    background: #fff;
  }
  .panel-nav {
    display: flex;
    gap: 0.4rem;
  }
  .pbtn {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    background: none;
    border: 1px solid var(--line);
    color: var(--blue);
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }
  .pbtn:hover {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }
  .pbtn.close {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
  .pbtn :global(svg) {
    width: 18px;
    height: 18px;
  }
  .pbtn :global(.flip) {
    transform: rotate(180deg);
  }
  .panel-body {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.25rem, 2.5vw, 2rem) 3rem;
  }
  .panel-body :global(.pp-head) {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    margin-bottom: clamp(1.6rem, 3vw, 2.4rem);
  }
  .panel-body :global(.pp-title) {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(2.4rem, 4.2vw, 4.6rem);
    line-height: 0.9;
    text-transform: uppercase;
    color: var(--blue);
    margin: 0;
  }
  .panel-body :global(.pp-lead) {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 60ch;
    margin: 0.2rem 0 0;
  }
  /* Infos direkt unter dem Titel, nebeneinander */
  .panel-body :global(.pp-facts) {
    width: 100%;
    margin: 1rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.2rem 2rem;
  }
  .panel-body :global(.pp-facts > div) {
    position: relative;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line);
  }
  .panel-body :global(.pp-facts dt) {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 0.35rem;
  }
  .panel-body :global(.pp-facts dd) {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .panel-body :global(.pp-facts a) {
    color: var(--blue);
  }
  /* Galerie: erstes Bild groß, danach zweispaltig */
  .panel-body :global(.pp-galerie) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }
  .panel-body :global(.pp-galerie img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }
  .panel-body :global(.pp-galerie img:first-child) {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }
  @media (max-width: 900px) {
    :global(:root) {
      --panel-w: 100vw;
    }
    :global(body.panel-open) .grid-wrap {
      padding: 0 6px;
    }
    .grid-wrap {
      padding-inline: 6px;
    }
    .filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      gap: 1.4rem;
    }
    .f {
      flex: none;
    }
    .panel-body :global(.pp-galerie) {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

<script>
  const refs = document.querySelector<HTMLElement>('[data-refs]')!;
  const tiles = Array.from(document.querySelectorAll<HTMLElement>('[data-tiles] .tile'));
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const panel = document.querySelector<HTMLElement>('[data-panel]')!;
  const body = panel.querySelector<HTMLElement>('[data-panel-body]')!;
  let current: string | null = null;

  /* ---------- Filter ---------- */
  const filterWrap = document.querySelector<HTMLElement>('[data-filters]')!;
  const applyFilter = (f: string) => {
    let visible = 0;
    tiles.forEach((t) => {
      const show = f === 'alle' || (t.dataset.cats ?? '').split('|').includes(f);
      t.hidden = !show;
      if (show) visible++;
    });
    if (empty) empty.hidden = visible > 0;
    filterWrap.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => {
      const on = b.dataset.filter === f;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', String(on));
    });
  };
  filterWrap.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!b) return;
    const f = b.dataset.filter ?? 'alle';
    applyFilter(f);
    const u = new URL(location.href);
    if (f === 'alle') u.searchParams.delete('kategorie');
    else u.searchParams.set('kategorie', f);
    history.replaceState(null, '', u);
  });

  /* ---------- Seitenfenster ---------- */
  const visibleIds = () => tiles.filter((t) => !t.hidden).map((t) => t.dataset.id!);

  const open = (id: string, updateUrl = true) => {
    const tpl = document.querySelector<HTMLTemplateElement>(`template[data-project="${CSS.escape(id)}"]`);
    if (!tpl) return;
    body.replaceChildren(tpl.content.cloneNode(true));
    body.scrollTop = 0;
    current = id;
    tiles.forEach((t) => t.classList.toggle('is-current', t.dataset.id === id));
    panel.classList.add('is-open');
    panel.setAttribute('aria-hidden', 'false');
    document.body.classList.add('panel-open');
    if (updateUrl) {
      const u = new URL(location.href);
      u.searchParams.set('p', id);
      history.replaceState(null, '', u);
    }
  };
  const close = () => {
    panel.classList.remove('is-open');
    panel.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('panel-open');
    tiles.forEach((t) => t.classList.remove('is-current'));
    const last = current;
    current = null;
    const u = new URL(location.href);
    u.searchParams.delete('p');
    history.replaceState(null, '', u);
    if (last) document.querySelector<HTMLElement>(`[data-open="${CSS.escape(last)}"]`)?.focus({ preventScroll: true });
  };
  const step = (dir: number) => {
    if (!current) return;
    const ids = visibleIds();
    const i = ids.indexOf(current);
    const next = ids[(i + dir + ids.length) % ids.length];
    if (!next) return;
    open(next);
    document.querySelector<HTMLElement>(`.tile[data-id="${CSS.escape(next)}"]`)?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
  };

  refs.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-open]');
    if (!a) return;
    e.preventDefault();
    const id = a.dataset.open!;
    if (id === current) close();
    else open(id);
  });
  panel.querySelector('[data-close]')!.addEventListener('click', close);
  panel.querySelector('[data-prev]')!.addEventListener('click', () => step(-1));
  panel.querySelector('[data-next]')!.addEventListener('click', () => step(1));
  document.addEventListener('keydown', (e) => {
    if (!current) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') step(1);
    if (e.key === 'ArrowLeft') step(-1);
  });

  /* ---------- Zustand aus der URL (z. B. Links von der Startseite) ---------- */
  const params = new URL(location.href).searchParams;
  const kat = params.get('kategorie');
  if (kat) applyFilter(kat);
  const p = params.get('p');
  if (p) open(p, false);
</script>
