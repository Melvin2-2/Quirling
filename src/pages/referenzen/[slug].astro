---
import { Image, getImage } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import CtaBand from '~/components/CtaBand.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import Icon from '~/components/Icon.astro';
import { leistungen } from '~/data/site';
import { url } from '~/lib/url';

export async function getStaticPaths() {
  const alle = (await getCollection('projekte')).sort(
    (a, b) => (a.data.highlight ?? 99) - (b.data.highlight ?? 99) || (b.data.jahr ?? 0) - (a.data.jahr ?? 0),
  );
  return alle.map((p, i) => ({
    params: { slug: p.id },
    props: { p, prev: alle[(i - 1 + alle.length) % alle.length]!, next: alle[(i + 1) % alle.length]!, alle },
  }));
}
interface Props {
  p: CollectionEntry<'projekte'>;
  prev: CollectionEntry<'projekte'>;
  next: CollectionEntry<'projekte'>;
  alle: CollectionEntry<'projekte'>[];
}
const { p, prev, next, alle } = Astro.props;
const d = p.data;
const bereich = leistungen.find((l) => l.slug === d.bereich)!;
const [cover, ...galerie] = d.bilder;
const gross = await Promise.all(d.bilder.map((b) => getImage({ src: b, width: 1800, format: 'webp', quality: 80 })));
const aehnlich = alle.filter((x) => x.id !== p.id && x.data.kategorien.some((k) => d.kategorien.includes(k))).slice(0, 3);
const fakten = d.fakten.filter((f) => f.label.toLowerCase() !== 'fertigstellung');
---

<Base title={d.title} description={`${d.leistung} – Referenzprojekt der Quirling GmbH Bauunternehmen, Hamburg.`}>
  <section class="p-hero on-dark">
    <div class="p-hero-img media" data-parallax>
      <Image src={cover!} alt={`${d.title} – ${d.leistung}`} widths={[900, 1500, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="shade"></div>
    <div class="container p-hero-in">
      <nav class="crumbs" aria-label="Brotkrumen">
        <a href={url('/')}>Start</a><span aria-hidden="true">/</span><a href={url('/referenzen/')}>Referenzen</a><span aria-hidden="true"
          >/</span
        ><span aria-current="page">{d.title}</span>
      </nav>
      <p class="eyebrow light">{d.kategorien.join(' · ')}{d.jahr && ` · Fertigstellung ${d.jahr}`}</p>
      <h1 class="h1" data-split>{d.title}</h1>
      <p class="lead" data-reveal>{d.leistung}</p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container info">
      <dl class="facts" data-reveal data-reveal-children>
        <div>
          <dt>Leistung</dt>
          <dd>{d.leistung}</dd>
        </div>
        <div>
          <dt>Leistungsbereich</dt>
          <dd><a href={url(`/leistungen/${bereich.slug}/`)}>{bereich.title}</a></dd>
        </div>
        {
          d.jahr && (
            <div>
              <dt>Fertigstellung</dt>
              <dd>{d.jahr}</dd>
            </div>
          )
        }
        {
          fakten.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd set:html={f.value.replace(/\n/g, '<br />')} />
            </div>
          ))
        }
      </dl>

      <div class="gallery" data-gallery>
        {
          galerie.map((b, i) => (
            <button type="button" class="g-item media" data-index={i + 1} data-reveal aria-label={`Bild ${i + 2} von ${d.bilder.length} vergrößern`}>
              <Image src={b} alt={`${d.title} – Bild ${i + 2}`} widths={[500, 900, 1300]} sizes="(min-width: 1024px) 30vw, 50vw" />
            </button>
          ))
        }
        {
          galerie.length === 0 && (
            <button type="button" class="g-item media g-cover" data-index="0" aria-label="Titelbild vergrößern">
              <Image src={cover!} alt="" widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 60vw, 100vw" />
            </button>
          )
        }
      </div>
    </div>
  </section>

  <dialog class="lightbox" data-lightbox aria-label="Bildergalerie">
    <img alt="" data-lb-img />
    <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Schließen"><Icon name="close" /></button>
    <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Vorheriges Bild"><Icon name="arrow" /></button>
    <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Nächstes Bild"><Icon name="arrow" /></button>
    <span class="lb-count" data-lb-count></span>
  </dialog>
  <script type="application/json" data-lb-src set:html={JSON.stringify(gross.map((g) => g.src))} />

  <nav class="pn bg-stone" aria-label="Weitere Projekte">
    <div class="container pn-in">
      <a href={url(`/referenzen/${prev.id}/`)} class="pn-link">
        <span class="pn-dir"><Icon name="arrow" class="flip" /> Vorheriges Projekt</span>
        <span class="h4">{prev.data.title}</span>
      </a>
      <a href={url('/referenzen/')} class="pn-all">Alle Referenzen</a>
      <a href={url(`/referenzen/${next.id}/`)} class="pn-link right">
        <span class="pn-dir">Nächstes Projekt <Icon name="arrow" /></span>
        <span class="h4">{next.data.title}</span>
      </a>
    </div>
  </nav>

  {
    aehnlich.length > 0 && (
      <section class="section bg-white">
        <div class="container">
          <p class="eyebrow">Ähnliche Projekte</p>
          <div class="sim" data-reveal data-reveal-children>
            {aehnlich.map((x) => (
              <ProjectCard project={x} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand />
</Base>

<style>
  .p-hero {
    position: relative;
    min-height: min(88svh, 900px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
  }
  .p-hero-img {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .p-hero-img :global(img) {
    height: 114%;
    margin-top: -7%;
  }
  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(to top, rgb(18 23 53 / 0.9) 0%, rgb(18 23 53 / 0.35) 50%, rgb(18 23 53 / 0.3) 100%);
  }
  .p-hero-in {
    padding-top: calc(var(--header-h) + 2rem);
    padding-bottom: clamp(3rem, 7vw, 5.5rem);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: rgb(255 255 255 / 0.7);
    margin-bottom: clamp(3rem, 10vw, 9rem);
  }
  .crumbs a {
    text-decoration: none;
  }
  .p-hero .lead {
    margin-top: 1.2rem;
    max-width: 40rem;
  }
  .info {
    display: grid;
    grid-template-columns: 1fr 2.2fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .facts {
    margin: 0;
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    border-top: 2px solid var(--blue);
  }
  .facts > div {
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .facts dt {
    font-family: var(--font-head);
    font-stretch: 115%;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 0.3rem;
  }
  .facts dd {
    margin: 0;
    color: var(--ink-2);
    line-height: 1.5;
  }
  .gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }
  .g-item {
    border: 0;
    padding: 0;
    cursor: zoom-in;
    aspect-ratio: 4 / 3;
  }
  .g-item:nth-child(3n + 1) {
    grid-column: span 2;
    aspect-ratio: 16 / 9;
  }
  .g-item :global(img) {
    transition: transform 1s var(--ease);
  }
  .g-item:hover :global(img) {
    transform: scale(1.04);
  }
  .g-item:nth-child(3n + 2):last-child,
  .g-cover {
    grid-column: span 2;
    aspect-ratio: 16 / 9;
  }

  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(10 12 28 / 0.96);
    color: #fff;
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox img {
    max-width: 92vw;
    max-height: 86vh;
    object-fit: contain;
  }
  .lb-btn {
    position: absolute;
    width: 54px;
    height: 54px;
    border: 1px solid rgb(255 255 255 / 0.35);
    background: transparent;
    color: #fff;
    border-radius: 0;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .lb-btn:hover {
    background: var(--blue);
    border-color: var(--blue);
  }
  .lb-btn :global(svg) {
    width: 22px;
    height: 22px;
  }
  .lb-close {
    top: 1.25rem;
    right: 1.25rem;
  }
  .lb-prev {
    left: 1.25rem;
    top: 50%;
  }
  .lb-prev :global(svg) {
    transform: rotate(180deg);
  }
  .lb-next {
    right: 1.25rem;
    top: 50%;
  }
  .lb-count {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.9rem;
    color: rgb(255 255 255 / 0.7);
  }

  .pn-in {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 2rem;
  }
  .pn-link {
    display: grid;
    gap: 0.3rem;
    text-decoration: none;
  }
  .pn-link.right {
    text-align: right;
    justify-items: end;
  }
  .pn-link:hover .h4 {
    color: var(--blue);
  }
  .pn-dir {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--ink-3);
  }
  .pn-dir :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  .pn-dir :global(.flip) {
    transform: rotate(180deg);
  }
  .pn-all {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--blue);
    text-decoration: none;
    padding: 0.6rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0;
  }
  .sim {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 2rem);
  }
  @media (max-width: 900px) {
    .info {
      grid-template-columns: 1fr;
    }
    .facts {
      position: static;
    }
    .sim {
      grid-template-columns: 1fr 1fr;
    }
    .pn-all {
      display: none;
    }
    .pn-in {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .sim {
      grid-template-columns: 1fr;
    }
    .gallery {
      grid-template-columns: 1fr;
    }
    .g-item:nth-child(3n + 1),
    .g-item:nth-child(3n + 2):last-child,
    .g-cover {
      grid-column: auto;
      aspect-ratio: 4 / 3;
    }
  }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const srcs: string[] = JSON.parse(document.querySelector('[data-lb-src]')?.textContent ?? '[]');
  const img = dlg?.querySelector<HTMLImageElement>('[data-lb-img]');
  const count = dlg?.querySelector<HTMLElement>('[data-lb-count]');
  let idx = 0;
  const show = (i: number) => {
    if (!img || !srcs.length) return;
    idx = (i + srcs.length) % srcs.length;
    img.src = srcs[idx]!;
    if (count) count.textContent = `${idx + 1} / ${srcs.length}`;
  };
  document.querySelectorAll<HTMLButtonElement>('[data-gallery] [data-index]').forEach((b) =>
    b.addEventListener('click', () => {
      show(Number(b.dataset.index));
      dlg?.showModal();
      window.dispatchEvent(new CustomEvent('quirling:lock'));
    }),
  );
  dlg?.addEventListener('close', () => window.dispatchEvent(new CustomEvent('quirling:unlock')));
  dlg?.querySelector('[data-lb-close]')?.addEventListener('click', () => dlg.close());
  dlg?.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(idx - 1));
  dlg?.querySelector('[data-lb-next]')?.addEventListener('click', () => show(idx + 1));
  dlg?.addEventListener('click', (e) => e.target === dlg && dlg.close());
  document.addEventListener('keydown', (e) => {
    if (!dlg?.open) return;
    if (e.key === 'ArrowLeft') show(idx - 1);
    if (e.key === 'ArrowRight') show(idx + 1);
  });
</script>
