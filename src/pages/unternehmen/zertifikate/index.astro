---
import { getEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import { downloadGruppen, downloadsZip, firma } from '~/data/site';
import { url } from '~/lib/url';

const hero = (await getEntry('projekte', 'amsinckstrasse'))!.data.bilder[0]!;
---

<Base title="Zertifikate & Downloads" description="Bescheinigungen und Nachweise der Quirling GmbH zum Herunterladen: Freistellungsbescheinigung, BG Bau, SOKA-BAU, Registernachweis und mehr.">
  <PageHero
    title="Zertifikate"
    titleLight="und Nachweise."
    intro="Alle Bescheinigungen für Auftraggeber als PDF. Weitere Dokumente senden wir Ihnen gerne auf Anfrage zu."
    image={hero}
    imageAlt="Bürogebäude Amsinckstraße"
    size="small"
    crumbs={[{ label: 'Unternehmen', href: '/unternehmen/' }, { label: 'Zertifikate & Downloads' }]}
  />

  <section class="section">
    <div class="container dl-wrap">
      <div class="dl-side">
        <h2 class="h-sec">Zum<br /><span class="lt">Download.</span></h2>
        <p class="small">Einzeln nach Thema oder alle Nachweise gesammelt in einer Datei. Fehlt Ihnen ein Dokument, schreiben Sie uns kurz.</p>
        <a class="zip" href={url(`/downloads/${downloadsZip.file}`)} download>
          <span class="zip-t">Alle Nachweise</span>
          <span class="zip-m">ZIP · {downloadsZip.size}</span>
          <span class="zip-i"><Icon name="download" /></span>
        </a>
        <a class="text-link" href={`mailto:${firma.email}?subject=Anfrage%20Nachweise`}><span>Dokument anfragen</span><Icon name="arrow" /></a>
      </div>

      <div class="groups">
        {
          downloadGruppen.map((g) => (
            <section class="group" aria-labelledby={`g-${g.titel}`}>
              <header class="g-head">
                <h3 class="g-t" id={`g-${g.titel}`}>{g.titel}</h3>
                <p class="small">{g.text}</p>
              </header>
              <ul class="dl-list">
                {g.dokumente.map((d) => (
                  <li>
                    <a href={url(`/downloads/${d.file}`)} download class="dl">
                      <span class="dl-title">{d.title}</span>
                      <span class="dl-size">PDF · {d.size}</span>
                      <span class="dl-icon">
                        <Icon name="download" />
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .dl-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .dl-side {
    position: sticky;
    top: 7rem;
    display: grid;
    gap: 1.3rem;
    justify-items: start;
  }
  .dl-side .small {
    margin: 0;
    max-width: 34ch;
  }

  /* Gesamt-Download */
  .zip {
    width: 100%;
    max-width: 22rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.2rem 1rem;
    padding: 1.1rem 1.1rem 1.1rem 1.4rem;
    background: var(--navy);
    color: #fff;
    text-decoration: none;
    margin-top: 0.4rem;
    transition: background 0.3s ease;
  }
  .zip:hover {
    background: var(--blue);
  }
  .zip-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 1.5rem;
    line-height: 1;
  }
  .zip-m {
    grid-row: 2;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: #aab4ea;
  }
  .zip-i {
    grid-row: 1 / 3;
    grid-column: 2;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: var(--blue);
    transition: background 0.3s ease;
  }
  .zip:hover .zip-i {
    background: var(--navy);
  }
  .zip-i :global(svg) {
    width: 20px;
    height: 20px;
  }

  /* Gruppen */
  .groups {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }
  .g-head {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 0.4rem 2rem;
    align-items: end;
    margin-bottom: 1rem;
  }
  .g-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.9rem, 2.8vw, 2.8rem);
    line-height: 0.9;
    color: var(--blue);
    margin: 0;
  }
  .g-head .small {
    margin: 0;
    max-width: 44ch;
  }
  .dl-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .dl {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1rem 1rem 1rem 1.4rem;
    background: #fff;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.25s ease;
  }
  .dl:hover {
    background: var(--tint);
  }
  .dl-title {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.1rem, 1.35vw, 1.3rem);
    line-height: 1.05;
  }
  .dl-size {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .dl-icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 1px solid var(--stone-200);
    color: var(--blue);
    transition:
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }
  .dl:hover .dl-icon {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }
  .dl-icon :global(svg) {
    width: 18px;
    height: 18px;
  }
  @media (max-width: 900px) {
    .dl-wrap {
      grid-template-columns: minmax(0, 1fr);
    }
    .dl-side {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .g-head {
      grid-template-columns: minmax(0, 1fr);
    }
    .dl {
      grid-template-columns: minmax(0, 1fr) auto;
      padding: 0.9rem 0.9rem 0.9rem 1.1rem;
    }
    .dl-size {
      display: none;
    }
  }
</style>
