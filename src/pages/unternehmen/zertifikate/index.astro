---
import { getEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import { downloads, firma } from '~/data/site';
import { url } from '~/lib/url';

const hero = (await getEntry('projekte', 'amsinckstrasse'))!.data.bilder[0]!;
---

<Base title="Zertifikate & Downloads" description="Bescheinigungen und Nachweise der Quirling GmbH zum Herunterladen: Freistellungsbescheinigung, BG Bau, SOKA-BAU, Registernachweis und mehr.">
  <PageHero
    eyebrow="Unternehmen · Downloads"
    title="Zertifikate & Bescheinigungen."
    intro="Wir bemühen uns, den Downloadbereich immer aktuell zu halten. Sollten Sie noch weitere Dokumente benötigen, kontaktieren Sie uns bitte."
    image={hero}
    size="medium"
    crumbs={[{ label: 'Unternehmen', href: '/unternehmen/' }, { label: 'Zertifikate & Downloads' }]}
  />

  <section class="section bg-white">
    <div class="container dl-wrap">
      <div class="dl-side">
        <p class="eyebrow">Downloads</p>
        <h2 class="h3">Nachweise für Auftraggeber</h2>
        <p>Alle Dokumente als PDF. Weitere Nachweise senden wir Ihnen gerne auf Anfrage zu.</p>
        <a class="link-arrow" href={`mailto:${firma.email}?subject=Anfrage%20Nachweise`}>Dokument anfragen <Icon name="arrow" /></a>
      </div>
      <ul class="dl-list" data-reveal data-reveal-children>
        {
          downloads.map((d) => (
            <li>
              <a href={url(`/downloads/${d.file}`)} download class="dl">
                <span class="dl-type">PDF</span>
                <span class="dl-title">{d.title}</span>
                <span class="dl-size">{d.size}</span>
                <span class="dl-icon">
                  <Icon name="download" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .dl-wrap {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .dl-side {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
  .dl-side p:not(.eyebrow) {
    color: var(--ink-2);
    margin: 1rem 0 1.5rem;
  }
  .dl-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .dl {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.4rem 0.5rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: background 0.25s ease;
  }
  .dl:hover {
    background: var(--stone-50);
  }
  .dl-type {
    font-family: var(--font-head);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #fff;
    background: var(--blue);
    padding: 0.3rem 0.5rem;
  }
  .dl-title {
    font-family: var(--font-head);
    font-stretch: 108%;
    font-weight: 600;
    font-size: 1.1rem;
    line-height: 1.3;
  }
  .dl-size {
    color: var(--ink-3);
    font-size: 0.9rem;
    white-space: nowrap;
  }
  .dl-icon {
    width: 46px;
    height: 46px;
    border: 1px solid var(--line);
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--blue);
    transition:
      background 0.3s ease,
      color 0.3s ease;
  }
  .dl:hover .dl-icon {
    background: var(--blue);
    color: #fff;
  }
  .dl-icon :global(svg) {
    width: 20px;
    height: 20px;
  }
  @media (max-width: 900px) {
    .dl-wrap {
      grid-template-columns: 1fr;
    }
    .dl-side {
      position: static;
    }
  }
  @media (max-width: 520px) {
    .dl {
      grid-template-columns: 1fr auto;
    }
    .dl-type,
    .dl-size {
      display: none;
    }
  }
</style>
