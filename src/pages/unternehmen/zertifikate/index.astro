---
import { getEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import { downloads, firma } from '~/data/site';
import { url } from '~/lib/url';

const hero = (await getEntry('projekte', 'amsinckstrasse'))!.data.bilder[0]!;
---

<Base title="Zertifikate & Downloads" description="Bescheinigungen und Nachweise der Quirling GmbH zum Herunterladen: Freistellungsbescheinigung, BG Bau, SOKA-BAU, Registernachweis und mehr.">
  <PageHero
    eyebrow="Downloads"
    title="Zertifikate"
    titleLight="und Nachweise."
    intro="Alle Bescheinigungen für Auftraggeber als PDF. Weitere Dokumente senden wir Ihnen gerne auf Anfrage zu."
    image={hero}
    imageAlt="Bürogebäude Amsinckstraße"
    size="small"
    crumbs={[{ label: 'Unternehmen', href: '/unternehmen/' }, { label: 'Zertifikate & Downloads' }]}
  />

  <section class="section">
    <div class="container dl-wrap">
      <div class="dl-side">
        <span class="label">{downloads.length} Dokumente</span>
        <h2 class="h-sec">Zum<br /><span class="lt">Download.</span></h2>
        <p class="small">Wir halten den Downloadbereich aktuell. Fehlt Ihnen ein Nachweis, schreiben Sie uns kurz.</p>
        <a class="text-link" href={`mailto:${firma.email}?subject=Anfrage%20Nachweise`}><span>Dokument anfragen</span><Icon name="arrow" /></a>
      </div>
      <ul class="dl-list">
        {
          downloads.map((d, i) => (
            <li>
              <a href={url(`/downloads/${d.file}`)} download class="dl">
                <span class="label dl-nr">{String(i + 1).padStart(2, '0')}</span>
                <span class="dl-title">{d.title}</span>
                <span class="dl-size">PDF · {d.size}</span>
                <span class="dl-icon">
                  <Icon name="download" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .dl-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.8fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .dl-side {
    position: sticky;
    top: 7rem;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  .dl-side .small {
    margin: 0;
    max-width: 34ch;
  }
  .dl-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }
  .dl {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.3rem 1.3rem 1.3rem 1.5rem;
    background: #fff;
    text-decoration: none;
    color: var(--ink);
    transition: background 0.25s ease;
  }
  .dl:hover {
    background: var(--tint);
  }
  .dl-title {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.2rem, 1.5vw, 1.45rem);
    line-height: 1.05;
  }
  .dl-size {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    white-space: nowrap;
  }
  .dl-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: var(--navy);
    color: #fff;
    transition: background 0.3s ease;
  }
  .dl:hover .dl-icon {
    background: var(--blue);
  }
  .dl-icon :global(svg) {
    width: 20px;
    height: 20px;
  }
  @media (max-width: 900px) {
    .dl-wrap {
      grid-template-columns: minmax(0, 1fr);
    }
    .dl-side {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .dl {
      grid-template-columns: minmax(0, 1fr) auto;
      padding: 1rem 1rem 1rem 1.2rem;
    }
    .dl-nr,
    .dl-size {
      display: none;
    }
  }
</style>
