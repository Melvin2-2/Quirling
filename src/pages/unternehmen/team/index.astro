---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import { url } from '~/lib/url';
import baustellenteam from '~/assets/team/baustellenteam.jpg';
import baustelle from '~/assets/site/buero-tilsiter-strasse.jpg';
import thomas from '~/assets/team/thomas-quirling.jpg';
import ivonne from '~/assets/team/ivonne-quirling.jpg';
import michaela from '~/assets/team/michaela-venghaus.jpg';

const personen = [
  { name: 'Thomas Quirling', rolle: 'Geschäftsführender Gesellschafter', bild: thomas },
  { name: 'Ivonne Quirling', rolle: 'Assistentin der Geschäftsführung', bild: ivonne },
  { name: 'Michaela Venghaus', rolle: 'Büroangestellte', bild: michaela },
];
---

<Base title="Team" description="Das Team der Quirling GmbH: Geschäftsführung, Büro und unsere Mannschaft auf der Baustelle.">
  <PageHero
    title="Wir stellen"
    titleLight="uns vor."
    intro="Ein eingespieltes und beständiges Team, das Sie bei Ihrem Vorhaben kompetent und zuverlässig unterstützt."
    image={baustelle}
    imageAlt="Bürogebäude der Quirling GmbH in der Tilsiter Straße 174, Hamburg"
    crumbs={[{ label: 'Unternehmen', href: '/unternehmen/' }, { label: 'Team' }]}
    size="medium"
  />

  <section class="section">
    <div class="container">
      <div class="head">
        <h2 class="h-sec">Ihre<br /><span class="lt">Ansprechpartner.</span></h2>
      </div>
      <div class="people">
        {
          personen.map((p) => (
            <article class="person">
              <div class="pimg">
                <Image src={p.bild} alt={p.name} widths={[400, 700, 1000]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw" />
              </div>
              <span class="label">{p.rolle}</span>
              <h3 class="p-name">{p.name}</h3>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section crew">
    <div class="container crew-in">
      <div class="crew-text">
        <h2 class="h-sec">Unsere<br /><span class="lt">Mannschaft.</span></h2>
        <p class="small">
          Das Herz unseres Unternehmens sind die Facharbeiter auf der Baustelle. Junge und erfahrene Kollegen, die seit vielen Jahren zusammenarbeiten.
          Wir bauen auf Partnerschaft im eigenen Team, denn ein zufriedenes Team ist auch für den Auftraggeber vielversprechend.
        </p>
        <a class="text-link" href={url('/karriere/')}><span>Mit anpacken</span><Icon name="arrow" /></a>
      </div>
      <div class="para crew-img">
        <span class="para-img">
          <Image src={baustellenteam} alt="Gruppenfoto unserer Mannschaft vor Schalungselementen" widths={[700, 1100, 1440]} sizes="(min-width: 1024px) 60vw, 100vw" />
        </span>
      </div>
    </div>
  </section>
</Base>

<style>
  .head {
    display: grid;
    gap: 1.2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .people {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .person {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }
  .pimg {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-bottom: 0.8rem;
    background: var(--stone-200);
  }
  .pimg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: transform 1s var(--ease);
  }
  .person:hover .pimg :global(img) {
    transform: scale(1.04);
  }
  .p-name {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    line-height: 1;
    color: var(--blue);
    margin: 0;
  }

  /* gleiche Fläche wie die Seite: die Mannschaft gehört dazu */
  .crew {
    padding-top: 0;
  }
  .crew-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }
  .crew-text {
    grid-column: 9 / 13;
    order: 2;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  .crew-text .small {
    margin: 0 0 0.4rem;
    max-width: 44ch;
  }
  .crew-img {
    grid-column: 1 / 9;
  }

  @media (max-width: 900px) {
    .people {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .crew-in {
      grid-template-columns: minmax(0, 1fr);
    }
    .crew-text,
    .crew-img {
      grid-column: 1 / -1;
      order: 0;
    }
    .crew-img {
      margin-inline: 4%;
    }
  }
  @media (max-width: 560px) {
    .people {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
