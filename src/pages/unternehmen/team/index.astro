---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import QHammer from '~/components/QHammer.astro';
import { url } from '~/lib/url';
import { firma } from '~/data/site';
import mannschaft from '~/assets/team/baustellenteam.jpg';
import kopfbild from '~/assets/site/baustelle-team.jpg';
import thomas from '~/assets/team/thomas-quirling.jpg';
import ivonne from '~/assets/team/ivonne-quirling.jpg';
import michaela from '~/assets/team/michaela-venghaus.jpg';

const personen = [
  { name: 'Thomas Quirling', rolle: 'Geschäftsführender Gesellschafter', bild: thomas },
  { name: 'Ivonne Quirling', rolle: 'Assistentin der Geschäftsführung', bild: ivonne },
  { name: 'Michaela Venghaus', rolle: 'Büroangestellte', bild: michaela },
];
---

<Base title="Team" description="Das Team der Quirling GmbH: Ihre Ansprechpartner im Büro und unsere Mannschaft auf der Baustelle.">
  <PageHero
    title="Wir stellen"
    titleLight="uns vor."
    intro="Ein eingespieltes Team aus jungen und erfahrenen Kollegen. Im Büro und auf der Baustelle."
    image={kopfbild}
    imageAlt="Zwei Mitarbeiter der Quirling GmbH mit blauen Helmen vor einer Schalung"
    imagePosition="50% 30%"
    crumbs={[{ label: 'Unternehmen', href: '/unternehmen/' }, { label: 'Team' }]}
  />

  <!-- Ansprechpartner im Büro -->
  <section class="section">
    <div class="container">
      <div class="head">
        <h2 class="h-sec">Ihre<br /><span class="lt">Ansprechpartner.</span></h2>
        <p class="small">
          Sie erreichen uns direkt im Büro in der Tilsiter Straße: <a href={firma.telefonHref}>{firma.telefon}</a>{' oder '}<a href={`mailto:${firma.email}`}>{firma.email}</a>.
        </p>
      </div>
      <div class="people">
        {
          personen.map((p) => (
            <article class="person">
              <div class="pimg">
                <Image src={p.bild} alt={p.name} widths={[400, 700, 1000]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw" />
              </div>
              <h3 class="p-name">{p.name}</h3>
              <p class="p-role">{p.rolle}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Mannschaft auf der Baustelle: Text oben, Gruppenfoto in voller Breite, darunter der Weg zur Karriere -->
  <section class="crew on-dark">
    <div class="container">
      <div class="crew-head">
        <h2 class="h-sec">Unsere<br /><span class="lt">Mannschaft.</span></h2>
        <p>
          Das Herz des Unternehmens sind die Facharbeiter auf der Baustelle. Junge und erfahrene Kollegen, die seit vielen Jahren zusammenarbeiten und
          sich aufeinander verlassen können. Sie sind der Grund, warum unsere Bauten stehen.
        </p>
      </div>
      <figure class="crew-photo">
        <Image src={mannschaft} alt="Die Mannschaft der Quirling GmbH vor Schalungselementen" widths={[800, 1200, 1600, 2200]} sizes="(min-width: 1400px) 1300px, 100vw" />
      </figure>
      <div class="crew-cta">
        <div class="crew-cta-t">
          <span class="crew-l">Werde Teil des Teams</span>
          <span class="crew-h"><QHammer class="crew-hammer" color="#9aa6ee" highlight="#ffffff" />Mit anpacken.</span>
        </div>
        <a class="crew-btn" href={url('/karriere/')}><span>Zur Karriere</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .head .h-sec {
    font-size: clamp(2.6rem, 4.6vw, 4.8rem);
    overflow-wrap: normal;
  }
  .head .small {
    margin: 0;
    max-width: 30rem;
  }
  .head a {
    color: var(--blue);
    white-space: nowrap;
  }
  .people {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .person {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
  }
  /* Porträt mit angedeutetem Rautenknick unten rechts */
  .pimg {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-bottom: 0.9rem;
    background: var(--stone-200);
    clip-path: polygon(0 0, 100% 0, 100% 92%, 78% 100%, 0 100%);
  }
  .pimg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: transform 1s var(--ease);
  }
  .person:hover .pimg :global(img) {
    transform: scale(1.04);
  }
  .p-name {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    line-height: 1;
    color: var(--blue);
    margin: 0;
  }
  .p-role {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 300;
    color: var(--ink-2);
  }

  /* Mannschaft: Navy-Fläche mit Rautenknick oben, Gruppenfoto unbeschnitten in Containerbreite */
  .crew {
    background: var(--navy);
    color: #fff;
    padding-block: clamp(6rem, 10vw, 9rem) clamp(4.5rem, 7vw, 6rem);
    clip-path: polygon(0 clamp(0.8rem, 1.6vw, 1.4rem), 22% clamp(2rem, 4vw, 3.5rem), 100% 0, 100% 100%, 0 100%);
  }
  .crew-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .crew-head .h-sec {
    color: #fff;
  }
  .crew-head p {
    margin: 0;
    max-width: 34rem;
    font-weight: 300;
    color: rgb(255 255 255 / 0.85);
  }
  /* Seitenverhältnis 16:9, Ausschnitt unten verankert: oben fällt nur Schalung weg, alle Personen bleiben vollständig sichtbar */
  .crew-photo {
    margin: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 100% 90%, 86% 100%, 0 100%);
    background: var(--stone-200);
  }
  .crew-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 88%;
  }
  /* Karriere: ruhige Zeile unter dem Foto, Raute-Knopf wie auf der übrigen Seite */
  .crew-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .crew-cta-t {
    display: grid;
    gap: 0.5rem;
  }
  .crew-l {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #9aa6ee;
  }
  .crew-h {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2rem, 3.2vw, 3.2rem);
    line-height: 0.9;
    white-space: nowrap;
  }
  .crew-cta :global(.crew-hammer) {
    width: 1em;
    height: 1em;
  }
  .crew-btn {
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.15rem 1.5rem 1.05rem;
    line-height: 1;
    background: #9aa6ee;
    color: var(--navy);
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.25rem, 1.6vw, 1.55rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease;
  }
  .crew-btn :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    transition: transform 0.35s var(--ease);
  }
  .crew-btn:hover {
    background: #fff;
  }
  .crew-btn:hover :global(svg) {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .head {
      grid-template-columns: minmax(0, 1fr);
    }
    .crew-head {
      grid-template-columns: minmax(0, 1fr);
    }
    .crew-photo {
      aspect-ratio: 3 / 2;
      margin-inline: calc(var(--gutter) * -1);
      clip-path: polygon(0 0, 100% 0, 100% 94%, 0 100%);
    }
    .people {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .people {
      grid-template-columns: minmax(0, 1fr);
    }
    .crew-h {
      font-size: 1.8rem;
    }
  }
</style>
