---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import { firma } from '~/data/site';
import { url } from '~/lib/url';
import baustellenteam from '~/assets/team/baustellenteam.jpg';
import baustelle from '~/assets/site/rohbau-wandsbek.jpg';
import thomas from '~/assets/team/thomas-quirling.jpg';
import ivonne from '~/assets/team/ivonne-quirling.jpg';
import michaela from '~/assets/team/michaela-venghaus.jpg';

const personen = [
  { name: 'Thomas Quirling', rolle: 'Geschäftsführender Gesellschafter', bild: thomas },
  { name: 'Ivonne Quirling', rolle: 'Assistentin der Geschäftsführung', bild: ivonne },
  { name: 'Michaela Venghaus', rolle: 'Büroangestellte', bild: michaela },
];
---

<Base title="Team" description="Das Team der Quirling GmbH: Geschäftsführung, Büro und unsere Mannschaft auf der Baustelle.">
  <PageHero
    title="Wir stellen"
    titleLight="uns vor."
    intro="Ein eingespieltes und beständiges Team, das Sie bei Ihrem Vorhaben kompetent und zuverlässig unterstützt."
    image={baustelle}
    imageAlt="Rohbau der Quirling GmbH in Hamburg-Wandsbek"
    crumbs={[{ label: 'Unternehmen', href: '/unternehmen/' }, { label: 'Team' }]}
    size="medium"
  />

  <section class="section">
    <div class="container">
      <div class="head">
        <h2 class="h-sec">Ihre<br /><span class="lt">Ansprechpartner.</span></h2>
        <!-- Kontaktkarte neben der Überschrift, nicht in der Bildreihe -->
        <aside class="reach">
          <div class="reach-in">
            <h3 class="reach-t">Direkt<br /><span class="lt">erreichen.</span></h3>
            <a class="reach-tel" href={firma.telefonHref}>{firma.telefon}</a>
            <a class="reach-mail" href={`mailto:${firma.email}`}>{firma.email}</a>
            <p>Montags bis freitags für Sie da.</p>
          </div>
        </aside>
      </div>
      <div class="people">
        {
          personen.map((p) => (
            <article class="person">
              <div class="pimg">
                <Image src={p.bild} alt={p.name} widths={[400, 700, 1000]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw" />
              </div>
              <span class="label">{p.rolle}</span>
              <h3 class="p-name">{p.name}</h3>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section crew">
    <div class="container crew-in">
      <div class="crew-text">
        <h2 class="h-sec">Unsere<br /><span class="lt">Mannschaft.</span></h2>
        <p class="small">
          Das Herz unseres Unternehmens sind die Facharbeiter auf der Baustelle. Junge und erfahrene Kollegen, die seit vielen Jahren zusammenarbeiten.
          Wir bauen auf Partnerschaft im eigenen Team, denn ein zufriedenes Team ist auch für den Auftraggeber vielversprechend.
        </p>
        <a class="text-link" href={url('/karriere/')}><span>Mit anpacken</span><Icon name="arrow" /></a>
      </div>
      <div class="para crew-img">
        <span class="para-img">
          <Image src={baustellenteam} alt="Gruppenfoto unserer Mannschaft vor Schalungselementen" widths={[700, 1100, 1440]} sizes="(min-width: 1024px) 60vw, 100vw" />
        </span>
      </div>
    </div>
  </section>
</Base>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 2rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .people {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .person {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }
  .pimg {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-bottom: 0.8rem;
    background: var(--stone-200);
  }
  .pimg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: transform 1s var(--ease);
  }
  .person:hover .pimg :global(img) {
    transform: scale(1.04);
  }
  .p-name {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    line-height: 1;
    color: var(--blue);
    margin: 0;
  }
  .reach {
    position: relative;
    width: min(100%, 27rem);
    background: var(--navy);
    color: #fff;
    overflow: hidden;
  }
  /* blauer Keil wie die Schräge im Seitenkopf */
  .reach::before {
    content: '';
    position: absolute;
    inset: 0 0 0 auto;
    width: 34%;
    background: var(--blue);
    clip-path: polygon(45% 0, 100% 0, 100% 100%, 0 100%);
  }
  .reach-in {
    position: relative;
    padding: clamp(1.3rem, 2.2vw, 1.9rem);
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }
  .reach-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.8rem, 2.4vw, 2.4rem);
    line-height: 0.97;
    margin: 0 0 0.6rem;
    color: #fff;
  }
  .reach-t .lt {
    font-weight: 300;
  }
  .reach-tel {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.5rem, 2vw, 2rem);
    line-height: 1;
    color: #fff;
    text-decoration: none;
  }
  .reach-mail {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: #c9d0f5;
    text-decoration: none;
  }
  .reach a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .reach p {
    margin: 0.3rem 0 0;
    font-size: 0.85rem;
    color: rgb(255 255 255 / 0.75);
  }

  /* gleiche Fläche wie die Seite: die Mannschaft gehört dazu */
  .crew {
    padding-top: 0;
  }
  .crew-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }
  .crew-text {
    grid-column: 9 / 13;
    order: 2;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  .crew-text .small {
    margin: 0 0 0.4rem;
    max-width: 44ch;
  }
  .crew-img {
    grid-column: 1 / 9;
  }

  @media (max-width: 1100px) {
    .head {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }
  @media (max-width: 900px) {
    .people {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .crew-in {
      grid-template-columns: minmax(0, 1fr);
    }
    .crew-text,
    .crew-img {
      grid-column: 1 / -1;
      order: 0;
    }
    .crew-img {
      margin-inline: 4%;
    }
  }
  @media (max-width: 560px) {
    .people {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
