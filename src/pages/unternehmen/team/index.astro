---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import QHammer from '~/components/QHammer.astro';
import { url } from '~/lib/url';
import { firma } from '~/data/site';
import mannschaft from '~/assets/team/baustellenteam.jpg';
import kopfbild from '~/assets/site/baustelle-team.jpg';
import thomas from '~/assets/team/thomas-quirling.jpg';
import ivonne from '~/assets/team/ivonne-quirling.jpg';
import michaela from '~/assets/team/michaela-venghaus.jpg';

const personen = [
  { name: 'Thomas Quirling', rolle: 'Geschäftsführender Gesellschafter', bild: thomas },
  { name: 'Ivonne Quirling', rolle: 'Assistentin der Geschäftsführung', bild: ivonne },
  { name: 'Michaela Venghaus', rolle: 'Büroangestellte', bild: michaela },
];
---

<Base title="Team" description="Das Team der Quirling GmbH: Ihre Ansprechpartner im Büro und unsere Mannschaft auf der Baustelle.">
  <PageHero
    title="Wir stellen"
    titleLight="uns vor."
    intro="Ein eingespieltes Team aus jungen und erfahrenen Kollegen. Im Büro und auf der Baustelle."
    image={kopfbild}
    imageAlt="Zwei Mitarbeiter der Quirling GmbH mit blauen Helmen vor einer Schalung"
    imagePosition="50% 30%"
    crumbs={[{ label: 'Unternehmen', href: '/unternehmen/' }, { label: 'Team' }]}
  />

  <!-- Ansprechpartner im Büro -->
  <section class="section">
    <div class="container">
      <div class="head">
        <h2 class="h-sec">Ihre<br /><span class="lt">Ansprechpartner.</span></h2>
        <p class="small">
          Sie erreichen uns direkt im Büro in der Tilsiter Straße: <a href={firma.telefonHref}>{firma.telefon}</a>{' oder '}<a href={`mailto:${firma.email}`}>{firma.email}</a>.
        </p>
      </div>
      <div class="people">
        {
          personen.map((p) => (
            <article class="person">
              <div class="pimg">
                <Image src={p.bild} alt={p.name} widths={[400, 700, 1000]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw" />
              </div>
              <h3 class="p-name">{p.name}</h3>
              <p class="p-role">{p.rolle}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Mannschaft: hellblaue Fläche, Text links, Gruppenfoto rechts bis an den Rand mit Knick -->
  <section class="crew">
    <div class="crew-text">
      <h2 class="h-sec">Unsere<br /><span class="lt">Mannschaft.</span></h2>
      <p>
        Das Herz des Unternehmens sind die Facharbeiter auf der Baustelle. Junge und erfahrene Kollegen, die seit vielen Jahren zusammenarbeiten und
        sich aufeinander verlassen können. Sie sind der Grund, warum unsere Bauten stehen.
      </p>
      <div class="crew-cta">
        <span class="crew-h"><QHammer class="crew-hammer" color="#121735" highlight="#3948A4" />Bock auf Beton?</span>
        <a class="crew-btn" href={url('/karriere/')}><span>Mit anpacken</span><Icon name="arrow" /></a>
      </div>
    </div>
    <figure class="crew-photo">
      <Image src={mannschaft} alt="Die Mannschaft der Quirling GmbH vor Schalungselementen" widths={[800, 1200, 1600, 2200]} sizes="(min-width: 900px) 60vw, 100vw" />
    </figure>
  </section>
</Base>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .head .h-sec {
    font-size: clamp(2.6rem, 4.6vw, 4.8rem);
    overflow-wrap: normal;
  }
  .head .small {
    margin: 0;
    max-width: 30rem;
  }
  .head a {
    color: var(--blue);
    white-space: nowrap;
  }
  .people {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .person {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
  }
  /* Porträt mit angedeutetem Rautenknick unten rechts */
  .pimg {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-bottom: 0.9rem;
    background: var(--stone-200);
    clip-path: polygon(0 0, 100% 0, 100% 92%, 78% 100%, 0 100%);
  }
  .pimg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: transform 1s var(--ease);
  }
  .person:hover .pimg :global(img) {
    transform: scale(1.04);
  }
  .p-name {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    line-height: 1;
    color: var(--blue);
    margin: 0;
  }
  .p-role {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 300;
    color: var(--ink-2);
  }

  /* Mannschaft: hellblaue Fläche mit Rautenknick oben, Foto rechts randlos */
  .crew {
    display: grid;
    grid-template-columns: var(--content-left) minmax(0, 28rem) clamp(2.5rem, 6vw, 6rem) minmax(0, 1fr);
    align-items: center;
    background: #e6e9f6;
    color: var(--navy);
    padding-block: clamp(5rem, 8vw, 7rem) clamp(4rem, 6vw, 5.5rem);
    clip-path: polygon(0 clamp(0.8rem, 1.6vw, 1.4rem), 22% clamp(2rem, 4vw, 3.5rem), 100% 0, 100% 100%, 0 100%);
  }
  .crew-text {
    grid-column: 2;
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  .crew-text p {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--ink-2);
  }
  /* Foto im Seitenverhältnis des Originals, Knick nur oben links im Bereich der Schalung: alle Personen bleiben ganz sichtbar */
  .crew-photo {
    grid-column: 4;
    margin: 0;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    clip-path: polygon(10% 0, 100% 0, 100% 100%, 0 100%, 0 55%);
  }
  .crew-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .crew-cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-top: 0.8rem;
  }
  .crew-h {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 2.2vw, 2.1rem);
    line-height: 1;
    white-space: nowrap;
  }
  .crew-cta :global(.crew-hammer) {
    width: 1em;
    height: 1em;
  }
  .crew-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    height: clamp(2.6rem, 3vw, 3rem);
    padding: 0.1rem 1.2rem 0;
    background: var(--blue);
    color: #fff;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.15rem, 1.4vw, 1.35rem);
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease;
  }
  .crew-btn :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    transition: transform 0.35s var(--ease);
  }
  .crew-btn:hover {
    background: var(--navy);
  }
  .crew-btn:hover :global(svg) {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .head {
      grid-template-columns: minmax(0, 1fr);
    }
    .crew {
      grid-template-columns: var(--gutter) minmax(0, 1fr) var(--gutter);
      row-gap: 3rem;
    }
    .crew-photo {
      grid-column: 1 / -1;
      grid-row: 2;
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 94%);
    }
    .people {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .people {
      grid-template-columns: minmax(0, 1fr);
    }
    .crew-h {
      font-size: 1.8rem;
    }
  }
</style>
