---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import QHammer from '~/components/QHammer.astro';
import { url } from '~/lib/url';
import { firma } from '~/data/site';
import mannschaft from '~/assets/team/baustellenteam.jpg';
import kran from '~/assets/site/kran.jpg';
import thomas from '~/assets/team/thomas-quirling.jpg';
import ivonne from '~/assets/team/ivonne-quirling.jpg';
import michaela from '~/assets/team/michaela-venghaus.jpg';

const personen = [
  { name: 'Thomas Quirling', rolle: 'Geschäftsführender Gesellschafter', bild: thomas },
  { name: 'Ivonne Quirling', rolle: 'Assistentin der Geschäftsführung', bild: ivonne },
  { name: 'Michaela Venghaus', rolle: 'Büroangestellte', bild: michaela },
];
---

<Base title="Team" description="Das Team der Quirling GmbH: Ihre Ansprechpartner im Büro und unsere Mannschaft auf der Baustelle.">
  <PageHero
    title="Wir stellen"
    titleLight="uns vor."
    intro="Ein eingespieltes Team aus jungen und erfahrenen Kollegen. Im Büro und auf der Baustelle."
    image={kran}
    imageAlt="Baukran der Quirling GmbH vor bewölktem Himmel"
    imagePosition="40% 50%"
    crumbs={[{ label: 'Unternehmen', href: '/unternehmen/' }, { label: 'Team' }]}
  />

  <!-- Ansprechpartner im Büro -->
  <section class="section">
    <div class="container">
      <div class="head">
        <h2 class="h-sec">Ihre<br /><span class="lt">Ansprechpartner.</span></h2>
        <p class="small">
          Sie erreichen uns direkt im Büro in der Tilsiter Straße: <a href={firma.telefonHref}>{firma.telefon}</a>{' oder '}<a href={`mailto:${firma.email}`}>{firma.email}</a>.
        </p>
      </div>
      <div class="people">
        {
          personen.map((p) => (
            <article class="person">
              <div class="pimg">
                <Image src={p.bild} alt={p.name} widths={[400, 700, 1000]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw" />
              </div>
              <h3 class="p-name">{p.name}</h3>
              <p class="p-role">{p.rolle}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Mannschaft auf der Baustelle -->
  <section class="crew on-dark">
    <!-- Gruppenfoto randlos rechts, Innenkante schräg wie im Seitenkopf -->
    <div class="crew-photo">
      <Image src={mannschaft} alt="Die Mannschaft der Quirling GmbH vor Schalungselementen" widths={[800, 1200, 1600]} sizes="(min-width: 900px) 55vw, 100vw" />
    </div>
    <div class="container crew-in">
      <div class="crew-text">
        <h2 class="h-sec">Unsere<br /><span class="lt">Mannschaft.</span></h2>
        <p>
          Das Herz des Unternehmens sind die Facharbeiter auf der Baustelle. Junge und erfahrene Kollegen, die seit vielen Jahren zusammenarbeiten und
          sich aufeinander verlassen können. Sie sind der Grund, warum unsere Bauten stehen.
        </p>
        <a class="crew-cta" href={url('/karriere/')}>
          <span class="crew-l">Werde Teil des Teams</span>
          <span class="crew-h"><QHammer class="crew-hammer" color="#ffffff" highlight="#9aa6ee" />Mit anpacken</span>
          <span class="crew-btn">Zur Karriere <Icon name="arrow" /></span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 5vw, 5rem);
    align-items: end;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .head .h-sec {
    font-size: clamp(2.6rem, 4.6vw, 4.8rem);
    overflow-wrap: normal;
  }
  .head .small {
    margin: 0;
    max-width: 30rem;
  }
  .head a {
    color: var(--blue);
    white-space: nowrap;
  }
  .people {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .person {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
  }
  /* Porträt mit angedeutetem Rautenknick unten rechts */
  .pimg {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-bottom: 0.9rem;
    background: var(--stone-200);
    clip-path: polygon(0 0, 100% 0, 100% 92%, 78% 100%, 0 100%);
  }
  .pimg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: transform 1s var(--ease);
  }
  .person:hover .pimg :global(img) {
    transform: scale(1.04);
  }
  .p-name {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    line-height: 1;
    color: var(--blue);
    margin: 0;
  }
  .p-role {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 300;
    color: var(--ink-2);
  }

  /* Mannschaft: Navy-Fläche mit Rautenknick oben, rechts das Gruppenfoto bis an den Rand */
  .crew {
    position: relative;
    overflow-x: clip;
    background: var(--navy);
    color: #fff;
    padding-block: clamp(6rem, 10vw, 9rem) clamp(5rem, 8vw, 7rem);
    clip-path: polygon(0 clamp(0.8rem, 1.6vw, 1.4rem), 22% clamp(2rem, 4vw, 3.5rem), 100% 0, 100% 100%, 0 100%);
  }
  .crew-photo {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 54%;
    clip-path: polygon(18% 0, 100% 0, 100% 100%, 0 100%);
  }
  .crew-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  .crew-in {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
  }
  .crew-text {
    grid-column: 1 / 6;
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  .crew-text .h-sec {
    color: #fff;
  }
  .crew-text p {
    margin: 0;
    max-width: 30rem;
    font-weight: 300;
    color: rgb(255 255 255 / 0.85);
  }
  .crew-cta {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 0.7rem;
    margin-top: 0.8rem;
    padding: 1.4rem 2.4rem 1.5rem 2.6rem;
    color: #fff;
    text-decoration: none;
  }
  .crew-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--blue);
    clip-path: polygon(1.2rem 0, 100% 0, calc(100% - 1.2rem) 100%, 0 100%);
    z-index: -1;
  }
  .crew-l {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #c9d0f5;
  }
  .crew-h {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2rem, 2.8vw, 2.8rem);
    line-height: 0.9;
    white-space: nowrap;
  }
  .crew-cta :global(.crew-hammer) {
    width: 1.1em;
    height: 1.1em;
  }
  .crew-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.4rem;
    padding: 0.7rem 1rem 0.65rem;
    background: #9aa6ee;
    color: var(--navy);
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    transition: background 0.25s ease;
  }
  .crew-btn :global(svg) {
    width: 1.1em;
    height: 1.1em;
    transition: transform 0.35s var(--ease);
  }
  .crew-cta:hover .crew-btn {
    background: #fff;
  }
  .crew-cta:hover .crew-btn :global(svg) {
    transform: translateX(4px);
  }

  @media (max-width: 900px) {
    .head {
      grid-template-columns: minmax(0, 1fr);
    }
    .crew {
      padding-top: 0;
      clip-path: none;
    }
    .crew-photo {
      position: relative;
      width: auto;
      aspect-ratio: 16 / 10;
      margin-bottom: 3rem;
      clip-path: polygon(0 0, 100% 0, 100% 92%, 0 100%);
    }
    .crew-text {
      grid-column: 1 / -1;
    }
    .people {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .people {
      grid-template-columns: minmax(0, 1fr);
    }
    .crew-h {
      font-size: 1.8rem;
    }
  }
</style>
