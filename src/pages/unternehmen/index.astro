---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import RouteLink from '~/components/RouteLink.astro';
import Icon from '~/components/Icon.astro';
import { url } from '~/lib/url';
import { firma, JAHRE_ERFAHRUNG, GRUENDUNGSJAHR } from '~/data/site';
import historisch from '~/assets/site/historisch.jpg';
import buero from '~/assets/site/buero-tilsiter-strasse.jpg';
import thomas from '~/assets/team/thomas-quirling.jpg';

// Die Basis als Geschosse: unten das Fundament, nach oben wird es schmaler
const geschosse = [
  { v: firma.mitarbeiter, l: 'Mitarbeiter', count: true },
  { v: firma.projekteAnzahl, l: 'Projekte', plus: true, count: true },
  { v: JAHRE_ERFAHRUNG, l: 'Jahre Erfahrung', count: true },
  { v: GRUENDUNGSJAHR, l: 'Das Fundament: gegründet in Hamburg', count: false },
];

// Unser Weg: kurz, ohne Fotos
const weg = [
  { k: String(GRUENDUNGSJAHR), t: 'Gründung', d: 'Thomas Quirling gründet die Quirling GmbH in Hamburg.' },
  { k: '1997', t: 'Tegelweg', d: 'Doppelhaus, schlüsselfertig gebaut.', href: '/referenzen/?p=tegelweg' },
  { k: '2001', t: 'Hanseforum', d: 'Bürogebäude mit Tiefgarage.', href: '/referenzen/?p=hanseforum' },
  { k: '2006', t: 'Buchholz', d: 'Rohbau für 35 Reihenhäuser.', href: '/referenzen/?p=reihenhaeuser-buchholz' },
  { k: '2016', t: 'Pferdemarkt', d: '25 barrierefreie Wohnungen.', href: '/referenzen/?p=pferdemarkt' },
  { k: '2019', t: 'Neues Büro', d: 'Umzug in die Tilsiter Straße 174.' },
  { k: 'Heute', t: 'Fest in Hamburg', d: `${firma.projekteAnzahl}+ Projekte und rund ${firma.mitarbeiter} Leute im Team.` },
];

const werte = [
  { t: 'Persönlich', d: 'Feste Ansprechpartner, vom ersten Gespräch bis zur Übergabe.' },
  { t: 'Verbindlich', d: 'Klare Absprachen, auf die Sie sich verlassen können.' },
  { t: 'Sorgfältig', d: 'Sauber gebaut, vom Fundament bis ins Detail.' },
];
---

<Base title="Über uns" description={`Die Quirling GmbH ist seit ${GRUENDUNGSJAHR} als Bauunternehmen in Hamburg tätig. Familienbetrieb mit Schwerpunkt Rohbau, Beton- und Stahlbetonbau.`}>
  <PageHero
    title="Bauen in Hamburg."
    titleLight={`Seit ${GRUENDUNGSJAHR}.`}
    intro="Das Handwerk liegt bei uns in der Familie. Heute bauen wir in Hamburg und Umgebung, mit einem eingespielten Team aus jungen und erfahrenen Kollegen."
    image={historisch}
    imageAlt="Historisches Foto einer Baumannschaft auf einem Gerüst, darunter der Vater unseres Gründers"
    imagePosition="50% 35%"
    crumbs={[{ label: 'Unternehmen' }]}
  />

  <!-- 1. Basis: Text links, rechts wächst das Gebäude aus den Zahlen -->
  <section class="section base">
    <div class="container base-in">
      <div class="base-text">
        <h2 class="h-sec">Eine Basis,<br /><span class="lt">auf die Sie<br />bauen können.</span></h2>
        <p class="small">
          Unser Schwerpunkt ist der Rohbau in Beton- und Stahlbetonbauweise. Dazu bauen wir schlüsselfertig und führen Umbauten und Sanierungen aus. Für
          private Bauherren ebenso wie für Projektentwickler und Unternehmen.
        </p>
      </div>
      <ol class="stack" data-stack aria-label="Quirling in Zahlen">
        {
          geschosse.map((g, i) => (
            <li class="floor" style={`--i:${i}`}>
              <span class="floor-v">
                {g.count ? <span data-count={g.v}>{g.v}</span> : g.v}
                {g.plus && '+'}
              </span>
              <span class="floor-l">{g.l}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 2. Inhaber: Porträt randlos links über die volle Höhe, oben und unten geknickt -->
  <section class="lead on-dark">
    <div class="lead-img">
      <Image src={thomas} alt="Thomas Quirling" widths={[600, 900, 1300]} sizes="(min-width: 900px) 44vw, 100vw" />
    </div>
    <div class="container lead-in">
      <div class="lead-text">
        <span class="lead-k">Inhabergeführt seit {GRUENDUNGSJAHR}</span>
        <p class="lead-q">„Was wir zusagen,<br />steht.“</p>
        <p class="lead-p">
          Unser Leitsatz gilt für jedes Bauvorhaben. Thomas Quirling führt das Unternehmen seit der Gründung selbst, unterstützt von Ivonne Quirling in
          der Assistenz der Geschäftsführung. Bei uns sprechen Sie mit denen, die entscheiden.
        </p>
        <span class="lead-n">Thomas Quirling<small>Geschäftsführender Gesellschafter</small></span>
        <a class="lead-btn" href={url('/unternehmen/team/')}><span>Das ganze Team</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- 3. Unser Weg: Linie füllt sich beim Scrollen, Rauten leuchten nacheinander auf -->
  <section class="section way">
    <div class="container">
      <h2 class="h-sec way-h">Unser<br /><span class="lt">Weg.</span></h2>
      <ol class="way-list" data-way>
        <span class="way-line" aria-hidden="true"><span class="way-fill"></span></span>
        {
          weg.map((w) => (
            <li class="way-step">
              <span class="way-k">{w.k}</span>
              {w.href ? (
                <a class="way-t" href={url(w.href)}>
                  {w.t}
                  <Icon name="arrow" />
                </a>
              ) : (
                <span class="way-t">{w.t}</span>
              )}
              <p>{w.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 4. Historie und Werte: Text links, drei Rauten rechts -->
  <section class="roots">
    <div class="container roots-in">
      <div class="roots-text">
        <h2 class="h-sec">Bauen liegt<br /><span class="lt">in der Familie.</span></h2>
        <p class="small">
          Schon der Vater unseres Gründers stand auf dem Gerüst, das Foto oben zeigt ihn in seiner Lehrzeit. Die Begeisterung fürs Bauen hat er
          weitergegeben. {GRUENDUNGSJAHR} hat Thomas Quirling daraus ein eigenes Unternehmen gemacht, und bis heute führt die Familie es selbst.
        </p>
      </div>
      <ul class="values" data-values>
        {
          werte.map((w, i) => (
            <li class="value" style={`--i:${i}`}>
              <span class="value-r">
                <span>{w.t}</span>
              </span>
              <p>{w.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Unser Büro: großes Bild mit Navy-Schräge wie im Seitenkopf -->
  <section class="office on-dark">
    <Image src={buero} alt="Bürogebäude der Quirling GmbH in der Tilsiter Straße 174, Hamburg" widths={[1000, 1600, 2400]} sizes="100vw" class="office-img" />
    <div class="office-slab" aria-hidden="true"></div>
    <div class="container office-in">
      <h2 class="h-sec">Unser Büro.<br /><span class="lt">In Wandsbek.</span></h2>
      <p>
        Seit 2019 laufen in unserem Bürogebäude in der Tilsiter Straße die Fäden zusammen: Angebote, Planung und die Abstimmung mit allen Baustellen. Kommen Sie
        gerne vorbei, wir freuen uns auf Sie.
      </p>
      <address>{firma.strasse}, {firma.plz} {firma.ort}</address>
      <RouteLink light />
    </div>
  </section>
</Base>

<style>
  /* ---------- 1. Basis ---------- */
  .base-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
    align-items: end;
  }
  .base-text {
    grid-column: 1 / 7;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    align-self: center;
  }
  .base-text .h-sec {
    font-size: clamp(2.4rem, 4.4vw, 4.6rem);
  }
  .base-text .small {
    margin: 0;
    max-width: 48ch;
  }
  /* Geschosse: nach oben schmaler, jede Etage mit schräger rechter Kante */
  .stack {
    grid-column: 7 / 13;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    justify-items: start;
  }
  .floor {
    --w: calc(64% + var(--i) * 12%);
    width: var(--w);
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 1.05rem 3.2rem 0.95rem 1.4rem;
    clip-path: polygon(0 0, calc(100% - 1.8rem) 0, 100% 100%, 0 100%);
    background: #e6e9f6;
    color: var(--navy);
  }
  .floor:nth-child(2) {
    background: #9aa6ee;
  }
  .floor:nth-child(3) {
    background: var(--blue);
    color: #fff;
  }
  .floor:nth-child(4) {
    background: var(--navy);
    color: #fff;
  }
  .floor-v {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(2.4rem, 3.6vw, 3.6rem);
    line-height: 0.85;
  }
  .floor-l {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  /* das Gebäude wächst von unten nach oben */
  .stack.will-build .floor {
    opacity: 0;
    transform: translateY(28px);
  }
  .stack.is-built .floor {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s ease,
      transform 0.8s var(--ease);
    transition-delay: calc(var(--i) * 0.14s);
  }
  .stack.is-built .floor:nth-child(4) {
    transition-delay: 0s;
  }
  .stack.is-built .floor:nth-child(3) {
    transition-delay: 0.14s;
  }
  .stack.is-built .floor:nth-child(2) {
    transition-delay: 0.28s;
  }
  .stack.is-built .floor:nth-child(1) {
    transition-delay: 0.42s;
  }

  /* ---------- 2. Inhaber ---------- */
  .lead {
    position: relative;
    overflow-x: clip;
    min-height: min(92svh, 860px);
    display: flex;
    align-items: center;
    background: var(--navy);
    color: #fff;
    padding-block: clamp(6rem, 10vw, 8rem);
    /* oben wie unten als angedeutete Raute geknickt */
    clip-path: polygon(
      0 0,
      78% clamp(2rem, 4vw, 3.5rem),
      100% clamp(0.8rem, 1.6vw, 1.4rem),
      100% calc(100% - clamp(2rem, 4vw, 3.5rem)),
      22% 100%,
      0 calc(100% - clamp(0.8rem, 1.6vw, 1.4rem))
    );
  }
  .lead-img {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 44%;
    clip-path: polygon(0 0, 100% 0, 84% 100%, 0 100%);
  }
  .lead-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
  }
  .lead-in {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    width: 100%;
  }
  .lead-text {
    grid-column: 7 / 13;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .lead-k {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #c9d0f5;
  }
  .lead-k::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    background: #9aa6ee;
    transform: rotate(45deg);
  }
  .lead-q {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(3rem, 5.6vw, 6rem);
    line-height: 0.9;
    text-transform: uppercase;
    color: #9aa6ee;
  }
  .lead-p {
    margin: 0;
    max-width: 34rem;
    font-weight: 300;
    color: rgb(255 255 255 / 0.85);
  }
  .lead-n {
    display: grid;
    gap: 0.3rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 1.5rem;
    text-transform: uppercase;
    line-height: 1;
  }
  .lead-n small {
    font-family: var(--font-body);
    font-stretch: normal;
    font-weight: 300;
    font-size: 1rem;
    text-transform: none;
    color: rgb(255 255 255 / 0.7);
  }
  .lead-btn {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.6rem;
    padding: 1rem 1.4rem 0.9rem;
    background: #fff;
    color: var(--navy);
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.2rem, 1.5vw, 1.45rem);
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease;
  }
  .lead-btn :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    transition: transform 0.35s var(--ease);
  }
  .lead-btn:hover {
    background: #9aa6ee;
  }
  .lead-btn:hover :global(svg) {
    transform: translateX(4px);
  }
  /* ---------- 3. Unser Weg ---------- */
  .way {
    padding-block: clamp(4.5rem, 7vw, 6rem) clamp(5rem, 8vw, 6.5rem);
  }
  .way-h {
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }
  .way-list {
    --p: 0;
    position: relative;
    list-style: none;
    margin: 0;
    padding: 2.6rem 0 0;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .way-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0.55rem;
    height: 2px;
    background: var(--stone-200);
  }
  .way-fill {
    position: absolute;
    inset: 0;
    background: var(--blue);
    transform-origin: left center;
    transform: scaleX(var(--p));
  }
  .way-step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.45rem;
  }
  /* Raute auf der Linie: leer, bis die Linie sie erreicht */
  .way-step::before {
    content: '';
    position: absolute;
    left: 0;
    top: -2.6rem;
    width: 1.1rem;
    height: 1.1rem;
    background: var(--stone-50);
    border: 2px solid var(--stone-200);
    transform: rotate(45deg) scale(0.8);
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      transform 0.45s var(--ease);
  }
  .way-step.is-on::before {
    background: var(--blue);
    border-color: var(--blue);
    transform: rotate(45deg) scale(1);
  }
  .way-k {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(2.2rem, 3vw, 3rem);
    line-height: 0.85;
    color: var(--stone-300, #b9bdd3);
    transition: color 0.4s ease;
  }
  .way-step.is-on .way-k {
    color: var(--blue);
  }
  .way-t {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.15rem, 1.4vw, 1.4rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--navy);
    text-decoration: none;
  }
  a.way-t :global(svg) {
    width: 0.9em;
    height: 0.9em;
    color: var(--blue);
    transition: transform 0.35s var(--ease);
  }
  a.way-t:hover {
    color: var(--blue);
  }
  a.way-t:hover :global(svg) {
    transform: translateX(3px);
  }
  .way-step p {
    margin: 0;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.45;
    color: var(--ink-2);
  }

  /* ---------- 4. Historie und Werte ---------- */
  .roots {
    background: #e6e9f6;
    padding-block: clamp(6rem, 10vw, 8.5rem) clamp(7rem, 11vw, 9.5rem);
    clip-path: polygon(0 clamp(0.8rem, 1.6vw, 1.4rem), 22% clamp(2rem, 4vw, 3.5rem), 100% 0, 100% 100%, 0 100%);
  }
  .roots-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  .roots-text {
    grid-column: 1 / 6;
    display: grid;
    gap: 1.2rem;
  }
  .roots-text .small {
    margin: 0;
    max-width: 46ch;
  }
  /* drei Rauten wie im Logo, leicht versetzt */
  .values {
    grid-column: 6 / 13;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .value {
    display: grid;
    justify-items: center;
    gap: 1.6rem;
    text-align: center;
  }
  .value:nth-child(2) {
    margin-top: 3.5rem;
  }
  .value-r {
    position: relative;
    width: min(100%, 11.5rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .value-r::before {
    content: '';
    position: absolute;
    inset: 14.6%;
    background: var(--navy);
    transform: rotate(45deg);
    transition: transform 0.6s var(--ease);
  }
  .value:nth-child(2) .value-r::before {
    background: var(--blue);
  }
  .value:nth-child(3) .value-r::before {
    background: #9aa6ee;
  }
  .value-r span {
    position: relative;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.15rem, 1.5vw, 1.5rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #fff;
  }
  .value:nth-child(3) .value-r span {
    color: var(--navy);
  }
  .value:hover .value-r::before {
    transform: rotate(135deg);
  }
  .value p {
    margin: 0;
    max-width: 18ch;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .values.will-in .value {
    opacity: 0;
    transform: translateY(24px) scale(0.92);
  }
  .values.is-in .value {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s ease,
      transform 0.8s var(--ease);
    transition-delay: calc(var(--i) * 0.15s);
  }

  /* Büro */
  .office {
    position: relative;
    /* Knick oben liegt über der hellblauen Werte-Fläche, kein heller Spalt */
    margin-top: calc(clamp(2rem, 5vw, 4.5rem) * -1);
    /* Oberkante als angedeutete Raute wie bei den Seitenköpfen */
    clip-path: polygon(0 0, 78% clamp(2rem, 5vw, 4.5rem), 100% clamp(0.8rem, 2vw, 1.8rem), 100% 100%, 0 100%);
    min-height: min(78svh, 760px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--navy);
    color: #fff;
  }
  /* Bild nur rechts, damit das Gebäude neben der Navy-Fläche ganz zu sehen ist */
  .office :global(.office-img) {
    position: absolute;
    top: 0;
    right: 0;
    width: 62%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 25%);
    mask-image: linear-gradient(to right, transparent, #000 25%);
  }
  .office-slab {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--content-left) + min(50vw, 820px));
    background: rgb(18 23 53 / 0.86);
    clip-path: polygon(0 0, 100% 0, 78% 100%, 0 100%);
  }
  .office-in {
    position: relative;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .office-in .h-sec {
    color: #fff;
  }
  .office-in p {
    margin: 0;
    max-width: 40ch;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.7;
    color: rgb(255 255 255 / 0.85);
  }
  .office-in address {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #c9d0f5;
  }

  @media (max-width: 1000px) {
    .way-list {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.8rem;
      padding: 0 0 0 2.8rem;
    }
    .way-line {
      left: 0.55rem;
      right: auto;
      top: 0;
      bottom: 0;
      width: 2px;
      height: auto;
    }
    .way-fill {
      transform-origin: center top;
      transform: scaleY(var(--p));
    }
    .way-step::before {
      left: -2.8rem;
      top: 0.4rem;
    }
    .way-step p {
      max-width: 36ch;
    }
  }
  @media (max-width: 900px) {
    .base-in,
    .lead-in,
    .roots-in {
      grid-template-columns: minmax(0, 1fr);
    }
    .base-text,
    .stack,
    .lead-text,
    .roots-text,
    .values {
      grid-column: 1 / -1;
    }
    .floor {
      --w: calc(70% + var(--i) * 10%);
    }
    .lead {
      display: block;
      min-height: 0;
      padding-top: 0;
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - 1.6rem), 22% 100%, 0 calc(100% - 0.6rem));
    }
    .lead-img {
      position: relative;
      width: auto;
      aspect-ratio: 4 / 5;
      max-height: 70svh;
      margin-bottom: 3rem;
      clip-path: polygon(0 0, 100% 0, 100% 94%, 0 100%);
    }
    .office-slab {
      width: 100%;
      clip-path: none;
    }
    .office :global(.office-img) {
      width: 100%;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
  @media (max-width: 560px) {
    .values {
      gap: 0.6rem;
    }
    .value:nth-child(2) {
      margin-top: 2rem;
    }
    .value-r span {
      font-size: 0.95rem;
    }
    .value p {
      font-size: 0.9rem;
    }
    .floor {
      padding-right: 2.4rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Gebäude und Rauten bauen sich beim Hereinscrollen auf */
  const reveal = (el: HTMLElement | null, cls: string) => {
    if (!el || reduce) return;
    el.classList.add(cls === 'is-built' ? 'will-build' : 'will-in');
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e?.isIntersecting) return;
        el.classList.add(cls);
        io.disconnect();
      },
      { rootMargin: '0px 0px -18% 0px' },
    );
    io.observe(el);
  };
  reveal(document.querySelector<HTMLElement>('[data-stack]'), 'is-built');
  reveal(document.querySelector<HTMLElement>('[data-values]'), 'is-in');

  /* Zeitstrahl: Linie füllt sich mit dem Scrollen, Stationen schalten nacheinander ein */
  const way = document.querySelector<HTMLElement>('[data-way]');
  if (way) {
    const steps = Array.from(way.querySelectorAll<HTMLElement>('.way-step'));
    const set = (p: number) => {
      way.style.setProperty('--p', p.toFixed(4));
      const wr = way.getBoundingClientRect();
      const vertical = window.matchMedia('(max-width: 1000px)').matches;
      steps.forEach((s) => {
        const r = s.getBoundingClientRect();
        const pos = vertical ? (r.top - wr.top) / wr.height : (r.left - wr.left) / wr.width;
        s.classList.toggle('is-on', p >= pos - 0.001);
      });
    };
    if (reduce) set(1);
    else
      ScrollTrigger.create({
        trigger: way,
        start: 'top 78%',
        end: 'bottom 55%',
        scrub: true,
        onUpdate: (st) => set(st.progress),
        onRefresh: (st) => set(st.progress),
      });
  }
</script>
