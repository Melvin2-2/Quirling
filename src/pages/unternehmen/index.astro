---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import RouteLink from '~/components/RouteLink.astro';
import Icon from '~/components/Icon.astro';
import { url } from '~/lib/url';
import { firma, GRUENDUNGSJAHR } from '~/data/site';
import historisch from '~/assets/site/historisch.jpg';
import buero from '~/assets/site/buero-tilsiter-strasse.jpg';
import handwerk from '~/assets/site/handwerk-schalung.jpg';
import buero2 from '~/assets/team/kontakt-ivonne-michaela.jpg';
import mannschaft from '~/assets/team/baustellenteam.jpg';
import thomas from '~/assets/team/thomas-quirling.jpg';
import Bauplan from '~/components/Bauplan.astro';

// Geschichte und Werte: drei Werte, jeder durch den eigenen Weg belegt.
// insight: kurzer Satz von Thomas Quirling je Wert; wird nur angezeigt, wenn gefüllt.
type Station = { k: string; d: string; href?: string; link?: string };
const kapitel = [
  {
    id: 'persoenlich',
    wert: 'Persönlich',
    d: 'Bei uns sprechen Sie mit Menschen, die für ihr Wort einstehen.',
    bild: buero2,
    bildAlt: 'Ivonne Quirling und Michaela Venghaus im Büro',
    bildPos: '74% 30%',
    insight: '',
    stationen: [
      { k: 'Damals', d: 'Der Vater unseres Gründers lernt auf dem Bau das Handwerk.' },
      { k: String(GRUENDUNGSJAHR), d: 'Thomas Quirling gründet die Quirling GmbH in Hamburg.' },
    ] as Station[],
  },
  {
    id: 'sorgfaeltig',
    wert: 'Sorgfältig',
    d: 'Jeder Bau ist eine Referenz für den nächsten.',
    bild: handwerk,
    bildAlt: 'Schalungselement mit Quirling-Logo auf einer Baustelle',
    bildPos: '62% 50%',
    insight: '',
    stationen: [
      { k: '1997', link: 'Tegelweg', d: 'ein Doppelhaus, schlüsselfertig gebaut.', href: '/referenzen/?p=tegelweg' },
      { k: '2001', link: 'Hanseforum', d: 'Bürogebäude mit Tiefgarage.', href: '/referenzen/?p=hanseforum' },
      { k: '2006', link: 'Buchholz', d: 'Rohbau für 35 Reihenhäuser.', href: '/referenzen/?p=reihenhaeuser-buchholz' },
      { k: '2016', link: 'Pferdemarkt', d: '25 barrierefreie Wohnungen.', href: '/referenzen/?p=pferdemarkt' },
    ] as Station[],
  },
  {
    id: 'verbindlich',
    wert: 'Verbindlich',
    d: 'Langjährige Kollegen, eingespielte Abläufe, kurze Wege.',
    bild: mannschaft,
    bildAlt: 'Die Mannschaft der Quirling GmbH',
    bildPos: '50% 70%',
    insight: '',
    stationen: [
      { k: '30+', d: 'Jahre sind einige unserer Kollegen schon an Bord.' },
      { k: '2019', d: 'Umzug ins neue Büro in der Tilsiter Straße.' },
      { k: 'Heute', d: `${firma.projekteAnzahl}+ Projekte, rund ${firma.mitarbeiter} Leute, die Familie an der Spitze.` },
    ] as Station[],
  },
];
---

<Base title="Über uns" description={`Die Quirling GmbH ist seit ${GRUENDUNGSJAHR} als Bauunternehmen in Hamburg tätig. Familienbetrieb mit Schwerpunkt Rohbau, Beton- und Stahlbetonbau.`}>
  <PageHero
    title="Bauen in Hamburg."
    titleLight={`Seit ${GRUENDUNGSJAHR}.`}
    intro="Das Handwerk liegt bei uns in der Familie. Heute bauen wir in Hamburg und Umgebung, mit einem eingespielten Team aus jungen und erfahrenen Kollegen."
    image={historisch}
    imageAlt="Historisches Foto einer Baumannschaft auf einem Gerüst, darunter der Vater unseres Gründers"
    imagePosition="50% 35%"
    crumbs={[{ label: 'Unternehmen' }]}
  />

  <!-- 1. Basis: Bauzeichnung, die beim Scrollen entsteht -->
  <Bauplan />

  <!-- 2. Inhaber: Porträt randlos links über die volle Höhe, oben und unten geknickt -->
  <section class="lead on-dark">
    <div class="lead-img">
      <Image src={thomas} alt="Thomas Quirling" widths={[600, 900, 1300]} sizes="(min-width: 900px) 44vw, 100vw" />
    </div>
    <div class="container lead-in">
      <div class="lead-text">
        <p class="lead-q">„Was wir zusagen,<br />steht.“</p>
        <p class="lead-p">
          Unser Leitsatz gilt für jedes Bauvorhaben. Thomas Quirling führt das Unternehmen seit der Gründung selbst, unterstützt von Ivonne Quirling in
          der Assistenz der Geschäftsführung. Bei uns sprechen Sie mit denen, die entscheiden.
        </p>
        <span class="lead-n">Thomas Quirling<small>Inhaber &amp; Geschäftsführer</small></span>
        <a class="lead-btn" href={url('/unternehmen/team/')}><span>Das ganze Team</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- 3. Geschichte und Werte: links ein ruhiger Textfluss, rechts ein stehendes Foto, das mit jedem Wert wechselt -->
  <section class="story" data-story>
    <div class="container story-in">
      <div class="story-main">
        <header class="story-head">
          <h2 class="h-sec">Bauen liegt<br /><span class="lt">in der Familie.</span></h2>
          <p class="story-intro">
            Schon der Vater unseres Gründers stand auf dem Gerüst, das Foto oben zeigt ihn in seiner Lehrzeit. Drei Dinge tragen uns seitdem.
          </p>
        </header>
        {
          kapitel.map((c, i) => (
            <article class="ch" data-ch={i}>
              <div class="ch-img">
                <Image src={c.bild} alt={c.bildAlt} widths={[500, 800]} sizes="100vw" style={`object-position:${c.bildPos}`} />
              </div>
              <h3 class="ch-w">{c.wert}.</h3>
              <p class="ch-d">{c.d}</p>
              <ul class="ch-list">
                {c.stationen.map((st) => (
                  <li>
                    <span class="ch-k">{st.k}</span>
                    <span class="ch-t">
                      {st.href && <a href={url(st.href)}>{st.link}</a>}
                      {st.href ? `: ${st.d}` : st.d}
                    </span>
                  </li>
                ))}
              </ul>
              {c.insight && (
                <figure class="ins">
                  <blockquote>„{c.insight}“</blockquote>
                  <figcaption>Thomas Quirling</figcaption>
                </figure>
              )}
            </article>
          ))
        }
      </div>
      <div class="story-side" aria-hidden="true">
        <div class="story-photo">
          {
            kapitel.map((c, i) => (
              <div class:list={['sp', { 'is-on': i === 0 }]} data-sp={i}>
                <Image src={c.bild} alt="" widths={[700, 1000, 1400]} sizes="(min-width: 900px) 45vw, 100vw" style={`object-position:${c.bildPos}`} />
              </div>
            ))
          }
          <ol class="sp-dots">
            {kapitel.map((c, i) => <li class:list={{ 'is-on': i === 0 }} data-spd={i}>{c.wert}</li>)}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- Unser Büro: großes Bild mit Navy-Schräge wie im Seitenkopf -->
  <section class="office on-dark">
    <Image src={buero} alt="Bürogebäude der Quirling GmbH in der Tilsiter Straße 174, Hamburg" widths={[1000, 1600, 2400]} sizes="100vw" class="office-img" />
    <div class="office-slab" aria-hidden="true"></div>
    <div class="container office-in">
      <h2 class="h-sec">Unser Büro.<br /><span class="lt">In Wandsbek.</span></h2>
      <p>
        Seit 2019 laufen in unserem Bürogebäude in der Tilsiter Straße die Fäden zusammen: Angebote, Planung und die Abstimmung mit allen Baustellen. Kommen Sie
        gerne vorbei, wir freuen uns auf Sie.
      </p>
      <address>{firma.strasse}, {firma.plz} {firma.ort}</address>
      <RouteLink light />
    </div>
  </section>
</Base>

<style>
  /* ---------- 2. Inhaber ---------- */
  .lead {
    position: relative;
    overflow-x: clip;
    min-height: min(92svh, 860px);
    display: flex;
    align-items: center;
    background: var(--navy);
    color: #fff;
    padding-block: clamp(6rem, 10vw, 8rem);
    /* oben wie unten als angedeutete Raute geknickt */
    clip-path: polygon(
      0 0,
      78% clamp(2rem, 4vw, 3.5rem),
      100% clamp(0.8rem, 1.6vw, 1.4rem),
      100% calc(100% - clamp(2rem, 4vw, 3.5rem)),
      22% 100%,
      0 calc(100% - clamp(0.8rem, 1.6vw, 1.4rem))
    );
  }
  .lead-img {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 44%;
    clip-path: polygon(0 0, 100% 0, 84% 100%, 0 100%);
  }
  .lead-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
  }
  .lead-in {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    width: 100%;
  }
  .lead-text {
    grid-column: 7 / 13;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .lead-q {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(3rem, 5.6vw, 6rem);
    line-height: 0.9;
    text-transform: uppercase;
    color: #9aa6ee;
  }
  .lead-p {
    margin: 0;
    max-width: 34rem;
    font-weight: 300;
    color: rgb(255 255 255 / 0.85);
  }
  .lead-n {
    display: grid;
    gap: 0.3rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 1.5rem;
    text-transform: uppercase;
    line-height: 1;
  }
  .lead-n small {
    font-family: var(--font-body);
    font-stretch: normal;
    font-weight: 300;
    font-size: 1rem;
    text-transform: none;
    color: rgb(255 255 255 / 0.7);
  }
  .lead-btn {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.6rem;
    padding: 1rem 1.4rem 0.9rem;
    background: #fff;
    color: var(--navy);
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.2rem, 1.5vw, 1.45rem);
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease;
  }
  .lead-btn :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    transition: transform 0.35s var(--ease);
  }
  .lead-btn:hover {
    background: #9aa6ee;
  }
  .lead-btn:hover :global(svg) {
    transform: translateX(4px);
  }
  /* ---------- 3. Geschichte und Werte ---------- */
  .story {
    padding-block: clamp(5rem, 8vw, 7rem) clamp(6rem, 9vw, 8rem);
  }
  .story-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
  }
  .story-main {
    grid-column: 1 / 7;
    display: grid;
    gap: clamp(4rem, 8vw, 6.5rem);
  }
  .story-head {
    display: grid;
    gap: 1.3rem;
  }
  .story-intro,
  .ch-d {
    margin: 0;
    max-width: 40ch;
    font-size: 1.1875rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--ink-2);
  }
  /* ein Kapitel: Wert, ein Satz, kurze Zeilen mit Jahr */
  .ch {
    display: grid;
    gap: 1.1rem;
    transition: color 0.4s ease;
  }
  .ch-img {
    display: none;
  }
  .ch-w {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(3rem, 5.4vw, 5.6rem);
    line-height: 0.86;
    text-transform: uppercase;
    color: var(--blue);
    transition: color 0.4s ease;
  }
  .ch-list {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--stone-200);
  }
  .ch-list li {
    display: grid;
    grid-template-columns: 6.2rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.85rem 0 0.8rem;
    border-bottom: 1px solid var(--stone-200);
  }
  .ch-k {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--blue);
    transition: color 0.4s ease;
  }
  .ch-t {
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink-2);
    transition: color 0.4s ease;
  }
  .ch-t a {
    color: inherit;
    font-weight: 400;
    text-decoration: underline;
    text-decoration-color: #9aa6ee;
    text-underline-offset: 3px;
  }
  .ch-t a:hover {
    color: var(--blue);
    text-decoration-color: var(--blue);
  }
  /* Fokus: nur das Kapitel, das gerade gelesen wird, steht in voller Farbe */
  .story.is-live .ch:not(.is-on) .ch-w,
  .story.is-live .ch:not(.is-on) .ch-k {
    color: #c9cee3;
  }
  .story.is-live .ch:not(.is-on) .ch-d,
  .story.is-live .ch:not(.is-on) .ch-t {
    color: #a9aec6;
  }
  /* Insight von Thomas Quirling */
  .ins {
    margin: 0.4rem 0 0;
    padding-left: 1.2rem;
    border-left: 3px solid var(--blue);
    display: grid;
    gap: 0.5rem;
  }
  .ins blockquote {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--navy);
  }
  .ins figcaption {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue);
  }
  /* rechts: stehendes Foto mit Knick, wechselt mit dem Kapitel */
  .story-side {
    grid-column: 8 / 13;
  }
  .story-photo {
    position: sticky;
    top: 120px;
    height: calc(100svh - 160px);
    max-height: 760px;
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 0 92%);
    background: var(--stone-200);
  }
  .sp {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 0.8s ease,
      transform 1.4s var(--ease);
  }
  .sp.is-on {
    opacity: 1;
    transform: none;
  }
  .sp :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* kleine Rauten unten links zeigen, welcher Wert gerade dran ist */
  .sp-dots {
    position: absolute;
    left: 1.4rem;
    bottom: calc(8% + 1.2rem);
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0.55rem 0.9rem 0.5rem;
    display: flex;
    gap: 1.1rem;
    background: #fff;
  }
  .sp-dots li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 0.95rem;
    text-transform: uppercase;
    color: #b9bdd3;
    transition: color 0.3s ease;
  }
  .sp-dots li::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    background: currentColor;
    transform: rotate(45deg);
  }
  .sp-dots li.is-on {
    color: var(--blue);
  }

  /* Büro */
  .office {
    position: relative;
    /* Knick oben liegt über der hellblauen Werte-Fläche, kein heller Spalt */
    margin-top: 0;
    /* Oberkante als angedeutete Raute wie bei den Seitenköpfen */
    clip-path: polygon(0 0, 78% clamp(2rem, 5vw, 4.5rem), 100% clamp(0.8rem, 2vw, 1.8rem), 100% 100%, 0 100%);
    min-height: min(78svh, 760px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--blue);
    color: #fff;
  }
  /* Bild nur rechts, damit das Gebäude neben der Navy-Fläche ganz zu sehen ist */
  .office :global(.office-img) {
    position: absolute;
    top: 0;
    right: 0;
    width: 62%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 25%);
    mask-image: linear-gradient(to right, transparent, #000 25%);
  }
  .office-slab {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--content-left) + min(50vw, 820px));
    background: var(--blue);
    clip-path: polygon(0 0, 100% 0, 78% 100%, 0 100%);
  }
  .office-in {
    position: relative;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .office-in .h-sec {
    color: #fff;
  }
  .office-in p {
    margin: 0;
    max-width: 40ch;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.7;
    color: rgb(255 255 255 / 0.85);
  }
  .office-in address {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #c9d0f5;
  }

  @media (max-width: 900px) {
    .lead-in,
    .story-in {
      grid-template-columns: minmax(0, 1fr);
    }
    .lead-text,
    .story-main {
      grid-column: 1 / -1;
    }
    .story-side {
      display: none;
    }
    .ch-img {
      display: block;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      margin-bottom: 0.6rem;
      clip-path: polygon(0 0, 100% 0, 100% 92%, 0 100%);
    }
    .ch-img :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .lead {
      display: block;
      min-height: 0;
      padding-top: 0;
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - 1.6rem), 22% 100%, 0 calc(100% - 0.6rem));
    }
    .lead-img {
      position: relative;
      width: auto;
      aspect-ratio: 4 / 5;
      max-height: 70svh;
      margin-bottom: 3rem;
      clip-path: polygon(0 0, 100% 0, 100% 94%, 0 100%);
    }
    .office-slab {
      width: 100%;
      clip-path: none;
      background: rgb(57 72 164 / 0.86);
    }
    .office :global(.office-img) {
      width: 100%;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
  @media (max-width: 560px) {
    .ch-list li {
      grid-template-columns: 4.6rem minmax(0, 1fr);
      gap: 0.8rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Geschichte: das Kapitel in der Bildschirmmitte ist aktiv, rechts wechselt das Foto mit */
  const story = document.querySelector<HTMLElement>('[data-story]');
  if (story) {
    const chapters = Array.from(story.querySelectorAll<HTMLElement>('[data-ch]'));
    const photos = Array.from(story.querySelectorAll<HTMLElement>('[data-sp]'));
    const dots = Array.from(story.querySelectorAll<HTMLElement>('[data-spd]'));
    let current = -1;
    const update = () => {
      let a = 0;
      chapters.forEach((c, i) => {
        if (c.getBoundingClientRect().top < window.innerHeight * 0.55) a = i;
      });
      if (a === current) return;
      current = a;
      chapters.forEach((c, i) => c.classList.toggle('is-on', i === a));
      photos.forEach((p, i) => p.classList.toggle('is-on', i === a));
      dots.forEach((d, i) => d.classList.toggle('is-on', i === a));
    };
    if (!reduce && window.matchMedia('(min-width: 901px)').matches) {
      story.classList.add('is-live');
      ScrollTrigger.create({ trigger: story, start: 'top bottom', end: 'bottom top', onUpdate: update, onRefresh: update });
      update();
    }
  }
</script>
