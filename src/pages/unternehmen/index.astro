---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import CtaBand from '~/components/CtaBand.astro';
import Icon from '~/components/Icon.astro';
import Todo from '~/components/Todo.astro';
import { firma, platzhalter, JAHRE_ERFAHRUNG, GRUENDUNGSJAHR } from '~/data/site';
import { url } from '~/lib/url';
import historisch from '~/assets/site/historisch.jpg';
import team from '~/assets/team/baustellenteam.jpg';

const bild = (await getEntry('projekte', 'horner-landstrasse'))!.data.bilder[0]!;

type Station = { jahr: string; titel: string; text: string; link?: string; pruefen?: boolean };
const stationen: Station[] = [
  { jahr: String(GRUENDUNGSJAHR), titel: 'Gründung in Hamburg', text: 'Thomas Quirling gründet das Bauunternehmen. Bereits in der Anfangsphase können wir mit zufriedenen und treuen Kunden rechnen.', pruefen: true },
  { jahr: '1997', titel: 'Schlüsselfertig am Tegelweg', text: 'Schlüsselfertiger Neubau eines Doppelhauses am Tegelweg 51 a in Hamburg-Farmsen-Berne – viele Jahre auch unsere Firmenadresse.', link: 'tegelweg', pruefen: true },
  { jahr: '2001', titel: 'Hanseforum am Axel-Springer-Platz', text: 'Beton- und Stahlbetonbauarbeiten eines Bürogebäudes mit Tiefgarage mitten in Hamburg.', link: 'hanseforum' },
  { jahr: '2006', titel: '35 Reihenhäuser in Buchholz', text: 'Rohbau von 35 Reihenhäusern in Buchholz in der Nordheide.', link: 'reihenhaeuser-buchholz' },
  { jahr: '2009', titel: 'Große Johannisstraße', text: 'Rohbau eines Büro- und Geschäftshauses in der Hamburger Altstadt.', link: 'grosse-johannisstrasse' },
  { jahr: '2010', titel: 'Alsterpalais', text: 'Umbau und Erweiterung des Alsterpalais in der Alsterdorfer Straße.', link: 'kinderwelt' },
  { jahr: '2016', titel: 'Wohnen in Bad Oldesloe', text: 'Rohbau von 25 barrierefreien Wohnungen mit Tiefgarage am Pferdemarkt.', link: 'pferdemarkt' },
  { jahr: '2018', titel: 'Horner Landstraße', text: 'Rohbau eines Mehrfamilienhauses mit 20 Wohneinheiten.', link: 'horner-landstrasse' },
  { jahr: '2019', titel: 'Bergedorf & Tilsiter Straße', text: 'Rohbau für Kaufhaus und Hotel am Serrahnhafen in Bergedorf. Schlüsselfertiger Neubau des Betriebsgebäudes in der Tilsiter Straße 174 – heute unser Firmensitz.', pruefen: true },
  { jahr: 'Heute', titel: `Mehr als ${firma.projekteAnzahl} Projekte`, text: `${JAHRE_ERFAHRUNG} Jahre Erfahrung, ein eingespieltes Team und Bauvorhaben in Hamburg und Umgebung.` },
];

const werte = [
  { t: 'Kommunikation', d: 'Wir setzen auf partnerschaftliche Beziehungen und stehen im ständigen Kontakt mit unseren Auftraggebern. Kommunikation wird bei uns großgeschrieben.' },
  { t: 'Qualität', d: 'Bei uns werden die Arbeiten bis zum Schluss sorgfältig ausgeführt. Durch sorgfältiges und flexibles Arbeiten stellen wir unsere Kunden zufrieden.' },
  { t: 'Partnerschaft', d: 'Wir bauen auch auf eine Partnerschaft mit unseren Mitarbeitern und schaffen so ein angenehmes Arbeitsklima. Ein zufriedenes Team ist auch für den Auftraggeber vielversprechend.' },
];
---

<Base title="Über uns" description={`Die Quirling GmbH ist seit ${GRUENDUNGSJAHR} als Bauunternehmen in Hamburg tätig – mit Schwerpunkt Rohbau, Beton- und Stahlbetonbau.`}>
  <PageHero
    eyebrow="Unternehmen"
    title={`Bauen in Hamburg. Seit ${GRUENDUNGSJAHR}.`}
    intro="Die Quirling GmbH ist ein dynamisches und flexibles Team, das überwiegend aus jungen und erfahrenen Mitarbeitern besteht."
    image={historisch}
    imageAlt="Historisches Foto einer Baumannschaft"
    crumbs={[{ label: 'Unternehmen' }]}
  />

  <section class="section bg-white">
    <div class="container about">
      <div class="about-text">
        <p class="eyebrow">Über uns</p>
        <h2 class="h2" data-split>Eine Basis, auf die Sie bauen können.</h2>
        <div data-reveal>
          <p class="lead">
            Mit unseren kompetenten Mitarbeitern konnten wir uns an vielseitigen Bauten beweisen. Wir erstellen nicht nur Neubauten, sondern führen
            auch vielseitige Umbau- und Sanierungsmaßnahmen aus.
          </p>
          <p>
            Schwerpunkt ist die Erstellung von Rohbauten, speziell Beton- und Stahlbetonbau (Schalungsbau). Auch bei komplizierteren Bauten finden
            wir gemeinsam eine Lösung. Unser Einsatzgebiet ist {firma.einsatzgebiet}
          </p>
        </div>
      </div>
      <div class="about-img media" data-clip>
        <Image src={bild} alt="Mehrfamilienhaus Horner Landstraße" widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 40vw, 100vw" />
      </div>
    </div>
  </section>

  <section class="section bg-stone">
    <div class="container">
      <p class="eyebrow">Unsere Werte</p>
      <div class="werte" data-reveal data-reveal-children>
        {
          werte.map((w, i) => (
            <article class="wert">
              <span class="wnr">0{i + 1}</span>
              <h3 class="h3">{w.t}</h3>
              <p>{w.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container tl-wrap">
      <div class="tl-head">
        <p class="eyebrow">Geschichte</p>
        <h2 class="h2" data-split>Stein auf Stein – unser Weg.</h2>
        <p class="tl-note">Eine Auswahl von Stationen aus {JAHRE_ERFAHRUNG} Jahren Firmengeschichte.</p>
      </div>
      <ol class="timeline">
        <span class="tl-line" aria-hidden="true"><span data-line></span></span>
        {
          stationen.map((s) => (
            <li class="station" data-reveal>
              <span class="dot" aria-hidden="true" />
              <span class="jahr">{s.jahr}</span>
              <div>
                <h3 class="h4">
                  {s.link ? <a href={url(`/referenzen/${s.link}/`)}>{s.titel}</a> : s.titel}
                </h3>
                <p>
                  {s.pruefen ? <Todo hint="bitte prüfen">{s.text}</Todo> : s.text}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section on-dark split">
    <div class="container split-in">
      <div class="media split-img" data-parallax>
        <Image src={team} alt="Das Baustellenteam der Quirling GmbH" widths={[700, 1200]} sizes="(min-width: 1024px) 50vw, 100vw" />
      </div>
      <div class="split-text" data-reveal>
        <p class="eyebrow light">In Zahlen</p>
        <dl class="nums">
          <div><dt>Gegründet</dt><dd>{GRUENDUNGSJAHR}</dd></div>
          <div><dt>Projekte</dt><dd>&gt;&thinsp;{firma.projekteAnzahl}</dd></div>
          <div><dt>Mitarbeiter</dt><dd><Todo hint="Anzahl fehlt">{platzhalter.mitarbeiter}</Todo></dd></div>
          <div><dt>Firmensitz</dt><dd class="sm">Hamburg-Wandsbek</dd></div>
        </dl>
        <div class="split-links">
          <a class="link-arrow" href={url('/unternehmen/team/')}>Unser Team <Icon name="arrow" /></a>
          <a class="link-arrow" href={url('/unternehmen/zertifikate/')}>Zertifikate &amp; Downloads <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .about h2 {
    margin-bottom: 1.8rem;
  }
  .about p:not(.lead):not(.eyebrow) {
    color: var(--ink-2);
  }
  .about .lead {
    margin-bottom: 1.2rem;
  }
  .about-img {
    aspect-ratio: 4 / 5;
  }
  .werte {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .wert {
    background: #fff;
    padding: clamp(1.75rem, 3vw, 2.75rem);
    display: grid;
    gap: 1rem;
    align-content: start;
    border-top: 3px solid var(--blue);
  }
  .wnr {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 700;
    font-size: 2.6rem;
    color: var(--stone-200);
    line-height: 1;
  }
  .wert p {
    color: var(--ink-2);
  }
  .tl-wrap {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .tl-head {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }
  .tl-note {
    color: var(--ink-3);
    margin-top: 1.2rem;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 2.5rem;
    position: relative;
  }
  .tl-line {
    position: absolute;
    left: 0.45rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 2px;
    background: var(--stone-200);
  }
  .tl-line span {
    display: block;
    height: 100%;
    background: var(--blue);
    transform-origin: top;
  }
  .station {
    position: relative;
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }
  .dot {
    position: absolute;
    left: -2.5rem;
    top: 0.35rem;
    width: 1rem;
    height: 1rem;
    background: #fff;
    border: 2px solid var(--blue);
    transform: rotate(45deg);
  }
  .jahr {
    font-family: var(--font-head);
    font-stretch: 120%;
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--blue);
    line-height: 1.1;
  }
  .station h3 a {
    text-decoration: none;
  }
  .station h3 a:hover {
    color: var(--blue);
    text-decoration: underline;
  }
  .station p {
    color: var(--ink-2);
    margin-top: 0.5rem;
  }
  .split-in {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .split-img {
    aspect-ratio: 4 / 3;
  }
  .nums {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin: 0 0 2rem;
  }
  .nums div {
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line-light);
  }
  .nums dt {
    color: rgb(255 255 255 / 0.65);
    font-size: 0.95rem;
  }
  .nums dd {
    margin: 0.2rem 0 0;
    font-family: var(--font-head);
    font-stretch: 120%;
    font-weight: 650;
    font-size: clamp(2rem, 3.5vw, 3rem);
    line-height: 1.1;
  }
  .nums dd.sm {
    font-size: 1.4rem;
    padding-top: 0.6rem;
  }
  .split-links {
    display: grid;
    gap: 0.8rem;
  }
  @media (max-width: 900px) {
    .about,
    .tl-wrap,
    .split-in {
      grid-template-columns: 1fr;
    }
    .werte {
      grid-template-columns: 1fr;
    }
    .tl-head {
      position: static;
    }
    .station {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }
</style>
