---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import RouteLink from '~/components/RouteLink.astro';
import Icon from '~/components/Icon.astro';
import { url } from '~/lib/url';
import { firma, JAHRE_ERFAHRUNG, GRUENDUNGSJAHR } from '~/data/site';
import historisch from '~/assets/site/historisch.jpg';
import geruest from '~/assets/site/baustelle-geruest.jpg';
import buero from '~/assets/site/buero-tilsiter-strasse.jpg';
import thomas from '~/assets/team/thomas-quirling.jpg';


// Unser Weg in drei Stationen
const weg = [
  { k: 'Damals', t: 'Das Handwerk im Blut', d: 'Der Vater unseres Gründers lernt auf dem Bau, was gute Arbeit ausmacht.' },
  { k: String(GRUENDUNGSJAHR), t: 'Die Gründung', d: 'Thomas Quirling gründet die Quirling GmbH in Hamburg, mit Schwerpunkt Rohbau.' },
  { k: 'Heute', t: 'Fest in Hamburg', d: `Über ${firma.projekteAnzahl} Projekte, eine eingespielte Mannschaft und ein Büro in der Tilsiter Straße.` },
];

const zahlen = [
  { v: String(GRUENDUNGSJAHR), l: 'Gegründet in Hamburg' },
  { v: `${firma.projekteAnzahl}+`, l: 'Projekte' },
  { v: String(firma.mitarbeiter), l: 'Mitarbeiter' },
  { v: String(JAHRE_ERFAHRUNG), l: 'Jahre Erfahrung' },
];
---

<Base title="Über uns" description={`Die Quirling GmbH ist seit ${GRUENDUNGSJAHR} als Bauunternehmen in Hamburg tätig. Familienbetrieb mit Schwerpunkt Rohbau, Beton- und Stahlbetonbau.`}>
  <PageHero
    title="Bauen in Hamburg."
    titleLight={`Seit ${GRUENDUNGSJAHR}.`}
    intro="Familienbetrieb mit Schwerpunkt Rohbau. Inhabergeführt, mit kurzen Wegen und einem eingespielten Team aus jungen und erfahrenen Kollegen."
    image={geruest}
    imageAlt="Rohbau mit Gerüst und Kränen auf einer Baustelle der Quirling GmbH"
    crumbs={[{ label: 'Unternehmen' }]}
  />

  <!-- Über uns: kurz, mit den Zahlen daneben -->
  <section class="section">
    <div class="container about">
      <div class="about-text">
        <h2 class="h-sec">Eine Basis,<br /><span class="lt">auf die Sie<br />bauen können.</span></h2>
        <p class="small">
          Seit {GRUENDUNGSJAHR} bauen wir in Hamburg und Umgebung. Unser Schwerpunkt ist der Rohbau in Beton- und Stahlbetonbauweise, dazu bauen wir
          schlüsselfertig und führen Umbauten und Sanierungen aus. Inhabergeführt, mit kurzen Wegen und Sorgfalt bis zum Schluss.
        </p>
      </div>
      <dl class="zahlen">
        {
          zahlen.map((z) => (
            <div class="zahl">
              <dt class="label">{z.l}</dt>
              <dd>{z.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Familiengeschichte: historisches Foto randlos links, Text rechts -->
  <section class="story">
    <figure class="story-photo">
      <span class="story-img">
        <Image src={historisch} alt="Historisches Foto einer Baumannschaft auf einem Gerüst" widths={[800, 1200, 1600]} sizes="(min-width: 900px) 46vw, 100vw" />
      </span>
      <figcaption class="story-cap">Der Vater unseres Gründers in seiner Lehrzeit.</figcaption>
    </figure>
    <div class="container story-in">
      <div class="story-text">
        <h2 class="h-sec">Bauen liegt<br /><span class="lt">in der Familie.</span></h2>
        <p class="small">
          Schon der Vater unseres Gründers stand auf dem Gerüst. {GRUENDUNGSJAHR} hat Thomas Quirling das Unternehmen in Hamburg gegründet, und bis heute
          führt die Familie es selbst. Das heißt für Sie: kurze Wege, klare Absprachen und Menschen mit Namen, die für ihr Wort einstehen.
        </p>
        <ul class="vals">
          <li>Persönlich</li>
          <li>Verbindlich</li>
          <li>Sorgfältig</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Unser Weg: drei Stationen auf einer Linie, Rauten als Marken -->
  <section class="section way">
    <div class="container">
      <h2 class="h-sec way-h">Unser<br /><span class="lt">Weg.</span></h2>
      <ol class="way-list">
        {
          weg.map((w) => (
            <li class="way-step">
              <span class="way-k">{w.k}</span>
              <h3 class="way-t">{w.t}</h3>
              <p>{w.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Der Mensch dahinter: Porträt mit Rautenknick, daneben der Leitsatz -->
  <section class="lead on-dark">
    <div class="container lead-in">
      <div class="lead-img">
        <Image src={thomas} alt="Thomas Quirling" widths={[500, 800, 1100]} sizes="(min-width: 900px) 34vw, 100vw" />
      </div>
      <div class="lead-text">
        <span class="lead-k">Inhabergeführt seit {GRUENDUNGSJAHR}</span>
        <p class="lead-q">„Was wir zusagen, steht.“</p>
        <p class="lead-p">
          Unser Leitsatz gilt für jedes Bauvorhaben. Thomas Quirling führt das Unternehmen seit der Gründung selbst. Er ist ansprechbar, entscheidet
          schnell und steht mit seinem Namen für das, was wir bauen.
        </p>
        <span class="lead-n">Thomas Quirling<small>Geschäftsführender Gesellschafter</small></span>
      </div>
    </div>
  </section>

  <!-- Überleitung zum Team -->
  <section class="section section-tint team-cta">
    <div class="container team-cta-in">
      <h2 class="h-sec">Wer steckt<br /><span class="lt">dahinter?</span></h2>
      <p class="small">Lernen Sie Ihre Ansprechpartner im Büro und unsere Mannschaft auf der Baustelle kennen.</p>
      <a class="block-btn" href={url('/unternehmen/team/')}><span>Zum Team</span><Icon name="arrow" /></a>
    </div>
  </section>

  <!-- Unser Büro: großes Bild mit Navy-Schräge wie im Seitenkopf -->
  <section class="office on-dark">
    <Image src={buero} alt="Bürogebäude der Quirling GmbH in der Tilsiter Straße 174, Hamburg" widths={[1000, 1600, 2400]} sizes="100vw" class="office-img" />
    <div class="office-slab" aria-hidden="true"></div>
    <div class="container office-in">
      <h2 class="h-sec">Unser Büro.<br /><span class="lt">In Wandsbek.</span></h2>
      <p>
        In unserem Bürogebäude in der Tilsiter Straße laufen die Fäden zusammen: Angebote, Planung und die Abstimmung mit allen Baustellen. Kommen Sie
        gerne vorbei, wir freuen uns auf Sie.
      </p>
      <address>{firma.strasse}, {firma.plz} {firma.ort}</address>
      <RouteLink light />
    </div>
  </section>
</Base>

<style>
  /* Über uns */
  .about {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }
  .about-text {
    grid-column: 1 / 7;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  .about-text .small {
    margin: 0;
    max-width: 50ch;
  }
  .about-text .h-sec {
    font-size: clamp(2.4rem, 4.4vw, 4.6rem);
  }
  .zahlen {
    grid-column: 8 / 13;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 3.5vw, 3rem) 2rem;
  }
  .zahl {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
    gap: 0.6rem;
  }
  .zahl dd {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(3rem, 5.5vw, 5.4rem);
    line-height: 0.85;
    color: var(--blue);
  }

  /* Familiengeschichte: Foto füllt links die volle Höhe, Innenkante mit Knick */
  .story {
    position: relative;
    overflow-x: clip;
    padding-block: var(--section);
  }
  .story-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
  }
  .story-photo {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 44%;
    margin: 0;
  }
  .story-img {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: polygon(0 0, 86% 0, 100% 46%, 90% 100%, 0 100%);
    background: var(--stone-200);
  }
  .story-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 80% 0%;
  }
  .story-cap {
    position: absolute;
    left: var(--content-left);
    bottom: 1.4rem;
    padding: 0.5rem 0.8rem 0.45rem;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .story-text {
    grid-column: 7 / 13;
    display: grid;
    gap: 1.4rem;
    justify-items: start;
    padding-block: clamp(2rem, 5vw, 4rem);
  }
  .story-text .small {
    margin: 0;
    max-width: 36rem;
  }
  .vals {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
  }
  .vals li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.25rem, 1.6vw, 1.5rem);
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--blue);
  }
  .vals li::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    background: var(--blue);
    transform: rotate(45deg);
  }
  /* Unser Weg */
  .way-h {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .way-list {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
  }
  /* durchgehende Linie auf Höhe der Rauten */
  .way-list::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0.62rem;
    height: 1.5px;
    background: var(--blue);
  }
  .way-step {
    position: relative;
    display: grid;
    gap: 0.6rem;
    align-content: start;
    padding-top: 2.6rem;
  }
  .way-step::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 1.25rem;
    height: 1.25rem;
    background: var(--blue);
    transform: rotate(45deg);
    outline: 6px solid var(--stone-50);
  }
  .way-k {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(2.6rem, 4vw, 4rem);
    line-height: 0.9;
    color: var(--blue);
    text-transform: uppercase;
  }
  .way-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.3rem, 1.7vw, 1.7rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--navy);
    margin: 0.4rem 0 0;
  }
  .way-step p {
    margin: 0;
    max-width: 30ch;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--ink-2);
  }
  /* Der Mensch dahinter */
  .lead {
    background: var(--navy);
    color: #fff;
    padding-block: clamp(5rem, 8vw, 7rem);
    clip-path: polygon(0 0, 78% clamp(2rem, 4vw, 3.5rem), 100% clamp(0.8rem, 1.6vw, 1.4rem), 100% 100%, 0 100%);
  }
  .lead-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }
  .lead-img {
    grid-column: 1 / 5;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 100% 90%, 76% 100%, 0 100%);
    background: var(--stone-200);
  }
  .lead-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
  }
  .lead-text {
    grid-column: 6 / 13;
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  .lead-k {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #c9d0f5;
  }
  .lead-k::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    background: #9aa6ee;
    transform: rotate(45deg);
  }
  .lead-q {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(3rem, 5.6vw, 6rem);
    line-height: 0.9;
    text-transform: uppercase;
    color: #9aa6ee;
  }
  .lead-p {
    margin: 0;
    max-width: 34rem;
    font-weight: 300;
    color: rgb(255 255 255 / 0.85);
  }
  .lead-n {
    display: grid;
    gap: 0.3rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 1.5rem;
    text-transform: uppercase;
    line-height: 1;
  }
  .lead-n small {
    font-family: var(--font-body);
    font-stretch: normal;
    font-weight: 300;
    font-size: 1rem;
    text-transform: none;
    color: rgb(255 255 255 / 0.7);
  }
  /* Überleitung zum Team */
  .team-cta-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 1.5rem clamp(2rem, 5vw, 5rem);
    align-items: end;
  }
  .team-cta-in .small {
    margin: 0;
    max-width: 30rem;
  }
  .block-btn {
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.15rem 1.5rem 1.05rem;
    line-height: 1;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.25rem, 1.6vw, 1.55rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.25s ease;
  }
  .block-btn :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    transition: transform 0.35s var(--ease);
  }
  .block-btn:hover {
    background: var(--blue);
  }
  .block-btn:hover :global(svg) {
    transform: translateX(4px);
  }

  /* Büro */
  .office {
    position: relative;
    /* Oberkante als angedeutete Raute wie bei den Seitenköpfen */
    clip-path: polygon(0 0, 78% clamp(2rem, 5vw, 4.5rem), 100% clamp(0.8rem, 2vw, 1.8rem), 100% 100%, 0 100%);
    min-height: min(78svh, 760px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--navy);
    color: #fff;
  }
  /* Bild nur rechts, damit das Gebäude neben der Navy-Fläche ganz zu sehen ist */
  .office :global(.office-img) {
    position: absolute;
    top: 0;
    right: 0;
    width: 62%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 25%);
    mask-image: linear-gradient(to right, transparent, #000 25%);
  }
  .office-slab {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--content-left) + min(50vw, 820px));
    background: rgb(18 23 53 / 0.86);
    clip-path: polygon(0 0, 100% 0, 78% 100%, 0 100%);
  }
  .office-in {
    position: relative;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .office-in .h-sec {
    color: #fff;
  }
  .office-in p {
    margin: 0;
    max-width: 40ch;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.7;
    color: rgb(255 255 255 / 0.85);
  }
  .office-in address {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #c9d0f5;
  }

  @media (max-width: 900px) {
    .about,
    .story-in,
    .team-cta-in,
    .lead-in,
    .way-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .lead-img,
    .lead-text {
      grid-column: 1 / -1;
    }
    .lead-img {
      max-width: 22rem;
    }
    .way-list::before {
      left: 0.62rem;
      right: auto;
      top: 0;
      bottom: 0;
      width: 1.5px;
      height: auto;
    }
    .way-step {
      padding: 0 0 0 3rem;
    }
    .about-text,
    .zahlen,
    .story-text {
      grid-column: 1 / -1;
    }
    .story {
      padding-top: 0;
    }
    .story-photo {
      position: relative;
      width: auto;
      aspect-ratio: 4 / 3;
    }
    .story-img {
      clip-path: polygon(0 0, 100% 0, 100% 94%, 0 100%);
    }
    .story-cap {
      left: var(--gutter);
      bottom: 2rem;
    }
    .team-cta-in {
      align-items: start;
      justify-items: start;
    }
    .office-slab {
      width: 100%;
      clip-path: none;
    }
    .office :global(.office-img) {
      width: 100%;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .zahlen {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
