---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import RouteLink from '~/components/RouteLink.astro';
import Icon from '~/components/Icon.astro';
import { url } from '~/lib/url';
import { firma, JAHRE_ERFAHRUNG, GRUENDUNGSJAHR } from '~/data/site';
import historisch from '~/assets/site/historisch.jpg';
import headerBild from '~/assets/projects/dorfkoppel/03.jpg';
import tegelweg from '~/assets/projects/tegelweg/01.jpg';
import hanseforum from '~/assets/projects/hanseforum/04.jpg';
import buchholz from '~/assets/projects/reihenhaeuser-buchholz/01.jpg';
import alsterpalais from '~/assets/projects/kinderwelt/03.jpg';
import pferdemarkt from '~/assets/projects/pferdemarkt/03.jpg';
import buero from '~/assets/site/buero-tilsiter-strasse.jpg';
import thomas from '~/assets/team/thomas-quirling.jpg';


// Unser Weg: Stationen aus Familie, Firmengeschichte und den Referenzen
const weg = [
  { k: 'Damals', t: 'Das Handwerk im Blut', d: 'Der Vater unseres Gründers lernt auf dem Bau, was gute Arbeit ausmacht. Die Begeisterung für das Bauen gibt er weiter.' },
  { k: String(GRUENDUNGSJAHR), t: 'Die Gründung', d: 'Thomas Quirling gründet die Quirling GmbH in Hamburg. Von Anfang an mit Schwerpunkt Rohbau in Beton und Stahlbeton.' },
  { k: '1997', t: 'Schlüsselfertig bis zur Übergabe', d: 'Am Tegelweg bauen wir ein Doppelhaus schlüsselfertig. Neben dem Rohbau übernehmen wir auf Wunsch alles bis zum Einzug.', bild: tegelweg, href: '/referenzen/?p=tegelweg' },
  { k: '2001', t: 'Das Hanseforum', d: 'Beton- und Stahlbetonarbeiten für ein Bürogebäude mit Tiefgarage. Großer Gewerbebau, ganz in unserem Element.', bild: hanseforum, href: '/referenzen/?p=hanseforum' },
  { k: '2006', t: '35 Reihenhäuser auf einen Streich', d: 'In Buchholz entsteht der Rohbau für 35 Reihenhäuser. Eines unserer größten Wohnprojekte.', bild: buchholz, href: '/referenzen/?p=reihenhaeuser-buchholz' },
  { k: '2010', t: 'Umbau im Alsterpalais', d: 'Für die Kinderwelt bauen wir das Alsterpalais um und erweitern es. Arbeiten im Bestand verlangen Sorgfalt, genau unser Ding.', bild: alsterpalais, href: '/referenzen/?p=kinderwelt' },
  { k: '2016', t: 'Barrierefrei wohnen am Pferdemarkt', d: 'Rohbau für 25 barrierefreie Wohnungen mit Tiefgarage. Wohnraum, der für alle Lebensphasen gemacht ist.', bild: pferdemarkt, href: '/referenzen/?p=pferdemarkt' },
  { k: '2019', t: 'Neues Büro in Wandsbek', d: 'Wir ziehen in unser neues Bürogebäude in der Tilsiter Straße 174. Mehr Platz für Planung, Angebote und kurze Wege zu allen Baustellen.' },
  { k: 'Heute', t: 'Fest in Hamburg', d: `Über ${firma.projekteAnzahl} Projekte, eine eingespielte Mannschaft von rund ${firma.mitarbeiter} Leuten und die Familie Quirling an der Spitze.` },
];

const zahlen = [
  { v: String(GRUENDUNGSJAHR), l: 'Gegründet in Hamburg' },
  { v: `${firma.projekteAnzahl}+`, l: 'Projekte' },
  { v: String(firma.mitarbeiter), l: 'Mitarbeiter' },
  { v: String(JAHRE_ERFAHRUNG), l: 'Jahre Erfahrung' },
];
---

<Base title="Über uns" description={`Die Quirling GmbH ist seit ${GRUENDUNGSJAHR} als Bauunternehmen in Hamburg tätig. Familienbetrieb mit Schwerpunkt Rohbau, Beton- und Stahlbetonbau.`}>
  <PageHero
    title="Bauen in Hamburg."
    titleLight={`Seit ${GRUENDUNGSJAHR}.`}
    intro="Familienbetrieb mit Schwerpunkt Rohbau. Inhabergeführt, mit kurzen Wegen und einem eingespielten Team aus jungen und erfahrenen Kollegen."
    image={headerBild}
    imageAlt="Wohnanlage Dorfkoppel der Quirling GmbH, im Vordergrund blühende Rhododendren"
    imagePosition="40% 50%"
    crumbs={[{ label: 'Unternehmen' }]}
  />

  <!-- Über uns: kurz, mit den Zahlen daneben -->
  <section class="section">
    <div class="container about">
      <div class="about-text">
        <h2 class="h-sec">Eine Basis,<br /><span class="lt">auf die Sie<br />bauen können.</span></h2>
        <p class="small">
          Seit {GRUENDUNGSJAHR} bauen wir in Hamburg und Umgebung. Unser Schwerpunkt ist der Rohbau in Beton- und Stahlbetonbauweise, dazu bauen wir
          schlüsselfertig und führen Umbauten und Sanierungen aus. Inhabergeführt, mit kurzen Wegen und Sorgfalt bis zum Schluss.
        </p>
      </div>
      <dl class="zahlen">
        {
          zahlen.map((z) => (
            <div class="zahl">
              <dt class="label">{z.l}</dt>
              <dd>{z.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Familiengeschichte: historisches Foto randlos links, Text rechts -->
  <section class="story">
    <figure class="story-photo">
      <span class="story-img">
        <Image src={historisch} alt="Historisches Foto einer Baumannschaft auf einem Gerüst" widths={[800, 1200, 1600]} sizes="(min-width: 900px) 46vw, 100vw" />
      </span>
      <figcaption class="story-cap">Der Vater unseres Gründers in seiner Lehrzeit.</figcaption>
    </figure>
    <div class="container story-in">
      <div class="story-text">
        <h2 class="h-sec">Bauen liegt<br /><span class="lt">in der Familie.</span></h2>
        <p class="small">
          Schon der Vater unseres Gründers stand auf dem Gerüst. {GRUENDUNGSJAHR} hat Thomas Quirling das Unternehmen in Hamburg gegründet, und bis heute
          führt die Familie es selbst. Das heißt für Sie: kurze Wege, klare Absprachen und Menschen mit Namen, die für ihr Wort einstehen.
        </p>
        <ul class="vals">
          <li>Persönlich</li>
          <li>Verbindlich</li>
          <li>Sorgfältig</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Unser Weg: senkrechte Linie in der Mitte, Stationen abwechselnd links und rechts, Rauten als Marken -->
  <section class="section way">
    <div class="container">
      <h2 class="h-sec way-h">Unser<br /><span class="lt">Weg.</span></h2>
      <ol class="way-list">
        {
          weg.map((w) => (
            <li class:list={['way-step', { 'has-img': w.bild }]}>
              <div class="way-text">
                <span class="way-k">{w.k}</span>
                <h3 class="way-t">{w.t}</h3>
                <p>{w.d}</p>
              </div>
              {w.bild && (
                <a class="way-img" href={url(w.href!)} aria-label={`Referenz ansehen: ${w.t}`}>
                  <Image src={w.bild} alt="" widths={[400, 700, 1000]} sizes="(min-width: 900px) 30vw, 100vw" />
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Der Mensch dahinter: Porträt randlos links über die volle Höhe, rechts Leitsatz und Weg zum Team -->
  <section class="lead on-dark">
    <div class="lead-img">
      <Image src={thomas} alt="Thomas Quirling" widths={[600, 900, 1300]} sizes="(min-width: 900px) 44vw, 100vw" />
    </div>
    <div class="container lead-in">
      <div class="lead-text">
        <span class="lead-k">Inhabergeführt seit {GRUENDUNGSJAHR}</span>
        <p class="lead-q">„Was wir zusagen,<br />steht.“</p>
        <p class="lead-p">
          Unser Leitsatz gilt für jedes Bauvorhaben. Thomas Quirling führt das Unternehmen seit der Gründung selbst, unterstützt von Ivonne Quirling in
          der Assistenz der Geschäftsführung. Bei uns sprechen Sie mit denen, die entscheiden.
        </p>
        <span class="lead-n">Thomas Quirling<small>Geschäftsführender Gesellschafter</small></span>
        <a class="lead-btn" href={url('/unternehmen/team/')}><span>Das ganze Team</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- Unser Büro: großes Bild mit Navy-Schräge wie im Seitenkopf -->
  <section class="office on-dark">
    <Image src={buero} alt="Bürogebäude der Quirling GmbH in der Tilsiter Straße 174, Hamburg" widths={[1000, 1600, 2400]} sizes="100vw" class="office-img" />
    <div class="office-slab" aria-hidden="true"></div>
    <div class="container office-in">
      <h2 class="h-sec">Unser Büro.<br /><span class="lt">In Wandsbek.</span></h2>
      <p>
        Seit 2019 laufen in unserem Bürogebäude in der Tilsiter Straße die Fäden zusammen: Angebote, Planung und die Abstimmung mit allen Baustellen. Kommen Sie
        gerne vorbei, wir freuen uns auf Sie.
      </p>
      <address>{firma.strasse}, {firma.plz} {firma.ort}</address>
      <RouteLink light />
    </div>
  </section>
</Base>

<style>
  /* Über uns */
  .about {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }
  .about-text {
    grid-column: 1 / 7;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  .about-text .small {
    margin: 0;
    max-width: 50ch;
  }
  .about-text .h-sec {
    font-size: clamp(2.4rem, 4.4vw, 4.6rem);
  }
  .zahlen {
    grid-column: 8 / 13;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 3.5vw, 3rem) 2rem;
  }
  .zahl {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
    gap: 0.6rem;
  }
  .zahl dd {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(3rem, 5.5vw, 5.4rem);
    line-height: 0.85;
    color: var(--blue);
  }

  /* Familiengeschichte: Foto füllt links die volle Höhe, Innenkante mit Knick */
  .story {
    position: relative;
    overflow-x: clip;
    padding-block: var(--section);
  }
  .story-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
  }
  .story-photo {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 44%;
    margin: 0;
  }
  .story-img {
    position: absolute;
    inset: 0;
    overflow: hidden;
    clip-path: polygon(0 0, 86% 0, 100% 46%, 90% 100%, 0 100%);
    background: var(--stone-200);
  }
  .story-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 80% 0%;
  }
  .story-cap {
    position: absolute;
    left: var(--content-left);
    bottom: 1.4rem;
    padding: 0.5rem 0.8rem 0.45rem;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .story-text {
    grid-column: 7 / 13;
    display: grid;
    gap: 1.4rem;
    justify-items: start;
    padding-block: clamp(2rem, 5vw, 4rem);
  }
  .story-text .small {
    margin: 0;
    max-width: 36rem;
  }
  .vals {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 2rem;
  }
  .vals li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.25rem, 1.6vw, 1.5rem);
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    color: var(--blue);
  }
  .vals li::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    background: var(--blue);
    transform: rotate(45deg);
  }
  /* Unser Weg: Mittellinie, Stationen im Wechsel links und rechts */
  .way-h {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .way-list {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
  }
  .way-list::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.6rem;
    bottom: 0;
    width: 1.5px;
    background: var(--blue);
  }
  .way-step {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(3.5rem, 8vw, 7rem);
    align-items: start;
  }
  /* Raute auf der Linie */
  .way-step::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.5rem;
    width: 1.2rem;
    height: 1.2rem;
    margin-left: -0.6rem;
    background: var(--blue);
    transform: rotate(45deg);
    outline: 6px solid var(--stone-50);
  }
  .way-text {
    grid-column: 1;
    display: grid;
    gap: 0.55rem;
    justify-items: end;
    text-align: right;
  }
  .way-img {
    grid-column: 2;
    grid-row: 1;
    display: block;
    aspect-ratio: 16 / 10;
    max-width: 30rem;
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 100% 86%, 82% 100%, 0 100%);
    background: var(--stone-200);
  }
  .way-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s var(--ease);
  }
  .way-img:hover :global(img) {
    transform: scale(1.05);
  }
  /* jede zweite Station gespiegelt */
  .way-step:nth-child(even) .way-text {
    grid-column: 2;
    justify-items: start;
    text-align: left;
  }
  .way-step:nth-child(even) .way-img {
    grid-column: 1;
    justify-self: end;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 18% 100%, 0 86%);
  }
  .way-k {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(2.8rem, 4.4vw, 4.4rem);
    line-height: 0.85;
    color: var(--blue);
    text-transform: uppercase;
  }
  .way-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.4rem, 1.9vw, 1.9rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--navy);
    margin: 0.3rem 0 0;
  }
  .way-step p {
    margin: 0;
    max-width: 34ch;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--ink-2);
  }
  /* Der Mensch dahinter: Porträt randlos links über die volle Höhe */
  .lead {
    position: relative;
    overflow-x: clip;
    min-height: min(92svh, 860px);
    display: flex;
    align-items: center;
    background: var(--navy);
    color: #fff;
    padding-block: clamp(6rem, 10vw, 8rem);
    clip-path: polygon(0 0, 78% clamp(2rem, 4vw, 3.5rem), 100% clamp(0.8rem, 1.6vw, 1.4rem), 100% 100%, 0 100%);
  }
  .lead-img {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 44%;
    clip-path: polygon(0 0, 100% 0, 84% 100%, 0 100%);
  }
  .lead-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
  }
  .lead-in {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    width: 100%;
  }
  .lead-text {
    grid-column: 7 / 13;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .lead-k {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #c9d0f5;
  }
  .lead-k::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    background: #9aa6ee;
    transform: rotate(45deg);
  }
  .lead-q {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(3rem, 5.6vw, 6rem);
    line-height: 0.9;
    text-transform: uppercase;
    color: #9aa6ee;
  }
  .lead-p {
    margin: 0;
    max-width: 34rem;
    font-weight: 300;
    color: rgb(255 255 255 / 0.85);
  }
  .lead-n {
    display: grid;
    gap: 0.3rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 1.5rem;
    text-transform: uppercase;
    line-height: 1;
  }
  .lead-n small {
    font-family: var(--font-body);
    font-stretch: normal;
    font-weight: 300;
    font-size: 1rem;
    text-transform: none;
    color: rgb(255 255 255 / 0.7);
  }
  .lead-btn {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.6rem;
    padding: 1rem 1.4rem 0.9rem;
    background: #fff;
    color: var(--navy);
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.2rem, 1.5vw, 1.45rem);
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease;
  }
  .lead-btn :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    transition: transform 0.35s var(--ease);
  }
  .lead-btn:hover {
    background: #9aa6ee;
  }
  .lead-btn:hover :global(svg) {
    transform: translateX(4px);
  }
  .block-btn {
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.15rem 1.5rem 1.05rem;
    line-height: 1;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.25rem, 1.6vw, 1.55rem);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.25s ease;
  }
  .block-btn :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    transition: transform 0.35s var(--ease);
  }
  .block-btn:hover {
    background: var(--blue);
  }
  .block-btn:hover :global(svg) {
    transform: translateX(4px);
  }

  /* Büro */
  .office {
    position: relative;
    /* Oberkante als angedeutete Raute wie bei den Seitenköpfen */
    clip-path: polygon(0 0, 78% clamp(2rem, 5vw, 4.5rem), 100% clamp(0.8rem, 2vw, 1.8rem), 100% 100%, 0 100%);
    min-height: min(78svh, 760px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--navy);
    color: #fff;
  }
  /* Bild nur rechts, damit das Gebäude neben der Navy-Fläche ganz zu sehen ist */
  .office :global(.office-img) {
    position: absolute;
    top: 0;
    right: 0;
    width: 62%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 25%);
    mask-image: linear-gradient(to right, transparent, #000 25%);
  }
  .office-slab {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--content-left) + min(50vw, 820px));
    background: rgb(18 23 53 / 0.86);
    clip-path: polygon(0 0, 100% 0, 78% 100%, 0 100%);
  }
  .office-in {
    position: relative;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .office-in .h-sec {
    color: #fff;
  }
  .office-in p {
    margin: 0;
    max-width: 40ch;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.7;
    color: rgb(255 255 255 / 0.85);
  }
  .office-in address {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #c9d0f5;
  }

  @media (max-width: 900px) {
    .about,
    .story-in,
    .lead-in,
    .way-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .lead-text {
      grid-column: 1 / -1;
    }
    .lead {
      display: block;
      min-height: 0;
      padding-top: 0;
      clip-path: none;
    }
    .lead-img {
      position: relative;
      width: auto;
      aspect-ratio: 4 / 5;
      max-height: 70svh;
      margin-bottom: 3rem;
      clip-path: polygon(0 0, 100% 0, 100% 94%, 0 100%);
    }
    .way-list::before {
      left: 0.6rem;
    }
    .way-step,
    .way-step:nth-child(even) {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 1.2rem;
      padding-left: 2.8rem;
    }
    .way-step::before {
      left: 0.6rem;
    }
    .way-step .way-text,
    .way-step:nth-child(even) .way-text {
      grid-column: 1;
      grid-row: 1;
      justify-items: start;
      text-align: left;
    }
    .way-step .way-img,
    .way-step:nth-child(even) .way-img {
      grid-column: 1;
      grid-row: 2;
      justify-self: start;
    }
    .about-text,
    .zahlen,
    .story-text {
      grid-column: 1 / -1;
    }
    .story {
      padding-top: 0;
    }
    .story-photo {
      position: relative;
      width: auto;
      aspect-ratio: 4 / 3;
    }
    .story-img {
