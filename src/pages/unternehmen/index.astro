---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import RouteLink from '~/components/RouteLink.astro';
import Icon from '~/components/Icon.astro';
import { url } from '~/lib/url';
import { firma, JAHRE_ERFAHRUNG, GRUENDUNGSJAHR } from '~/data/site';
import historisch from '~/assets/site/historisch.jpg';
import buero from '~/assets/site/buero-tilsiter-strasse.jpg';
import handwerk from '~/assets/site/handwerk-schalung.jpg';
import thomas from '~/assets/team/thomas-quirling.jpg';

// Die Basis als Rohbau: Fundament unten, darauf drei Geschosse mit Stützen und Decken
const geschosse = [
  { v: firma.mitarbeiter, l: 'Mitarbeiter' },
  { v: firma.projekteAnzahl, l: 'Projekte', plus: true },
  { v: JAHRE_ERFAHRUNG, l: 'Jahre Erfahrung' },
];

// Geschichte und Werte: drei Kapitel, jeder Wert wird durch den eigenen Weg belegt.
// insight: kurzer Satz von Thomas Quirling je Kapitel, wird nur angezeigt, wenn gefüllt.
type Station = { k: string; t: string; d: string; href?: string };
const kapitel: { n: string; wert: string; t: string; d: string; insight: string; stationen: Station[] }[] = [
  {
    n: '01',
    wert: 'Persönlich',
    t: 'Ein Familienbetrieb',
    d: 'Bei uns sprechen Sie mit Menschen, die für ihr Wort einstehen. Von Anfang an.',
    insight: '',
    stationen: [
      { k: 'Damals', t: 'Das Handwerk im Blut', d: 'Der Vater unseres Gründers lernt auf dem Bau, was gute Arbeit ausmacht.' },
      { k: String(GRUENDUNGSJAHR), t: 'Die Gründung', d: 'Thomas Quirling gründet die Quirling GmbH in Hamburg und führt sie bis heute selbst.' },
    ],
  },
  {
    n: '02',
    wert: 'Sorgfältig',
    t: 'Gewachsen mit jedem Projekt',
    d: 'Vom Doppelhaus bis zum Bürogebäude: Jeder Bau ist eine Referenz für den nächsten.',
    insight: '',
    stationen: [
      { k: '1997', t: 'Tegelweg', d: 'Ein Doppelhaus, schlüsselfertig gebaut.', href: '/referenzen/?p=tegelweg' },
      { k: '2001', t: 'Hanseforum', d: 'Bürogebäude mit Tiefgarage.', href: '/referenzen/?p=hanseforum' },
      { k: '2006', t: 'Buchholz', d: 'Rohbau für 35 Reihenhäuser.', href: '/referenzen/?p=reihenhaeuser-buchholz' },
      { k: '2016', t: 'Pferdemarkt', d: '25 barrierefreie Wohnungen mit Tiefgarage.', href: '/referenzen/?p=pferdemarkt' },
    ],
  },
  {
    n: '03',
    wert: 'Verbindlich',
    t: 'Ein Team, das bleibt',
    d: 'Langjährige Kollegen, eingespielte Abläufe und kurze Wege.',
    insight: '',
    stationen: [
      { k: '30+', t: 'Jahre dabei', d: 'Einige unserer Kollegen sind seit über 30 Jahren an Bord.' },
      { k: '2019', t: 'Neues Büro', d: 'Umzug in die Tilsiter Straße 174 in Wandsbek.' },
      { k: 'Heute', t: 'Fest in Hamburg', d: `${firma.projekteAnzahl}+ Projekte, rund ${firma.mitarbeiter} Leute und die Familie an der Spitze.` },
    ],
  },
];
---

<Base title="Über uns" description={`Die Quirling GmbH ist seit ${GRUENDUNGSJAHR} als Bauunternehmen in Hamburg tätig. Familienbetrieb mit Schwerpunkt Rohbau, Beton- und Stahlbetonbau.`}>
  <PageHero
    title="Bauen in Hamburg."
    titleLight={`Seit ${GRUENDUNGSJAHR}.`}
    intro="Das Handwerk liegt bei uns in der Familie. Heute bauen wir in Hamburg und Umgebung, mit einem eingespielten Team aus jungen und erfahrenen Kollegen."
    image={historisch}
    imageAlt="Historisches Foto einer Baumannschaft auf einem Gerüst, darunter der Vater unseres Gründers"
    imagePosition="50% 35%"
    crumbs={[{ label: 'Unternehmen' }]}
  />

  <!-- 1. Basis: Text links, rechts wächst das Gebäude aus den Zahlen -->
  <section class="section base">
    <div class="container base-in">
      <div class="base-text">
        <h2 class="h-sec">Eine Basis,<br /><span class="lt">auf die Sie<br />bauen können.</span></h2>
        <p class="small">
          Unser Schwerpunkt ist der Rohbau in Beton- und Stahlbetonbauweise. Dazu bauen wir schlüsselfertig und führen Umbauten und Sanierungen aus. Für
          private Bauherren ebenso wie für Projektentwickler und Unternehmen.
        </p>
      </div>
      <div class="rb" data-stack role="list" aria-label="Quirling in Zahlen">
        {
          geschosse.map((g, i) => (
            <div class="rb-floor" role="listitem" style={`--i:${geschosse.length - i}`}>
              <span class="rb-v">
                <span data-count={g.v}>{g.v}</span>
                {g.plus && '+'}
              </span>
              <span class="rb-l">{g.l}</span>
            </div>
          ))
        }
        <div class="rb-found" role="listitem">
          <span class="rb-v">{GRUENDUNGSJAHR}</span>
          <span class="rb-l">Gegründet in Hamburg</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Inhaber: Porträt randlos links über die volle Höhe, oben und unten geknickt -->
  <section class="lead on-dark">
    <div class="lead-img">
      <Image src={thomas} alt="Thomas Quirling" widths={[600, 900, 1300]} sizes="(min-width: 900px) 44vw, 100vw" />
    </div>
    <div class="container lead-in">
      <div class="lead-text">
        <p class="lead-q">„Was wir zusagen,<br />steht.“</p>
        <p class="lead-p">
          Unser Leitsatz gilt für jedes Bauvorhaben. Thomas Quirling führt das Unternehmen seit der Gründung selbst, unterstützt von Ivonne Quirling in
          der Assistenz der Geschäftsführung. Bei uns sprechen Sie mit denen, die entscheiden.
        </p>
        <span class="lead-n">Thomas Quirling<small>Inhaber &amp; Geschäftsführer</small></span>
        <a class="lead-btn" href={url('/unternehmen/team/')}><span>Das ganze Team</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- 3. Geschichte und Werte: links bleibt die Einleitung stehen, rechts drei Kapitel mit dem Weg als Beleg -->
  <section class="story" data-story>
    <div class="container story-in">
      <div class="story-side">
        <div class="story-sticky">
          <h2 class="h-sec">Bauen liegt<br /><span class="lt">in der Familie.</span></h2>
          <p class="small">
            Schon der Vater unseres Gründers stand auf dem Gerüst, das Foto oben zeigt ihn in seiner Lehrzeit. {GRUENDUNGSJAHR} hat Thomas Quirling daraus
            ein eigenes Unternehmen gemacht. Drei Dinge tragen uns seitdem.
          </p>
          <ol class="story-nav">
            {
              kapitel.map((c) => (
                <li data-nav={c.n}>{c.wert}</li>
              ))
            }
          </ol>
          <div class="story-img">
            <Image src={handwerk} alt="Schalungselement mit Quirling-Logo auf einer Baustelle" widths={[500, 800, 1100]} sizes="(min-width: 900px) 34vw, 100vw" />
          </div>
        </div>
      </div>
      <div class="story-main" data-way>
        <span class="way-line" aria-hidden="true"><span class="way-fill"></span></span>
        {
          kapitel.map((c) => (
            <div class="ch" data-ch={c.n}>
              <header class="ch-head">
                <h3 class="ch-w">{c.wert}.</h3>
                <p class="ch-t">{c.t}</p>
                <p class="ch-d">{c.d}</p>
              </header>
              <ol class="ch-list">
                {c.stationen.map((st) => (
                  <li class="way-step">
                    <span class="way-k">{st.k}</span>
                    <div class="way-b">
                      {st.href ? (
                        <a class="way-t" href={url(st.href)}>
                          {st.t}
                          <Icon name="arrow" />
                        </a>
                      ) : (
                        <span class="way-t">{st.t}</span>
                      )}
                      <p>{st.d}</p>
                    </div>
                  </li>
                ))}
              </ol>
              {c.insight && (
                <figure class="ins">
                  <blockquote>„{c.insight}“</blockquote>
                  <figcaption>Thomas Quirling</figcaption>
                </figure>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Unser Büro: großes Bild mit Navy-Schräge wie im Seitenkopf -->
  <section class="office on-dark">
    <Image src={buero} alt="Bürogebäude der Quirling GmbH in der Tilsiter Straße 174, Hamburg" widths={[1000, 1600, 2400]} sizes="100vw" class="office-img" />
    <div class="office-slab" aria-hidden="true"></div>
    <div class="container office-in">
      <h2 class="h-sec">Unser Büro.<br /><span class="lt">In Wandsbek.</span></h2>
      <p>
        Seit 2019 laufen in unserem Bürogebäude in der Tilsiter Straße die Fäden zusammen: Angebote, Planung und die Abstimmung mit allen Baustellen. Kommen Sie
        gerne vorbei, wir freuen uns auf Sie.
      </p>
      <address>{firma.strasse}, {firma.plz} {firma.ort}</address>
      <RouteLink light />
    </div>
  </section>
</Base>

<style>
  /* ---------- 1. Basis ---------- */
  .base-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
    align-items: end;
  }
  .base-text {
    grid-column: 1 / 7;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    align-self: center;
  }
  .base-text .h-sec {
    font-size: clamp(2.4rem, 4.4vw, 4.6rem);
  }
  .base-text .small {
    margin: 0;
    max-width: 48ch;
  }
  /* Rohbau als feine Linienzeichnung in einer Farbe: Decken, Stützen, Fundament */
  .rb {
    grid-column: 7 / 13;
    justify-self: center;
    width: min(100%, 26rem);
    --slab: 3px;
    --col: 2px;
    display: grid;
    padding-inline: 1.4rem;
    color: var(--blue);
  }
  .rb-floor {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: calc(var(--slab) + 1.15rem) 1.6rem 1rem;
  }
  /* Decke */
  .rb-floor::before {
    content: '';
    position: absolute;
    left: -0.8rem;
    right: -0.8rem;
    top: 0;
    height: var(--slab);
    background: var(--blue);
    transform-origin: center;
  }
  /* Stützen links, Mitte, rechts */
  .rb-floor::after {
    content: '';
    position: absolute;
    inset: var(--slab) 0 0;
    background:
      linear-gradient(var(--blue), var(--blue)) left / var(--col) 100% no-repeat,
      linear-gradient(var(--blue), var(--blue)) 64% 0 / var(--col) 100% no-repeat,
      linear-gradient(var(--blue), var(--blue)) right / var(--col) 100% no-repeat;
    transform-origin: bottom;
  }
  .rb-v {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(2.2rem, 3.2vw, 3.2rem);
    line-height: 0.85;
  }
  .rb-l {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  /* Fundament: feiner Umriss, breiter als das Gebäude, darunter zwei Streifenfundamente */
  .rb-found {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-inline: -1.4rem;
    padding: 1rem 3rem 0.9rem;
    border: var(--slab) solid var(--blue);
  }
  .rb-found::after {
    content: '';
    position: absolute;
    left: 1.4rem;
    right: 1.4rem;
    top: 100%;
    height: 0.9rem;
    background:
      linear-gradient(var(--blue), var(--blue)) left / 2.2rem 100% no-repeat,
      linear-gradient(var(--blue), var(--blue)) right / 2.2rem 100% no-repeat;
  }
  .rb-found .rb-v {
    font-size: clamp(2.6rem, 3.8vw, 3.8rem);
  }
  /* Aufbau beim Hereinscrollen: Fundament, dann Geschoss für Geschoss nach oben */
  .rb.will-build .rb-found {
    clip-path: inset(0 50% -2rem 50%);
  }
  .rb.will-build .rb-floor::after {
    transform: scaleY(0);
  }
  .rb.will-build .rb-floor::before {
    transform: scaleX(0);
  }
  .rb.will-build .rb-floor > * {
    opacity: 0;
  }
  .rb.is-built .rb-found {
    clip-path: inset(0 0 -2rem 0);
    transition: clip-path 0.45s var(--ease);
  }
  .rb.is-built .rb-floor::after {
    transform: none;
    transition: transform 0.5s var(--ease) calc(0.3s + (var(--i) - 1) * 0.45s);
  }
  .rb.is-built .rb-floor::before {
    transform: none;
    transition: transform 0.5s var(--ease) calc(0.55s + (var(--i) - 1) * 0.45s);
  }
  .rb.is-built .rb-floor > * {
    opacity: 1;
    transition: opacity 0.5s ease calc(0.65s + (var(--i) - 1) * 0.45s);
  }

  /* ---------- 2. Inhaber ---------- */
  .lead {
    position: relative;
    overflow-x: clip;
    min-height: min(92svh, 860px);
    display: flex;
    align-items: center;
    background: var(--navy);
    color: #fff;
    padding-block: clamp(6rem, 10vw, 8rem);
    /* oben wie unten als angedeutete Raute geknickt */
    clip-path: polygon(
      0 0,
      78% clamp(2rem, 4vw, 3.5rem),
      100% clamp(0.8rem, 1.6vw, 1.4rem),
      100% calc(100% - clamp(2rem, 4vw, 3.5rem)),
      22% 100%,
      0 calc(100% - clamp(0.8rem, 1.6vw, 1.4rem))
    );
  }
  .lead-img {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 44%;
    clip-path: polygon(0 0, 100% 0, 84% 100%, 0 100%);
  }
  .lead-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
  }
  .lead-in {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    width: 100%;
  }
  .lead-text {
    grid-column: 7 / 13;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .lead-q {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(3rem, 5.6vw, 6rem);
    line-height: 0.9;
    text-transform: uppercase;
    color: #9aa6ee;
  }
  .lead-p {
    margin: 0;
    max-width: 34rem;
    font-weight: 300;
    color: rgb(255 255 255 / 0.85);
  }
  .lead-n {
    display: grid;
    gap: 0.3rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: 1.5rem;
    text-transform: uppercase;
    line-height: 1;
  }
  .lead-n small {
    font-family: var(--font-body);
    font-stretch: normal;
    font-weight: 300;
    font-size: 1rem;
    text-transform: none;
    color: rgb(255 255 255 / 0.7);
  }
  .lead-btn {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.6rem;
    padding: 1rem 1.4rem 0.9rem;
    background: #fff;
    color: var(--navy);
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.2rem, 1.5vw, 1.45rem);
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.25s ease;
  }
  .lead-btn :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
    transition: transform 0.35s var(--ease);
  }
  .lead-btn:hover {
    background: #9aa6ee;
  }
  .lead-btn:hover :global(svg) {
    transform: translateX(4px);
  }
  /* ---------- 3. Geschichte und Werte ---------- */
  .story {
    padding-block: clamp(5rem, 8vw, 7rem) clamp(6rem, 9vw, 8rem);
  }
  .story-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
  }
  .story-side {
    grid-column: 1 / 6;
  }
  .story-sticky {
    position: sticky;
    top: 110px;
    display: grid;
    gap: 1.3rem;
    justify-items: start;
  }
  .story-sticky .small {
    margin: 0;
    max-width: 44ch;
  }
  /* Kapitel-Übersicht: das aktive Kapitel wird blau und bekommt die Raute */
  .story-nav {
    list-style: none;
    margin: 0.3rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.6rem;
  }
  .story-nav li {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.2rem, 1.5vw, 1.45rem);
    text-transform: uppercase;
    color: #b9bdd3;
    transition: color 0.35s ease;
  }
  .story-nav li.is-on {
    color: var(--blue);
  }
  .story-img {
    width: 100%;
    aspect-ratio: 16 / 10;
    margin-top: 0.8rem;
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 100% 90%, 0 100%);
  }
  .story-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 45%;
  }
  /* rechte Spalte: eine durchgehende Linie, die sich beim Scrollen füllt */
  .story-main {
    --p: 0;
    grid-column: 7 / 13;
    position: relative;
    display: grid;
    gap: clamp(3.5rem, 6vw, 5rem);
    padding-left: 3rem;
  }
  .way-line {
    position: absolute;
    left: 0.5rem;
    top: 0.6rem;
    bottom: 0;
    width: 2px;
    background: var(--stone-200);
  }
  .way-fill {
    position: absolute;
    inset: 0;
    background: var(--blue);
    transform-origin: center top;
    transform: scaleY(var(--p));
  }
  .ch {
    display: grid;
    gap: 1.8rem;
  }
  .ch-head {
    position: relative;
    display: grid;
    gap: 0.5rem;
  }
  /* große Raute je Kapitel auf der Linie */
  .ch-head::before {
    content: '';
    position: absolute;
    left: -3rem;
    top: 0.1rem;
    width: 1.1rem;
    height: 1.1rem;
    background: var(--blue);
    transform: rotate(45deg);
    outline: 6px solid var(--stone-50);
  }
  .ch-w {
    margin: 0.2rem 0 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(2.6rem, 4.2vw, 4.2rem);
    line-height: 0.88;
    text-transform: uppercase;
    color: var(--blue);
  }
  .ch-t {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.25rem, 1.6vw, 1.55rem);
    text-transform: uppercase;
    color: var(--navy);
  }
  .ch-d {
    margin: 0;
    max-width: 40ch;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.6;
    color: var(--ink-2);
  }
  .ch-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.3rem;
  }
  .way-step {
    position: relative;
    display: grid;
    grid-template-columns: 6.6rem minmax(0, 1fr);
    gap: 1.2rem;
    align-items: baseline;
  }
  /* kleine Raute je Station: leer, bis die Linie sie erreicht */
  .way-step::before {
    content: '';
    position: absolute;
    left: -2.73rem;
    top: 0.45rem;
    width: 0.6rem;
    height: 0.6rem;
    background: var(--stone-50);
    border: 1.5px solid #b9bdd3;
    transform: rotate(45deg);
    transition:
      background 0.3s ease,
      border-color 0.3s ease;
  }
  .way-step.is-on::before {
    background: var(--blue);
    border-color: var(--blue);
  }
  .way-k {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.7rem, 2.2vw, 2.2rem);
    line-height: 0.85;
    color: #b9bdd3;
    transition: color 0.4s ease;
  }
  .way-step.is-on .way-k {
    color: var(--blue);
  }
  .way-b {
    display: grid;
    gap: 0.25rem;
  }
  .way-t {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.1rem, 1.3vw, 1.3rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--navy);
    text-decoration: none;
  }
  a.way-t :global(svg) {
    width: 0.9em;
    height: 0.9em;
    color: var(--blue);
    transition: transform 0.35s var(--ease);
  }
  a.way-t:hover {
    color: var(--blue);
  }
  a.way-t:hover :global(svg) {
    transform: translateX(3px);
  }
  .way-step p {
    margin: 0;
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink-2);
  }
  /* Insight von Thomas Quirling: helle Fläche mit Knick */
  .ins {
    margin: 0;
    padding: 1.4rem 1.6rem 1.3rem;
    background: #e6e9f6;
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 1.2rem), calc(100% - 1.2rem) 100%, 0 100%);
    display: grid;
    gap: 0.7rem;
  }
  .ins blockquote {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.3rem, 1.7vw, 1.7rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--navy);
  }
  .ins figcaption {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue);
  }

  /* Büro */
  .office {
    position: relative;
    /* Knick oben liegt über der hellblauen Werte-Fläche, kein heller Spalt */
    margin-top: 0;
    /* Oberkante als angedeutete Raute wie bei den Seitenköpfen */
    clip-path: polygon(0 0, 78% clamp(2rem, 5vw, 4.5rem), 100% clamp(0.8rem, 2vw, 1.8rem), 100% 100%, 0 100%);
    min-height: min(78svh, 760px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--blue);
    color: #fff;
  }
  /* Bild nur rechts, damit das Gebäude neben der Navy-Fläche ganz zu sehen ist */
  .office :global(.office-img) {
    position: absolute;
    top: 0;
    right: 0;
    width: 62%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 25%);
    mask-image: linear-gradient(to right, transparent, #000 25%);
  }
  .office-slab {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--content-left) + min(50vw, 820px));
    background: var(--blue);
    clip-path: polygon(0 0, 100% 0, 78% 100%, 0 100%);
  }
  .office-in {
    position: relative;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .office-in .h-sec {
    color: #fff;
  }
  .office-in p {
    margin: 0;
    max-width: 40ch;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.7;
    color: rgb(255 255 255 / 0.85);
  }
  .office-in address {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #c9d0f5;
  }

  @media (max-width: 900px) {
    .base-in,
    .lead-in,
    .story-in {
      grid-template-columns: minmax(0, 1fr);
    }
    .base-text,
    .rb,
    .lead-text,
    .story-side,
    .story-main {
      grid-column: 1 / -1;
    }
    .story-sticky {
      position: static;
    }
    .story-nav {
      display: none;
    }
    .story-main {
      margin-top: 1.5rem;
    }
    .lead {
      display: block;
      min-height: 0;
      padding-top: 0;
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - 1.6rem), 22% 100%, 0 calc(100% - 0.6rem));
    }
    .lead-img {
      position: relative;
      width: auto;
      aspect-ratio: 4 / 5;
      max-height: 70svh;
      margin-bottom: 3rem;
      clip-path: polygon(0 0, 100% 0, 100% 94%, 0 100%);
    }
    .office-slab {
      width: 100%;
      clip-path: none;
      background: rgb(57 72 164 / 0.86);
    }
    .office :global(.office-img) {
      width: 100%;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }
  @media (max-width: 560px) {
    .rb-floor {
      padding-inline: 1.2rem;
    }
    .rb-found {
      padding-inline: 2.4rem;
    }
    .way-step {
      grid-template-columns: 5.4rem minmax(0, 1fr);
      gap: 0.8rem;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Rohbau baut sich beim Hereinscrollen auf */
  const stack = document.querySelector<HTMLElement>('[data-stack]');
  if (stack && !reduce) {
    stack.classList.add('will-build');
    const io = new IntersectionObserver(
      ([e]) => {
        if (!e?.isIntersecting) return;
        stack.classList.add('is-built');
        io.disconnect();
      },
      { rootMargin: '0px 0px -5% 0px' },
    );
    io.observe(stack);
  }

  /* Geschichte: Linie füllt sich mit dem Scrollen, Stationen und Kapitel schalten nacheinander ein */
  const way = document.querySelector<HTMLElement>('[data-way]');
  const navItems = Array.from(document.querySelectorAll<HTMLElement>('[data-nav]'));
  const chapters = Array.from(document.querySelectorAll<HTMLElement>('[data-ch]'));
  if (way) {
    const steps = Array.from(way.querySelectorAll<HTMLElement>('.way-step'));
    const set = (p: number) => {
      way.style.setProperty('--p', p.toFixed(4));
      const wr = way.getBoundingClientRect();
      steps.forEach((s) => {
        const pos = (s.getBoundingClientRect().top - wr.top) / wr.height;
        s.classList.toggle('is-on', p >= pos - 0.001);
      });
      // aktives Kapitel: das letzte, dessen Kopf die obere Bildschirmhälfte erreicht hat
      let active = chapters[0]?.dataset.ch;
      chapters.forEach((c) => {
        if (c.getBoundingClientRect().top < window.innerHeight * 0.45) active = c.dataset.ch;
      });
      navItems.forEach((n) => n.classList.toggle('is-on', n.dataset.nav === active));
    };
    if (reduce) set(1);
    else
      ScrollTrigger.create({
        trigger: way,
        start: 'top 70%',
        end: 'bottom 60%',
        scrub: true,
        onUpdate: (st) => set(st.progress),
        onRefresh: (st) => set(st.progress),
      });
  }
</script>
