---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import RouteLink from '~/components/RouteLink.astro';
import Icon from '~/components/Icon.astro';
import { url } from '~/lib/url';
import { firma, JAHRE_ERFAHRUNG, GRUENDUNGSJAHR } from '~/data/site';
import historisch from '~/assets/site/historisch.jpg';
import buero from '~/assets/site/buero-tilsiter-strasse.jpg';
import team from '~/assets/team/baustellenteam.jpg';
import thomas from '~/assets/team/thomas-quirling.jpg';
import ivonne from '~/assets/team/ivonne-quirling.jpg';
import michaela from '~/assets/team/michaela-venghaus.jpg';

const personen = [
  { name: 'Thomas Quirling', rolle: 'Geschäftsführender Gesellschafter', bild: thomas },
  { name: 'Ivonne Quirling', rolle: 'Assistentin der Geschäftsführung', bild: ivonne },
  { name: 'Michaela Venghaus', rolle: 'Büroangestellte', bild: michaela },
];


const zahlen = [
  { v: String(GRUENDUNGSJAHR), l: 'Gegründet in Hamburg' },
  { v: `${firma.projekteAnzahl}+`, l: 'Projekte' },
  { v: String(firma.mitarbeiter), l: 'Mitarbeiter' },
  { v: String(JAHRE_ERFAHRUNG), l: 'Jahre Erfahrung' },
];
---

<Base title="Über uns" description={`Die Quirling GmbH ist seit ${GRUENDUNGSJAHR} als Bauunternehmen in Hamburg tätig. Familienbetrieb mit Schwerpunkt Rohbau, Beton- und Stahlbetonbau. Lernen Sie unser Team kennen.`}>
  <PageHero
    title="Bauen in Hamburg."
    titleLight={`Seit ${GRUENDUNGSJAHR}.`}
    intro="Familienbetrieb mit Schwerpunkt Rohbau. Inhabergeführt, mit kurzen Wegen und einem eingespielten Team aus jungen und erfahrenen Kollegen."
    image={historisch}
    imageAlt="Historisches Foto einer Baumannschaft"
    crumbs={[{ label: 'Unternehmen' }]}
  />

  <!-- Über uns: kurz, mit den Zahlen daneben -->
  <section class="section">
    <div class="container about">
      <div class="about-text">
        <h2 class="h-sec">Eine Basis,<br /><span class="lt">auf die Sie<br />bauen können.</span></h2>
        <p class="small">
          Seit {GRUENDUNGSJAHR} bauen wir in Hamburg und Umgebung. Unser Schwerpunkt ist der Rohbau in Beton- und Stahlbetonbauweise, dazu bauen wir
          schlüsselfertig und führen Umbauten und Sanierungen aus. Inhabergeführt, mit kurzen Wegen und Sorgfalt bis zum Schluss.
        </p>
      </div>
      <dl class="zahlen">
        {
          zahlen.map((z) => (
            <div class="zahl">
              <dt class="label">{z.l}</dt>
              <dd>{z.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Unsere Mannschaft: eigener Abschnitt, großes Foto -->
  <section class="section section-tint crew" id="mannschaft">
    <div class="container crew-in">
      <div class="para crew-img">
        <span class="para-img">
          <Image src={team} alt="Die Mannschaft der Quirling GmbH vor Schalungselementen" widths={[800, 1200, 1600]} sizes="(min-width: 1024px) 60vw, 100vw" />
        </span>
      </div>
      <div class="crew-text">
        <h2 class="h-sec">Unsere<br /><span class="lt">Mannschaft.</span></h2>
        <p class="small">
          Das Herz des Unternehmens sind die Facharbeiter auf der Baustelle. Junge und erfahrene Kollegen, die seit vielen Jahren zusammenarbeiten und
          sich aufeinander verlassen können. Sie sind der Grund, warum unsere Bauten stehen.
        </p>
        <a class="text-link" href={url('/karriere/')}><span>Mit anpacken</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- Team: Ansprechpartner im Büro -->
  <section class="section team-sec" id="team">
    <div class="container">
      <h2 class="h-sec team-h">Ihre<br /><span class="lt">Ansprechpartner.</span></h2>
      <div class="people">
        {
          personen.map((p) => (
            <article class="person">
              <div class="pimg">
                <Image src={p.bild} alt={p.name} widths={[400, 700, 1000]} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw" />
              </div>
              <span class="label">{p.rolle}</span>
              <h3 class="p-name">{p.name}</h3>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Unser Büro: großes Bild mit Navy-Schräge wie im Seitenkopf -->
  <section class="office on-dark">
    <Image src={buero} alt="Bürogebäude der Quirling GmbH in der Tilsiter Straße 174, Hamburg" widths={[1000, 1600, 2400]} sizes="100vw" class="office-img" />
    <div class="office-slab" aria-hidden="true"></div>
    <div class="container office-in">
      <h2 class="h-sec">Unser Büro.<br /><span class="lt">In Wandsbek.</span></h2>
      <p>
        In unserem Bürogebäude in der Tilsiter Straße laufen die Fäden zusammen: Angebote, Planung und die Abstimmung mit allen Baustellen. Kommen Sie
        gerne vorbei, wir freuen uns auf Sie.
      </p>
      <address>{firma.strasse}, {firma.plz} {firma.ort}</address>
      <RouteLink light />
    </div>
  </section>
</Base>

<style>
  /* Über uns */
  .about {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }
  .about-text {
    grid-column: 1 / 7;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  .about-text .small {
    margin: 0;
    max-width: 50ch;
  }
  .about-text .h-sec {
    font-size: clamp(2.4rem, 4.4vw, 4.6rem);
  }
  .zahlen {
    grid-column: 8 / 13;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 3.5vw, 3rem) 2rem;
  }
  .zahl {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
    gap: 0.6rem;
  }
  /* Mannschaft */
  .crew-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }
  .crew-img {
    grid-column: 1 / 9;
  }
  .crew-text {
    grid-column: 9 / 13;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  .crew-text .small {
    margin: 0;
    max-width: 40ch;
  }
  .zahl dd {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(3rem, 5.5vw, 5.4rem);
    line-height: 0.85;
    color: var(--blue);
  }

  /* Werte */

  /* Zeitstrahl */
  /* Team */
  .team-sec {
    scroll-margin-top: 4rem;
  }
  .team-h {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .people {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }
  .person {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
  }
  .pimg {
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    margin-bottom: 0.8rem;
    background: var(--stone-200);
  }
  .pimg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: transform 1s var(--ease);
  }
  .person:hover .pimg :global(img) {
    transform: scale(1.04);
  }
  .p-name {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    line-height: 1;
    color: var(--blue);
    margin: 0;
  }

  /* Büro */
  .office {
    position: relative;
    /* Oberkante als angedeutete Raute wie bei den Seitenköpfen */
    clip-path: polygon(0 0, 78% clamp(2rem, 5vw, 4.5rem), 100% clamp(0.8rem, 2vw, 1.8rem), 100% 100%, 0 100%);
    min-height: min(78svh, 760px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--navy);
    color: #fff;
  }
  /* Bild nur rechts, damit das Gebäude neben der Navy-Fläche ganz zu sehen ist */
  .office :global(.office-img) {
    position: absolute;
    top: 0;
    right: 0;
    width: 62%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 25%);
    mask-image: linear-gradient(to right, transparent, #000 25%);
  }
  .office-slab {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--content-left) + min(50vw, 820px));
    background: rgb(18 23 53 / 0.86);
    clip-path: polygon(0 0, 100% 0, 78% 100%, 0 100%);
  }
  .office-in {
    position: relative;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .office-in .h-sec {
    color: #fff;
  }
  .office-in p {
    margin: 0;
    max-width: 40ch;
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.7;
    color: rgb(255 255 255 / 0.85);
  }
  .office-in address {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #c9d0f5;
  }

  @media (max-width: 900px) {
    .about,
    .crew-in {
      grid-template-columns: minmax(0, 1fr);
    }
    .about-text,
    .zahlen,
    .crew-img,
    .crew-text {
      grid-column: 1 / -1;
    }
    .crew-img {
      margin-inline: 4%;
    }
    .office-slab {
      width: 100%;
      clip-path: none;
    }
    .office :global(.office-img) {
      width: 100%;
      -webkit-mask-image: none;
      mask-image: none;
    }
    .people {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .zahlen {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    }
  @media (max-width: 560px) {
    .people {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
