---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import RouteLink from '~/components/RouteLink.astro';
import ValueIcon from '~/components/ValueIcon.astro';
import { firma, JAHRE_ERFAHRUNG, GRUENDUNGSJAHR } from '~/data/site';
import historisch from '~/assets/site/historisch.jpg';
import buero from '~/assets/site/buero-tilsiter-strasse.jpg';
import team from '~/assets/team/baustellenteam.jpg';



const werte = [
  { icon: 'dialog' as const, t: 'Im Gespräch', d: 'Wir setzen auf partnerschaftliche Beziehungen und stehen im ständigen Kontakt mit unseren Auftraggebern.' },
  { icon: 'hammer' as const, t: 'Sorgfältig', d: 'Die Arbeiten werden bei uns bis zum Schluss sorgfältig ausgeführt. Flexibel, sauber und verlässlich.' },
  { icon: 'familie' as const, t: 'Als Team', d: 'Ein gutes Arbeitsklima im eigenen Team. Ein zufriedenes Team ist auch für den Auftraggeber vielversprechend.' },
];

const zahlen = [
  { v: String(GRUENDUNGSJAHR), l: 'Gegründet in Hamburg' },
  { v: `${firma.projekteAnzahl}+`, l: 'Projekte' },
  { v: String(firma.mitarbeiter), l: 'Mitarbeiter' },
  { v: String(JAHRE_ERFAHRUNG), l: 'Jahre Erfahrung' },
];
---

<Base title="Über uns" description={`Die Quirling GmbH ist seit ${GRUENDUNGSJAHR} als Bauunternehmen in Hamburg tätig, mit Schwerpunkt Rohbau, Beton- und Stahlbetonbau.`}>
  <PageHero
    title="Bauen in Hamburg."
    titleLight={`Seit ${GRUENDUNGSJAHR}.`}
    intro="Familienbetrieb mit Schwerpunkt Rohbau. Inhabergeführt, mit kurzen Wegen und einem eingespielten Team aus jungen und erfahrenen Kollegen."
    image={historisch}
    imageAlt="Historisches Foto einer Baumannschaft"
    crumbs={[{ label: 'Unternehmen' }]}
  />

  <!-- Über uns -->
  <section class="section">
    <div class="container about">
      <div class="para about-img">
        <span class="para-img">
          <Image src={team} alt="Die Mannschaft der Quirling GmbH vor Schalungselementen" widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 50vw, 100vw" />
        </span>
      </div>
      <div class="about-text">
        <h2 class="h-sec">Eine Basis,<br /><span class="lt">auf die Sie<br />bauen können.</span></h2>
        <p class="small">
          Seit {GRUENDUNGSJAHR} bauen wir in Hamburg und Umgebung. Unser Schwerpunkt ist der Rohbau in Beton- und Stahlbetonbauweise, dazu bauen wir
          schlüsselfertig und führen Umbauten und Sanierungen aus. Mit eigenem Team, direkten Absprachen und Sorgfalt bis zum Schluss.
        </p>
      </div>
    </div>

    <!-- Zahlen -->
    <div class="container">
      <dl class="zahlen">
        {
          zahlen.map((z) => (
            <div class="zahl">
              <dt class="label">{z.l}</dt>
              <dd>{z.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Unser Büro: großes Bild mit Navy-Schräge wie im Seitenkopf -->
  <section class="office on-dark">
    <Image src={buero} alt="Bürogebäude der Quirling GmbH in der Tilsiter Straße 174, Hamburg" widths={[1000, 1600, 2400]} sizes="100vw" class="office-img" />
    <div class="office-slab" aria-hidden="true"></div>
    <div class="container office-in">
      <h2 class="h-sec">Unser Büro.<br /><span class="lt">In Wandsbek.</span></h2>
      <p>
        In unserem Bürogebäude in der Tilsiter Straße laufen die Fäden zusammen: Angebote, Planung und die Abstimmung mit allen Baustellen. Kommen Sie
        gerne vorbei, wir freuen uns auf Sie.
      </p>
      <address>{firma.strasse}, {firma.plz} {firma.ort}</address>
      <RouteLink light />
    </div>
  </section>

  <!-- Werte, wie Familienbetrieb auf der Startseite -->
  <section class="section on-blue werte-sec">
    <div class="container">
      <div class="werte-head">
        <h2 class="h-sec">Wie wir<br /><span class="lt">arbeiten.</span></h2>
      </div>
      <div class="werte">
        {
          werte.map((w) => (
            <div class="wert">
              <ValueIcon name={w.icon} class="wert-icon" frame={false} />
              <h3 class="wert-t">{w.t}</h3>
              <p class="small">{w.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

</Base>

<style>
  /* Über uns */
  .about {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }
  .about-img {
    grid-column: 1 / 7;
  }
  .about-text {
    grid-column: 8 / 13;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  .about-text .small {
    margin: 0;
    max-width: 46ch;
  }
  .about-text .h-sec {
    font-size: clamp(2.4rem, 4.4vw, 4.6rem);
  }

  .zahlen {
    margin: clamp(4rem, 8vw, 7rem) 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }
  .zahl {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
    gap: 0.6rem;
  }
  .zahl dd {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(3rem, 5.5vw, 5.4rem);
    line-height: 0.85;
    color: var(--blue);
  }

  /* Werte */
  .werte-sec {
    background: var(--blue);
  }
  .werte-head {
    display: grid;
    gap: 1.2rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .werte {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
  }
  .wert {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    align-content: start;
  }
  .wert :global(.wert-icon) {
    color: #fff;
  }
  .wert :global(.vicon-art) {
    width: 68px;
    height: 68px;
  }
  .wert :global(.vicon-hammer) {
    width: 60px;
    height: 60px;
  }
  .wert-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    line-height: 1;
    color: #fff;
    margin: 0.4rem 0 0;
  }
  .wert .small {
    margin: 0;
    max-width: 36ch;
  }

  /* Zeitstrahl */
  /* Büro */
  .office {
    position: relative;
    /* Oberkante als angedeutete Raute wie bei den Seitenköpfen */
    clip-path: polygon(0 0, 78% clamp(2rem, 5vw, 4.5rem), 100% clamp(0.8rem, 2vw, 1.8rem), 100% 100%, 0 100%);
    min-height: min(78svh, 760px);
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--navy);
    color: #fff;
  }
  .office :global(.office-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 40%;
  }
  .office-slab {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--content-left) + min(50vw, 820px));
    background: rgb(18 23 53 / 0.86);
    clip-path: polygon(0 0, 100% 0, 78% 100%, 0 100%);
  }
  .office-in {
    position: relative;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .office-in .h-sec {
    color: #fff;
  }
  .office-in p {
    margin: 0;
    max-width: 40ch;
    font-size: 0.95rem;
    line-height: 1.7;
    color: rgb(255 255 255 / 0.85);
  }
  .office-in address {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #c9d0f5;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
    .about-img,
    .about-text {
      grid-column: 1 / -1;
    }
    .about-img {
      margin-inline: 4%;
    }
    .office-slab {
      width: 100%;
      clip-path: none;
    }
    .zahlen {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .werte {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
