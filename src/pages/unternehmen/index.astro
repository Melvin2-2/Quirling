---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import Todo from '~/components/Todo.astro';
import ValueIcon from '~/components/ValueIcon.astro';
import { firma, JAHRE_ERFAHRUNG, GRUENDUNGSJAHR } from '~/data/site';
import { url } from '~/lib/url';
import historisch from '~/assets/site/historisch.jpg';
import team from '~/assets/team/baustellenteam.jpg';

const bild = (await getEntry('projekte', 'horner-landstrasse'))!.data.bilder[0]!;

type Station = { jahr: string; titel: string; text: string; link?: string; pruefen?: boolean };
const stationen: Station[] = [
  { jahr: String(GRUENDUNGSJAHR), titel: 'Gründung in Hamburg', text: 'Thomas Quirling gründet das Bauunternehmen. Bereits in der Anfangsphase können wir mit zufriedenen und treuen Kunden rechnen.', pruefen: true },
  { jahr: '1997', titel: 'Schlüsselfertig am Tegelweg', text: 'Schlüsselfertiger Neubau eines Doppelhauses am Tegelweg 51 a in Hamburg-Farmsen-Berne, viele Jahre auch unsere Firmenadresse.', link: 'tegelweg', pruefen: true },
  { jahr: '2001', titel: 'Hanseforum', text: 'Beton- und Stahlbetonbauarbeiten eines Bürogebäudes mit Tiefgarage am Axel-Springer-Platz.', link: 'hanseforum' },
  { jahr: '2006', titel: '35 Reihenhäuser in Buchholz', text: 'Rohbau von 35 Reihenhäusern in Buchholz in der Nordheide.', link: 'reihenhaeuser-buchholz' },
  { jahr: '2009', titel: 'Große Johannisstraße', text: 'Rohbau eines Büro- und Geschäftshauses in der Hamburger Altstadt.', link: 'grosse-johannisstrasse' },
  { jahr: '2010', titel: 'Alsterpalais', text: 'Umbau und Erweiterung des Alsterpalais in der Alsterdorfer Straße.', link: 'kinderwelt' },
  { jahr: '2016', titel: 'Wohnen in Bad Oldesloe', text: 'Rohbau von 25 barrierefreien Wohnungen mit Tiefgarage am Pferdemarkt.', link: 'pferdemarkt' },
  { jahr: '2018', titel: 'Horner Landstraße', text: 'Rohbau eines Mehrfamilienhauses mit 20 Wohneinheiten.', link: 'horner-landstrasse' },
  { jahr: '2019', titel: 'Neuer Firmensitz', text: 'Rohbau für Kaufhaus und Hotel am Serrahnhafen in Bergedorf. Schlüsselfertiger Neubau des Betriebsgebäudes in der Tilsiter Straße 174, heute unser Firmensitz.', pruefen: true },
  { jahr: 'Heute', titel: `Mehr als ${firma.projekteAnzahl} Projekte`, text: `${JAHRE_ERFAHRUNG} Jahre Erfahrung, ein eingespieltes Team und Bauvorhaben in Hamburg und Umgebung.` },
];

const werte = [
  { icon: 'dialog' as const, t: 'Im Gespräch', d: 'Wir setzen auf partnerschaftliche Beziehungen und stehen im ständigen Kontakt mit unseren Auftraggebern.' },
  { icon: 'hammer' as const, t: 'Sorgfältig', d: 'Die Arbeiten werden bei uns bis zum Schluss sorgfältig ausgeführt. Flexibel, sauber und verlässlich.' },
  { icon: 'familie' as const, t: 'Als Team', d: 'Ein gutes Arbeitsklima im eigenen Team. Ein zufriedenes Team ist auch für den Auftraggeber vielversprechend.' },
];

const zahlen = [
  { v: String(GRUENDUNGSJAHR), l: 'Gegründet in Hamburg' },
  { v: `${firma.projekteAnzahl}+`, l: 'Projekte' },
  { v: String(firma.mitarbeiter), l: 'Mitarbeiter' },
  { v: String(JAHRE_ERFAHRUNG), l: 'Jahre Erfahrung' },
];
---

<Base title="Über uns" description={`Die Quirling GmbH ist seit ${GRUENDUNGSJAHR} als Bauunternehmen in Hamburg tätig, mit Schwerpunkt Rohbau, Beton- und Stahlbetonbau.`}>
  <PageHero
    eyebrow="Unternehmen"
    title="Bauen in Hamburg."
    titleLight={`Seit ${GRUENDUNGSJAHR}.`}
    intro="Ein dynamisches und flexibles Team aus jungen und erfahrenen Mitarbeitern. Inhabergeführt und mit kurzen Wegen."
    image={historisch}
    imageAlt="Historisches Foto einer Baumannschaft"
    crumbs={[{ label: 'Unternehmen' }]}
  />

  <!-- Über uns -->
  <section class="section">
    <div class="container about">
      <div class="para about-img">
        <span class="para-img">
          <Image src={bild} alt="Mehrfamilienhaus Horner Landstraße" widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 45vw, 100vw" />
        </span>
      </div>
      <div class="about-text">
        <span class="label">Über uns</span>
        <h2 class="h-sec">Eine Basis,<br /><span class="lt">auf die Sie<br />bauen können.</span></h2>
        <p class="small">
          Mit unseren kompetenten Mitarbeitern konnten wir uns an vielseitigen Bauten beweisen. Wir erstellen nicht nur Neubauten, sondern führen
          auch Umbau- und Sanierungsmaßnahmen aus. Schwerpunkt ist der Rohbau, speziell Beton- und Stahlbetonbau mit Schalungsbau.
        </p>
        <p class="small">Unser Einsatzgebiet ist {firma.einsatzgebiet}</p>
      </div>
    </div>

    <!-- Zahlen -->
    <div class="container">
      <dl class="zahlen">
        {
          zahlen.map((z) => (
            <div class="zahl">
              <dt class="label">{z.l}</dt>
              <dd>{z.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Werte, wie Familienbetrieb auf der Startseite -->
  <section class="section on-blue werte-sec">
    <div class="container">
      <div class="werte-head">
        <span class="label">Werte</span>
        <h2 class="h-sec">Wie wir<br /><span class="lt">arbeiten.</span></h2>
      </div>
      <div class="werte">
        {
          werte.map((w) => (
            <div class="wert">
              <ValueIcon name={w.icon} class="wert-icon" frame={false} />
              <h3 class="wert-t">{w.t}</h3>
              <p class="small">{w.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Geschichte: die blaue Linie als Zeitstrahl -->
  <section class="section">
    <div class="container tl-wrap">
      <div class="tl-head">
        <span class="label">Geschichte</span>
        <h2 class="h-sec">Stein<br /><span class="lt">auf Stein.</span></h2>
        <p class="small">Eine Auswahl von Stationen aus {JAHRE_ERFAHRUNG} Jahren Firmengeschichte.</p>
      </div>
      <ol class="timeline">
        <span class="tl-line" aria-hidden="true"><span data-line></span></span>
        {
          stationen.map((s) => (
            <li class="station">
              <span class="jahr">{s.jahr}</span>
              <div class="st-text">
                <h3 class="st-t">{s.link ? <a href={url(`/referenzen/?p=${s.link}`)}>{s.titel}</a> : s.titel}</h3>
                <p class="small">{s.pruefen ? <Todo hint="bitte prüfen">{s.text}</Todo> : s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Team und Downloads -->
  <section class="section section-tint">
    <div class="container more">
      <div class="more-text">
        <span class="label">Mehr über uns</span>
        <h2 class="h-sec">Menschen<br /><span class="lt">und Nachweise.</span></h2>
        <p class="small">Lernen Sie die Ansprechpartner im Büro kennen oder laden Sie Zertifikate und Unterlagen direkt herunter.</p>
        <div class="more-links">
          <a class="text-link" href={url('/unternehmen/team/')}><span>Unser Team</span><Icon name="arrow" /></a>
          <a class="text-link" href={url('/unternehmen/zertifikate/')}><span>Zertifikate und Downloads</span><Icon name="arrow" /></a>
        </div>
      </div>
      <div class="para flip more-img">
        <span class="para-img">
          <Image src={team} alt="Das Baustellenteam der Quirling GmbH" widths={[700, 1200]} sizes="(min-width: 1024px) 50vw, 100vw" />
        </span>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Über uns */
  .about {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }
  .about-img {
    grid-column: 1 / 7;
  }
  .about-text {
    grid-column: 8 / 13;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  .about-text .small {
    margin: 0;
    max-width: 46ch;
  }
  .about-text .h-sec {
    font-size: clamp(2.4rem, 4.4vw, 4.6rem);
  }

  .zahlen {
    margin: clamp(4rem, 8vw, 7rem) 0 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }
  .zahl {
    position: relative;
    padding-top: 1.2rem;
    display: flex;
    flex-direction: column-reverse;
    gap: 0.6rem;
  }
  .zahl::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 3rem;
    height: 2px;
    background: var(--blue);
  }
  .zahl dd {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(3rem, 5.5vw, 5.4rem);
    line-height: 0.85;
    color: var(--blue);
  }

  /* Werte */
  .werte-sec {
    background: var(--blue);
  }
  .werte-head {
    display: grid;
    gap: 1.2rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .werte {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
  }
  .wert {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    align-content: start;
  }
  .wert :global(.wert-icon) {
    color: #fff;
  }
  .wert :global(.vicon-art) {
    width: 68px;
    height: 68px;
  }
  .wert :global(.vicon-hammer) {
    width: 60px;
    height: 60px;
  }
  .wert-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    line-height: 1;
    color: #fff;
    margin: 0.4rem 0 0;
  }
  .wert .small {
    margin: 0;
    max-width: 36ch;
  }

  /* Zeitstrahl */
  .tl-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .tl-head {
    position: sticky;
    top: 7rem;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  .tl-head .small {
    margin: 0;
    max-width: 30ch;
  }
  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tl-line {
    position: absolute;
    left: 7.5rem;
    top: 0.6rem;
    bottom: 0.6rem;
    width: 2px;
    background: var(--line);
  }
  .tl-line span {
    position: absolute;
    inset: 0;
    background: var(--blue);
    transform-origin: top;
  }
  .station {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    padding-bottom: clamp(2rem, 3.5vw, 3rem);
  }
  .station::before {
    content: '';
    position: absolute;
    left: calc(7.5rem - 5px);
    top: 0.55rem;
    width: 12px;
    height: 12px;
    background: var(--stone-50);
    border: 2px solid var(--blue);
    transform: rotate(45deg) scaleY(0.75);
  }
  .jahr {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.6rem, 2vw, 2rem);
    line-height: 1;
    color: var(--blue);
    padding-right: 1.5rem;
  }
  .st-text {
    padding-left: 2rem;
  }
  .st-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.3rem, 1.6vw, 1.6rem);
    line-height: 1.05;
    color: var(--ink);
    margin: 0 0 0.5rem;
  }
  .st-t a {
    color: inherit;
    text-decoration: none;
  }
  .st-t a:hover {
    color: var(--blue);
    text-decoration: underline;
  }
  .st-text .small {
    margin: 0;
    max-width: 52ch;
  }

  /* Mehr */
  .more {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }
  .more-text {
    grid-column: 1 / 6;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  .more-text .small {
    margin: 0;
    max-width: 42ch;
  }
  .more-links {
    display: grid;
    gap: 0.9rem;
    margin-top: 0.6rem;
  }
  .more-img {
    grid-column: 7 / 13;
  }

  @media (max-width: 900px) {
    .about,
    .more,
    .tl-wrap {
      grid-template-columns: minmax(0, 1fr);
    }
    .about-img,
    .about-text,
    .more-text,
    .more-img {
      grid-column: 1 / -1;
    }
    .about-img,
    .more-img {
      margin-inline: 4%;
    }
    .tl-head {
      position: static;
    }
    .zahlen {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .werte {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .tl-line {
      left: 0;
    }
    .station {
      grid-template-columns: minmax(0, 1fr);
      padding-left: 1.8rem;
      gap: 0.5rem;
    }
    .station::before {
      left: -5px;
    }
    .st-text {
      padding-left: 0;
    }
  }
</style>
