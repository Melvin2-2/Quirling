---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import { firma } from '~/data/site';
import { url } from '~/lib/url';
import buero from '~/assets/site/buero-tilsiter-strasse.jpg';
import team from '~/assets/team/kontakt-ivonne-michaela.jpg';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const anliegen = ['Neubau', 'Rohbau', 'Schlüsselfertig', 'Umbau & Sanierung', 'Bewerbung', 'Sonstiges'];
---

<Base title="Kontakt" footerClaim={false} description="Kontakt zur Quirling GmbH Bauunternehmen, Tilsiter Straße 174, 22047 Hamburg. Telefon 040 / 33 46 34 19 0, info@quirling.de.">
  <PageHero
    title="Sprechen"
    titleLight="wir."
    intro="Ob erste Idee oder fertige Planung: Rufen Sie uns an, schreiben Sie uns oder kommen Sie vorbei. Wir freuen uns auf Ihr Vorhaben."
    image={buero}
    imageAlt="Bürogebäude der Quirling GmbH in der Tilsiter Straße 174, Hamburg"
    size="medium"
    crumbs={[{ label: 'Kontakt' }]}
  >
    <div class="quick">
      <a class="pill light" href={firma.telefonHref}><Icon name="phone" /><span>Anrufen</span></a>
      <a class="pill light" href="#anfrage"><Icon name="mail" /><span>Anfrage senden</span></a>
    </div>
  </PageHero>

  <!-- Persönlich am Telefon -->
  <section class="section direct">
    <div class="container direct-in">
      <div class="para direct-img">
        <span class="para-img">
          <Image src={team} alt="Ivonne Quirling und Michaela Venghaus aus dem Büro der Quirling GmbH" widths={[700, 1100, 1600]} sizes="(min-width: 1024px) 50vw, 100vw" />
        </span>
      </div>
      <div class="direct-text">
        <h2 class="h-sec">Am Telefon.<br /><span class="lt">Gleich persönlich.</span></h2>
        <a class="tel" href={firma.telefonHref}>{firma.telefon}</a>
        <p class="small">
          Ivonne Quirling und Michaela Venghaus sind montags bis freitags für Sie da und verbinden Sie direkt mit dem richtigen Ansprechpartner.
        </p>
        <a class="mail" href={`mailto:${firma.email}`}><Icon name="mail" /><span>{firma.email}</span></a>
      </div>
    </div>
  </section>

  <!-- Anfrage: blaue Fläche, Oberkante als angedeutete Raute wie im Seitenkopf -->
  <section class="ask on-blue" id="anfrage">
    <div class="container ask-in">
      <div class="ask-head">
        <h2 class="ask-h">Ihre<br /><span class="lt">Anfrage.</span></h2>
        <p>Erzählen Sie uns kurz von Ihrem Vorhaben. Wir melden uns zeitnah bei Ihnen zurück.</p>
      </div>

      <form class="form" data-form data-endpoint={endpoint} data-mail={firma.email} novalidate>
        <fieldset class="chips">
          <legend>Worum geht es?</legend>
          {
            anliegen.map((a, i) => (
              <label class="chip">
                <input type="radio" name="anliegen" value={a} checked={i === 0} />
                <span>{a}</span>
              </label>
            ))
          }
        </fieldset>
        <div class="row2">
          <label class="f">
            <span>Name *</span>
            <input name="name" required autocomplete="name" />
          </label>
          <label class="f">
            <span>Firma</span>
            <input name="firma" autocomplete="organization" />
          </label>
        </div>
        <div class="row2">
          <label class="f">
            <span>E-Mail *</span>
            <input name="email" type="email" required autocomplete="email" />
          </label>
          <label class="f">
            <span>Telefon</span>
            <input name="telefon" type="tel" autocomplete="tel" />
          </label>
        </div>
        <label class="f">
          <span>Ihre Nachricht *</span>
          <textarea name="nachricht" rows="5" required></textarea>
        </label>
        <div class="row2 bottom">
          <!-- Sicherheitsfrage gegen Spam: Aufgabe wird beim Laden neu gewürfelt -->
          <label class="f captcha">
            <span>Sicherheitsfrage *</span>
            <span class="cq">
              <span class="cq-t" data-captcha-q>Was ergibt 3 + 4?</span>
              <input name="sicherheit" inputmode="numeric" required autocomplete="off" data-captcha-a />
            </span>
          </label>
          <label class="check">
            <input type="checkbox" name="datenschutz" required />
            <span>Ich habe die <a href={url('/datenschutz/')}>Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Angaben zur Beantwortung meiner Anfrage einverstanden. *</span>
          </label>
        </div>
        <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="submit">
          <button class="send" type="submit"><span>Nachricht senden</span><Icon name="arrow" /></button>
          <p class="status" data-status role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>

  <!-- Besuchen und Bewerben -->
  <section class="section more">
    <div class="container more-in">
      <div class="m">
        <h2 class="m-h">Besuchen<br /><span class="lt">Sie uns.</span></h2>
        <address class="small">
          {firma.langname}<br />
          {firma.strasse}<br />
          {`${firma.plz} ${firma.ort}`}
        </address>
        <a class="text-link" href={firma.mapsUrl} target="_blank" rel="noopener"><span>Route planen</span><Icon name="arrow" /></a>
      </div>
      <div class="m">
        <h2 class="m-h">Mit anpacken<br /><span class="lt">bei Quirling.</span></h2>
        <p class="small">Bewerbungen gerne per E-Mail an <a href={`mailto:${firma.email}`}>{firma.email}</a> oder persönlich bei uns im Büro.</p>
        <a class="text-link" href={url('/karriere/')}><span>Zur Karriereseite</span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .quick {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  /* Persönlich am Telefon */
  .direct-in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }
  .direct-img {
    grid-column: 1 / 7;
  }
  .direct-img :global(img) {
    object-position: 60% 18%;
  }
  .direct-text {
    grid-column: 8 / 13;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  .direct-text .h-sec {
    font-size: clamp(2.4rem, 4vw, 4.2rem);
  }
  .tel {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(2.6rem, 4.6vw, 4.8rem);
    line-height: 1;
    color: var(--blue);
    text-decoration: none;
    white-space: nowrap;
  }
  .tel:hover {
    color: var(--navy);
  }
  .direct-text .small {
    margin: 0;
    max-width: 40ch;
  }
  .mail {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--blue);
    text-decoration: none;
  }
  .mail :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }
  .mail:hover span {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* Anfrage */
  .ask {
    position: relative;
    background: var(--blue);
    color: #fff;
    padding-block: clamp(6rem, 11vw, 10rem) var(--section);
    clip-path: polygon(0 0, 78% clamp(2rem, 5vw, 4.5rem), 100% clamp(0.8rem, 2vw, 1.8rem), 100% 100%, 0 100%);
    margin-top: calc(var(--section) * -0.3);
    scroll-margin-top: 2rem;
  }
  .ask-in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.7fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .ask-head {
    position: sticky;
    top: 7rem;
    display: grid;
    gap: 1.2rem;
  }
  .ask-h {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(3rem, 6vw, 6.2rem);
    line-height: 0.97;
    color: #fff;
    margin: 0;
  }
  .ask-h .lt {
    font-weight: 300;
    color: #c9d0f5;
  }
  .ask-head p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgb(255 255 255 / 0.85);
    max-width: 32ch;
  }

  .form {
    display: grid;
    gap: 1.4rem;
  }
  .chips {
    border: 0;
    margin: 0 0 0.4rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chips legend,
  .f > span:first-child {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #c9d0f5;
    margin-bottom: 0.7rem;
    padding: 0;
  }
  .f > span:first-child {
    margin-bottom: 0;
  }
  .chip {
    position: relative;
    cursor: pointer;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }
  .chip span {
    display: inline-block;
    padding: 0.65rem 1.1rem;
    border: 1.5px solid rgb(255 255 255 / 0.45);
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #fff;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .chip:hover span {
    border-color: #fff;
  }
  .chip input:checked + span {
    background: #fff;
    border-color: #fff;
    color: var(--blue);
  }
  .chip input:focus-visible + span {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }
  .row2 {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.4rem;
  }
  .f {
    display: grid;
    gap: 0.45rem;
  }
  input,
  textarea {
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: #fff;
    border: 0;
    border-bottom: 3px solid transparent;
    padding: 0.85rem 0.9rem;
    border-radius: 0;
    width: 100%;
    transition: border-color 0.2s ease;
  }
  input:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--navy);
  }
  .was-validated :invalid:not([type='radio']):not([type='checkbox']) {
    border-bottom-color: #ff9c9c;
  }
  textarea {
    resize: vertical;
  }
  .bottom {
    align-items: end;
  }
  .cq {
    display: grid;
    grid-template-columns: auto minmax(4.5rem, 7rem);
    align-items: center;
    gap: 1rem;
    justify-content: start;
  }
  .cq-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 1.35rem;
    color: #fff;
  }
  .check {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.8rem;
  }
  .check input {
    width: 1.2rem;
    height: 1.2rem;
    margin-top: 0.15rem;
    accent-color: var(--navy);
  }
  .check span {
    font-size: 0.82rem;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.88);
  }
  .check a {
    color: #fff;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
    margin-top: 0.4rem;
  }
  .send {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.05rem 1.8rem;
    border: 0;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 0.25s ease,
      color 0.25s ease;
  }
  .send :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    transition: transform 0.35s var(--ease);
  }
  .send:hover {
    background: #fff;
    color: var(--blue);
  }
  .send:hover :global(svg) {
    transform: translateX(4px);
  }
  .status {
    margin: 0;
    font-size: 0.92rem;
    color: #fff;
  }
  .status.err {
    color: #ffd0d0;
  }

  /* Besuchen und Bewerben */
  .more-in {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 6vw, 6rem);
  }
  .m {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    align-content: start;
  }
  .m-h {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.4rem, 4vw, 4.2rem);
    line-height: 0.97;
    color: var(--blue);
    margin: 0 0 0.4rem;
  }
  .m-h .lt {
    font-weight: 300;
  }
  .m address {
    font-style: normal;
    margin: 0;
  }
  .m .small {
    margin: 0;
    max-width: 40ch;
  }
  .m .small a {
    color: var(--blue);
  }

  @media (max-width: 900px) {
    .direct-in,
    .ask-in,
    .more-in {
      grid-template-columns: minmax(0, 1fr);
    }
    .direct-img,
    .direct-text {
      grid-column: 1 / -1;
    }
    .direct-img {
      margin-inline: 4%;
    }
    .ask-head {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .row2 {
      grid-template-columns: minmax(0, 1fr);
    }
    .tel {
      white-space: normal;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const say = (msg: string, cls = '') => {
    if (!status) return;
    status.textContent = msg;
    status.className = `status ${cls}`;
  };

  /* Sicherheitsfrage: einfache Rechenaufgabe, bei jedem Laden neu */
  const q = form?.querySelector<HTMLElement>('[data-captcha-q]');
  const a = form?.querySelector<HTMLInputElement>('[data-captcha-a]');
  let solution = 7;
  const newTask = () => {
    const x = 2 + Math.floor(Math.random() * 8);
    const y = 1 + Math.floor(Math.random() * 9);
    solution = x + y;
    if (q) q.textContent = `Was ergibt ${x} + ${y}?`;
    if (a) a.value = '';
  };
  newTask();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    form.classList.add('was-validated');
    if (!form.checkValidity()) {
      say('Bitte füllen Sie alle Pflichtfelder (*) aus.', 'err');
      form.querySelector<HTMLElement>(':invalid')?.focus();
      return;
    }
    if (Number(a?.value.trim()) !== solution) {
      say('Die Antwort auf die Sicherheitsfrage stimmt leider nicht. Bitte versuchen Sie es noch einmal.', 'err');
      newTask();
      a?.focus();
      return;
    }
    const data = new FormData(form);
    if (data.get('_gotcha')) return;
    data.delete('sicherheit');
    const endpoint = form.dataset.endpoint;

    if (endpoint) {
      // Versand über einen Formulardienst (z. B. Formspree / Web3Forms), siehe TODO.md
      say('Wird gesendet …');
      try {
        const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        form.classList.remove('was-validated');
        newTask();
        say('Vielen Dank! Ihre Nachricht wurde gesendet. Wir melden uns zeitnah bei Ihnen.', 'ok');
      } catch {
        say('Leider ist ein Fehler aufgetreten. Bitte schreiben Sie uns direkt per E-Mail.', 'err');
      }
      return;
    }

    // Ohne Formulardienst: E-Mail-Programm mit vorbereiteter Nachricht öffnen
    const body = [
      `Name: ${data.get('name')}`,
      data.get('firma') ? `Firma: ${data.get('firma')}` : '',
      `E-Mail: ${data.get('email')}`,
      data.get('telefon') ? `Telefon: ${data.get('telefon')}` : '',
      '',
      String(data.get('nachricht') ?? ''),
    ]
      .filter((l, i) => l !== '' || i === 4)
      .join('\n');
    const subject = `Kontaktanfrage: ${data.get('anliegen')}`;
    window.location.href = `mailto:${form.dataset.mail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    say('Ihr E-Mail-Programm wird geöffnet. Bitte senden Sie die vorbereitete Nachricht dort ab.', 'ok');
  });
</script>
