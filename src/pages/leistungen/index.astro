---
/**
 * Alle Leistungen auf einer Seite: drei Kapitel (Rohbau, Schlüsselfertig, Umbau),
 * jeweils mit Text, Bild, Leistungsumfang und passenden Referenzen.
 * Die früheren Unterseiten /leistungen/<slug>/ leiten auf die Kapitel weiter.
 */
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import Icon from '~/components/Icon.astro';
import { leistungenInhalt } from '~/data/leistungen-inhalt';
import { leistungBild } from '~/data/leistung-bilder';
import { leistungen } from '~/data/site';
import { url } from '~/lib/url';

const hero = (await getEntry('projekte', 'dorfkoppel'))!.data.bilder[0]!;
const alle = await getCollection('projekte');
const sortiert = alle.sort((a, b) => (a.data.highlight ?? 99) - (b.data.highlight ?? 99) || (b.data.jahr ?? 0) - (a.data.jahr ?? 0));

const kapitel = await Promise.all(
  leistungenInhalt.map(async (l) => {
    const [t1, t2] = l.title.includes(' & ') ? [l.title.split(' & ')[0] + ' &', l.title.split(' & ')[1]] : ['', ''];
    return {
      ...l,
      bild: await leistungBild(l.slug, l.slug === 'rohbau' ? 'text' : 'start'),
      // Titel mit weichem Trennzeichen (Schlüssel-fertiges), damit er immer passt
      titel: leistungen.find((x) => x.slug === l.slug)!.title,
      t1,
      t2,
      projekte: sortiert.filter((p) => p.data.bereich === l.slug).slice(0, 3),
    };
  }),
);

const werte = [
  { t: 'Kommunikation', d: 'Wir stehen im ständigen Kontakt mit unseren Auftraggebern. Kommunikation wird bei uns großgeschrieben.' },
  { t: 'Qualität', d: 'Bei uns werden die Arbeiten bis zum Schluss sorgfältig ausgeführt.' },
  { t: 'Flexibilität', d: 'Durch sorgfältiges und flexibles Arbeiten stellen wir unsere Kunden zufrieden.' },
  { t: 'Lösungen', d: 'Auch bei komplizierteren Bauten finden wir gemeinsam einen Weg.' },
];
---

<Base title="Leistungen" description="Rohbau und Stahlbetonbau, schlüsselfertiges Bauen sowie Umbau und Sanierung: die Leistungen der Quirling GmbH in Hamburg.">
  <PageHero
    title="Vom Fundament"
    titleLight="bis zur Übergabe."
    intro="Schwerpunkt ist der Rohbau, speziell Beton- und Stahlbetonbau. Dazu bauen wir schlüsselfertig und führen vielseitige Umbauten und Sanierungen aus."
    image={hero}
    imageAlt="Wohnhaus Dorfkoppel"
    crumbs={[{ label: 'Leistungen' }]}
    size="medium"
  />

  <!-- Sprungmarken zu den drei Kapiteln -->
  <nav class="jump container" aria-label="Leistungen auf dieser Seite">
    {
      kapitel.map((k) => (
        <a class="jump-link" href={`#${k.slug}`}>
          <span set:html={k.titel} />
          <Icon name="arrow-down" />
        </a>
      ))
    }
  </nav>

  {
    kapitel.map((k, i) => (
      <section class:list={['kap', { 'section-tint': i % 2 === 1 }]} id={k.slug}>
        <div class="container">
          <!-- Text und Bild -->
          <div class:list={['kap-top', { flip: i % 2 === 1 }]}>
            <div class="kap-text">
              <h2 class="kap-h">
                {k.t1 ? (
                  <>
                    {k.t1}
                    <br />
                    <span class="lt">{k.t2}</span>
                  </>
                ) : (
                  <Fragment set:html={k.titel} />
                )}
              </h2>
              <p class="lead-c">{k.intro}</p>
              {k.absaetze.map((a) => (
                <p class="small">{a}</p>
              ))}
            </div>
            <div class:list={['para', 'kap-img', { flip: i % 2 === 0 }]}>
              <span class="para-img">
                <Image src={k.bild} alt="" widths={[700, 1100, 1500]} sizes="(min-width: 1024px) 45vw, 100vw" />
              </span>
            </div>
          </div>

          <!-- Leistungsumfang -->
          <div class="kap-umfang">
            <div>
              <h3 class="u-head">{k.umfangTitel[0]} <span class="lt">{k.umfangTitel[1]}</span></h3>
              <p class="small typen">
                <span class="label">Gebäude</span>
                <br />
                {k.gebaeude.join(', ')}
              </p>
            </div>
            <ul class="umfang">
              {k.umfang.map((u) => (
                <li>{u}</li>
              ))}
            </ul>
          </div>

          <!-- Referenzen aus diesem Bereich -->
          {k.projekte.length > 0 && (
            <div class="kap-refs">
              <div class="tiles">
                {k.projekte.map((p) => (
                  <ProjectCard project={p} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
                ))}
              </div>
              <a class="text-link" href={url('/referenzen/')}>
                <span>Alle Referenzen</span>
                <Icon name="arrow" />
              </a>
            </div>
          )}
        </div>
      </section>
    ))
  }

  <section class="section werte-sec">
    <div class="container werte-wrap">
      <div class="werte-head">
        <h2 class="h-sec">So arbeiten<br /><span class="lt">wir.</span></h2>
      </div>
      <div class="werte">
        {
          werte.map((w) => (
            <div class="wert">
              <h3 class="wert-t">{w.t}</h3>
              <p class="small">{w.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  /* Sprungmarken */
  .jump {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    padding-block: clamp(2.5rem, 5vw, 4rem) 0;
  }
  .jump-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: clamp(1.1rem, 2vw, 1.6rem) clamp(1.2rem, 2vw, 1.8rem);
    background: var(--navy);
    color: #fff;
    text-decoration: none;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.25rem, 1.9vw, 1.9rem);
    line-height: 1;
    transition: background 0.3s var(--ease);
  }
  .jump-link :global(svg) {
    flex: none;
    width: 1.3rem;
    height: 1.3rem;
    transition: transform 0.35s var(--ease);
  }
  .jump-link:hover {
    background: var(--blue);
  }
  .jump-link:hover :global(svg) {
    transform: translateY(4px);
  }

  /* Kapitel */
  .kap {
    padding-block: var(--section);
    scroll-margin-top: 1rem;
  }
  .kap-top {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }
  .kap-text {
    grid-column: 1 / 7;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  .kap-img {
    grid-column: 8 / 13;
  }
  .kap-top.flip .kap-text {
    grid-column: 7 / 13;
    order: 2;
  }
  .kap-top.flip .kap-img {
    grid-column: 1 / 6;
  }
  .kap-h {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(3rem, 6vw, 6.2rem);
    line-height: 0.97;
    color: var(--blue);
    margin: 0 0 0.4rem;
    hyphens: manual;
  }
  .lead-c {
    font-size: clamp(1.1rem, 1.35vw, 1.3rem);
    line-height: 1.6;
    color: var(--ink);
    margin: 0;
  }
  .kap-text .small {
    margin: 0;
    max-width: 58ch;
  }

  /* Leistungsumfang */
  .kap-umfang {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    margin-top: clamp(3rem, 6vw, 5rem);
  }
  .u-head {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2rem, 3.2vw, 3.2rem);
    line-height: 0.97;
    color: var(--blue);
    margin: 0;
  }
  .typen {
    margin: 1.4rem 0 0;
  }
  .umfang {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 2.5rem;
  }
  .umfang li {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(1.1rem, 1.4vw, 1.35rem);
    line-height: 1.4;
    color: var(--ink);
  }

  /* Referenzen */
  .kap-refs {
    margin-top: clamp(3rem, 6vw, 5rem);
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  .tiles {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
  }

  /* So arbeiten wir */
  .werte-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .werte {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem) clamp(2rem, 4vw, 4rem);
  }
  .wert-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 0.97;
    color: var(--blue);
    margin: 0 0 0.8rem;
  }
  .wert .small {
    margin: 0;
    max-width: 38ch;
  }

  @media (max-width: 900px) {
    .jump {
      grid-template-columns: minmax(0, 1fr);
    }
    .kap-top,
    .kap-umfang,
    .werte-wrap {
      grid-template-columns: minmax(0, 1fr);
    }
    .kap-text,
    .kap-img,
    .kap-top.flip .kap-text,
    .kap-top.flip .kap-img {
      grid-column: 1 / -1;
      order: 0;
    }
    .kap-img {
      margin-inline: 4%;
    }
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .umfang,
    .tiles,
    .werte {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
