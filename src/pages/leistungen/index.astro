---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import { leistungenInhalt } from '~/data/leistungen-inhalt';
import { leistungBild } from '~/data/leistung-bilder';
import { leistungen } from '~/data/site';
import { url } from '~/lib/url';

const hero = (await getEntry('projekte', 'dorfkoppel'))!.data.bilder[0]!;
const rows = await Promise.all(
  leistungenInhalt.map(async (l) => ({
    ...l,
    bild: await leistungBild(l.slug, 'start'),
    // Titel mit weichem Trennzeichen (Schlüssel-fertiges), damit er in die Spalte passt
    titel: leistungen.find((x) => x.slug === l.slug)!.title,
  })),
);

const werte = [
  { t: 'Kommunikation', d: 'Wir stehen im ständigen Kontakt mit unseren Auftraggebern. Kommunikation wird bei uns großgeschrieben.' },
  { t: 'Qualität', d: 'Bei uns werden die Arbeiten bis zum Schluss sorgfältig ausgeführt.' },
  { t: 'Flexibilität', d: 'Durch sorgfältiges und flexibles Arbeiten stellen wir unsere Kunden zufrieden.' },
  { t: 'Lösungen', d: 'Auch bei komplizierteren Bauten finden wir gemeinsam einen Weg.' },
];
---

<Base title="Leistungen" description="Rohbau und Stahlbetonbau, schlüsselfertiges Bauen sowie Umbau und Sanierung: die Leistungen der Quirling GmbH in Hamburg.">
  <PageHero
    title="Vom Fundament"
    titleLight="bis zur Übergabe."
    intro="Schwerpunkt ist der Rohbau, speziell Beton- und Stahlbetonbau. Dazu bauen wir schlüsselfertig und führen vielseitige Umbauten und Sanierungen aus."
    image={hero}
    imageAlt="Wohnhaus Dorfkoppel"
    crumbs={[{ label: 'Leistungen' }]}
    size="medium"
  />

  <section class="section svc">
    <div class="container rows">
      {
        rows.map((l, i) => (
          <article class:list={['row', { flip: i % 2 === 1 }]}>
            <a class:list={['para', { flip: i % 2 === 1 }]} href={url(`/leistungen/${l.slug}/`)} tabindex="-1" aria-hidden="true">
              <span class="para-img">
                <Image src={l.bild} alt="" widths={[700, 1100, 1500]} sizes="(min-width: 1024px) 55vw, 100vw" />
              </span>
            </a>
            <div class="row-text">
              <h2 class="row-h">
                <a href={url(`/leistungen/${l.slug}/`)} set:html={l.titel} />
              </h2>
              <p class="small">{l.intro}</p>
              <a class="text-link" href={url(`/leistungen/${l.slug}/`)}>
                <span>Mehr erfahren</span>
                <Icon name="arrow" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section-tint">
    <div class="container werte-wrap">
      <div class="werte-head">
        <h2 class="h-sec">So arbeiten<br /><span class="lt">wir.</span></h2>
      </div>
      <div class="werte">
        {
          werte.map((w) => (
            <div class="wert">
              <h3 class="wert-t">{w.t}</h3>
              <p class="small">{w.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .rows {
    display: grid;
    gap: clamp(4.5rem, 9vw, 8rem);
  }
  .row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }
  .row .para {
    grid-column: 1 / 8;
  }
  .row-text {
    grid-column: 8 / 13;
    display: grid;
    justify-items: start;
    gap: 1.1rem;
  }
  .row.flip .para {
    grid-column: 6 / 13;
    order: 2;
  }
  .row.flip .row-text {
    grid-column: 1 / 6;
  }
  .row-h {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 4.4vw, 4.6rem);
    line-height: 0.95;
    color: var(--blue);
    margin: 0;
    hyphens: manual;
  }
  .row-text h2 a {
    color: inherit;
    text-decoration: none;
  }
  .row-text h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
  }
  .row-text .small {
    max-width: 44ch;
    margin: 0 0 0.6rem;
  }

  /* Arbeitsweise */
  .werte-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .werte-head {
    display: grid;
    gap: 1.2rem;
  }
  .werte {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 3.5rem) clamp(2rem, 4vw, 4rem);
  }
  .wert {
    position: relative;
  }
  .wert-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 0.97;
    color: var(--blue);
    margin: 0 0 0.8rem;
  }
  .wert .small {
    margin: 0;
    max-width: 38ch;
  }

  @media (max-width: 900px) {
    .row,
    .werte-wrap {
      grid-template-columns: minmax(0, 1fr);
    }
    .row .para,
    .row .row-text,
    .row.flip .para,
    .row.flip .row-text {
      grid-column: 1 / -1;
      order: 0;
    }
    .row .para {
      margin-inline: 4%;
    }
  }
  @media (max-width: 560px) {
    .werte {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
