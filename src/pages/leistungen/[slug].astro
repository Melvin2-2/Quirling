---
import { Image } from 'astro:assets';
import { getEntry, getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import Icon from '~/components/Icon.astro';
import { leistungenInhalt } from '~/data/leistungen-inhalt';
import { leistungen } from '~/data/site';
import { url } from '~/lib/url';

export function getStaticPaths() {
  return leistungenInhalt.map((l) => ({ params: { slug: l.slug }, props: { l } }));
}
const { l } = Astro.props;
const hero = (await getEntry('projekte', l.heroProjekt))!.data.bilder[0]!;
const bild = (await getEntry('projekte', l.bildProjekt))!.data.bilder[0]!;
const projekte = (await getCollection('projekte', (p) => p.data.bereich === l.slug)).sort(
  (a, b) => (a.data.highlight ?? 99) - (b.data.highlight ?? 99) || (b.data.jahr ?? 0) - (a.data.jahr ?? 0),
);
const andere = leistungen.filter((x) => x.slug !== l.slug);
// Titel im Hero zweizeilig: "Rohbau &" / "Stahlbetonbau"
const [t1, t2] = l.title.includes(' & ') ? [l.title.split(' & ')[0] + ' &', l.title.split(' & ')[1]] : [l.title, undefined];
---

<Base title={l.title} description={l.intro}>
  <PageHero
    title={t1!}
    titleLight={t2}
    intro={l.intro}
    image={hero}
    crumbs={[{ label: 'Leistungen', href: '/leistungen/' }, { label: l.title }]}
    size="medium"
  />

  <!-- Text und Bild -->
  <section class="section">
    <div class="container intro">
      <div class="intro-text">
        <p class="lead-c">{l.absaetze[0]}</p>
        {l.absaetze.slice(1).map((a) => <p class="small">{a}</p>)}
      </div>
      <div class="para flip intro-img">
        <span class="para-img">
          <Image src={bild} alt="" widths={[700, 1100, 1500]} sizes="(min-width: 1024px) 45vw, 100vw" />
        </span>
      </div>
    </div>
  </section>

  <!-- Leistungsumfang -->
  <section class="section section-tint">
    <div class="container umfang-wrap">
      <div class="umfang-head">
        <span class="label">Leistungsumfang</span>
        <h2 class="h-sec">Aus einer<br /><span class="lt">Hand.</span></h2>
        <p class="small typen"><span class="label">Gebäude</span><br />{l.gebaeude.join(', ')}</p>
      </div>
      <ol class="umfang">
        {
          l.umfang.map((u) => (
            <li>
              <span class="u-t">{u}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Referenzen -->
  {
    projekte.length > 0 && (
      <section class="section refs">
        <div class="container refs-head">
          <div>
            <h2 class="h-sec">
              Gebaut
              <br />
              <span class="lt">von uns.</span>
            </h2>
          </div>
          <a class="text-link" href={url('/referenzen/')}>
            <span>Alle Referenzen</span>
            <Icon name="arrow" />
          </a>
        </div>
        <div class="tiles">
          {projekte.slice(0, 6).map((p) => (
            <ProjectCard project={p} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" />
          ))}
        </div>
      </section>
    )
  }

  <!-- Weitere Leistungen -->
  <section class="section tight more-sec">
    <div class="container">
      <span class="label">Weitere Leistungen</span>
      <div class="more">
        {
          andere.map((a) => (
            <a class="more-link" href={url(`/leistungen/${a.slug}/`)}>
              <span class="more-t" set:html={a.title} />
              <Icon name="arrow" />
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
  }
  .intro-text {
    grid-column: 1 / 6;
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  .intro-img {
    grid-column: 7 / 13;
  }
  .lead-c {
    font-size: clamp(1.1rem, 1.35vw, 1.3rem);
    line-height: 1.6;
    color: var(--ink);
    margin: 0;
  }
  .intro-text .small {
    margin: 0;
  }

  .umfang-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .umfang-head {
    display: grid;
    gap: 1.2rem;
    justify-items: start;
  }
  .typen {
    margin: 1rem 0 0;
  }
  .umfang {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.8rem, 3vw, 2.6rem) clamp(2rem, 4vw, 4rem);
  }
  .umfang li {
    position: relative;
    padding-top: 1.2rem;
    display: grid;
    gap: 0.5rem;
  }
  .umfang li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 3rem;
    height: 2px;
    background: var(--blue);
  }
  .u-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 700;
    text-transform: uppercase;
    font-size: clamp(1.3rem, 1.7vw, 1.7rem);
    line-height: 1.05;
    color: var(--ink);
  }

  .refs-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .refs-head > div {
    display: grid;
    gap: 1.2rem;
  }
  .tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    padding-inline: var(--content-left);
  }

  .more-sec {
    padding-top: 0;
  }
  .more {
    margin-top: 1.4rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }
  .more-link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.4rem;
    padding: clamp(1.4rem, 2.5vw, 2.2rem) clamp(1.2rem, 2.5vw, 2.2rem);
    background: var(--navy);
    color: #fff;
    text-decoration: none;
    transition: background 0.3s var(--ease);
  }
  .more-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.4rem, 2.2vw, 2.2rem);
    line-height: 1;
  }
  .more-link :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
    transition: transform 0.35s var(--ease);
  }
  .more-link:hover {
    background: var(--blue);
  }
  .more-link:hover :global(svg) {
    transform: translateX(6px);
  }

  @media (max-width: 900px) {
    .intro,
    .umfang-wrap {
      grid-template-columns: minmax(0, 1fr);
    }
    .intro-text,
    .intro-img {
      grid-column: 1 / -1;
    }
    .intro-img {
      margin-inline: 4%;
    }
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-inline: 6px;
    }
    .more {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .umfang,
    .tiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
