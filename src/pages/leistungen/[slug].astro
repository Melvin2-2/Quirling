---
// Die Leistungen stehen jetzt gemeinsam auf /leistungen/, jede als eigenes Kapitel.
import Redirect from '~/layouts/Redirect.astro';
import { leistungenInhalt } from '~/data/leistungen-inhalt';

export function getStaticPaths() {
  return leistungenInhalt.map((l) => ({ params: { slug: l.slug } }));
}
const { slug } = Astro.params;
---

<Redirect to={`/leistungen/#${slug}`} />
