---
/**
 * Leistungsseite Rohbau & Stahlbetonbau (neuer Aufbau, Vorlage für die beiden anderen Leistungen).
 * Ebenen der Blickführung: große Aussage (h-sec) → Einleitung (lead) → Zwischenüberschrift → Fließtext.
 */
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import { leistungen } from '~/data/site';
import { leistungBild } from '~/data/leistung-bilder';
import { url } from '~/lib/url';
import bewehrung from '~/assets/site/baustelle-bewehrung.jpg';
import schalung from '~/assets/site/handwerk-schalung.jpg';

const hero = await leistungBild('rohbau', 'hero');
const projekte = (await getCollection('projekte', (p) => p.data.bereich === 'rohbau'))
  .sort((a, b) => (a.data.highlight ?? 99) - (b.data.highlight ?? 99) || (b.data.jahr ?? 0) - (a.data.jahr ?? 0))
  .slice(0, 3);
const andere = await Promise.all(
  leistungen
    .filter((x) => x.slug !== 'rohbau')
    .map(async (x) => ({ ...x, bild: await leistungBild(x.slug, 'start') })),
);

// Was wir im Rohbau selbst ausführen
const umfang = [
  { t: 'Gründung und Bodenplatten', d: 'Streifen- und Einzelfundamente, Bodenplatten und Gründungen nach Statik.' },
  { t: 'Tiefgaragen und Keller', d: 'Untergeschosse und Tiefgaragen, auf Wunsch als Weiße Wanne in WU-Beton.' },
  { t: 'Wände, Stützen, Decken', d: 'Tragwerk in Ortbeton, geschalt mit unserer eigenen Systemschalung.' },
  { t: 'Sichtbeton', d: 'Betonflächen, die sichtbar bleiben, mit sauberer Schalung und klaren Kanten.' },
  { t: 'Bewehrung', d: 'Bewehrung nach Plan, sorgfältig verlegt, bevor betoniert wird.' },
  { t: 'Halbfertigteile', d: 'Elementdecken und Doppelwände, wo sie Bauzeit sparen.' },
  { t: 'Mauerwerk', d: 'Tragende und nichttragende Wände im Zusammenspiel mit dem Betonbau.' },
  { t: 'Grundleitungen und Erdarbeiten', d: 'Grundleitungen unter der Bodenplatte und kleinere Erdarbeiten.' },
];

// Was uns im Rohbau ausmacht
const eigen = [
  { t: 'Eigene Poliere', d: 'Auf jeder Baustelle führt ein Polier aus unserem Team. Sie haben einen festen Ansprechpartner, der Ihr Projekt kennt.' },
  { t: 'Eigene Systemschalung', d: 'Wir schalen mit eigenem Material. Das macht uns unabhängig und hält den Zeitplan stabil.' },
  { t: 'Eigener Bauhof', d: 'Lager, Werkstatt und Fuhrpark: Material und Gerät sind da, wenn die Baustelle sie braucht.' },
];

// Warum Quirling im Rohbau: drei Aussagen statt Zahlen
const usp = [
  { t: 'Der ganze Rohbau aus einer Hand', d: 'Gründung, Tragwerk und Mauerwerk liegen bei uns. Keine Schnittstellen zu weiteren Firmen, ein Ansprechpartner für alles.' },
  { t: 'Termine, die halten', d: 'Wir planen den Ablauf realistisch und sagen früh, wenn etwas klemmt. Darauf können sich Bauherr und Folgegewerke verlassen.' },
  { t: 'Ein Partner für Ihre Planer', d: 'Mit Architekten und Tragwerksplanern klären wir Details, bevor sie auf der Baustelle zum Problem werden.' },
];
---

<Base
  title="Rohbau & Stahlbetonbau"
  description="Rohbau in Beton und Stahlbeton in der Metropolregion Hamburg: Gründungen, Tiefgaragen, Wände, Stützen und Decken in Ortbeton. Mit eigenen Polieren, eigener Schalung und eigenem Bauhof."
>
  <PageHero
    title="Rohbau &"
    titleLight="Stahlbetonbau"
    intro="Der Rohbau ist unser Handwerk. Seit 1992 schalen, bewehren und betonieren wir in der Metropolregion Hamburg. Solide, sauber und termingerecht."
    image={hero}
    crumbs={[{ label: 'Leistungen', href: '/#leistungen' }, { label: 'Rohbau & Stahlbetonbau' }]}
    size="medium"
  />

  <!-- 1. Einstieg: Aussage und Text links, Foto randlos rechts über die volle Höhe -->
  <section class="rb-intro">
    <div class="rb-intro-img">
      <Image src={bewehrung} alt="Bewehrung auf einer Baustelle der Quirling GmbH" widths={[700, 1100, 1600]} sizes="(min-width: 900px) 46vw, 100vw" />
    </div>
    <div class="container rb-grid">
      <div class="rb-intro-text">
        <h2 class="h-sec">Massiv gebaut.<br /><span class="lt">Von Grund auf.</span></h2>
        <p class="rb-lead">
          Rohbau ist für uns kein Nebengeschäft, sondern seit 1992 unser Kern. Wir bauen Wohnanlagen, Mehrfamilienhäuser mit Tiefgarage sowie Büro- und
          Lagergebäude in Beton und Stahlbeton, für Bauträger, Projektentwickler und private Bauherren.
        </p>
        <ul class="rb-usp">
          {
            usp.map((u) => (
              <li>
                <h3 class="rb-h">{u.t}</h3>
                <p>{u.d}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 2. Leistungsumfang: hellblaue Fläche mit Knick -->
  <section class="rb-scope">
    <div class="container">
      <div class="rb-scope-head">
        <h2 class="h-sec">Was wir<br /><span class="lt">für Sie bauen.</span></h2>
      </div>
      <ul class="rb-list">
        {
          umfang.map((u) => (
            <li>
              <h3 class="rb-h">{u.t}</h3>
              <p>{u.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Was uns ausmacht: Navy, Foto randlos links -->
  <section class="rb-own on-dark">
    <div class="rb-own-img">
      <Image src={schalung} alt="Systemschalung mit Quirling-Logo auf einer Baustelle" widths={[700, 1100, 1600]} sizes="(min-width: 900px) 44vw, 100vw" />
    </div>
    <div class="container rb-grid">
      <div class="rb-own-text">
        <h2 class="h-sec">Eigene Leute.<br /><span class="lt">Eigenes Gerät.</span></h2>
        <ul class="rb-own-list">
          {
            eigen.map((e) => (
              <li>
                <h3 class="rb-h">{e.t}</h3>
                <p>{e.d}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 4. Referenzen -->
  <section class="section rb-refs">
    <div class="container">
      <div class="rb-refs-head">
        <h2 class="h-sec">Gebaut<br /><span class="lt">von uns.</span></h2>
        <a class="text-link" href={url('/referenzen/?leistung=rohbau')}><span>Alle Rohbau-Referenzen</span><Icon name="arrow" /></a>
      </div>
      <ul class="rb-tiles">
        {
          projekte.map((p) => (
            <li>
              <a class="rb-tile" href={url(`/referenzen/?p=${p.id}`)}>
                <span class="rb-tile-img">
                  <Image src={p.data.bilder[0]!} alt="" widths={[500, 800, 1200]} sizes="(min-width: 900px) 33vw, 100vw" />
                </span>
                <span class="rb-tile-t">{p.data.title}</span>
                <span class="rb-tile-d">{p.data.leistung}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. Weitere Leistungen und Anfrage -->
  <section class="rb-more">
    <div class="container">
      <div class="rb-cta">
        <p class="rb-cta-t">Sie planen einen Rohbau<br />in der Metropolregion Hamburg?</p>
        <a class="rb-btn" href={url('/kontakt/')}><span>Rohbau anfragen</span><Icon name="arrow" /></a>
      </div>
      <h2 class="rb-more-h">Auch das bauen wir.</h2>
      <div class="rb-cards">
        {
          andere.map((a) => (
            <a class="rb-card" href={url(`/leistungen/${a.slug}/`)}>
              <span class="rb-card-img">
                <Image src={a.bild} alt="" widths={[600, 900, 1300]} sizes="(min-width: 900px) 50vw, 100vw" />
              </span>
              <span class="rb-card-body">
                <span class="rb-card-t" set:html={a.title} />
                <span class="rb-card-d">{a.kurz}</span>
                <span class="rb-card-more" aria-hidden="true"><Icon name="arrow" /></span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .rb-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(2rem, 4vw, 4rem);
    width: 100%;
  }
  /* Einleitung unter der großen Aussage */
  .rb-lead {
    margin: 0;
    max-width: 38ch;
    font-size: clamp(1.3rem, 1.75vw, 1.6rem);
    font-weight: 300;
    line-height: 1.45;
    color: var(--navy);
  }
  /* Zwischenüberschrift */
  .rb-h {
    margin: 0 0 0.45rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.3rem, 1.6vw, 1.55rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--blue);
  }

  /* ---------- 1. Einstieg ---------- */
  /* Seitenkopf liegt über dem Einstieg, damit das Foto in seinen Knick hineinreicht */
  :global(.phero) {
    position: relative;
    z-index: 2;
    /* Knick als echter Zuschnitt statt heller Fläche, damit das Foto darunter durchscheint */
    clip-path: polygon(0 0, 100% 0, 100% 94%, 78% 100%, 0 90%);
  }
  :global(.phero-cut) {
    display: none;
  }
  .rb-intro {
    position: relative;
    z-index: 0;
    overflow-x: clip;
    padding-block: clamp(4.5rem, 7vw, 6rem) clamp(4rem, 6vw, 5rem);
  }
  /* Foto reicht oben unter den Knick des Seitenkopfs und unten unter den Knick der nächsten Fläche */
  .rb-intro-img {
    position: absolute;
    top: -6rem;
    bottom: calc(clamp(2rem, 4vw, 3.5rem) * -1);
    right: 0;
    width: 44%;
    clip-path: polygon(16% 0, 100% 0, 100% 100%, 0 100%);
  }
  .rb-intro-img :global(img),
  .rb-own-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rb-intro-text {
    grid-column: 1 / 7;
    display: grid;
    gap: 1.4rem;
    justify-items: start;
  }
  .rb-usp {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.4rem;
    max-width: 46ch;
  }
  .rb-usp p {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* ---------- 2. Leistungsumfang ---------- */
  .rb-scope {
    position: relative;
    z-index: 1;
    background: #e6e9f6;
    padding-block: clamp(6rem, 10vw, 8.5rem) calc(clamp(5rem, 8vw, 7rem) + clamp(2rem, 4vw, 3.5rem));
    clip-path: polygon(0 clamp(0.8rem, 1.6vw, 1.4rem), 22% clamp(2rem, 4vw, 3.5rem), 100% 0, 100% 100%, 0 100%);
  }
  .rb-scope-head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1.5rem clamp(2rem, 4vw, 4rem);
    align-items: end;
    margin-bottom: clamp(3rem, 5vw, 4.5rem);
  }
  .rb-scope-head .h-sec {
    grid-column: 1 / 7;
  }
  .rb-scope-head .rb-lead {
    grid-column: 7 / 13;
  }
  .rb-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(2.2rem, 3.6vw, 3.2rem) clamp(1.6rem, 2.6vw, 2.6rem);
  }
  .rb-list p,
  .rb-own-list p {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 300;
    line-height: 1.55;
    color: var(--ink-2);
  }

  /* ---------- 3. Eigene Leute, eigenes Gerät ---------- */
  .rb-own {
    position: relative;
    overflow-x: clip;
    z-index: 1;
    min-height: min(88svh, 820px);
    display: flex;
    align-items: center;
    background: var(--navy);
    color: #fff;
    padding-block: clamp(6rem, 10vw, 8rem);
    clip-path: polygon(
      0 0,
      78% clamp(2rem, 4vw, 3.5rem),
      100% clamp(0.8rem, 1.6vw, 1.4rem),
      100% calc(100% - clamp(2rem, 4vw, 3.5rem)),
      22% 100%,
      0 calc(100% - clamp(0.8rem, 1.6vw, 1.4rem))
    );
    /* greift in die hellblaue Fläche darüber, damit im Knick kein heller Spalt entsteht */
    margin-top: calc(clamp(2rem, 4vw, 3.5rem) * -1);
  }
  .rb-own-img {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 44%;
    clip-path: polygon(0 0, 100% 0, 84% 100%, 0 100%);
  }
  .rb-own-text {
    grid-column: 7 / 13;
    display: grid;
    gap: clamp(2rem, 3.6vw, 2.8rem);
  }
  .rb-own-text .h-sec {
    color: #fff;
  }
  .rb-own-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1.8rem, 3vw, 2.4rem);
  }
  .rb-own .rb-h {
    margin-bottom: 0.55rem;
    font-size: clamp(1.8rem, 2.6vw, 2.5rem);
    line-height: 0.95;
    color: #9aa6ee;
  }
  .rb-own-list p {
    max-width: 44ch;
    color: rgb(255 255 255 / 0.85);
  }

  /* ---------- 4. Referenzen ---------- */
  .rb-refs-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }
  .rb-tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem 10px;
  }
  .rb-tile {
    display: grid;
    gap: 0.4rem;
    color: var(--navy);
    text-decoration: none;
  }
  .rb-tile-img {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: 0.4rem;
    background: var(--stone-200);
  }
  .rb-tile-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .rb-tile:hover .rb-tile-img :global(img) {
    transform: scale(1.04);
  }
  .rb-tile-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.15rem, 1.4vw, 1.35rem);
    line-height: 1;
    text-transform: uppercase;
    transition: color 0.25s ease;
  }
  .rb-tile:hover .rb-tile-t {
    color: var(--blue);
  }
  .rb-tile-d {
    font-size: 0.98rem;
    font-weight: 300;
    line-height: 1.45;
    color: var(--ink-2);
  }

  /* ---------- 5. Weitere Leistungen und Anfrage ---------- */
  .rb-more {
    background: #e6e9f6;
    padding-block: clamp(6rem, 10vw, 8rem) calc(clamp(4rem, 7vw, 6rem) + clamp(1.6rem, 3.2vw, 3rem));
    clip-path: polygon(0 clamp(0.8rem, 1.6vw, 1.4rem), 22% clamp(2rem, 4vw, 3.5rem), 100% 0, 100% 100%, 0 100%);
  }
  .rb-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    padding-bottom: clamp(3rem, 5vw, 4rem);
  }
  .rb-cta-t {
    margin: 0;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(2rem, 3.6vw, 3.6rem);
    line-height: 0.92;
    text-transform: uppercase;
    color: var(--blue);
  }
  .rb-btn {
    display: inline-flex;
    align-items: center;
    gap: 1.1rem;
    height: clamp(2.8rem, 4vw, 3.8rem);
    padding: 0.1rem clamp(1.3rem, 2vw, 1.8rem) 0;
    background: var(--blue);
    color: #fff;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.25rem, 1.7vw, 1.7rem);
    letter-spacing: 0.02em;
    line-height: 1;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.25s ease;
  }
  .rb-btn :global(svg) {
    width: 1.3em;
    height: 1.3em;
    transition: transform 0.35s var(--ease);
  }
  .rb-btn:hover {
    background: var(--navy);
  }
  .rb-btn:hover :global(svg) {
    transform: translateX(4px);
  }
  .rb-more-h {
    margin: 0 0 1.4rem;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.4rem, 1.8vw, 1.8rem);
    text-transform: uppercase;
    color: var(--navy);
  }
  .rb-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .rb-card {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    background: #fff;
    color: var(--navy);
    text-decoration: none;
    min-height: 15rem;
  }
  .rb-card-img {
    overflow: hidden;
    clip-path: polygon(0 0, 100% 0, 86% 100%, 0 100%);
  }
  .rb-card-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .rb-card:hover .rb-card-img :global(img) {
    transform: scale(1.05);
  }
  .rb-card-body {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: clamp(1.4rem, 2.4vw, 2rem);
  }
  .rb-card-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(1.5rem, 2.1vw, 2.1rem);
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--blue);
  }
  .rb-card-d {
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink-2);
  }
  .rb-card-more {
    position: relative;
    width: 2.2rem;
    height: 2.2rem;
    margin-top: 0.4rem;
    display: grid;
    place-items: center;
    color: var(--blue);
  }
  .rb-card-more::before {
    content: '';
    position: absolute;
    inset: 0.35rem;
    border: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition:
      transform 0.4s var(--ease),
      background 0.3s ease;
  }
  .rb-card-more :global(svg) {
    position: relative;
    width: 0.95rem;
    height: 0.95rem;
  }
  .rb-card:hover .rb-card-more {
    color: #fff;
  }
  .rb-card:hover .rb-card-more::before {
    background: var(--blue);
    transform: rotate(135deg);
  }

  @media (max-width: 1100px) {
    .rb-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .rb-cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 900px) {
    :global(.phero) {
      clip-path: polygon(0 0, 100% 0, 100% 97%, 78% 100%, 0 95%);
    }
    .rb-own {
      display: block;
      min-height: 0;
      padding-top: 0;
    }
    .rb-intro {
      padding-top: 0;
    }
    /* Foto schließt mobil direkt an den Knick des Seitenkopfs an */
    .rb-intro-img {
      margin-top: -1.8rem;
    }
    .rb-intro {
      padding-bottom: clamp(4rem, 10vw, 5rem);
    }
    .rb-intro-img,
    .rb-own-img {
      position: relative;
      top: auto;
      bottom: auto;
      width: auto;
      aspect-ratio: 4 / 3;
      margin-bottom: 2.6rem;
      clip-path: polygon(0 0, 100% 0, 100% 92%, 0 100%);
    }
    .rb-own {
      clip-path: polygon(0 0, 100% 0, 100% calc(100% - 1.6rem), 22% 100%, 0 calc(100% - 0.6rem));
      margin-top: 0;
    }
    .rb-intro-text,
    .rb-own-text,
    .rb-scope-head .h-sec,
    .rb-scope-head .rb-lead {
      grid-column: 1 / -1;
    }
    .rb-tiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 560px) {
    .rb-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .rb-card {
      grid-template-columns: minmax(0, 1fr);
    }
    .rb-card-img {
      aspect-ratio: 16 / 9;
      clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%);
    }
  }
</style>
