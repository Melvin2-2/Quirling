---
import Base from '~/layouts/Base.astro';
import PageHero from '~/components/PageHero.astro';
import Icon from '~/components/Icon.astro';
import { firma } from '~/data/site';
import { url } from '~/lib/url';
import hero from '~/assets/team/kontakt-ivonne-michaela.jpg';

const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
---

<Base title="Kontakt" description="Kontakt zur Quirling GmbH Bauunternehmen, Tilsiter Straße 174, 22047 Hamburg. Telefon 040 / 33 46 34 19 0, info@quirling.de.">
  <PageHero
    title="Sprechen"
    titleLight="wir."
    intro="Wir sind montags bis freitags für Sie da und freuen uns auf Ihr Vorhaben. Am schnellsten erreichen Sie uns telefonisch."
    image={hero}
    imageAlt="Ivonne Quirling und Michaela Venghaus aus dem Büro der Quirling GmbH"
    size="medium"
    imagePosition="75% 12%"
    crumbs={[{ label: 'Kontakt' }]}
  />

  <section class="section">
    <div class="container contact">
      <div class="info">
        <div class="block">
          <h2 class="b-t">Anrufen</h2>
          <a class="big" href={firma.telefonHref}>{firma.telefon}</a>
          <p>Montags bis freitags. Wir rufen auch gerne zurück.</p>
        </div>
        <div class="block">
          <h2 class="b-t">Schreiben</h2>
          <a class="mail" href={`mailto:${firma.email}`}>{firma.email}</a>
        </div>
        <div class="block">
          <h2 class="b-t">Besuchen</h2>
          <address>
            {firma.langname}<br />
            {firma.strasse}<br />
            {`${firma.plz} ${firma.ort}`}
          </address>
          <a class="text-link" href={firma.mapsUrl} target="_blank" rel="noopener"><span>Route planen</span><Icon name="arrow" /></a>
        </div>
        <div class="block">
          <h2 class="b-t">Bewerben</h2>
          <p>Bewerbungen gerne per E-Mail an <a href={`mailto:${firma.email}`}>{firma.email}</a> oder persönlich bei uns im Büro.</p>
        </div>
      </div>

      <div class="form-wrap">
        <form class="form on-blue" data-form data-endpoint={endpoint} data-mail={firma.email} novalidate>
          <h2 class="form-h">Ihre<br /><span class="lt">Anfrage.</span></h2>
          <p class="form-intro">Erzählen Sie uns kurz von Ihrem Vorhaben. Wir melden uns zeitnah bei Ihnen.</p>
          <div class="row2">
            <label>
              <span>Name *</span>
              <input name="name" required autocomplete="name" />
            </label>
            <label>
              <span>Firma</span>
              <input name="firma" autocomplete="organization" />
            </label>
          </div>
          <div class="row2">
            <label>
              <span>E-Mail *</span>
              <input name="email" type="email" required autocomplete="email" />
            </label>
            <label>
              <span>Telefon</span>
              <input name="telefon" type="tel" autocomplete="tel" />
            </label>
          </div>
          <label>
            <span>Ihr Anliegen</span>
            <select name="anliegen">
              <option>Anfrage zu einem Bauvorhaben</option>
              <option>Rohbau &amp; Stahlbetonbau</option>
              <option>Schlüsselfertiges Bauen</option>
              <option>Umbau &amp; Sanierung</option>
              <option>Bewerbung</option>
              <option>Sonstiges</option>
            </select>
          </label>
          <label>
            <span>Nachricht *</span>
            <textarea name="nachricht" rows="6" required></textarea>
          </label>
          <!-- Sicherheitsfrage gegen Spam: Aufgabe wird beim Laden neu gewürfelt -->
          <label class="captcha">
            <span>Sicherheitsfrage *</span>
            <span class="cq">
              <span class="cq-t" data-captcha-q>Was ergibt 3 + 4?</span>
              <input name="sicherheit" inputmode="numeric" required autocomplete="off" data-captcha-a />
            </span>
          </label>
          <label class="check">
            <input type="checkbox" name="datenschutz" required />
            <span>Ich habe die <a href={url('/datenschutz/')}>Datenschutzerklärung</a> gelesen und bin mit der Verarbeitung meiner Angaben zur Beantwortung meiner Anfrage einverstanden. *</span>
          </label>
          <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <div class="submit">
            <button class="send" type="submit"><span>Nachricht senden</span><Icon name="arrow" /></button>
            <p class="status" data-status role="status" aria-live="polite"></p>
          </div>
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }
  .info {
    display: grid;
    gap: clamp(2rem, 3.5vw, 2.8rem);
    padding-top: 0.5rem;
  }
  .b-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 2.2vw, 2.1rem);
    line-height: 1;
    color: var(--ink);
    margin: 0 0 0.7rem;
  }
  .block p {
    font-size: 0.92rem;
    line-height: 1.65;
    color: var(--ink-2);
    margin: 0;
    max-width: 36ch;
  }
  .block p a {
    color: var(--blue);
  }
  address {
    font-style: normal;
    margin-bottom: 0.9rem;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--ink-2);
  }
  .big {
    display: block;
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    font-size: clamp(2.2rem, 3.4vw, 3.2rem);
    line-height: 1;
    color: var(--blue);
    text-decoration: none;
    margin-bottom: 0.6rem;
  }
  .mail {
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--blue);
    text-decoration: none;
  }
  .big:hover,
  .mail:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Formular: blaue Fläche mit Navy-Block wie bei den Bildern */
  .form-wrap {
    position: relative;
  }
  .form-wrap::before {
    content: '';
    position: absolute;
    right: -3%;
    top: 12%;
    bottom: -4%;
    width: 34%;
    background: var(--navy);
    clip-path: polygon(40% 0, 100% 0, 88% 100%, 0 100%);
  }
  .form {
    position: relative;
    background: var(--blue);
    color: #fff;
    padding: clamp(1.75rem, 4vw, 3.5rem);
    display: grid;
    gap: 1.3rem;
  }
  .form-h {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 4.4vw, 4.4rem);
    line-height: 0.94;
    color: #fff;
    margin: 0;
  }
  .form-h .lt {
    font-weight: 300;
  }
  .form-intro {
    margin: -0.2rem 0 0.6rem;
    font-size: 0.95rem;
    color: rgb(255 255 255 / 0.85);
  }
  .row2 {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.3rem;
  }
  label {
    display: grid;
    gap: 0.45rem;
  }
  label > span:first-child {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #c9d0f5;
  }
  input,
  select,
  textarea {
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: #fff;
    border: 0;
    border-bottom: 3px solid transparent;
    padding: 0.85rem 0.9rem;
    border-radius: 0;
    width: 100%;
    transition: border-color 0.2s ease;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-bottom-color: var(--navy);
  }
  .form :focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .was-validated :invalid {
    border-bottom-color: #ff8a8a;
  }
  textarea {
    resize: vertical;
  }
  .cq {
    display: grid;
    grid-template-columns: auto 8rem;
    align-items: center;
    gap: 1.2rem;
    justify-content: start;
  }
  .cq-t {
    font-family: var(--font-head);
    font-stretch: 68%;
    font-weight: 700;
    text-transform: uppercase;
    font-size: 1.35rem;
    color: #fff;
  }
  .check {
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.8rem;
  }
  .check input {
    width: 1.2rem;
    height: 1.2rem;
    margin-top: 0.15rem;
    accent-color: var(--navy);
  }
  .check span {
    font-size: 0.86rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.88);
  }
  .check a {
    color: #fff;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
    margin-top: 0.4rem;
  }
  .send {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.95rem 1.6rem;
    border: 0;
    background: var(--navy);
    color: #fff;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background 0.25s ease,
      color 0.25s ease;
  }
  .send :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
    transition: transform 0.35s var(--ease);
  }
  .send:hover {
    background: #fff;
    color: var(--blue);
  }
  .send:hover :global(svg) {
    transform: translateX(4px);
  }
  .status {
    margin: 0;
    font-size: 0.92rem;
    color: #fff;
  }
  .status.err {
    color: #ffd0d0;
  }
  @media (max-width: 900px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }
    .form-wrap::before {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .row2 {
      grid-template-columns: minmax(0, 1fr);
    }
    .form {
      margin-inline: calc(var(--gutter) * -1);
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const say = (msg: string, cls = '') => {
    if (!status) return;
    status.textContent = msg;
    status.className = `status ${cls}`;
  };

  /* Sicherheitsfrage: einfache Rechenaufgabe, bei jedem Laden neu */
  const q = form?.querySelector<HTMLElement>('[data-captcha-q]');
  const a = form?.querySelector<HTMLInputElement>('[data-captcha-a]');
  let solution = 7;
  const newTask = () => {
    const x = 2 + Math.floor(Math.random() * 8);
    const y = 1 + Math.floor(Math.random() * 9);
    solution = x + y;
    if (q) q.textContent = `Was ergibt ${x} + ${y}?`;
    if (a) a.value = '';
  };
  newTask();

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    form.classList.add('was-validated');
    if (!form.checkValidity()) {
      say('Bitte füllen Sie alle Pflichtfelder (*) aus.', 'err');
      form.querySelector<HTMLElement>(':invalid')?.focus();
      return;
    }
    if (Number(a?.value.trim()) !== solution) {
      say('Die Antwort auf die Sicherheitsfrage stimmt leider nicht. Bitte versuchen Sie es noch einmal.', 'err');
      newTask();
      a?.focus();
      return;
    }
    const data = new FormData(form);
    if (data.get('_gotcha')) return;
    data.delete('sicherheit');
    const endpoint = form.dataset.endpoint;

    if (endpoint) {
      // Versand über einen Formulardienst (z. B. Formspree / Web3Forms), siehe TODO.md
      say('Wird gesendet …');
      try {
        const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        form.classList.remove('was-validated');
        newTask();
        say('Vielen Dank! Ihre Nachricht wurde gesendet. Wir melden uns zeitnah bei Ihnen.', 'ok');
      } catch {
        say('Leider ist ein Fehler aufgetreten. Bitte schreiben Sie uns direkt per E-Mail.', 'err');
      }
      return;
    }

    // Ohne Formulardienst: E-Mail-Programm mit vorbereiteter Nachricht öffnen
    const body = [
      `Name: ${data.get('name')}`,
      data.get('firma') ? `Firma: ${data.get('firma')}` : '',
      `E-Mail: ${data.get('email')}`,
      data.get('telefon') ? `Telefon: ${data.get('telefon')}` : '',
      '',
      String(data.get('nachricht') ?? ''),
    ]
      .filter((l, i) => l !== '' || i === 4)
      .join('\n');
    const subject = `Kontaktanfrage: ${data.get('anliegen')}`;
    window.location.href = `mailto:${form.dataset.mail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    say('Ihr E-Mail-Programm wird geöffnet. Bitte senden Sie die vorbereitete Nachricht dort ab.', 'ok');
  });
</script>
