---
/**
 * ENTWURF (gesichert am 06.11.2026): Werte-Bereich „Familienbetrieb.“ mit Rauten um die
 * Piktogramme und waagrechten Trennlinien zwischen den Werten.
 * Wird nicht gebaut (liegt außerhalb von src/). Zum Wiederverwenden Markup und Styles
 * in src/pages/index.astro einsetzen. Benötigt: ValueIcon, werte-Array, Rail-Logik im Skript.
 */
---

  <!-- ======================= WERTE ======================= -->
  <section class="values on-blue" data-values>
    <span class="rail rail-values" aria-hidden="true"><span data-values-bar></span></span>
    <div class="container values-grid">
      <div class="values-head">
        <h2 class="values-h">Familien&shy;betrieb.</h2>
        <p class="values-core">Hinter jedem Bauvorhaben steht die Familie Quirling. Mit Namen und Handschlag.</p>
      </div>
      <ul class="values-list">
        {
          werte.map((w) => (
            <li class="value" data-follow data-to-rail>
              <ValueIcon name={w.icon} class="value-icon" />
              <div>
                <h3>{w.t}</h3>
                <p>{w.d}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>


<style>
  /* ======================= WERTE ======================= */
  .values {
    position: relative;
    z-index: 2;
    padding-block: clamp(5rem, 9vw, 8rem);
  }
  .values-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }
  .values-h {
    font-family: var(--font-head);
    font-stretch: 125%;
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 5.2vw, 5.4rem);
    line-height: 0.95;
    hyphens: manual;
    margin-bottom: 1.6rem;
  }
  .values-core {
    font-family: var(--font-head);
    font-stretch: 112%;
    font-weight: 300;
    font-size: clamp(1rem, 1.25vw, 1.2rem);
    line-height: 1.4;
    max-width: 24rem;
    color: #fff !important;
    margin: 0;
  }
  .values-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .value {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-block: clamp(1.25rem, 2.4vw, 2rem);
  }
  /* Abzweig von der Randlinie: zeichnet sich von rechts zur Zeile */
  .value::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: calc(-1 * var(--to-rail, 0px));
    height: 1.5px;
    background: rgb(255 255 255 / 0.55);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.7s var(--ease);
  }
  .value.is-in::before {
    transform: scaleX(1);
  }
  .value > :global(*) {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.6s ease 0.45s,
      transform 0.6s var(--ease) 0.45s;
  }
  .value.is-in > :global(*) {
    opacity: 1;
    transform: none;
  }
  .values[data-values] .value[data-follow] {
    opacity: 1;
    transform: none;
  }
  .value :global(.value-icon) {
    flex: none;
    color: #fff;
    --vicon-bg: #3948a4;
  }
  .value h3 {
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(1.4rem, 2.2vw, 2rem);
    text-transform: uppercase;
    line-height: 1;
    margin-bottom: 0.45rem;
  }
  .value p {
    font-size: 0.92rem;
    color: rgb(255 255 255 / 0.82);
    margin: 0;
  }

</style>
