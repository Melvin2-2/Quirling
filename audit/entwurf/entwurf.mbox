new file mode 100644
index 0000000..5691e52
--- /dev/null
+++ b/src/pages/referenzen/[id].astro
@@ -0,0 +1,222 @@
+---
+/** Eigene Seite je Referenzprojekt (Audit REF-01): auffindbar per Suche, teilbar per Link. */
+import { Image } from 'astro:assets';
+import { getCollection, type CollectionEntry } from 'astro:content';
+import Base from '~/layouts/Base.astro';
+import PageHero from '~/components/PageHero.astro';
+import Icon from '~/components/Icon.astro';
+import { leistungen } from '~/data/site';
+import { url } from '~/lib/url';
+
+export async function getStaticPaths() {
+  const projekte = await getCollection('projekte');
+  return projekte.map((p) => ({ params: { id: p.id }, props: { p } }));
+}
+interface Props {
+  p: CollectionEntry<'projekte'>;
+}
+const { p } = Astro.props;
+const d = p.data;
+const bereich = leistungen.find((l) => l.slug === d.bereich);
+const bereichName = bereich?.title.replace('­', '') ?? '';
+const ort = d.fakten.find((f) => f.label === 'Adresse')?.value.split('\n').pop()?.replace(/^\d{5}\s*/, '') ?? 'Hamburg';
+const beschreibung = `${d.title}: ${d.leistung}. ${bereichName} in ${ort}${d.jahr ? `, fertiggestellt ${d.jahr}` : ''}. Referenz der Quirling GmbH.`;
+const weitere = (await getCollection('projekte', (x) => x.data.bereich === d.bereich && x.id !== p.id)).slice(0, 3);
+---
+
+<Base title={`${d.title}: ${bereichName} in ${ort}`} description={beschreibung}>
+  <PageHero
+    title={d.title}
+    intro={d.leistung}
+    image={d.bilder[0]}
+    imageAlt={`${d.title}, ${d.leistung}`}
+    crumbs={[{ label: 'Referenzen', href: '/referenzen/' }, { label: d.title }]}
+    size="medium"
+  />
+
+  <section class="pj">
+    <div class="container pj-grid">
+      <dl class="pj-facts">
+        <div>
+          <dt>Leistungsbereich</dt>
+          <dd><a href={url(`/leistungen/${d.bereich}/`)}>{bereichName}</a></dd>
+        </div>
+        <div>
+          <dt>Gebäudeart</dt>
+          <dd>{d.kategorien.join(', ')}</dd>
+        </div>
+        {
+          d.fakten.map((f) => (
+            <div>
+              <dt>{f.label}</dt>
+              <dd set:html={f.value.replace(/\n/g, '<br />')} />
+            </div>
+          ))
+        }
+      </dl>
+      <div class="pj-gal">
+        {
+          d.bilder.map((b, i) => (
+            <Image src={b} alt={`${d.title}, Ansicht ${i + 1}`} widths={[600, 1000, 1600]} sizes={i === 0 ? '(min-width: 900px) 62vw, 100vw' : '(min-width: 900px) 31vw, 100vw'} loading={i < 2 ? 'eager' : 'lazy'} />
+          ))
+        }
+      </div>
+    </div>
+  </section>
+
+  <section class="pj-more">
+    <div class="container">
+      <div class="pj-cta">
+        <p>Ähnliches Vorhaben geplant?</p>
+        <a class="pill solid" href={url('/kontakt/')}><span>Projekt anfragen</span><Icon name="arrow" /></a>
+      </div>
+      {
+        weitere.length > 0 && (
+          <>
+            <h2 class="pj-h">Weitere Projekte: {bereichName}</h2>
+            <ul class="pj-tiles">
+              {weitere.map((w) => (
+                <li>
+                  <a href={url(`/referenzen/${w.id}/`)}>
+                    <Image src={w.data.bilder[0]!} alt="" widths={[500, 800]} sizes="(min-width: 900px) 30vw, 100vw" />
+                    <span>{w.data.title}</span>
+                  </a>
+                </li>
+              ))}
+            </ul>
+          </>
+        )
+      }
+      <a class="pj-back" href={url('/referenzen/')}><Icon name="arrow" class="flip" /><span>Alle Referenzen</span></a>
+    </div>
+  </section>
+</Base>
+
+<style>
+  .pj {
+    padding-block: clamp(3rem, 7vw, 6rem);
+  }
+  .pj-grid {
+    display: grid;
+    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
+    gap: clamp(2rem, 4vw, 4rem);
+    align-items: start;
+  }
+  .pj-facts {
+    margin: 0;
+    display: grid;
+    gap: 1.2rem;
+    position: sticky;
+    top: calc(var(--header-h) + 1.5rem);
+  }
+  .pj-facts dt {
+    font-family: var(--font-mono);
+    font-size: 0.8rem;
+    letter-spacing: 0.06em;
+    text-transform: uppercase;
+    color: var(--ink-3);
+  }
+  .pj-facts dd {
+    margin: 0.25rem 0 0;
+    font-size: 1.125rem;
+    line-height: 1.5;
+    color: var(--ink);
+  }
+  .pj-facts a {
+    color: var(--blue);
+  }
+  .pj-gal {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 0.6rem;
+  }
+  .pj-gal :global(img) {
+    width: 100%;
+    height: 100%;
+    aspect-ratio: 4 / 3;
+    object-fit: cover;
+    display: block;
+  }
+  .pj-gal :global(img:first-child) {
+    grid-column: 1 / -1;
+    aspect-ratio: 16 / 9;
+  }
+  .pj-more {
+    padding-block: 0 var(--section);
+  }
+  .pj-cta {
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    justify-content: space-between;
+    gap: 1rem 2rem;
+    background: var(--navy);
+    color: #fff;
+    padding: clamp(1.6rem, 3vw, 2.4rem) clamp(1.4rem, 3vw, 2.8rem);
+  }
+  .pj-cta p {
+    margin: 0;
+    font-family: var(--font-head);
+    font-stretch: 68%;
+    font-weight: 800;
+    font-size: clamp(1.8rem, 3vw, 2.6rem);
+    text-transform: uppercase;
+    line-height: 1;
+  }
+  .pj-h {
+    margin: clamp(3rem, 6vw, 5rem) 0 1.4rem;
+    font-family: var(--font-head);
+    font-stretch: 68%;
+    font-weight: 800;
+    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
+    text-transform: uppercase;
+    color: var(--navy);
+  }
+  .pj-tiles {
+    list-style: none;
+    margin: 0;
+    padding: 0;
+    display: grid;
+    grid-template-columns: repeat(3, minmax(0, 1fr));
+    gap: 1rem;
+  }
+  .pj-tiles a {
+    display: grid;
+    gap: 0.6rem;
+    text-decoration: none;
+    color: var(--ink);
+    font-weight: 500;
+  }
+  .pj-tiles :global(img) {
+    width: 100%;
+    aspect-ratio: 4 / 3;
+    object-fit: cover;
+    display: block;
+  }
+  .pj-back {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.6rem;
+    min-height: 44px;
+    margin-top: 2rem;
+    font-family: var(--font-mono);
+    font-size: 0.85rem;
+    text-transform: uppercase;
+    letter-spacing: 0.06em;
+    color: var(--blue);
+    text-decoration: none;
+  }
+  .pj-back :global(.flip) {
+    transform: scaleX(-1);
+  }
+  @media (max-width: 900px) {
+    .pj-grid,
+    .pj-tiles {
+      grid-template-columns: minmax(0, 1fr);
+    }
+    .pj-facts {
+      position: static;
+      grid-template-columns: 1fr 1fr;
+    }
+  }
+</style>
