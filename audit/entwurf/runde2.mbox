+---
+/**
+ * Einsatzgebiet (Audit LOCAL-02): kurzer Text und schematische Karte.
+ * Hamburg mit Firmensitz, das Umland grob als Fläche abgesteckt. Keine eingebettete Fremdkarte, keine Cookies.
+ */
+import Icon from '~/components/Icon.astro';
+import { laender } from '~/data/karte-nord';
+import { url } from '~/lib/url';
+
+// Ausschnitt Norddeutschland (Einheiten der Quellkarte, ca. 1 Einheit ≈ 1 km)
+const vb = '170 92 200 150';
+// Firmensitz Tilsiter Straße, Hamburg-Wandsbek (aus Lage im Stadtgebiet abgeleitet, schematisch)
+const sitz = { x: 268.9, y: 160.7 };
+---
+
+<section class="eg" aria-labelledby="eg-h">
+  <div class="container eg-grid">
+    <div class="eg-text">
+      <h2 class="h-sec" id="eg-h">Hamburg<br /><span class="lt">und Umgebung.</span></h2>
+      <p class="eg-p">
+        Zuhause sind wir in Hamburg-Wandsbek. Von hier aus bauen wir in ganz Hamburg und in der Metropolregion, in Schleswig-Holstein und Niedersachsen.
+      </p>
+      <p class="eg-p">Ihr Bauvorhaben liegt weiter draußen? Fragen Sie uns gern an.</p>
+      <a class="eg-link" href={url('/kontakt/')}><span>Projekt anfragen</span><Icon name="arrow" /></a>
+    </div>
+    <figure class="eg-map">
+      <svg viewBox={vb} role="img" aria-labelledby="eg-cap">
+        <defs>
+          <radialGradient id="eg-fade" cx="0.5" cy="0.5" r="0.5">
+            <stop offset="0" stop-color="#3948a4" stop-opacity="0.28" />
+            <stop offset="0.75" stop-color="#3948a4" stop-opacity="0.16" />
+            <stop offset="1" stop-color="#3948a4" stop-opacity="0" />
+          </radialGradient>
+        </defs>
+        <rect x="170" y="92" width="200" height="150" fill="#eef0f7" />
+        {['sh', 'ni', 'mv', 'hb', 'bb'].map((id) => <path d={laender[id]} fill="#ffffff" stroke="#c4c9df" stroke-width="0.6" />)}
+        <!-- Umland grob: weiche Fläche um Hamburg -->
+        <circle cx="265" cy="163" r="62" fill="url(#eg-fade)" />
+        <circle cx="265" cy="163" r="54" fill="none" stroke="#3948a4" stroke-width="0.7" stroke-dasharray="2.4 2" opacity="0.7" />
+        <path d={laender.hh} fill="#3948a4" stroke="#121735" stroke-width="0.5" />
+        <!-- Firmensitz als Raute -->
+        <rect x={sitz.x - 2.6} y={sitz.y - 2.6} width="5.2" height="5.2" transform={`rotate(45 ${sitz.x} ${sitz.y})`} fill="#ffffff" stroke="#121735" stroke-width="0.9" />
+        <g class="eg-lbl">
+          <text x="252" y="190" class="eg-city">Hamburg</text>
+          <text x="276" y="155" class="eg-small">Firmensitz Wandsbek</text>
+          <text x="196" y="112" class="eg-land">Schleswig-Holstein</text>
+          <text x="186" y="232" class="eg-land">Niedersachsen</text>
+          <text x="318" y="120" class="eg-land">Mecklenburg-</text>
+          <text x="318" y="127" class="eg-land">Vorpommern</text>
+          <text x="300" y="222" class="eg-area">Metropolregion</text>
+        </g>
+      </svg>
+      <figcaption id="eg-cap">
+        <span>Schematische Karte: Hamburg mit Firmensitz, das Umland grob abgesteckt.</span>
+        <span class="eg-src">Kartengrundlage: MapSVG, CC BY 4.0</span>
+      </figcaption>
+    </figure>
+  </div>
+</section>
+
+<style>
+  .eg {
+    padding-block: var(--section);
+    background: var(--stone-50);
+  }
+  .eg-grid {
+    display: grid;
+    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
+    gap: clamp(2rem, 5vw, 5rem);
+    align-items: center;
+  }
+  .eg-text {
+    display: grid;
+    gap: 1.2rem;
+    justify-items: start;
+  }
+  .eg-p {
+    margin: 0;
+    max-width: 40ch;
+    font-size: clamp(1.1rem, 1.4vw, 1.25rem);
+    font-weight: 300;
+    line-height: 1.6;
+    color: var(--ink);
+  }
+  .eg-link {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.6rem;
+    min-height: 44px;
+    margin-top: 0.4rem;
+    font-family: var(--font-mono);
+    font-size: 0.85rem;
+    letter-spacing: 0.06em;
+    text-transform: uppercase;
+    color: var(--blue);
+    text-decoration: none;
+  }
+  .eg-link:hover span {
+    text-decoration: underline;
+  }
+  .eg-map {
+    margin: 0;
+    display: grid;
+    gap: 0.6rem;
+  }
+  .eg-map svg {
+    display: block;
+    width: 100%;
+    height: auto;
+    clip-path: polygon(0 0, 100% 3%, 100% 100%, 0 97%);
+  }
+  .eg-map figcaption {
+    display: flex;
+    flex-wrap: wrap;
+    justify-content: space-between;
+    gap: 0.3rem 1rem;
+    font-size: 0.85rem;
+    color: var(--ink-3);
+  }
+  .eg-src {
+    font-family: var(--font-mono);
+    font-size: 0.72rem;
+  }
+  .eg-lbl text {
+    font-family: var(--font-body);
+    fill: #2c335f;
+  }
+  .eg-city {
+    font-family: var(--font-head) !important;
+    font-stretch: 68%;
+    font-weight: 800;
+    font-size: 9px;
+    text-transform: uppercase;
+    fill: #121735 !important;
+  }
+  .eg-small {
+    font-size: 4.6px;
+    font-weight: 600;
+  }
+  .eg-land {
+    font-size: 4.6px;
+    letter-spacing: 0.04em;
+    text-transform: uppercase;
+    fill: #5b6188 !important;
+  }
+  .eg-area {
+    font-size: 4.6px;
+    font-style: italic;
+    fill: #3948a4 !important;
+  }
+  @media (max-width: 900px) {
+    .eg-grid {
+      grid-template-columns: minmax(0, 1fr);
+    }
+  }
+</style>
