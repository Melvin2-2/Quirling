     <figure class="figs-photo">
       <span class="figs-img" data-figs-img>
         <Image src={historisch} alt="Historisches Foto einer Baumannschaft auf einem Gerüst" widths={[800, 1200, 1600]} sizes="(min-width: 900px) 46vw, 100vw" />
+        <!-- Markierung: Kreis um den Vater des Gründers, Pfeil und Beschriftung; Lage wird per Skript aus dem Bildausschnitt berechnet -->
+        <span class="figs-ov" data-figs-ov aria-hidden="true">
+          <svg class="figs-mark">
+            <ellipse class="fm-ring" data-fm-ring pathLength="1" />
+            <path class="fm-arrow" data-fm-arrow pathLength="1" />
