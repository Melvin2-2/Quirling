+          <button class="send" type="submit"><span>Anfrage senden</span><Icon name="arrow" /></button>
           <p class="status" data-status role="status" aria-live="polite"></p>
         </div>
       </form>
+      <!-- Bestätigung nach erfolgreichem Versand über den Formulardienst -->
+      <div class="sent" data-sent hidden tabindex="-1">
+        <p class="sent-h">Danke, Ihre Anfrage ist da.</p>
+        <p>Wir melden uns schnellstmöglich bei Ihnen. Eilt es? Rufen Sie uns an: <a href={firma.telefonHref}>{firma.telefon}</a></p>
+      </div>
     </div>
   </section>
 
@@ -237,6 +242,36 @@ const anliegen = ['Neubau', 'Rohbau', 'Schlüsselfertig', 'Umbau & Sanierung', '
   .ask-h .lt {
     color: #c9d0f5;
   }
+  .form[hidden] {
+    display: none;
+  }
+  .sent {
+    align-self: start;
+    display: grid;
+    gap: 0.8rem;
+    padding: clamp(1.6rem, 3vw, 2.6rem);
+    background: #fff;
+    color: var(--ink);
+    font-size: 1.125rem;
+    line-height: 1.6;
+  }
+  .sent p {
+    margin: 0;
+  }
+  .sent-h {
+    font-family: var(--font-head);
+    font-stretch: 68%;
+    font-weight: 800;
+    font-size: clamp(1.8rem, 3vw, 2.6rem);
+    line-height: 1;
+    text-transform: uppercase;
+    color: var(--navy);
+  }
+  .sent a {
+    color: var(--blue);
+    font-weight: 600;
+    white-space: nowrap;
+  }
   .ask-head p {
     margin: 0;
     font-size: 1.125rem;
@@ -506,7 +541,16 @@ const anliegen = ['Neubau', 'Rohbau', 'Schlüsselfertig', 'Umbau & Sanierung', '
         form.reset();
         form.classList.remove('was-validated');
         newTask();
-        say('Vielen Dank! Ihre Nachricht wurde gesendet. Wir melden uns zeitnah bei Ihnen.', 'ok');
+        say('');
+        // Bestätigung ersetzt das Formular
+        const sent = document.querySelector<HTMLElement>('[data-sent]');
+        if (sent) {
+          form.hidden = true;
+          sent.hidden = false;
+          sent.focus();
+        } else {
+          say('Vielen Dank! Ihre Anfrage ist da. Wir melden uns schnellstmöglich bei Ihnen.', 'ok');
+        }
       } catch {
         say('Leider ist ein Fehler aufgetreten. Bitte schreiben Sie uns direkt per E-Mail.', 'err');
       }
